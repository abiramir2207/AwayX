<CFPARAM NAME="IDGENERATOR_GENERATEDIDVARIABLENAME" DEFAULT=""> 
<CFPARAM NAME="IDGENERATOR_DESTINATIONTABLE" DEFAULT=""> 
<CFPARAM NAME="IDGENERATOR_DESTINATIONFIELD" DEFAULT=""> 


<CFSET GENERATED_ID = #CREATEUUID()#>
<CFSET UNIQUEID = 0>

<CFLOOP CONDITION="UniqueID EQUAL 0">
	<CFQUERY NAME="CheckForDuplicateID" datasource="#application.datasource#" DBTYPE="ODBC">
		SELECT #IDGENERATOR_DESTINATIONFIELD#
		FROM 
			#IDGENERATOR_DESTINATIONTABLE# 
		WHERE 
			#IDGENERATOR_DESTINATIONFIELD# = '#Generated_ID#'
	</CFQUERY>
	<CFIF CHECKFORDUPLICATEID.RECORDCOUNT EQ 0>
		<CFSET "#IDGENERATOR_GENERATEDIDVARIABLENAME#" = GENERATED_ID>
		<CFSET UNIQUEID = 1>
	</CFIF>
</CFLOOP>
