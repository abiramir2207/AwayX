	   // labelfunction used to calculate the net lbs
	   // Updates the dataProvider with the amount
	   private function calcPounds(item:Object, column:DataGridColumn):String
	   {
	      var emptyField:String = "";
	
	     if (!isNaN(item['Cases_Claimed']) && item['Cases_Claimed'] != null && StringUtil.trim(item['Cases_Claimed']) != "") {
	     		var pounds:Number = item['Item_Case_Weight'] * item['Cases_Claimed'];
	            item['Net_Lbs_Claimed'] = pounds;
	          
	          return pounds.toString();
	        }
	     else {
	     	return emptyField
	     }
	   }
	    
	    // labelfunction used to calculate the Adjusted Amount
	    // Updates dataProvider with the calculated amount
	    // We may come up with a better way to handle this but it works
	    private function calcAdjAmount(item:Object, column:DataGridColumn):String 
	    {
	    	 
	    	 var adjustedAmt:String;
	    	 var emptyField:String = "";
	    	 var adjTotal:Number = 0;
	    	 
	    	 
	    	  if (item['Cases_Claimed'] != null && StringUtil.trim(item['Cases_Claimed']) != ""  && !isNaN(item['Cases_Claimed'])) 
	    	  {
	    	  	adjustedAmt = numFormat.format(Number(item['Net_Lbs_Claimed']) * Number(removeFormatting.format(item['Net_Promo_Amt'])));
	    	 	item['Adj_Extended_Amt'] = adjustedAmt;
				
				totalAmts();
				totalCases();
	    	 	//return basicCurrencyFormat.format(adjustedAmt.toPrecision(4).toString());
	    	 	return basicCurrencyFormat.format(adjustedAmt.toString());
	
	    	 }
	    	 else {
		    	 	totalAmts();
		    	 	totalCases();
	    		 	return emptyField;
	    	 }
	    }
	    
