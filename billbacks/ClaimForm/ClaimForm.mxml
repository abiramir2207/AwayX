				<mx:Text id="shipToNum" />
				<mx:Text id="destination" />
				<mx:Text id="stateLbl" />
			</mx:VBox>
			<mx:VBox height="100%" verticalGap="-2">
				<mx:Text text="Purchasing Group:" fontWeight="bold"/>
				<mx:Text id="corpPgm" />
				<mx:Text id="deductAutosF" />
				<mx:Text id="deduct" />
			</mx:VBox>
			<mx:VBox height="100%" verticalGap="-2">
				<mx:Spacer height="15"/>
