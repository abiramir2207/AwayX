	    private function enableButtons(pane:Number):void 
		{
			saveForm.enabled = true;
			sendForm.enabled = true;
			deleteFormBtn.enabled = false;
		
			switch (pane) 
			{
				case 1:
				       saveForm.enabled = true;
				       sendForm.enabled = true;
				       saveForm.label = "Save Form";
				       isEnabled = true;
				       break;
				case 2: 
				       saveForm.enabled = true;
				       sendForm.enabled = true;
				       deleteFormBtn.enabled = true;
				       saveForm.label = "Update Form";
				       isEnabled = true;
				       break; 
			    case 3:
			           saveForm.enabled = true;
			           sendForm.enabled = true;
			           saveForm.label = "Update Form";
			           isEnabled = true;
			           break;
			    case 4:
			           saveForm.enabled = false;
			           sendForm.enabled = false;
			           saveForm.label = "Save Form";
			           isEnabled = false;
			           break;
			}
		}
	     
		public function printClaim():void
		{
			var printJob:FlexPrintJob = new FlexPrintJob();
			
			if (printJob.start())
			{
			  
				var printView:ClaimPrintView = new ClaimPrintView();
				addChild(printView);
				printView.width=printJob.pageWidth;
				printView.height=printJob.pageHeight;
				
				printView.ProgramNum.text = lwProgramNum.text;
				printView.desc.text = desc.text;
				printView.effDate.text = progEffDate.text;
				printView.endDate.text = progEndDate.text;
				printView.invNum.text = "Inv/Ref No: " + inv.text;
				printView.distributor.text = dist.text;
				printView.shipNum.text = shipToNum.text;
				printView.dest.text = destination.text;
				printView.stateTxt.text = stateLbl.text;
				// printView.claimDateFrom.text = 'From: ' + claimDateFrom.text;
				// printView.claimDateTo.text = 'To: ' + claimDateTo.text;
				printView.claimDateFromVis.text = 'From Date: ' + claimDateFromVis.text;
				printView.claimDateToVis.text = 'To Date: ' + claimDateToVis.text;
				printView.claimAmt.text = 'Amount: ' + amt.text;
				// printView.invDate.text = 'Date: ' + invDate.text;
				printView.payName.text = payName.text;
				printView.payNum.text = payToNum.text;
				printView.bsNum.text =  baProgramNum.text;
				printView.broker.text = broker.text;
				printView.brokerNum.text = brokerNum.text;
				printView.corpPGM.text = corpPgm.text;
				printView.deductAutosF.text = deductAutosF.text;
				printView.deductAutos.text = deduct.text;
				printView.pullback.text = pullback.text;
				
				printView.casesTotal.text = 'Total # Cases Claimed: ' + casesTotal.text;
				printView.extAmtTotal.text = 'Extended Amount Total: ' + extAmtTotal.text;
				
			       printView.showPage("single");
			       if(!printView.PrintGrid.validNextPage)
	               {
	                	printJob.addObject(printView,FlexPrintJobScaleType.MATCH_HEIGHT);
	               }
			       else
	            	{
	                	// Create the first page and add it to the print job.
	                
	               		printView.showPage("first");
	                	printJob.addObject(printView,FlexPrintJobScaleType.MATCH_HEIGHT);
	                	printView.pageNumber++;
	                	// Loop through the following code until all pages are queued.
	                	while(true)
	                	{
		                    // Move the next page of data to the top of the print grid.
		                    printView.PrintGrid.nextPage();
		                    printView.showPage("last");    
		                    // If the page holds the remaining data, or if the last page 
		                    // was completely filled by the last grid data, queue it for printing.
		                    // Test if there is data for another PrintDataGrid page.
		                    if(!printView.PrintGrid.validNextPage) 
		                    {
								// This is the last page; queue it and exit the print loop.
		                        printJob.addObject(printView,FlexPrintJobScaleType.MATCH_HEIGHT);
		                        break;
		                    }
	                    else
	                    // This is not the last page. Queue a middle page. 
	                    {
	                        printView.showPage("middle");
	                        printJob.addObject(printView,FlexPrintJobScaleType.MATCH_HEIGHT);
	                        printView.pageNumber++;
	                    }
	                }
	            }
			      
			       removeChild(printView);
			       printJob.send();
			}
	
		}
	     
	     private function totalCases():void
	     {
	     	      var total:Number = 0;
	     	      var item:Object = new Object();
	     	      var i:Number;
	     	      
	     	      for (i = 0; i < claimDetail.length; i++)
	     	      {
	     	      	item = claimDetail.getItemAt(i);
	     	      	total += Number(item['Cases_Claimed']);
	     	      }
	     	      
	     	      casesTotal.text = String(total);
	     }
	     
	     private function totalAmts():void
	     {   
	     	      var adjTotal:String;
	     	      var i:Number;
	     	      var total:Number;
	     	      
	     	      for (i = 0; i < claimDetail.length; i++)
	     	      {
	     	      	
	     	      	if (String(claimDetail[i].Cases_Claimed) != "")
	     	      	{
	     	      		adjTotal = numFormat.format(Number(adjTotal) + Number(removeFormatting.format(claimDetail[i].Adj_Extended_Amt)));
	     	      	}	
	     	      }
	     	      extAmtTotal.text = numFormat.format(basicCurrencyFormat.format(adjTotal));
	     }
	     
	     private function getForms(event:Event):void
	     {
	   		// When users select a claim and then click on another tab then we need to clear the claim detail so that they dont click save.  
