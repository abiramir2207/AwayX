	       }
	   
	   public function formatCurrency(item:Object, column:DataGridColumn):String 
	      {
	   	       var myAmt:String = item[column.dataField];
	   	       if (myAmt == '0')
	   	       {
	   	       	  myAmt = fourDecimalFormat.format('.0000');
	   	       }
	   	       else
	   	       {
	   	       	myAmt = fourDecimalFormat.format(item[column.dataField]);
	   	       }
	   	       
	   	       return myAmt;
	   	      
	      }
	   public function standardCurrencyFormatter(item:Object, column:DataGridColumn):String
	      {
