		//1
	    private function manageFromToDateComparison():Boolean
	    {	
	     	var fromDate:Date = new Date(claimDateFromVis.text);
	     	var toDate:Date = new Date(claimDateToVis.text);
	     	var fromDateString:String = new String(claimDateFromVis.text);
	     	var toDateString:String = new String(claimDateToVis.text);
			if (fromDateString.length > 0 && toDateString.length > 0)
			{
	 		   	  var areValidDates:Boolean = true;
			      var result:int = DateUtils.compareDates(fromDate,toDate);
	
				  switch (result)
				  {
					case -1:
					  areValidDates = false;
					  Alert.show("FromDate is greater than ToDate and MUST be less than ToDate","From Date Greater...",4.0,null,fromDateAlertActions);
					  //compareFromToDates.text="-1";
					  break;
					
					case 0:
					  areValidDates = false;
					  Alert.show("FromDate equals ToDate and MUST be less than ToDate","From Date Equal...",4.0,null,fromDateAlertActions);
					  //compareFromToDates.text="0";
					  break;
					  
					case 1:
					  areValidDates = true;
					  manageToNowDateComparison();
					  //Alert.show("compareDates() FromDate is less than ToDate");
					  //compareFromToDates.text="1";
					  break;  
				  } 
	
	     		}
	     	return areValidDates;
	    }
	    
	    //2
	    private function manageToNowDateComparison():Boolean
	    {	
	     	var toDate:Date = new Date(claimDateToVis.selectedDate);
	     	var nowDate:Date = new Date();
	     		
	 		   if (claimDateFromVis.selectedDate != null && claimDateToVis.selectedDate != null)
	 		   {
	 		   	  var areValidDates:Boolean = true;
			      var result:int = DateUtils.compareDates(toDate,nowDate);
	
				  switch (result)
				  {
					case -1:
					  areValidDates = false;
					  Alert.show("ToDate is greater than Today and MUST be less than or equal to Today","To Date Greater...",4.0,null,toDateAlertActions);
					  //compareToNowDates.text="-1";
					  break;
					
					case 0:
					  areValidDates = true;
					  //compareToNowDates.text="1";
					  break;
					  
					case 1:
					  areValidDates = true;
					  //compareToNowDates.text="1";
					  break;  
				  } 
	
	     		}
	     	return areValidDates;
	    }
	    
