					<mx:DateField id="brkrRecDateVis" dateChooserStyleName="searchPanel" formatString="MM/DD/YY" tabIndex="6" showToday="true" change="backToBlack();" disabledRanges="{[{rangeStart:tomorrow()}]}" enabled="{isEnabled}" textAlign="right" editable="true" />
				</mx:HBox>
