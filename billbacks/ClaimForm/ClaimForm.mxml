	   	      return amt;
	      }
	   
	  private function dateFormatter(event:Event):void
	     {
	      	var dateText:TextInput = event.currentTarget as TextInput;
	      	var dateString:String = dateText.text;
	      	if (dateString.indexOf("/",0) > -1)
	      	{
	      		dateText.text = StandardDateFormat.format(dateString);
	      	}
	      	else
	      	{
	      		var theDate:String = dateString.substring(0,2) + '/' + dateString.substr(2,2) + '/' + dateString.substr(4,4);
	      		dateText.text = StandardDateFormat.format(theDate);
	      	}
	      	
	     }
	         
