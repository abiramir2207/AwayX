		private function saveFormInfo(state:String,canSave:String = 'noSave'):void 
		{
			var formArgs:Object = new Object();
			var errormessage:String = '';
			var formState:String = state;
		 	var caseTotal:Number = 0;
		 	var amtTotal:Number = Number(removeFormatting.format(extAmtTotal.text));
		 	var numberCompare:NumberUtils = new NumberUtils();
		 	var caseTotalTxt:Number = Number(claimed.text);
		 	var amtTotalTxt:Number = Number(removeFormatting.format(amt.text));
		 	var numResult:Boolean;
		 	var promoAmtBlank:Boolean = false;
		 	var difference:Number;
		 	var amtDifference:Number;
		 	var amtResult:Boolean;
		 	var todaysDate:Date = new Date();
	  		var item:Object = new Object();
	  		var claimsInRange:Boolean = claimDatesInRange();
	  		var claimFromToDate:Boolean = claimFromToDatesValidate();
	  		Alert.okLabel = "OK";
			Alert.cancelLabel = "Edit";
	
	 		formArgs.formId = form_id.text;
			formArgs.user_id = userId;
	
	  		if (claimform_id.text != "0") 
	  		{
	 			formArgs.ClaimFormId = claimform_id.text;
	 		}
	 
	 		formArgs.claimDateFrom = claimDateFromVis.text;
			formArgs.claimDateTo = claimDateToVis.text;
			formArgs.inv = inv.text;
			formArgs.amt = removeFormatting.format(amt.text);
			formArgs.brokerDate = brkrRecDateVis.text;
			formArgs.invoiceDate = invDateVis.text;
			formArgs.casesClaimed = claimed.text;
	  
	  		if (formState == "save")
	  		{
				formArgs.formState = 1;
	  		}
	  		
	  		if(saveForm.label == "Save Form") 
	  		{
	 			formArgs.saveType = "save";
	  		}
	  
	  		if (formState == "send")
	  		{ 
	 			formArgs.formState = 2;
	  		}
	  		
	  		if(saveForm.label == "Update Form")
	  		{
				formArgs.saveType = "update"; 
	  		}
	
			// Call validation method and store it in a string to display the error message
	   		errormessage += collectValidations(claimDateFromValidator);
			errormessage += collectValidations(currencyValidator);
			errormessage += collectValidations(claimDateToValidator);
			errormessage += collectValidations(invValidator);
			errormessage += collectValidations(brkrRecDateValidator);
			errormessage += collectValidations(invDateValidator);
			errormessage += collectValidations(casesClaimedValidator);
	  
			if (errormessage) 
			{
				Alert.show(' Please correct the following errors, Note: These fields will have red boxes around them:\n' +errormessage, 'Errors Found');
				this.sendForm.enabled = true;
				return;
			}
	
			// We do a check to make sure the number of cases claimed in the claimed TextInput
			// Matches the total amount of cases claimed in the item detail
			// We the data can not be submitted if these 2 values don't match 
			for (var i:Number = 0; i < claimDetail.length; i++) 
			{
				item = claimDetail.getItemAt(i);
			  	if (item['Cases_Claimed'] != null && StringUtil.trim(item['Cases_Claimed']) != ""  && !isNaN(item['Cases_Claimed']))
			  	{
			  		caseTotal = (caseTotal + Number(item['Cases_Claimed']));
			  	 	if (Number(removeFormatting.format(item['Net_Promo_Amt'])) == .0000)
			  	    {
			  	    	promoAmtBlank = true;
			  	    }
			  	}
			}
	 		difference = (caseTotalTxt - caseTotal);
	 		amtDifference = (amtTotalTxt - amtTotal);
	 		numResult = numberCompare.numCompare(caseTotalTxt,caseTotal);
	 		amtResult = numberCompare.totalsCompare(amtTotalTxt,amtTotal);
	 
			if (numResult) 
			{
				Alert.show('The amount of cases you claimed does not match the amount of cases claimed in the item section:\n Header Total: ' +caseTotalTxt + '\n Item Total: ' + caseTotal + '\n Difference: ' +difference);
				return;
			}
	 
			if (!claimsInRange)
			{
				Alert.show('The claim dates are not in the Programs Effective Dates. Please adjust the Claim Dates.');
			    return;
			}
			if (!claimFromToDate)
			{
				Alert.show('The From Date is Greater than the To Date. Please adjust the Claim Dates.');
			    return;
			}
	 
			if (!amtResult && canSave != 'save')
			{
				Alert.show('The Adjusted total amount in the header is greater than or less than $5.00 the amount in the item detail. \n Click "OK" to continue or "Edit" to fix the Header amount', "Alert", 4|8, this, submitClaim);
			    return;
			}
	 
			/*
			RBL D&G16302 [begin] 
	 		if (!dateComparer())
	 		{
	   			var message:String = "The From Date is Greater than the To Date. Please Fix your Dates.";
	  			claimDateFrom.setFocus();
	 			Alert.show(message);
	  			return;
	 		}
	 		if (!dateComparer2()) 
	 		{
	  			Alert.show("The to date must not be in the future");
	   			return;
	 		}
	 		RBL D&G16302 [end]	
			*/
			   
			if (promoAmtBlank)
			{
	   			Alert.show('The Promo Amount cannot be 0 if you entered in a case amount for that item.');
			}
			else
			{
	 			//CursorManager.setBusyCursor();
	 			// Send Header Info to RemoteObject to Save
	   			newFormObject.saveInfo(formArgs);
			}    
		} 
	    
	   // Check validators and return a message with the name
	   // And the message to display to the user
	   public function collectValidations(v:Validator):String 
	   {
		  var vResult:ValidationResultEvent = v.validate() ;
		   
		    if (vResult.type == ValidationResultEvent.INVALID) 
		    {
		       return v.source.id + ' ' + vResult.message + '\n';
		    }
			return '';
	    }
	  
