	   		claimDetail = null;
	   		
	     	if (tabs.selectedIndex == 0)
	     	{
	     		enableButtons(1);
	     	}
	     	
	     	if (tabs.selectedIndex == 1 && searchEnabled == false)
	     	{
	     		newFormObject.getNewClaims();
	     		enableButtons(1);
	     	}
	     	
	     	if (tabs.selectedIndex == 2 && !searchEnabled)
	     	{
	     		newFormObject.getSavedClaims();
	     		enableButtons(2);
	     	}
	     	if (tabs.selectedIndex == 3 && !searchEnabled)
	     	{
	     		newFormObject.getPendingClaims();
	     		enableButtons(3);
	     	}
	     	if (tabs.selectedIndex == 4 && !searchEnabled)
	     	{
	     		newFormObject.getSentClaims();
	     		enableButtons(4);
	     	}
	     }
