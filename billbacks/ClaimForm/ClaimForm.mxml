      </mx:VBox>
      </mx:HDividedBox>
    </MinMaxPanel>
    
    <!-- DETAILS SECTION -->
    <MinMaxPanel width="100%" height="100%" maxHeight="{vBox.height-35}" borderStyle="none" id="details" panelTitle="Item Detail" color="#FFFFFF" maxWidth="{vBox.width}" showMaximize="false"
				minimized="header.maximize(false)"
				normalized="header.normalize(false)"
				showMinimize="false">
     <mx:VBox right="0" left="0" bottom="5" top="0" tabEnabled="false">
		<mx:DataGrid id="claimFormGrid" liveScrolling="true" 
			         dataProvider="{claimDetail}" width="100%" 
			         height="100%" 
			         color="#000000" editable="{isEnabled}" 
			         fontFamily="Arial" 
			         paddingBottom="0" paddingTop="0"
			         tabEnabled="true" tabIndex="8"
			         >
			<mx:columns>
				<mx:DataGridColumn headerText="CAT NO." dataField="Program_ItemId" headerStyleName="redDataGridHeader" width="48" editable="false" />
				<mx:DataGridColumn headerText="Desc" dataField="Item_Desc" width="100" headerStyleName="redDataGridHeader" editable="false" />
				<mx:DataGridColumn headerText="Net Wt" dataField="Item_Case_Weight" width="45" headerStyleName="redDataGridHeader" editable="false" />
				<mx:DataGridColumn headerText="# Cases Claimed" dataField="Cases_Claimed" editable="{isEnabled}" width="95" headerStyleName="greenDataGridHeader"/>
				<mx:DataGridColumn headerText="Net Lbs Claimed" dataField="Net_Lbs_Claimed" width="90" labelFunction="calcPounds" headerStyleName="redDataGridHeader" editable="false"/>
				<mx:DataGridColumn headerText="STD" dataField="STD" editable="false" headerStyleName="redDataGridHeader" width="30"/>
				<mx:DataGridColumn headerText="Rebate Rate" dataField="Promo_rate" headerStyleName="redDataGridHeader" labelFunction="formatCurrency" editable="false"/>
				<mx:DataGridColumn headerText="Base Price" dataField="Invoice_Price" headerStyleName="redDataGridHeader" labelFunction="formatCurrency" editable="false"/>
				<mx:DataGridColumn headerText="(If Fixed) Promo Amt" dataField="Promo_Amt" headerStyleName="redDataGridHeader" labelFunction="formatCurrency" editable="false"/>
				<mx:DataGridColumn headerText="Pricelist" dataField="Price_List" headerStyleName="redDataGridHeader" editable="false"/>
				<mx:DataGridColumn dataField="Less_Corp_Allow" id="Less_Corp_Allow" headerStyleName="redDataGridHeader" labelFunction="formatCurrency" editable="false"/>
				<mx:DataGridColumn dataField="Less_Local_Allow" id="Less_Local_Allow" headerStyleName="redDataGridHeader" labelFunction="formatCurrency" editable="false"/>
				<mx:DataGridColumn headerText="Promo Amt" dataField="Net_Promo_Amt" headerStyleName="greenDataGridHeader" editable="{isEnabled}" labelFunction="formatCurrency" />
				<mx:DataGridColumn headerText="Adjusted Ext Amt Claimed" dataField="Adj_Extended_Amt" headerStyleName="redDataGridHeader" labelFunction="calcAdjAmount" editable="false"/> 
			 	<mx:DataGridColumn headerText="itemid" dataField="item_Id" visible="false" editable="false" width="0" />
			 	<mx:DataGridColumn headerText="claimformfk" dataField="ClaimFormFK" visible="false" editable="false" width="0"/>
			</mx:columns>
		</mx:DataGrid>

		<mx:HBox width="100%">
			<mx:Label text="Total # Cases Claimed:" color="#000000"/>		
			<mx:Text text="0" width="116" id="casesTotal"/><mx:TextInput id="myid" visible="false" color="#000000"/>
		</mx:HBox>
		<mx:HBox width="100%">
			<mx:Label text="Extended Amount Total:" color="#000000"/>		
			<mx:Text text="0" width="116" id="extAmtTotal"/>
		</mx:HBox>
		<mx:HBox width="100%" horizontalAlign="center" horizontalGap="1" verticalAlign="bottom" height="22">
			<mx:Button id="saveForm" visible="true" label="Save Form" click="checkFormInfo('save')" tabIndex="9"/>
			<mx:Button id="sendForm" label="Send Form" click="checkFormInfo('send')"/>
			<mx:Button id="deleteFormBtn" label="Delete" click="deleteFormItem();"/>
			<!--<mx:Button id="printBtn" icon="@Embed('/assets/PrintImg.gif')" labelPlacement="left" label="Print" click="printClaim();"/>-->
			<mx:Button id="pdfBtn" label="PDF" click="pdfClaim();"/>
			<mx:Button id="emailFormBtn" label="Email" click="emailClaim();" />
			<mx:Button id="Comments" visible="true" label="Comments" click="commentsURL()"/><!--30374-One Page Claim Form - Add a Comment Field-->
		</mx:HBox>
		<mx:HBox horizontalAlign="center" width="100%">
			<mx:Text fontFamily="Arial" fontSize="12" color="#FF0000" id="msgTxt"/>
		</mx:HBox>
	 </mx:VBox>
	    <mx:TextInput id="brokeridnum" height="0" width="0" visible="false" tabEnabled="false"/>
		<mx:TextInput id="form_id" height="0" width="0" text="0" visible="false" tabEnabled="false"/>
		<mx:TextInput id="claimform_id" height="0" text="0" color="#000000" visible="FALSE" tabEnabled="false"/>
    </MinMaxPanel>
  </mx:VBox>
</mx:Application>