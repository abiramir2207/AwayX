			<mx:Label text="PROGRAM EFF DATE:" id="effDate" fontAntiAliasType="advanced" fontSize="9"/>
			<mx:Label text="PROGRAM END DATE:" id="endDate" fontAntiAliasType="advanced" fontSize="9"/>
			<mx:Label text="Inv/Ref No:" id="invNum" fontAntiAliasType="advanced" fontSharpness="50" fontSize="9"/>
			<mx:Label text="Distributor:" id="distributor" fontAntiAliasType="advanced" fontSharpness="50" fontSize="9"/>
			<mx:Label text="Ship-To No:" fontAntiAliasType="advanced" fontSharpness="50" fontSize="9" id="shipNum"/>
			<mx:Label text="Destination" fontAntiAliasType="advanced" fontSharpness="50" fontSize="9" id="dest"/>
			<mx:Label text="ST:" fontAntiAliasType="advanced" fontSharpness="50" fontSize="9" id="stateTxt"/>
			<mx:Label text="From Date:" id="claimDateFromVis" fontAntiAliasType="advanced" fontSharpness="50" fontSize="9"/>
			<mx:Label text="To Date:" id="claimDateToVis" fontAntiAliasType="advanced" fontSharpness="50" fontSize="9"/>
		</mx:VBox>
		<!--
		<mx:VBox height="100%" verticalGap="-1">
			<mx:Label/>
