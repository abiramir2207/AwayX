<cfsilent>
<!---get application settings--->
<cfset genSettingsManager = CreateObject("component", "components.settings.ApplicationSettingsManager").init() />
<cfset BBProgramManager = CreateObject("component", "components.Billback.Programs.BillbackProgramsManager") />
<cfset appSettings = genSettingsManager.get()>

<cfparam name="URL.BBID" default="">
<cfparam name="URL.AUTOBB" default="">
<cfparam name="url.modifyagree" default="0">
<cfparam name="URL.source" default="">
<cfparam name="bBillbackSalesTax" default="0">
<CFSET LocalBBID = 0>
<CFSET VarCopiedBB = 0>
<cfset Split_Parent = 0 />

<cfscript>
  // 27047 - determine the statement template to run based on the bb statement type setting
  vars = StructNew();
  vars.bb_statement_type = appSettings.getBillBack_Statement_Type();
  if ( vars.bb_statement_type eq "claim-summary" ) {
    // claim auto print setting is on
    vars.statementCFM = "summaryReport.cfm";
  }
  else if ( vars.bb_statement_type eq "pdf-v2" ) {
    // Solo statement type
    vars.statementCFM = "create_summary_statement.cfm";
  }
  else if ( vars.bb_statement_type eq "excel-v3" ) {
    // GM excel statement
    vars.statementCFM = "xls_statement.cfm";
  }
  else {
    // Heinz claim summary statement
    vars.statementCFM = "claimsummary_report.cfm";
  }
</cfscript>

<cfparam name="IsSplitChild" default="0">
<cfset iBBDevOverridePrice = appSettings.BB_DEVIATIONS_OVERRIDE_PRICE />
<cfquery name="getBBSettings" datasource="#application.datasource#">
	SELECT 	Enable_BB_Dup_Check
	FROM 		Billback_Settings
</cfquery>	
<CFIF len(trim(URL.BBID)) GT 0>
	<cfquery name="quickBBCheck" datasource="#Application.Datasource#">
		SELECT 	Billback.Billback_ID, Billback_Status_ID, Auto_Billback, CopiedBB, VolumeRateSaved,
				BB_Creator_ID, Created_Date, BB_Request_Approval_User_ID, BB_Request_Approval_Date,
				BB_Approved.Date_Approved, BB_Approved.User_Approved,
				BB_Reset_User_ID, BB_Reset_Date, BB_Is_Child, Scheduled_Auto_BB,
				BB_Disagree, BB_Disagree_Date, BB_Disagree_By,Negative_Billback,
				(SELECT COUNT(Billback_ID) FROM BB_Agreed_Info WHERE BB_Agreed_Info.Billback_ID =  '#URL.BBID#' AND BB_Agreed_Info.Deleted = 0)
				AS Agreed_Count
				,BB_Reversed
				,BB_Reversed_By
				,BB_Reversed_Date
				,Billback.BB_Deviations_Override_Price as BB_Level_Deviations_Override_Price_Flag
				,Billback.BB_Upload_Dup_Group_ID
		FROM 	Billback
				LEFT JOIN BB_Approved
				ON
				BB_Approved.Billback_ID = Billback.Billback_ID
		WHERE 	Billback.Billback_ID = '#URL.BBID#'
				AND Billback.Deleted = 0
	</cfquery>
	<cfif quickBBCheck.BB_Level_Deviations_Override_Price_Flag EQ 1>
		<cfset iBBDevOverridePrice = 1 />
	</cfif>

	<!--- Get the Billback number --->
<cfquery name="Get_Billback_Info" datasource="#application.datasource#">
	SELECT	  	isnull(Billback_Program.Program_ID,'') AS ProgramID,
				isNull(Billback.Claim_Cases, 0.00) as Claim_Cases,
				isNull(Billback.Claim_Pounds, 0.00) as Claim_Pounds,
				isNull(Billback.BB_Amount, 0.00) as BB_Amount,
				Billback.*,
				Billback_Allied.BB_Is_Locked,
				Billback_Allied.BB_Locked_By_User_ID,
				Billback_Status.BB_Status_Description,
				_USERS.name_first + ' ' + _USERS.name_last as user_name,
				DD_Closure_Sent_On
	FROM		Billback
				LEFT JOIN Billback_Allied ON
				Billback_Allied.Billback_ID = Billback.Billback_ID
				LEFT JOIN Billback_Program ON
				Billback_Program.billback_id = 	Billback.billback_id
				AND Billback_program.deleted = 0
				LEFT JOIN   Billback_Status ON
				Billback_Status.Billback_Status_ID = Billback.Billback_Status_ID
				LEFT JOIN _USERS ON
				_USERS.USER_ID = Billback.BB_modify_agree_user
	WHERE		Billback.Deleted = 0
	AND			Billback.Billback_ID = '#URL.BBID#'
</cfquery>

	<cfif len(trim(Get_Billback_Info.BB_parent_ID)) GT 0>
		<cfset IsSplitChild = 1>
	</cfif>

	<CFQUERY NAME="CheckSplit" DATASOURCE="#Application.Datasource#">
		SELECT Top 1 * FROM Billback WHERE BB_parent_ID = '#URL.BBID#' AND Deleted = 0
	</CFQUERY>

	<CFIF quickBBCheck.CopiedBB NEQ "" AND quickBBCheck.VolumeRateSaved NEQ 1>
		<CFSET VarCopiedBB = quickBBCheck.CopiedBB>
	</CFIF>
	<CFIF quickBBCheck.recordcount GT 0>
		<CFSET LocalBBID = URL.BBID>
	</CFIF>

	<!--- <cfif quickBBCheck.Billback_Status_ID GT 2>
		<cfset quickBBCheck.Auto_Billback = 0>
	</cfif> --->

	<cfquery name="BB_Check_GL_Code_Alloc" datasource="#Application.Datasource#">
		SELECT 	Top 1 *
		FROM 	Gl_Code_Allocation
		WHERE 	Billback_ID = '#URL.BBID#' AND
				GL_Code_Allocation.Deleted = 0 AND
				Allocation_Saved = 1
	</cfquery>
	<cfset GLCode_Allocation = BB_Check_GL_Code_Alloc.recordCount />
	<cfset Split_Parent = CheckSplit.recordCount />
	
	<!---- BB Sales Tax (Start) --->
	<cfset CheckTemplateApprovalRights = BBProgramManager.getTemplateApprovalRights(URL.BBID)>

	<cfset bBillbackSalesTax = 0 />
	<cfif (CheckTemplateApprovalRights.RecordCount GTE 2)>
		<cfloop query = "CheckTemplateApprovalRights">
			<cfif (CheckTemplateApprovalRights.Billback_Sales_Tax EQ 1)>
				<cfset bBillbackSalesTax = 1 />
			</cfif>
		</cfloop>
	<cfelseif (CheckTemplateApprovalRights.Billback_Sales_Tax EQ 1)>
		<cfset bBillbackSalesTax = 1 />
	</cfif>
	<!---- BB Sales Tax (End) --->

<cfelse>
	<cfset quickBBCheck.Billback_Status_ID = 0>
	<cfset quickBBCheck.Billback_ID = 0>
	<cfset quickBBCheck.Scheduled_Auto_BB = 0>
	<cfif URL.AUTOBB EQ "1">
		<cfset quickBBCheck.Auto_Billback = 1>
		<cfset quickBBCheck.Scheduled_Auto_BB = 1>
	<cfelseif URL.AUTOBB EQ 2>
		<cfset quickBBCheck.Auto_Billback = 2>
		<cfset quickBBCheck.Scheduled_Auto_BB = 1>
	<cfelse>
		<cfset quickBBCheck.Auto_Billback = 0>
	</cfif>
	<cfset quickBBCheck.Negative_Billback = 0>
	<cfset quickBBCheck.BB_Reversed = 0>
	<cfset quickBBCheck.BB_UPLOAD_DUP_GROUP_ID = 0>
</CFIF>

<cfset enablePaymentTabAfterPaidStatus = 0 />
<cfif UCase(left(application.returned_customer_setting.Customer_Keyword,1)) EQ "H" AND UCase(right(application.returned_customer_setting.Customer_Keyword,1)) EQ "Z">
	<cfset enablePaymentTabAfterPaidStatus = 1 />
</cfif>

<cfset basicInfoPage = "/billbacks/capture/basic_information_form.cfm">
<CFIF len(trim(LocalBBID)) GT 0 AND LocalBBID NEQ 0>
<cfset iframeSourcePage = "Billback_Summary.cfm?BBID=#LocalBBID#" />
<cfelse>
	<cfset iframeSourcePage = basicInfoPage>
</CFIF>
<cfset paymentExtraURL = "">
<!--- moved modify agree code to bb_menu_stats.cfm --->

</cfsilent>


<!--- <cfinclude template="bb_menu_stats.cfm">  --->

<!------ If coming from deduction ----->
<cfif isDefined("URL.DEDUCTION_ID") AND URL.DEDUCTION_ID NEQ "" AND LocalBBID NEQ 0>
	<!------ If the billback is approved, lock the billback and take to payment tab ----->
	<cfif quickBBCheck.Billback_Status_ID GTE 3>
		<cfset iframeSourcePage = "Billback_Locker.cfm?BBID=#LocalBBID#&Billback_IsLocked=1&relocatePage=payment&DEDUCTION_ID=#URL.DEDUCTION_ID#&failureURLType=deduction">
		<cfset paymentExtraURL = "&DEDUCTION_ID=#URL.DEDUCTION_ID#">
	<cfelse>
		<cfoutput>
		<br><br><br>
		<center><span style="color:red;font-weight:bold;font-size:14px;">
		The billback is not yet approved.
		<br><br><br>
		<table cellpadding="0" cellspacing="0">
		<tr><td align="left" style="font-weight:bold;font-size:12px;">
		<li>
		<a href="index.cfm?BBID=#LocalBBID#">Click here to edit the billback.</a><br>
		</li>
		<li>
		<a href="/deductions/deduction.cfm?DEDUCTION_ID=#URL.DEDUCTION_ID#&Billback_ID=#LocalBBID#&NoAccess=1">Click here to go back to to the deduction.</a><br>
		</li>
		</ul>
		</td></tr>
		</table>
		</span></center>
		</cfoutput>
		<cfabort>
	</cfif>
</cfif>

<cfsilent>

 <cfset bSource = 0/>
<cfif (isDefined("URL.source") AND (URL.source EQ "BBFlexScoreCard"))>
<cfset bSource = 1/>
</cfif>

<cfif (LocalBBID NEQ 0 AND VarCopiedBB EQ 0 and url.modifyagree EQ 0 AND (bSource EQ 0) )>
	<cfquery name="unlockBB" datasource="#application.datasource#">
		UPDATE Billback_Allied
		SET BB_Is_Locked = 0
		WHERE Billback_ID = '#LocalBBID#' AND BB_Is_Locked = 1 AND BB_Locked_By_User_ID = '#request.AccessStructure.user_id#'
		AND BB_Locked_By_Match_Central = 0
	</cfquery>
</cfif>

<!---BJF: Add payment history link, if payment history table exists and has data in it --->

<cfset ShowPaymentHistory = 0>

<!--- get the User Profile information --->
<cfinclude template="/get_access_profile.cfm">

<Cfif LocalBBID NEQ 0>
<cfquery name="PaymentHistoryTableExists" datasource="#application.datasource#">
SELECT * FROM   INFORMATION_SCHEMA.COLUMNS
WHERE TABLE_NAME = 'BB_Payment_Confirmation'
</cfquery>

<cfif PaymentHistoryTableExists.Recordcount GT 0>
	<cfquery name="PaymentHistoryforthisBB" datasource="#application.datasource#">
	SELECT BB_Payment_Confirmation_ID FROM BB_Payment_Confirmation
	INNER JOIN Contract_Main
	ON Contract_Main.Contract_Number LIKE '%' + right(left(BB_Payment_Confirmation.Rebate_ID, 10), 7)
	INNER JOIN Billback_Program
	ON Billback_Program.Program_ID = Contract_Main.Contract_Main_ID
	AND Billback_Program.Deleted = 0
	AND Billback_Program.Billback_ID = '#LocalBBID#'
	</cfquery>

	<cfif PaymentHistoryforthisBB.Recordcount GT 0 AND quickBBCheck.Auto_Billback Neq 1>
		<cfset ShowPaymentHistory = 1>
	</cfif>

<!---Only display if there's actually data --->
</cfif>
</CFIF>


</cfsilent>
<!---Payment history --->
<!--- <cfdump var="#quickBBCheck#" /> --->
<CFSET PAGE_TITLE="Create Billback">
<!DOCTYPE HTML PUBLIC "-//W3C//DTD HTML 4.0 Transitional//EN">

<HTML>
<HEAD>
	<TITLE><CFOUTPUT>#PAGE_TITLE#</CFOUTPUT></TITLE>
	<LINK REL="STYLESHEET" TYPE="text/css" HREF="/common_files/main_style.css">
	<LINK REL="STYLESHEET" TYPE="text/css" HREF="/common_files/ViewModes.css">
<script type="text/javascript">

var iframeids=["contentIFrame"];
var iframehide="yes";
var getFFVersion=navigator.userAgent.substring(navigator.userAgent.indexOf("Firefox")).split("/")[1];
var FFextraHeight=parseFloat(getFFVersion)>=0.1? 16 : 0;//extra height in px to add to iframe in FireFox 1.0+ browsers

function dyniframesize() {
	var iframeids=["contentIFrame"];
	var iframehide="yes";
	var dyniframe=new Array()
	for (i=0; i<iframeids.length; i++){
		if (document.getElementById){ //begin resizing iframe procedure
			dyniframe[dyniframe.length] = document.getElementById(iframeids[i]);
			if (dyniframe[i] && !window.opera){
				dyniframe[i].style.display="block"
				if (dyniframe[i].contentDocument && dyniframe[i].contentDocument.body.offsetHeight){ //ns6 syntax
					dyniframe[i].height = dyniframe[i].contentDocument.body.offsetHeight+FFextraHeight;
				}
				else if (dyniframe[i].Document && dyniframe[i].Document.body.scrollHeight){ //ie5+ syntax
					dyniframe[i].height = dyniframe[i].Document.body.scrollHeight;
				}
			}
			}

		//reveal iframe for lower end browsers? (see var above):
		if ((document.all || document.getElementById) && iframehide=="no"){
			var tempobj=document.all? document.all[iframeids[i]] : document.getElementById(iframeids[i])
			tempobj.style.display="block"
		}
	}
}
/*
if (window.addEventListener)
window.addEventListener("load", dyniframesize, false)
else if (window.attachEvent)
window.attachEvent("onload", dyniframesize)
else
window.onload=dyniframesize
*/
</script>
<script language="JavaScript">
 var topMargin 	= 0
 var slideTime	= 500
 var ns6 = (!document.all && document.getElementById);
 var ie4 = (document.all);
 var ns4 = (document.layers);
 var Layer_Width = 650;
 var Layer_Height = 85;
 var storeinparent = 1;
 var allowScroll = true;

function floatObject() {
if (ns4 || ns6) {
 findHt =	window.innerHeight;
 } else if(ie4) {
 findHt =	document.body.clientHeight;
 }
}

function main() {

if(allowScroll == true){
if (ns4) {
 this.currentY 	= document.infoBarLayer.top;
 this.scrollTop	= window.pageYOffset;
 mainTrigger();
 } else if(ns6) {
 this.currentY = parseInt(document.getElementById('infoBarLayer').style.top);
 this.scrollTop = scrollY;
  mainTrigger();
 } else if(ie4) {
 this.currentY 	= infoBarLayer.style.pixelTop;
 this.scrollTop	= document.body.scrollTop;
 mainTrigger();
	}
   }
 function mainTrigger() {
 var newTargetY	= this.scrollTop + this.topMargin
 if ( this.currentY != newTargetY ) {
 if ( newTargetY != this.targetY ) {
 this.targetY = newTargetY
  floatStart();
  }
  animator();
  }
  }
  function floatStart() {
  var now	= new Date()
  this.A		= this.targetY - this.currentY
  this.B		= Math.PI / ( 2 * this.slideTime )
  this.C		= now.getTime()
  if (Math.abs(this.A) > this.findHt) {
  this.D = this.A > 0 ? this.targetY - this.findHt : this.targetY + this.findHt
  this.A = this.A > 0 ? this.findHt : -this.findHt
  } else {
  this.D = this.currentY
   }
  }
  function animator() {
  var now	= new Date()
  var newY	= this.A * Math.sin( this.B * ( now.getTime() - this.C ) ) + this.D
  newY		= Math.round(newY)
  if (( this.A > 0 && newY > this.currentY ) || ( this.A < 0 && newY < this.currentY )) {
  if ( ie4 )infoBarLayer.style.pixelTop = newY
  if ( ns4 )document.infoBarLayer.top = newY
  if ( ns6 )document.getElementById('infoBarLayer').style.top = newY + "px"
  }
 }
 }

</script>

</HEAD>

  <cfif (isDefined("URL.source") AND (URL.source EQ "BBFlexScoreCard"))>
<BODY style="margin:0" onLoad="dyniframesize();tabClick('deviations');">
<cfelse>
<BODY style="margin:0" onLoad="dyniframesize();">
</cfif>

