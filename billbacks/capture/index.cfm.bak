							document.all.deviations_tab.className	=	disabled_false_inactive;
						}

					</CFIF>
					case "5" : //paid
						document.all.summary_tab.className		=	disabled_false_inactive;
						if(auto_billback == 1){
							document.all.deviations_tab.className	=	disabled_true;
						}
						else
						{
							document.all.deviations_tab.className	=	disabled_false_inactive;
						}
						document.all.print_tab.className		=	disabled_false_inactive;
						document.all.email_tab.className		=	disabled_false_inactive;
						// document.all.fax_tab.className			=	disabled_false_inactive;
						document.all.BusiCon_tab.className		=	disabled_false_inactive;
						document.all.route_tab.className		=	disabled_false_inactive;
						document.all.inbox_tab.className		=	disabled_false_inactive;
						<cfif appSettings.getShowBBExcelReport()>
						document.all.excel_tab.className		=	disabled_false_inactive;
						</cfif>
						<cfif Detail_Button_Show EQ 1>
							document.all.detail_tab.className		=	disabled_false_inactive;
						</cfif>
						<cfif Delete_Button_Show EQ 1>
							document.all.delete_tab.className		=	disabled_false_inactive;
						</cfif>
						<cfif Copy_Button_Show EQ 1>
							document.all.copy_tab.className			=	disabled_false_inactive;
						</cfif>
						<cfif Reset_Button_Show EQ 1>
							document.all.wip_tab.className			=	disabled_false_inactive;
						</cfif>
						<cfif Reverse_Button_Show EQ 1>
							document.all.reverse_tab.className		=	disabled_false_inactive;
							document.all.settlement_tab.className		=	disabled_false_inactive;
						</cfif>
						<cfif enablePaymentTabAfterPaidStatus>
						document.all.payment_tab.className			=	disabled_false_inactive;
						</cfif>
						<cfif appSettings.getSplitBillbacks()>
						if(bb_complete_split == true){
						document.all.split_tab.className			=	disabled_false_inactive;
						}
						</cfif>
						<cfif bBillbackSalesTax>
							document.all.BBSalesTax_Tab.className		=	disabled_false_inactive;
						</cfif>
					break;
				}

				if(	document.all.wip_tab &&
					!(bb_status_id == 2 || bb_status_id == 3
					<cfif appSettings.getBBAllowResetBeforePMTInterfacePRStatus()>
					|| (bb_status_id == 4 && bb_in_pmt_interface == 0)
					</cfif>
					)
					)
				{
					document.all.wip_tab.className			=	disabled_true;
				}

				if(bb_in_pmt_interface == 1)
				{
					<cfif Delete_Button_Show EQ 1>
					document.all.delete_tab.className		=	disabled_true;
					</cfif>
				}

				if(bb_in_ded_interface == 1)
				{
					<cfif Delete_Button_Show EQ 1>
					document.all.delete_tab.className		=	disabled_true;
					</cfif>
					<cfif NOT appSettings.getBBAllowResetAfterDEDInterface()>
					if(document.all.wip_tab)
					 document.all.wip_tab.className		=	disabled_true;
					</cfif>
				}

			}
			else {
				if(bb_status_id == 0){
					current_menu_item = "basic_info";
					document.all.basic_info_tab.className	=	"activeMenuItem";
				}
				else{
					current_menu_item = "summary";
					document.all.summary_tab.className	=	"activeMenuItem";
				}

			}

			if(bb_status_id >= 2)//billback has to be RFA or above
			{
				<cfif application.oApplicationAppSettingsManager.getApplicationAppSettings().getBudgetsFunctionalityOn()>
				document.all.budgets_tab.className	=	disabled_false_inactive;
				</cfif>
			}

			if(current_user_view_deviations == 0) {
				document.all.deviations_tab.className	=	disabled_true;
			}
			dAccessDataArray = deductionRight();

			/*
			if(dAccessDataArray[0] != true)
			{
				document.all.deduction_tab.className	=	disabled_true;
			}
			*/
		}

		if(current_user_create_bb == 0) {
			document.all.basic_info_tab.className	=	disabled_true;
			document.all.payee_tab.className		=	disabled_true;
			document.all.programs_tab.className		=	disabled_true;
			document.all.document_tab.className		=	disabled_true;
			//document.all.deduction_tab.className	=	disabled_true;
			document.all.BusiCon_tab.className		=	disabled_true;
			//<!-- BJF: Even if you can't create, you should still be able to email print and fax, right? --->
			document.all.print_tab.className		=	disabled_false_inactive;
			document.all.email_tab.className		=	disabled_false_inactive;
			// document.all.fax_tab.className			=	disabled_false_inactive;
			document.all.route_tab.className		=	disabled_true;
			document.all.inbox_tab.className		=	disabled_true;
			<cfif appSettings.getShowBBExcelReport()>
			document.all.excel_tab.className		=	disabled_false_inactive;
			</cfif>
					<cfif Detail_Button_Show EQ 1>
						document.all.detail_tab.className		=	disabled_true;
					</cfif>
					<cfif Delete_Button_Show EQ 1>
						document.all.delete_tab.className		=	disabled_true;
					</cfif>
					<cfif Copy_Button_Show EQ 1>
						document.all.copy_tab.className			=	disabled_true;
					</cfif>
					<cfif Reset_Button_Show EQ 1>
						document.all.wip_tab.className			=	disabled_true;
					</cfif>
					<cfif Reverse_Button_Show EQ 1>
						document.all.reverse_tab.className		=	disabled_true;
						document.all.settlement_tab.className		=	disabled_true;
					</cfif>

			<cfif appSettings.getShow_BB_Route() IS 1>
			document.all.acknowledgments_tab.className	= 	disabled_true;
			</cfif>
			<cfif ShowPaymentHistory IS 1>
				document.all.paymenthistory_tab.className	=	disabled_true;
			</cfif>
			<cfif appsettings.getBillbackModifyAgree() EQ 1 AND quickBBCheck.Auto_Billback NEQ 1>
				document.all.ModifyAgree_tab.className			=	disabled_true;
			</cfif>
		}
		else{
			//current_menu_item = "summary";
		}

		if(bb_complete_deduction)
		{
			document.all.payment_tab.className		=	disabled_true;
		}
		assignStatusIcons();
		assignActiveTab();
	}

	function assignStatusIcons() {
	check_icon 	= "/images/programs/ball_green.gif";
	ex_icon		= "/images/programs/ball_gray_filled.gif";

	if(bb_complete_basic_info) document.all.basic_info_tab_icon.src = check_icon
	else	document.all.basic_info_tab_icon.src = ex_icon

	if(bb_complete_payee) document.all.payee_tab_icon.src = check_icon
	else	document.all.payee_tab_icon.src = ex_icon

	if(bb_complete_programs) document.all.programs_tab_icon.src = check_icon
	else	document.all.programs_tab_icon.src = ex_icon

	if(bb_complete_deviations && BB_Negative == 0) document.all.deviations_tab_icon.src = check_icon
	else	document.all.deviations_tab_icon.src = ex_icon

	<!--- if(bb_complete_wip) document.all.wip_tab_icon.src = check_icon
    else	document.all.wip_tab_icon.src = ex_icon --->

	if(bb_complete_payment) document.all.payment_tab_icon.src = check_icon
	else	document.all.payment_tab_icon.src = ex_icon

	if(bb_complete_document) document.all.document_tab_icon.src = check_icon
	else	document.all.document_tab_icon.src = ex_icon

	/*
	if(bb_complete_deduction) document.all.deduction_tab_icon.src = check_icon
	else	document.all.deduction_tab_icon.src = ex_icon
	*/

    <cfif appSettings.getSplitBillbacks()>
	if(bb_complete_split) document.all.split_tab_icon.src = check_icon
	else	document.all.split_tab_icon.src = ex_icon
    </cfif>
	}

	function assignActiveTab(){
		var windowtitle = "Billbacks";
		switch(current_menu_item) {
			case "summary":
				document.all.summary_tab.className="activeMenuItem";
				windowtitle = "Billback Summary";
			break;

			case "basic_info":
				document.all.basic_info_tab.className="activeMenuItem";
				windowtitle = "Billback Basic Info";
			break;

			case "payee":
				document.all.payee_tab.className="activeMenuItem";
				windowtitle = "Billback Payee";
			break;

			case "programs":
				document.all.programs_tab.className="activeMenuItem";
				windowtitle = "Billback Programs";
			break;

			case "deviations":
				document.all.deviations_tab.className="activeMenuItem";
				windowtitle = "Billback Deviations";
			break;
			case "payment":
				document.all.payment_tab.className="activeMenuItem";
				windowtitle = "Billback Payment";
			break;
			case "print":
				document.all.print_tab.className="activeMenuItem";
				windowtitle = "Billback Print";
			break;
			case "email":
				document.all.email_tab.className="activeMenuItem";
				windowtitle = "Billback Email";
			break;
<!--- 			case "fax":
				document.all.fax_tab.className="activeMenuItem";
				windowtitle = "Billback Fax";
			break; --->
			case "BusiCon":
				document.all.BusiCon_tab.className="activeMenuItem";
				windowtitle = "Business Considerations";
			break;
			case "route":
				document.all.route_tab.className="activeMenuItem";
				windowtitle = "Billback Route";
			break;
			case "inbox":
				document.all.inbox_tab.className="activeMenuItem";
				windowtitle = "Billback Route";
			break;
			case "excel":
				document.all.excel_tab.className="activeMenuItem";
				windowtitle = "Program Excel";
			break;
			<cfif appSettings.getShow_BB_Route() IS 1>
			case "acknowledgments":
				document.all.acknowledgments_tab.className="activeMenuItem";
				windowtitle = "Billback Acknowledgments";
			break;
			</cfif>
			<cfif ShowPaymentHistory IS 1>
			case "paymenthistory":
				document.all.paymenthistory_tab.className="activeMenuItem";
				windowtitle = "Billback Paymenthistory";
			break;
			</cfif>
			case "document":
				document.all.document_tab.className="activeMenuItem";
				windowtitle = "Billback Documents";
			break;
			//TSF: Label 21054 - Allow users to switch items on uploaded billbacks
			<cfif Switch_Product_Button_Show>
			case "switchProducts":
				document.all.switch_products_tab.className="activeMenuItem";
				windowtitle = "Switch Products";
			break;
			</cfif>
			/*
			case "deduction":
				document.all.deduction_tab.className="activeMenuItem";
				windowtitle = "Deductions";
			break;
			*/
		}

	window.parent.parent.header_new.show_title(windowtitle);
     }

function showDetail()
{
	if(bb_is_locked == 1 && locked_by_other_user == 0)
	{

	tabNavigate("/billbacks/common/Billback_Detail.cfm")

	}
	else
	{
		alert("Please lock the billback first.")

	}
}

function confirmDeletion()
{

	if(bb_is_locked == 0 || locked_by_other_user == 1)
	{
		alert("Please lock the billback first.");
		return;
	}
	if(bb_in_ded_interface == 1) // allow delete only if the billback has not interfaced in the deduction (1510/900) interface
	{
		alert("This billback has been interfaced to the accounting system, can't delete this.");
		return;
	}
	if(bb_in_pmt_interface == 1) // allow delete only if the billback has not interfaced in the payment (700) interface
	{
		alert("This billback has been interfaced to the accounting system, can't delete this.");
		return;
	}

	if( window.confirm("Do you really want to delete this billback?"))
	tabNavigate("/billbacks/common/bb_delete.cfm","",'<cfoutput>#quickBBCheck.Auto_Billback#</cfoutput>');

}

function resetToWIP()
{

		if (!(bb_status_id == 2 || bb_status_id == 3
			<cfif appSettings.getBBAllowResetBeforePMTInterfacePRStatus()>
			|| (bb_status_id == 4 && bb_in_pmt_interface == 0)
			</cfif>
			)
		)
		{
			msg = "Only RFA and Approved Billbacks can be reset.";
			<cfif appSettings.getBBAllowResetBeforePMTInterfacePRStatus()>
			if(bb_in_pmt_interface == 1)
			{
				msg = "This billback has been interfaced to the accounting system, can't reset this.";
			}
			</cfif>
			alert(msg);
			return;
		}
		<!--- Ana: D15168 - Dont let reset --->
		if (bb_complete_deduction == "true")
		{
			alert("Billback associated to a deduction cannot be reset.")
			return;
		}
		if(bb_is_locked == 0 || locked_by_other_user == 1)
		{
			alert("Please lock the billback first.");
			return;
		}
		<cfif appSettings.getBBAllowResetAfterDEDInterface() EQ 0>
		if(bb_in_ded_interface == 1) // allow delete only if the billback has not interfaced in the deduction (1510/900) interface
		{
			alert("This billback has been interfaced to the accounting system, can't reset this.");
			return;
		}
		</cfif>

	  	if (bb_complete_wip || bb_status_id == 2)
	  	{
		  	if
			(
				window.confirm("Do you really want to reset this billback to Work In Progress status?")
			)
			tabNavigate("/billbacks/common/bb_reset.cfm")
	  	}

}

function ShowSplit()
{
	if(bb_is_locked == 1 && locked_by_other_user == 0)
	{
	  if (bb_complete_split)
	  { tabNavigate("/billbacks/approval/Split_BB_History.cfm?billback_id=" + bb_id); }
	}
	else
	{
		alert("Please lock the billback first.")
	}
}

function reverseBillback()
{
	if(bb_is_locked == 1 && locked_by_other_user == 0)
	{
		if(window.confirm("Do you really want to void this billback?"))
		tabNavigate("/billbacks/common/bb_reverse.cfm")
	}
	else
	{
		alert("Please lock the billback first.")
	}
}

