<cfsilent>
<!---Permissions for left hand links --->

<cfset Billback_ID = LocalBBID>
<!---Billback has an ID assigned --->
<cfif Billback_ID IS NOT 0>
<cfquery name="GetLockStatus" datasource="#Application.Datasource#">
		SELECT BB_Is_Locked,BB_Locked_By_User_ID
		FROM
			Billback_Allied
		WHERE
			Billback_ID = '#Billback_ID#'
	</cfquery>

	<cfparam name="DisAllowAccessBasedOnLockStatus" default="1">

	<CFIF GetLockStatus.BB_Is_Locked EQ 1>
		<CFSET DisAllowAccessBasedOnLockStatus 	= 0>
	<CFELSE>
		<CFSET DisAllowAccessBasedOnLockStatus 	= 1>
	</CFIF>

	<cfset APVL_Contract_Status = quickBBCheck.Billback_Status_ID>
<!---Billback has an ID assigned --->
<cfelse>
	<cfset APVL_Contract_Status = 1>
	<CFSET DisAllowAccessBasedOnLockStatus 	= 0>
<!---Billback has an ID assigned --->
</cfif>

		<!------ Get the stored deduction id ----->

	<cfif Billback_ID NEQ 0>
	<cfquery name="getAssociatedDeductionID" datasource="#application.datasource#">
		SELECT	Deduction_ID
		FROM	DD_Closure_Detail
		WHERE	DD_Closure_ID = '#Billback_ID#' AND Deleted = 0
	</cfquery>
	<cfelse>
	<cfset getAssociatedDeductionID.recordcount = 0>
	</cfif>

<CFSET Delete_Button_Show		= 0>
<CFSET Detail_Button_Show		= 0>
<CFSET Copy_Button_Show			= 0>
<CFSET Reset_Button_Show		= 0>
<CFSET Reverse_Button_Show		= 0>

<!---TSF: Label 21054 - Allow users to switch items on uploaded billbacks --->
<CFSET Switch_Product_Button_Show	= 0>
<CFIF len(trim(URL.BBID)) GT 0 and Get_Billback_Info.Uploaded_Billback eq 3 and (appSettings.getThirdPartyBBUpload() eq 3 or iBBDevOverridePrice eq 1)>
	<CFSET Switch_Product_Button_Show	= 1>
</CFIF>



<!------------------- BB_Create is reused to Delete tooo -------------------------->
<CFSET Profile_Delete			= Get_Profile_Settings.BB_Delete>

<!------
		locked
and		deleted profile = 1
and		not a split parent
and
(
		(status <> payment request or paid or approved-void)
OR		(status = payment request
		and (only if not sent yet or if unsuccessful acknowledgement)
OR		(status = approved void
		and (reverse link app setting is off or reversal successfully acknowledged)
)
and		billback has not interfaced in the deduction (1510/900) interface
------>
<CFIF len(trim(URL.BBID)) EQ 0>
	<cfset Get_Billback_Info.BB_Payment_Request_Sent = 0 />
	<cfset Get_Billback_Info.BB_Received_Ack_Type = 0 />
	<cfset Get_Billback_Info.BB_Approved_Void_Ack_Type = 0 />
	<cfset Get_Billback_Info.DD_Closure_Sent_On = "" />
</CFIF>
<CFIF 		(Profile_Delete EQ 1)
		AND	Split_Parent EQ 0
		AND
		(		(APVL_Contract_Status NEQ 4 AND APVL_Contract_Status NEQ 5 AND APVL_Contract_Status NEQ 8)
			OR	(		APVL_Contract_Status EQ 4
					AND	(Get_Billback_Info.BB_Payment_Request_Sent EQ 0 OR Get_Billback_Info.BB_Received_Ack_Type EQ 2)
				)
			OR	(		APVL_Contract_Status EQ 8
					AND	(appSettings.getBBAllowReverse() EQ 0 OR Get_Billback_Info.BB_Approved_Void_Ack_Type EQ 1)
				)
		)
		AND Get_Billback_Info.DD_Closure_Sent_On EQ ""
		>
	<CFSET Delete_Button_Show		= 1>
</CFIF>

<CFIF (Get_Profile_Settings.BB_Create EQ 1) and not quickBBCheck.Scheduled_Auto_BB and quickBBCheck.Auto_Billback NEQ 1>
	<CFSET Copy_Button_Show		= 1>
</CFIF>
<CFIF APVL_Contract_Status GTE 3>
	<CFSET Detail_Button_Show = 1>
</CFIF>


<!------
		locked
and		have profile access
and		status = payment request
and		app setting BB_Allow_Reverse = 1
and		no deduction association
and		if successfully acknowledged
----->

<CFIF 		Get_Profile_Settings.BB_Reverse EQ 1
		AND ((APVL_Contract_Status eq 4 AND len(trim(Get_Billback_Info.BB_Payment_Request_Sent_On)) GT 0 AND (Get_Billback_Info.BB_Received_Ack_Type EQ 1 OR Get_Billback_Info.BB_Received_Ack_Type EQ 0))  OR (APVL_Contract_Status eq 5 AND Get_Billback_Info.BB_Received_Ack_Type EQ 1))
		AND	appSettings.getBBAllowReverse() EQ 1
		AND	getAssociatedDeductionID.RecordCount EQ 0
		AND quickBBCheck.Auto_Billback NEQ 1
		AND Get_Billback_Info.BB_Closing_method EQ 1
		>
	<CFSET Reverse_Button_Show = 1>
</CFIF>

<!------ If the following is true
- Billback is locked
- not a split parent
- It is already approved
- It is not paid
- It is not yet sent to the Client or it is sent to the client and we got reply back as void
- If the user is the creator or the approver
 ----->

<!---TSF: Label 10625 - Commented out DisAllowAccessBasedOnLockStatus variable because it doesn't need to be in the logic to display the Reset_Button_Show link --->
<!---(NOT DisAllowAccessBasedOnLockStatus) --->
<!------
		locked
and		not a split parent
below conditions are not applied here as we want the link to display even thought it will be disabled by the javascript
if the link does not show when status < 3, the problem is if the user approves the billback, the link will still not show
instead it will be better if we always show the link but will be enabled/disabled based on the current values
and
(
		status = approved
or		(status = payment request
		and the app switch "Billback: allow reset in payment request status before it has interfaced in payment interface" is ON
		and	the billback has not interfaced
		)
)
and
(
		the app switch "Allow reset after it has interfaced in deduction (1510/900) interface" is ON
or		billback has not interfaced in the deduction (1510/900) interface
)
------>

<CFIF	Split_Parent EQ 0 and Get_Profile_Settings.BB_Create eq 1>
		<!---DRK: Removed to solve below issue
		Issue: when a billback gets created from scratch the reset link will not show.
		But it still will not show even after it is approved.
		But will show if you go out of the billback and come back again
		Solution: Let the reset link show all the time just as disabled until it is approved and the javascript will handle when it should be enabled
		AND (APVL_Contract_Status EQ 3
			OR (APVL_Contract_Status EQ 4 AND appSettings.getBBAllowResetBeforePMTInterfacePRStatus() EQ 1 AND Get_Billback_Info.BB_Payment_Request_Sent EQ 0)
			)
		AND (appSettings.getBBAllowResetAfterDEDInterface() EQ 1 OR Get_Billback_Info.DD_Closure_Sent_On EQ "")
		--->
		<!--- BJF: removed this per request D12003 --->
		<!--- AND APVL_Contract_Status NEQ 5
		AND (getBillbackInformation.BB_Payment_Request_Sent EQ 0 OR getBillbackInformation.BB_Check_Status_ID EQ 3)
	 --->	<!---TSF: Label 11156 - Allow Reset button regardless of the creator or approver--->
		<!--- AND (request.AccessStructure.User_ID EQ getBillbackInformation.BB_Creator_ID OR request.AccessStructure.User_ID EQ getBillbackInformation.User_Approved)> --->
	<CFSET Reset_Button_Show		= 1>
</CFIF>
<CFIF getAssociatedDeductionID.RecordCount GT 0 OR quickBBCheck.Auto_Billback EQ 1>
	<CFSET Reset_Button_Show		= 0>
</CFIF>
<!--- /Permissions for left hand links --->
</cfsilent>
<!--- <CFDUMP var="#Get_Profile_Settings#"> --->
<script>
	<!--- some of the below variables might be set from the file bb_menu_stats.cfm --->
	var current_user_create_bb			= false;
	var current_user_id 				= 0;
	var current_user_approve 			= 0;
	var current_user_approve_critical 	= 0;
	var current_user_approve_amount 	= 0;
	var current_user_view_deviations 	= 0;
	var bb_adjustment_created			= 0;
	var bb_id							= 0;
	var bb_status_id 					= 0;
	var auto_billback 					= 0;
	var bb_approved_amount				= 0;

	<cfif isDefined("URL.source") AND URL.source EQ "BBFlexScoreCard" AND DisAllowAccessBasedOnLockStatus EQ 0>
		var bb_is_locked                = true;
	<cfelse>
		var bb_is_locked               	= false;
	</cfif>


	var bb_up							= 1; //unidentified payee
	var bb_pnf							= 1; //program not found;
	var bb_complete_basic_info 			= false;
	var bb_complete_payee 				= false;
	var bb_complete_programs 			= false;
	var bb_complete_deviations 			= false;
	var bb_complete_wip 			    = false;
	var bb_complete_payment 			= false;
	var bb_complete_document 			= false;
	var bb_complete_deduction 			= false;
	var bb_complete_split				= false;
	var current_menu_item	 			= "";
	var locked_by_other_user			= 0;
	var Scheduled_Auto_BB				= 0;
	var bb_is_split_parent				= 0;
	var bb_complete_gl_code_alloc		= 0;
	var bb_payee_type_id		= 0;
	var BB_Negative 					= 0;
	var bb_agreed_to 					= 0;
	var modifyagreerelatedlinks_enable	= 1;
	var modify_agree_enable				= 0;
   <cfif isDefined("URL.source") AND URL.source EQ "BBFlexScoreCard">
   var bb_force_deviation = 1;
   <cfelse>
   var bb_force_deviation = 0;
  </cfif>
	//var bb_force_deviation				= 1;
	var bb_in_ded_interface				= 0;
	var bb_in_pmt_interface				= 0;


	function initVariables() {
		current_user_create_bb			= false;
		current_user_id 				= 0;
		current_user_approve 			= 0;
		current_user_approve_critical 	= 0;
		current_user_approve_amount 	= 0;
		current_user_view_deviations 	= 0;
		bb_adjustment_created			= 0;
		bb_id							= '<cfoutput>#URL.BBID#</cfoutput>';
		bb_status_id 					= 0;
		auto_billback 					= '<cfoutput>#quickBBCheck.Auto_Billback#</cfoutput>';
		bb_approved_amount				= 0;
		bb_is_locked					= false;
		bb_up							= 1; //unidentified payee
		bb_pnf							= 1; //program not found;
		bb_complete_basic_info 			= false;
		bb_complete_payee 				= false;
		bb_complete_programs 			= false;
		bb_complete_deviations 			= false;
		bb_complete_wip 			    = false;
		bb_complete_payment 			= false;
		bb_complete_document 			= false;
		bb_complete_deduction 			= false;
		bb_complete_split					= false;
		current_menu_item	 			= "";
		locked_by_other_user			= 0;
		Scheduled_Auto_BB				= '<cfoutput>#quickBBCheck.Scheduled_Auto_BB#</cfoutput>';
		BB_Negative						= '<cfoutput>#quickBBCheck.Negative_billback#</cfoutput>';
	}

	function resetVariables() {
		current_user_id 				= 0;
		current_user_approve 			= 0;
		current_user_approve_critical 	= 0;
		current_user_approve_amount 	= 0;
		current_user_view_deviations 	= 0;
		bb_adjustment_created			= 0;
		bb_id							= 0;
		bb_status_id 					= 0;
		bb_is_locked					= false;
		bb_up							= 1; //unidentified payee
		bb_pnf							= 1; //program not found;
		bb_complete_basic_info 			= false;
		bb_complete_payee 				= false;
		bb_complete_programs 			= false;
		bb_complete_deviations 			= false;
		bb_complete_wip 			    = false;
		bb_complete_payment 			= false;
		bb_complete_document 			= false;
		bb_complete_deduction 			= false;
		bb_complete_split					= false;
		current_menu_item	 			= "";
		locked_by_other_user			= 0;
		BB_Negative						= 0;
	}

	//returns the next unfinished tab to be completed
	function nextTabToComplete(requested_action){
		internalArray = new Array();
		internalArray[0] = true;
		internalArray[1] = "";

		positionRefArray = new Array();
		positionRefArray[0] = "basic_info";
		positionRefArray[1] = "payee";
		positionRefArray[2] = "programs";
		positionRefArray[3] = "deviations";
		positionRefArray[4] = "payment";

		StopPosition = 0;
		for(var x=0;x<positionRefArray.length;x++){
			if(positionRefArray[x] == requested_action) StopPosition = x+1;
		}

		if(!bb_complete_basic_info) {
			internalArray[0] = false;
			internalArray[1] = internalArray[1] + "\n* Basic Informaition";
		}
		if(!bb_complete_payee  && StopPosition > 2) {
			internalArray[0] = false;
			internalArray[1] = internalArray[1] + "\n* Payee";
		}
		if(!bb_complete_programs && StopPosition > 3 && bb_status_id < 3) {
			internalArray[0] = false;
			internalArray[1] = internalArray[1] + "\n The billback amount on the basic info page does not equal the amount on the programs page.  \nAmounts must match before proceeding.";
		}
		if(!bb_complete_deviations && StopPosition > 4) {
			internalArray[0] = false;
			internalArray[1] = internalArray[1] + "\n* Deviations";
		}
		if(!bb_complete_payment && StopPosition > 5) {
			internalArray[0] = false;
			internalArray[1] = internalArray[1] + "\n* Payment";
		}

		if(!internalArray[0]){
			internalArray[1] = "Please complete the following items first:\n" + internalArray[1]
		}

		return internalArray;
	}

	//messaging system: responsible for displaying all messages to user
	function messageReporter(errorArray){
	if (isDefined(errorArray[1]))
		{
		alert(errorArray[1])
		}
	}

	function isDefined(item) {
    return (typeof item != 'undefined'); }


	//returns lock status
	function isBBLocked(){
		var argPassed = "";
		if(arguments.length > 0)
		{
			argPassed = arguments[0];
		}

		internalArray = new Array();
		internalArray[0] = false;
		internalArray[1] = "The billback is currently locked by another user";

		if(bb_status_id != 5<cfif enablePaymentTabAfterPaidStatus> || 1==1</cfif>) {
			if(locked_by_other_user == 0)
			{
				internalArray[0] = false;
				internalArray[1] = "Please lock the billback first.";

				if(bb_id != 0)
				{
					if(bb_is_locked == 1)
					{
						internalArray[0] = true;
						internalArray[1] = "ACCESS GRANTED";
					}
				}
				else
				{
					internalArray[0] = false;
					internalArray[1] = "Please create a billback first.";
				}
			}
		}

		else {
			internalArray[0] = false;
			internalArray[1] = "This billback can no longer be modified since it was paid";
		}

		if(internalArray[0] == true && bb_status_id >= 3) //if access granted and approved
		{
			//don't allow to access basic info, payee, program
			switch(argPassed)
			{
				case "basic_info":
				case "payee":
				case "programs":
				case "payee_program":
				//TSF: Label 21054 - Allow users to switch items on uploaded billbacks
				<cfif Switch_Product_Button_Show>
				case "switchProducts":
				</cfif>
					internalArray[0] = false;
					internalArray[1] = "This billback can no longer be modified since it is approved";
					break;
				default:
					//do nothing
			}
		}

		return internalArray;
	}

	function profileSettingsTabAccess(){
		internalArray = new Array();
		internalArray[0] = false;
		internalArray[1] = "You profile settings restrict you from this section.";

		if(current_user_create_bb == 1){
			internalArray[0] = true;
			internalArray[1] = "";
		}

		return internalArray
	}

	function modifyagreeaccess(){
		internalArray = new Array();
		internalArray[0] = false;

		if(modifyagreerelatedlinks_enable == 1){
			internalArray[0] = true;
			internalArray[1] = "";
		}

		return internalArray
	}

	function autoBillbackAccess(){
		internalArray = new Array();
		internalArray[0] = false;
		internalArray[1] = "This section is not accessible for auto billbacks.";

		if(auto_billback != 1){
			internalArray[0] = true;
			internalArray[1] = "";
		}

		return internalArray
	}

	function paymentRight() {
		internalArray = new Array();

		if(bb_is_split_parent != 0)
		{
			internalArray[0] = false;
			internalArray[1] = "You cannot pay a billback which has been split. You will need to pay the split versions separately.";
		}
		else if(bb_complete_deduction)
		{
			internalArray[0] = false;
			internalArray[1] = "You cannot pay a billback which is already associated to a deduction.";
		}
		else
		{
			internalArray[0] = false;
			internalArray[1] = "You need a higher approval level to approve this billback.";

			if(current_user_approve_amount == "*") current_user_approve_amount = bb_adjustment_created;

			bb_adjustment_created = parseFloat(bb_adjustment_created);
			current_user_approve_amount = parseFloat(current_user_approve_amount);
			if(bb_up == 0 && bb_pnf == 0 && current_user_approve == 1 && (bb_adjustment_created <= current_user_approve_amount || BB_Negative == 1)){
				internalArray[0] = true;
				internalArray[1] = "";
			}
			else {
				if((bb_up == 1 || bb_pnf == 1) && current_user_approve_critical == 1  && (bb_adjustment_created <= current_user_approve_amount || BB_Negative == 1)){
					internalArray[0] = true;
					internalArray[1] = "";
				}
			}
		}
		return internalArray;
	}

	function deductionRight()
	{
		internalArray = new Array();
		internalArray[0] = true;
		internalArray[1] = "";
		<cfoutput>
		<cfparam name="GLCode_Allocation" 	default="0">
		<cfparam name="Split_Parent" 		default="0">

		if(bb_status_id != 3)
		{
			internalArray[0] = false;
			internalArray[1] = "Billback need to be in approved status";
		}
		else if (bb_is_split_parent != 0)
		{
			internalArray[0] = false;
			internalArray[1] = "Billback has been split";
		}
		<cfif LEFT(application.returned_customer_setting.Customer_Keyword,1) EQ "H">
		else if(bb_complete_gl_code_alloc == 0)
		{
			internalArray[0] = false;
			internalArray[1] = "Billback needs to have GL code allocation";
		}
		</cfif>
		else if(bb_payee_type_id != 1)//if payee <> distributor
		{
			internalArray[0] = false;
			internalArray[1] = "Payee should be a #LCase(application.returned_customer_setting.distributor_label_singular)#";
		}
		</cfoutput>
		return internalArray;
	}

	function rand()
  	{
		now=new Date();
   		num=(now.getSeconds())%10;
   		num=num+Math.random();
		return num;
   	}

	function getMenuTabPermission(tabID) {
		AccessDataArray = new Array();
		AccessDataArray[0] = false;
		AccessDataArray[1] = "default access is: denied";
		current_menu_item = tabID;
		switch(tabID) {
			//summary
			case "summary":
				if(bb_id != 0) {
					AccessDataArray[0] = true;
					tabNavigate("/billbacks/capture/billback_summary.cfm")
				}
				else {
					AccessDataArray[0] = false;
					AccessDataArray[1] = "Please create the billback first.";
				}
			break;
			//basic info
			case "basic_info":
				AccessDataArray = isBBLocked(tabID);//make sure bb is locked
				if(AccessDataArray[0] == true) {
					AccessDataArray = profileSettingsTabAccess();
					if(AccessDataArray[0] == true) {
						AccessDataArray = modifyagreeaccess();	<!---- D13118: When the first user Agrees, both the Basic Information and Payee pages should be disabled. The only way to modify those two pages should be to select Modify Agree or to Disagree ---->
						if(AccessDataArray[0] == true) {
							document.all.basic_info_tab.className = "activeMenuItem"
							tabNavigate("<cfoutput>#basicInfoPage#</cfoutput>");
						}//modifyagreeaccess - end
					}//profileSettingsTabAccess - end
				}//make sure bb is locked - if end
				else{
					if(AccessDataArray[0] == false && bb_id == 0){//creating new billback
						AccessDataArray[0] = true;
						AccessDataArray = profileSettingsTabAccess();
						if(AccessDataArray[0] == true) {
							document.all.basic_info_tab.className = "activeMenuItem";
							tabNavigate("<cfoutput>#basicInfoPage#</cfoutput>");
						}//profileSettingsTabAccess - end
					}//creating new billback - end
				}//make sure bb is locked - end end
			break;
			//payee
			case "payee":
				AccessDataArray = isBBLocked(tabID); //make sure bb is locked
				if(AccessDataArray[0] == true) {
					AccessDataArray = autoBillbackAccess(); //make sure it is not auto billback
					if(AccessDataArray[0] == true) {
						AccessDataArray = profileSettingsTabAccess(); //make sure pre-reqs complete
						if(AccessDataArray[0] == true) {
							AccessDataArray = modifyagreeaccess(); <!---- D13118: When the first user Agrees, both the Basic Information and Payee pages should be disabled. The only way to modify those two pages should be to select Modify Agree or to Disagree ---->
							if(AccessDataArray[0] == true) {
								AccessDataArray = nextTabToComplete('payee');
								if(AccessDataArray[0] == true) {
									document.all.payee_tab.className="activeMenuItem";
									tabNavigate("/billbacks/capture/payee_form.cfm")
								}//nextTabToComplete - end
							}//modifyagreeaccess - end
						}//make sure pre-reqs complete - end
					}//make sure pre-reqs complete - end
				}//make sure bb is locked - end
			break;
			//programs
			case "programs":
				AccessDataArray = isBBLocked(tabID); //make sure bb is locked
					if(AccessDataArray[0] == true) {
						AccessDataArray = profileSettingsTabAccess(); //make sure pre-reqs complete
						if(AccessDataArray[0] == true) {
						    AccessDataArray = modifyagreeaccess();
							if(AccessDataArray[0] == true) {
								AccessDataArray = nextTabToComplete('programs');
								if(AccessDataArray[0] == true) {
								document.all.programs_tab.className="activeMenuItem";
								tabNavigate("/billbacks/capture/program_form.cfm")
								}// nextTabToComplete - end
						  	}//modifyagreeaccess - end
						}//make sure pre-reqs complete - end
					}//make sure bb is locked - end
			break;
			//deviations
			case "deviations":
			    current_menu_item = "deviations";
			    AccessDataArray = autoBillbackAccess(); //make sure it is not auto billback
			if(AccessDataArray[0] == true) {
				AccessDataArray = isBBLocked('deviations'); //make sure bb is locked
				if(AccessDataArray[0] == false && bb_status_id == 5) AccessDataArray[0] = true;


				if(AccessDataArray[0] == true) {
					if(current_user_view_deviations == 1){
						AccessDataArray = nextTabToComplete('deviations'); //make sure pre-reqs complete
						if(AccessDataArray[0] == true){
							if(bb_status_id > 2 || bb_force_deviation == 1) {
									if(Scheduled_Auto_BB > 0) {
										document.all.deviations_tab.className="activeMenuItem";
										tabNavigate("/Billbacks/Approval/index.cfm")
												}
									else{
										document.all.deviations_tab.className="activeMenuItem";
										<cfif (isDefined("URL.source") AND (URL.source EQ "BBFlexScoreCard"))>
                    tabNavigate("/Billbacks/Approval/payment.cfm", "source=BBFlexScoreCard");
                    <cfelse>
                    tabNavigate("/billbacks/Deviation/Deviation.CFM")
                    </cfif>
										}
								}
							else if(bb_status_id == 2){
								AccessDataArray[0] = false;
								AccessDataArray[1] = "Go to the summary page and select 'click here to begin approval process' button"
							}
							else{
								AccessDataArray[0] = false;
								AccessDataArray[1] = "You must flag this billback as 'Ready For Approval' before viewing its deviations"
							}
						}
					}
					else
					{
					if (BB_Negative == 1)
					alert("This link is not usable for a negative billback")
					else
					alert("Your profile settings restrict you from this section")
					}
				}
				}//make sure it is not auto billback - end
			break;
			//payment
			case "payment":
				AccessDataArray = isBBLocked(); //make sure bb is locked
				if(AccessDataArray[0] == true) {
					AccessDataArray[0] = false;
					AccessDataArray[1] = "Your profile settings restrict you from this section";
					if(current_user_approve == 1){
						AccessDataArray = paymentRight();
						if(AccessDataArray[0] == true) {
							AccessDataArray = nextTabToComplete('payment'); //make sure pre-reqs complete
							if(AccessDataArray[0] == true) {
								if(bb_status_id > 2){
									document.all.payment_tab.className="activeMenuItem"
									<cfoutput>
									tabNavigate("/Billbacks/Approval/payment_display.cfm", "#paymentExtraURL#");
									</cfoutput>
									current_menu_item = 'payment';
								}
								else{
									AccessDataArray[0] = false;
									AccessDataArray[1] = "The billback must be approved before issuing payment"
								}
							}
						}
					}
				}
			break;
			//document
			case "document":
				AccessDataArray = isBBLocked();
				if(AccessDataArray[0] == true) {
					AccessDataArray = profileSettingsTabAccess(); //make sure pre-reqs complete
					if(AccessDataArray[0] == true) {
						if(AccessDataArray[0] == true) {
							tabNavigate("/billbacks/capture/Attachments_Form.cfm")
						}
					}
				}
			break;
			//deduction
			case "deduction":
				AccessDataArray = isBBLocked();
				if(AccessDataArray[0] == true) {
					AccessDataArray = profileSettingsTabAccess(); //make sure pre-reqs complete
					if(AccessDataArray[0] == true) {
						AccessDataArray = deductionRight();
						if(AccessDataArray[0] == true) {
							tabNavigate("/billbacks/capture/deductions.cfm")
						}
					}
				}
			break;
			//route
			case "route":
				 AccessDataArray = autoBillbackAccess(); //make sure it is not auto billback
			if(AccessDataArray[0] == true) {
				AccessDataArray = isBBLocked();
				if(AccessDataArray[0] == true) {
					<!---BJF: Removed requirement that users have create permission  D10133--->
					tabNavigate("/billbacks/common/bb_route.cfm")

				}
				}//make sure it is not auto billback - end
			break;
			//inbox
			case "inbox":
			 AccessDataArray = autoBillbackAccess(); //make sure it is not auto billback
			if(AccessDataArray[0] == true) {
				AccessDataArray = isBBLocked();
				if(AccessDataArray[0] == true) {
					<!---BJF: Removed requirement that users have create permission  D10133--->
					tabNavigate("/billbacks/common/bb_route_inbox.cfm")

				}
				}//make sure it is not auto billback - end
			break;
			//excel
			case "excel":
				AccessDataArray = isBBLocked();
				if(AccessDataArray[0] == true) {
				<cfoutput>
					NewWindow("program_form.cfm?bbid=#bbid#&xl=1");
				</cfoutput>
				}
			break;
			<cfif appSettings.getShow_BB_Route() IS 1>
			//acknowledgments
			case "acknowledgments":
				AccessDataArray = isBBLocked();
				if(AccessDataArray[0] == true)
					{

						NewWindow("/billbacks/common/bb_acknowledgments.cfm?Billback_ID=<cfoutput>#url.BBID#</cfoutput>", 'name', '800', '600', 'Yes', 'No', true);
					}
			break;
			</cfif>

			<!---Only if payment history should be visible --->
			<cfif ShowPaymentHistory IS 1>
			case "paymenthistory":
				AccessDataArray = isBBLocked();
				if(AccessDataArray[0] == true) {
					tabNavigate("/billbacks/approval/payment_history.cfm")
				}
			break;
			</cfif>

			//search
			case "search":
				AccessDataArray[0] = true;
				AccessDataArray[1] = "";
				window.location.href="/billbacks/scorecard/billback_Search.cfm"
			break;
			//create
			case "create":
				AccessDataArray[0] = true;
				AccessDataArray[1] = "";
				AccessDataArray = profileSettingsTabAccess(); //make sure pre-reqs complete
				if(AccessDataArray[0] == true) {

						resetVariables();
						document.all.basic_info_tab.fireEvent("onclick");

				}
			break;
			//lock
			case "lock":
					AccessDataArray[0] = true;
					current_menu_item = "summary";
					this.document.contentIFrame.location = "Billback_Locker.cfm?BBID="+bb_id+"&Billback_IsLocked=1&rand=" + rand();
			break;
			//unlock
			case "unlock":
				if(bb_id == 0) {
					AccessDataArray[0] = false;
					AccessDataArray[1] = "An option for Read-Only will be available upon entering the basic billback information.";
				}
				else {
				AccessDataArray[0] = true;
				AccessDataArray[1] = "";
				current_menu_item = "summary";
				this.document.contentIFrame.location = "Billback_Locker.cfm?BBID="+bb_id+"&Billback_IsLocked=0&rand=" + rand();
				}
			break;
			<cfif application.oApplicationAppSettingsManager.getApplicationAppSettings().getBudgetsFunctionalityOn()>
			//budgets
			case "budgets":
				if(bb_status_id >= 2)
				{
						NewWindow("/billbacks/approval/budget_display_billback.cfm?Billback_ID=" + bb_id + "","bb_budget_display","800","600","Yes", "No");
						AccessDataArray[0] = true;
				}
				else
				{
					AccessDataArray[0] = false;
					AccessDataArray[1] = "Billback has to be RFA or above to view budgets";
				}
			break;
			</cfif>
			//TSF: Label 21054 - Allow users to switch items on uploaded billbacks
			<cfif Switch_Product_Button_Show>
			case "switchProducts":
				AccessDataArray = isBBLocked(tabID);
				if(AccessDataArray[0] == true)
				{
					tabNavigate("/billbacks/capture/switch_products.cfm");
				}
			break;
			</cfif>
		}

		return AccessDataArray
	}

	function tabClick(tabID) {
		AccessPermArray = getMenuTabPermission(tabID);
		if(AccessPermArray[0] == false) {
			messageReporter(AccessPermArray);
			return false;
		}
		else{
			buildMenu();
			return true;
		}

	}

	function tabNavigate(location, extraURL, isAutoBB) {
		if(extraURL)
		{
			extraURL = "&" + extraURL;
		}
		else
		{
			extraURL = "";
		}
		if(isAutoBB == '1')
		{
			extraURL = extraURL + "&isAutoBB=" + isAutoBB;
		}
		else
		{
			extraURL = extraURL + "&isAutoBB=0";
		}
		buildMenu();
		finalLocation = location +"?BBID=" + bb_id + extraURL;
		this.document.contentIFrame.location.href = finalLocation;

	}

	function LoadInfobar(InfobarString, AmountDisplayString) {
		if (current_menu_item == "summary")
		 {
		 	allowScroll = false;
		 	this.document.all.infoBar.style.backgroundColor = "#FFFFFF";
		 	this.document.all.infoBar.innerHTML = '';
		 	this.document.all.infoBar_BB_Amount.style.backgroundColor = "#FFFFFF";
		 	this.document.all.infoBar_BB_Amount.innerText = '';
		 }
		else
		{
		   allowScroll = true;
		   window.setInterval("main()", 10);
		   this.document.all.infoBar.style.backgroundColor = "#006600";
		   this.document.all.infoBar.style.paddingLeft = "1em";
		   this.document.all.infoBar.innerHTML = InfobarString;
		   var amountObj = this.document.all.infoBar_BB_Amount;
		   amountObj.style.paddingLeft = "1em";
		   amountObj.style.paddingRight = "1em";
		   amountObj.style.backgroundColor = "#33CC33";
		   amountObj.innerText = AmountDisplayString;
		}
	}


	function buildMenu() {
