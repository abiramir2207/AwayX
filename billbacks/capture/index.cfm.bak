<cfif appsettings.getBillbackModifyAgree() EQ 1 AND quickBBCheck.Auto_Billback NEQ 1>
function ModifyAgree()
{
	if(bb_status_id == 2 && bb_agreed_to == 1) // rfa and billback agreed to
	{
		if(modify_agree_enable == 1)//link is enabled
		{
			if(bb_is_locked == 1)
			{
				var modifyagree_confirm = confirm("After you make changes, you will be required to agree/approve the billback");
				if (modifyagree_confirm == true)
				{
					var newLocation = "/billbacks/capture/BB_modifyagree.cfm?BBID=" + bb_id
					window.location.href=newLocation;
				}
			}
			else
			{
				alert("Please lock the billback first.")
			}
		}//modify_agree_enable == 1 - if end
		else
		{
			if(bb_agreed_to == 0)
			{
				alert("You are restricted from this section since this billback is not agreed by anyone yet.");
			} // bb_agreed_to == 0 - end
			else
			{
				<CFIF len(trim(URL.BBID)) GT 0>
				<cfif Get_Billback_Info.BB_Modify_Agree EQ 1>
				alert("Billback is being modified by <cfoutput>#Get_Billback_Info.user_name#</cfoutput>");
				<cfelse>
				alert("You do not have access to this section.");
				</cfif>
				</CFIF>
			}
		}//modify_agree_enable == 1 - else end
	} // rfa and billback agreed to - if end
	else
	{
		return false;
	} // rfa and billback agreed to - else end
}//function - end
</cfif>

function copyBillback()
{
	var IsSplitChild = '<cfoutput>#IsSplitChild#</cfoutput>';

	if(bb_is_locked == 1 && locked_by_other_user == 0)
	{

		if (IsSplitChild == 0)
		{
			var newLocation = "/billbacks/capture/Copy_ThisBB.cfm?BBID=" + bb_id
			window.location.href=newLocation;
		}
		else
		{
			alert("You cannot copy the child of a split billback. Please copy the parent of this billback.");
		}

	}
	else
	{
		alert("Please lock the billback first.")

	}
}
