						</cfif>
						<cfif appSettings.getShow_BB_Route() IS 1>
						document.all.acknowledgments_tab.className	= 	disabled_false_inactive;
						</cfif>
						<cfif ShowPaymentHistory IS 1>
						document.all.paymenthistory_tab.className	=	disabled_false_inactive;
						</cfif>
						<!---- enable only if app settings for modify agree = on, billback status = 2, billback already agreed to --->
						<cfif appsettings.getBillbackModifyAgree() EQ 1 AND quickBBCheck.Auto_Billback NEQ 1>
						if(bb_status_id == 2 && bb_agreed_to == 1 && modify_agree_enable == 1)
						{
							document.all.ModifyAgree_tab.className	=	disabled_false_inactive;
						}
						</cfif>
						//TSF: Label 21054 - Allow users to switch items on uploaded billbacks
						<cfif Switch_Product_Button_Show>
							document.all.switch_products_tab.className			=	disabled_false_inactive;
						</cfif>
						<cfif bBillbackSalesTax>
							document.all.BBSalesTax_Tab.className		=	disabled_false_inactive;
						</cfif>
					break;

					case "3" : //approved
					case "6" : //Pending Vendor ID
					case "7" : //Payment Request
						document.all.summary_tab.className		=	disabled_false_inactive;
						//document.all.basic_info_tab.className	=	disabled_false_inactive;
						if(auto_billback == 1)
