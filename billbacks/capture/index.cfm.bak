		document.all.budgets_tab.className			=	disabled_true;
		</cfif>
		//TSF: Label 21054 - Allow users to switch items on uploaded billbacks
		<cfif Switch_Product_Button_Show>
			document.all.switch_products_tab.className			=	disabled_true;
		</cfif>
		if(locked_by_other_user == 0){
			if(bb_is_locked == 1 && bb_status_id != 0){
				switch(bb_status_id) {
					case 0 : //bb hasnt been created yet
						document.all.basic_info_tab.className	=	"disabled_false_inactive";
					break;

					case "1" : //wip
						document.all.summary_tab.className		=	disabled_false_inactive;
