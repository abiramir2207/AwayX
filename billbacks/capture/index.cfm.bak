	</td>
   </tr>
  <cfif application.appSettingsGet.getBillback_Module() EQ 1 AND Get_Profile_Settings.BB_Create EQ 1 AND appSettings.getShowManualBillback()>
	<tr>
	 <td class="inactiveMenuItem" nowrap>
	  <a href="/billbacks/capture/index.cfm"><img src="/images/programs/ball_blue.gif" border="0" align="absmiddle" />Create billback</a>
	 </td>
	</tr>
   </cfif>
   <cfif appSettings.getShowAutoBillback() EQ 1 AND Get_Profile_Settings.BB_Create EQ 1>
	<tr>
     <td class="inactiveMenuItem" nowrap>
	  <a href="/billbacks/capture/INDEX.CFM?AUTOBB=<CFIF appSettings.getAutoBillBackType()>2<cfelse>1</cfif>"><img src="/images/programs/ball_blue.gif" border="0" align="absmiddle" />Create Auto billback</a>
     </td>
	</tr>
   </cfif>
	<tr>
	 <td class="inactiveMenuItem">
	  <img border="0" src="/images/programs/ball_none.gif" align="absmiddle" />
	 </td>
	</tr>
	<cfif appSettings.getSplitBillbacks()>
	<tr>
	 <td id="split_tab" class="inactiveMenuItem" onClick="ShowSplit(); return false;">
	  <img src="/images/programs/ball_gray_filled.gif" id="split_tab_icon" align="absmiddle" />Split Detail
	 </td>
	</tr>
	</cfif>
	<cfif LocalBBID NEQ 0>
	<cfset userManager = CreateObject("component", "components.user.UserManager").init() />
	<cfoutput>
	<tr>
		<td>
			<a href="/workflow/Billback/BB_Workflow.cfm?Billback_ID=#bbid#" onClick="NewWindow(this.href,'BBWorkflow','1000','800','Yes', 'Yes');return false;"><IMG BORDER="0" SRC="/images/programs/ball_blue.gif" ALIGN="absmiddle"></A>
			<a href="/workflow/Billback/BB_Workflow.cfm?Billback_ID=#bbid#" onClick="NewWindow(this.href,'BBWorkflow','1000','800','Yes', 'Yes');return false;">Workflow</A>
		</td>
	</tr>
<!---
	<tr>
	 <td class="activeMenuLabelItem">
	  <img src="/images/programs/ball_blue.gif" align="absmiddle" border="0" />
		<cf_smallHelp
			borderColor="black"
			backgroundColor="WhiteSMoke"
			showImage="0"
			showText="Created By"
			borderWidth="1">
		#userManager.getUserName(quickBBCheck.BB_Creator_ID)#
		#Dateformat(quickBBCheck.Created_Date, "mm/dd/yyyy")#
		</cf_smallHelp>
	 </td>
	</tr>
    <tr>
	 <td class="<cfif quickBBCheck.Billback_Status_ID GTE 2>activeMenuLabelItem<cfelse>inactiveMenuLabelItem</cfif>">
	  <img src="/images/programs/ball_blue.gif" border="0" align="absmiddle" />
		<cfif quickBBCheck.Billback_Status_ID GTE 2>
		<cf_smallHelp
			borderColor="black"
			backgroundColor="WhiteSMoke"
			showImage="0"
			showText="Req. Approval By"
			borderWidth="1">
		#userManager.getUserName(quickBBCheck.BB_Request_Approval_User_ID)#
		#Dateformat(quickBBCheck.BB_Request_Approval_Date, "mm/dd/yyyy")#
		</cf_smallHelp>
		<cfelse>Req. Approval By</cfif>
	 </td>
	</tr>
	<tr>
	 <td class="<cfif quickBBCheck.Billback_Status_ID GTE 3>activeMenuLabelItem<cfelse>inactiveMenuLabelItem</cfif>">
	  <img src="/images/programs/ball_blue.gif" border="0" align="absmiddle" />
		<cfif quickBBCheck.Billback_Status_ID GTE 3>
      <!--
        Dev Notes:  21923/Anand Rao/19-Jan-2010
        Created a new table BB_Approval_History and using it for maintaining the
        BB Approval history, if a BB is Approved multiple times.
      -->
     <cfquery name="BillbackApprovalHistory" datasource="#application.datasource#">
      SELECT BBAH.BB_Approval_History_Id, BBAH.Billback_ID, BBAH.Approved_By , BBAH.Created_Date,
      u1.Name_First + ' ' +  u1.Name_Last AS Approved_By_Name
      FROM BB_Approval_History BBAH
      LEFT OUTER JOIN _Users u1
    	ON BBAH.Approved_By = u1.User_ID
      WHERE BBAH.Billback_ID = '#bbid#'
      order by BBAH.Created_Date
    </cfquery>

		<cf_smallHelp
			borderColor="black"
			backgroundColor="WhiteSMoke"
			showImage="0"
			showText="Approved By"
			borderWidth="1"
      width="300">
		<!--- #userManager.getUserName(quickBBCheck.User_Approved)#
		#Dateformat(quickBBCheck.Date_Approved, "mm/dd/yyyy")# --->
      <cfloop query="BillbackApprovalHistory"><li>#BillbackApprovalHistory.Approved_By_Name#&nbsp;(#Dateformat(BillbackApprovalHistory.Created_Date,"mm/dd/yy")# #Timeformat(BillbackApprovalHistory.Created_Date,"hh:mm tt")#)</li></cfloop>
		</cf_smallHelp>
		<cfelse>Approved By</cfif>
	  </td>
	 </tr>
	 <tr>
		<cfset isReset = 0>
		<cfif quickBBCheck.BB_Reset_User_ID NEQ "">
			<cfset isReset = 1>
		</cfif>
	 <td class="<cfif isReset>activeMenuLabelItem<cfelse>inactiveMenuLabelItem</cfif>">
	  <img src="/images/programs/ball_blue.gif" border="0" align="absmiddle" />
		<cfif isReset>
		<cf_smallHelp
			borderColor="black"
			backgroundColor="WhiteSMoke"
			showImage="0"
			showText="Reset By"
			borderWidth="1">
		#userManager.getUserName(quickBBCheck.BB_Reset_User_ID)#
		#Dateformat(quickBBCheck.BB_Reset_Date, "mm/dd/yyyy")#
		</cf_smallHelp>
		<cfelse>Reset By</cfif>
	  </td>
	 </tr>
	 <tr>
		<cfset isDisagree = 0>
		<cfif quickBBCheck.BB_Disagree EQ 1>
			<cfset isDisagree = 1>
		</cfif>
	  <td class="<cfif isDisagree>activeMenuLabelItem<cfelse>inactiveMenuLabelItem</cfif>">
	   <img src="/images/programs/ball_blue.gif" border="0" align="absmiddle" />
		<cfif isDisagree>
		<cf_smallHelp
			borderColor="black"
			backgroundColor="WhiteSMoke"
			showImage="0"
			showText="Disagree By"
			borderWidth="1">
		<cfif quickBBCheck.BB_Disagree_By NEQ "">#userManager.getUserName(quickBBCheck.BB_Disagree_By)#</cfif>
		<cfif quickBBCheck.BB_Disagree_Date NEQ "">#Dateformat(quickBBCheck.BB_Disagree_Date, "mm/dd/yyyy")#</cfif>
		</cf_smallHelp>
		<cfelse>Disagree By</cfif>
	  </td>
	 </tr>
	 <cfset isAgree = 0>
		<cfif quickBBCheck.Agreed_Count GT 0>
			<cfset isAgree = 1>
		</cfif>
	  <td class="<cfif isAgree>activeMenuLabelItem<cfelse>inactiveMenuLabelItem</cfif>">
	   <img src="/images/programs/ball_blue.gif" border="0" align="absmiddle" />
		<cfif isAgree>

		<cfquery name="AgreedUsers" datasource="#application.datasource#">
		SELECT DISTINCT Name_First, Name_Last, BB_Agreed_Info.Created_Date
		FROM _Users
			INNER JOIN BB_Agreed_Info
			ON BB_Agreed_Info.Billback_ID = '#url.BBID#'
			AND BB_Agreed_Info.Deleted = 0
			AND BB_Agreed_Info.User_ID = _Users.User_ID
		</cfquery>

		<cf_smallHelp
			borderColor="black"
			backgroundColor="WhiteSMoke"
			showImage="0"
			showText="Agreed To By"
			borderWidth="1">

		<cfloop query="AgreedUsers">
			#Name_First# #Name_Last# #Dateformat(AgreedUsers.Created_Date, "mm/dd/yyyy")#<br>
		</cfloop>

		</cf_smallHelp>
		<cfelse>Agreed To By</cfif>
	  </td>
	 </tr>
 --->
	</cfoutput>
	</cfif>
	<cfoutput>
	 <!--- VOIDED BY :::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::: --->
	 <tr>
	 <td class="<cfif quickBBCheck.BB_Reversed eq '1'>activeMenuLabelItem<cfelse>inactiveMenuLabelItem</cfif>">
	  <img src="/images/programs/ball_blue.gif" border="0" align="absmiddle" />
		<cfif quickBBCheck.BB_Reversed eq '1'>
		<cf_smallHelp
			borderColor="black"
			backgroundColor="WhiteSMoke"
			showImage="0"
			showText="Voided By"
			borderWidth="1">
		#userManager.getUserName(quickBBCheck.BB_Reversed_By)#
		#Dateformat(quickBBCheck.BB_Reversed_Date, "mm/dd/yyyy")#
		</cf_smallHelp>
		<cfelse>Voided By</cfif>
	  </td>
	 </tr>
	</cfoutput>
	<tr>
	 <td nowrap>
	  <img border="0" src="/images/programs/finial.gif" align="absmiddle" />
	 </td>
	</tr>
   </table>

<div style="overflow:auto;" align="left">
<div id="infoBarLayer" style="position: relative; z-index: 100;">
	<table border="0" cellpadding="0" id="AutoNumber2" cellspacing="0" bgcolor="#FFFFFF" width="84%">
 		     <tr>
		      <td class="titleMain" id="infoBar" width="100%"></td>
		      <td align="center" class="titleAmount" id="infoBar_BB_Amount"></td>
		     </tr>
	        </table>
	</div>
	<span class="cellaroundIframe"><iframe scrolling="no" src="<cfoutput>#iframeSourcePage#</cfoutput>" name="contentIFrame" id="contentIFrame" width="840" marginwidth="0" marginheight="0" align="left" frameborder="0" class="iframeStyle"></iframe></span>
</div>
</div>

<script>
	initVariables();
	buildMenu();
</script>

