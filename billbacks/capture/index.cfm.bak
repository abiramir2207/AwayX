						}
						document.all.programs_tab.className		=	disabled_false_inactive;
						//document.all.deviations_tab.className	=	disabled_false_inactive;
						document.all.document_tab.className		=	disabled_false_inactive;
						document.all.print_tab.className		=	disabled_false_inactive;
