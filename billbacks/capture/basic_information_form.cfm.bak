			</style>
			<form action="Basic_information_action.cfm" method="post" name="BBForm" id="BBForm">
			&nbsp; &nbsp; &nbsp; &nbsp; &nbsp;
			<CFINCLUDE TEMPLATE="/helpsystem/help_link.cfm">
			<table border="0" align="center" cellpadding="0" cellspacing="5">
             <tr>
              <td class="DataTitleCell">Payable Number:</td>
			  <td rowspan="100%" bgcolor="0000CC" width="2px"></td>
			  <td style="font-size: 20px; font-weight: bold;">#FORM.BB_Code#<CFIF URL.BBID EQ "">-00</CFIF></td>
             </tr>
  				<CFSET RefMaxLength = appSettings.getBB_Ref_Num_Max_Length()>
