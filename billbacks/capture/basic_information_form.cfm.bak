<cfinclude template="/get_access_profile.cfm">
<cfparam name="LoadBillbackData.Scheduled_auto_BB" default="0">
<cfset appSettings = application.oApplicationAppSettingsManager.getApplicationAppSettings()>

<CFIF Get_Profile_Settings.BB_Create EQ 1>
		<!--- load bb --->
		<cfparam name="URL.BBID"								default="">
		<cfif URL.BBID IS 0><cfset URL.BBID = ""></cfif>
		<cfparam name="Form.Billback_ID"						default="">
		<cfparam name="FORM.BB_Code" 							default="">
		<cfparam name="FORM.BB_Title" 							default="">
		<cfparam name="FORM.BB_Reference" 						default="">
		<cfparam name="FORM.BB_Date" 							default="#Now()#">
		<CFPARAM NAME="FORM.BB_Received_Date" 					DEFAULT="#Now()#">
		<cfparam name="FORM.BB_Start_Date" 						default="#Now()#">
		<cfparam name="FORM.BB_End_Date" 						default="#Now()#">
		<cfparam name="FORM.Postmark_Date" 						default="#Now()#">
		<cfparam name="FORM.BB_Amount" 							default="0.00">
		<cfparam name="FORM.BB_Volume"							default="0">
		<cfparam name="FORM.BB_Notes" 							default="">
		<cfparam name="FORM.BB_Creator_Notes" 					default="">
		<cfparam name="FORM.Billback_ID"						default="">
		<CFPARAM NAME="FORM.BB_Closing_Method" 					DEFAULT="">
		<CFPARAM NAME="FORM.IsBBReferenceExisted"				DEFAULT=false>
		<!--- <CFPARAM NAME="FORM.BBRefList"							DEFAULT=""> --->
		<CFPARAM NAME="FORM.ClaimMechanics"						DEFAULT="">
		<CFPARAM NAME="FORM.TotalTaxAmount"						DEFAULT="0">
		<CFPARAM NAME="FORM.TotalTaxableAmount_1"				DEFAULT="0">
		<CFPARAM NAME="FORM.TotalTaxableAmount_2"				DEFAULT="0">
		<CFPARAM NAME="FORM.TotalTaxableAmount_3"				DEFAULT="0">
		<CFPARAM NAME="FORM.TotalTaxAmount_1"					DEFAULT="0">
		<CFPARAM NAME="FORM.TotalTaxAmount_2"					DEFAULT="0">
		<CFPARAM NAME="FORM.TotalTaxAmount_3"					DEFAULT="0">
		<CFPARAM NAME="FORM.claimAmount"						DEFAULT="0">
		<CFPARAM NAME="FORM.claimCases"							DEFAULT="">
		<CFPARAM NAME="FORM.claimPounds"						DEFAULT="">
		<!--- D12149 Billbacks may now have negative values without this setting --->
		<!--- <CFPARAM NAME="FORM.Negative_Billback"						DEFAULT="0"> --->
		<cfparam name="form.referenceNum" default="" />

		<CFSET LoadBillback = 0>
		<CFIF len(trim(URL.BBID)) GT 0 AND trim(URL.BBID) NEQ 0>
			<CFSET Form.Billback_ID = URL.BBID>
			<CFSET LoadBillback = 1>
		</CFIF>

		<CFSET Disable_Deduction = 0>
    <cfset bDisableLinks = 0 />
		<CFIF LoadBillback EQ 1>
			<cfquery name="LoadBillbackData" datasource="#Application.Datasource#">
				SELECT	BB_Title,
						BB_Date,
						BB_Received_Date,
						BB_Start_Date,
						BB_End_Date,
						BB_Amount,
						BB_Volume,
						BB_Volume_UOM,
						BB_Reference,
						BB_Creator_ID,
						BB_Creator_Notes,
						BB_Code,
						BB_Creator_User_Position_ID,
						Billback_Status_ID,
						ISNULL(Billback_Payee_Type_ID, 0) AS Billback_Payee_Type_ID,
						BB_UP,
						BB_PNF,
						Created_Date,
						Deleted,
						Postmark_Date,
						BB_Closing_Method,
						BB_Associated_To_DD,
						Billback_Status_ID,
						ClaimMechanics,
						Scheduled_auto_BB,
						TotalTaxAmount,
						isNull(CLAIM_CASES, 0.00) as Claim_Cases,
						isNull(CLAIM_POUNDS, 0.00) as Claim_Pounds,
						<!--- Negative_Billback, --->
						referenceNum,
            			Uploaded_Billback,
						Billback.BB_Deviations_Override_Price as BB_Level_Deviations_Override_Price_Flag
				FROM 	Billback
				WHERE 	Billback_ID = '#Form.Billback_ID#'
			</cfquery>

			<CFIF NOT ListFindNoCase("0,1", LoadBillbackData.Billback_Payee_Type_ID)>
				<CFSET Disable_Deduction = 1>
			</CFIF>

			<cfset FORM.BB_Code 			= LoadBillbackData.BB_Code>
			<cfset FORM.BB_Title 			= LoadBillbackData.BB_Title>
			<cfset FORM.BB_Reference 		= LoadBillbackData.BB_Reference>
			<cfset FORM.BB_Date 			= dateformat(LoadBillbackData.BB_Date,'m/d/yyyy')>
			<CFSET FORM.BB_Received_Date	= dateformat(LoadBillbackData.BB_Received_Date,'m/d/yyyy')>
			<cfset FORM.BB_Start_Date 		= dateformat(LoadBillbackData.BB_Start_Date,'m/d/yyyy')>
			<cfset FORM.BB_End_Date 		= dateformat(LoadBillbackData.BB_End_Date,'m/d/yyyy')>
			<CFSET FORM.Postmark_Date		= dateformat(LoadBillbackData.Postmark_Date,'m/d/yyyy')>
			<cfset FORM.BB_Amount 			= LoadBillbackData.BB_Amount><!--- trim(numberformat(LoadBillbackData.BB_Amount,'__________________________.__'))> --->
			<cfset FORM.BB_Volume			= trim(numberformat(LoadBillbackData.BB_Volume,'___'))>
			<cfset FORM.BB_Volume_UOM		= LoadBillbackData.BB_Volume_UOM>
			<cfset FORM.BB_Notes			= LoadBillbackData.BB_CREATOR_NOTES>
			<CFSET FORM.BB_Closing_Method 	= LoadBillbackData.BB_Closing_Method>
			<cfset FORM.ClaimMechanics	 	= LoadBillbackData.ClaimMechanics>
			<cfset FORM.TotalTaxAmount	 	= LoadBillbackData.TotalTaxAmount>
			<cfset FORM.claimAmount	 		= LoadBillbackData.BB_Amount>
			<cfset form.claimCases			= LoadBillbackData.CLAIM_CASES>
			<cfset form.claimPounds			= LoadBillbackData.CLAIM_POUNDS>
			<!--- <CFSET FORM.Negative_Billback 	= LoadBillbackData.Negative_Billback> --->
			<cfset form.referenceNum        = LoadBillbackData.referenceNum />

			<cfquery name="getUomDesc" datasource="#Application.Datasource#">
				Select Abbreviation
				From Units_of_Measure
				where unit_of_Measure_id  = '#FORM.BB_Volume_UOM#'
			</cfquery>
      <!---
      19441 Starts [Added, Uploaded_Billback to the above query]
      the checking <cfif bDisableLinks EQ 0>  is put on all the controls.
      ---->
        <cfset BB_Upload_III_P_Qty_Amt_Editable = appSettings.getBB_Upload_III_P_Qty_Amt_Editable() />
		<cfset bEditable_Claimed_Dollars_Quantity = appSettings.getEditableClaimedDollarsQuantity() />
		<cfif LoadBillbackData.BB_Level_Deviations_Override_Price_Flag eq 1>
			<cfset BB_Upload_III_P_Qty_Amt_Editable = 0 />
		</cfif>
        <cfset bFlexBBDeviationOn               = appSettings.getFlex_BB_Deviation() />
        <cfset iUploadedBillback                = LoadBillbackData.Uploaded_Billback />

		<cfif ((BB_Upload_III_P_Qty_Amt_Editable EQ 0 AND iUploadedBillback EQ 3) OR (bEditable_Claimed_Dollars_Quantity EQ 0 AND iUploadedBillback EQ 2)) AND bFlexBBDeviationOn EQ 1>
          <cfset bDisableLinks = 1 />
        </cfif>
		
        <!---  BB_Upload_III_P_Qty_Amt_Editable:<cfoutput>#BB_Upload_III_P_Qty_Amt_Editable#</cfoutput>
              iUploadedBillback:<cfoutput>#iUploadedBillback#</cfoutput>  --->

    <!--- 19441 End--->
		<CFELSE>
			<cfinclude template="billback_number_generator.cfm">
			<CFSET FORM.BB_Code = generator_billback_number>
			<cfset Scheduled_auto_BB = 0>
		</CFIF>


		<!---  end load bb --->

		<CFSET InfoBar_BBID = Form.Billback_ID>
		<cfinclude template="billback_load_infobar.cfm">

		<CFSET thisbbid = Form.Billback_ID>

		<CFIF len(trim(thisbbid)) EQ 0>
			<CFSET HideLock = 1>
			<CFSET thisbbid = "">
			<CFSET AllowLockRelocate = 0>
			<cfinclude template="billback_Locker.cfm">
		</CFIF>

		<!---TSF: Label 9231 - handling for itemized totals--->
		<cfparam name="variables.itemized_total" 				default="0.00" />
		<CFPARAM NAME="variables.itemizedAmount"				DEFAULT="#variables.itemized_total#">
		<CFPARAM NAME="variables.itemizedCases"					DEFAULT="0.00">
		<CFPARAM NAME="variables.itemizedPounds"				DEFAULT="0.00">
		<CFPARAM NAME="variables.variationAmount"				DEFAULT="0.00">
		<CFPARAM NAME="variables.variationCases"				DEFAULT="0.00">
		<CFPARAM NAME="variables.variationPounds"				DEFAULT="0.00">

		<CFSET billbackMan = CreateObject("component", "components.billback.BillbackManager").init() />
		<cfif FORM.BB_Amount eq "">
			<cfset FORM.BB_Amount = 0>
		</cfif>
		<cfif Form.billback_id neq "">
			<!--- <cfset Form.BBRefList 							= billbackMan.getBBReferences(Form.Billback_ID) /> --->
			<!---TSF: Label 9231 - handling for itemized totals--->
			<cfset variables.getBillbackItemizedVolumeSum	= billbackMan.getBillbackItemizedVolumeSum(Form.Billback_ID) />
			<cfset variables.itemizedCases					= variables.getBillbackItemizedVolumeSum.Volume_CS />
			<cfset variables.itemizedPounds					= variables.getBillbackItemizedVolumeSum.Volume_LB />
			<cfset variables.variationAmount				= FORM.BB_Amount - variables.itemizedAmount />
			<cfset variables.variationCases					= form.claimCases - variables.itemizedCases />
			<cfset variables.variationPounds				= form.claimPounds - variables.itemizedPounds />
		<cfelse>
		<!--- 	<cfset Form.BBRefList = billbackMan.getBBReferences("NULL") /> --->
		</cfif>

		<!--- If the setting allows for Sales tax Info --->
		<!---
		<cfif appSettings.getBillbacksSalesTax() eq 1>
			<cfset BillbackSalesTaxInfo = billbackMan.getBillbacksSalesTaxInfo()>
			<cfset BillbackSalesTaxAmountInfo = billbackMan.getBillbacksSalesTaxAmount(Form.Billback_ID)>
		</cfif>
		--->


		<CFSET PAGE_TITLE="Basic Information">
			<TITLE><CFOUTPUT>#PAGE_TITLE#</CFOUTPUT></TITLE>
			<LINK REL="STYLESHEET" TYPE="text/css" HREF="/common_files/main_style.css">
			<style>
				.borderNone td {
					border:none;
				}
			</style>
			<SCRIPT language="JavaScript" src="/script/javascript/string_functions.js"></SCRIPT>
			<!---<SCRIPT language="JavaScript" src="/Common_Files/scripts/allowonlytwodecimalplaces.js"></SCRIPT>--->
			<SCRIPT LANGUAGE="JavaScript" SRC="/Script/javascript/dhtml.js"></SCRIPT>
			<SCRIPT>

					<!---TSF: Label 9231 - adjust the variation--->
					function adjustVariance()
					{

						var claimAmount 	= document.all.claimAmount.value;
						var itemizedAmount 	= document.all.itemizedAmount.value;
						var claimCases 		= document.all.claimCases.value;
						var itemizedCases 	= document.all.itemizedCases.value;
						var claimPounds 	= document.all.claimPounds.value;
						var itemizedPounds 	= document.all.itemizedPounds.value;
						var varianceAmount 	= 0.00;
						var varianceCases 	= 0.00;
						var variancePounds 	= 0.00;

						//do the math
						varianceAmount	= 	claimAmount	- itemizedAmount;
						varianceCases	=  	claimCases	- itemizedCases;
						variancePounds	= 	claimPounds	- itemizedPounds;

						//reset for amount
						if(parseFloat(varianceAmount) >= 0)
						{
							varianceAmount	= FormatTextWithCommas(varianceAmount);
							document.all.variationAmountSpan.innerText = varianceAmount;
							document.all.variationAmountSpan.style.color = "#000000";
						}
						else
						{
							varianceAmount	= FormatTextWithCommas(varianceAmount);
							document.all.variationAmountSpan.innerText = "( " + varianceAmount + " )";
							document.all.variationAmountSpan.style.color = "#FF0000";
						}

						//reset for cases
						if(parseFloat(varianceCases) >= 0)
						{
							varianceCases 	= FormatTextWithCommas(varianceCases);
							document.all.variationCaseSpan.innerText = varianceCases;
							document.all.variationCaseSpan.style.color = "#000000";
						}
						else
						{
							varianceCases 	= FormatTextWithCommas(varianceCases);
							document.all.variationCaseSpan.innerText = "( " + varianceCases + " )";
							document.all.variationCaseSpan.style.color = "#FF0000";
						}

						//reset for pounds
						if(parseFloat(variancePounds) >= 0)
						{
							variancePounds 	= FormatTextWithCommas(variancePounds);
							document.all.variationPoundSpan.innerText = variancePounds;
							document.all.variationPoundSpan.style.color = "#000000";
						}
						else
						{
							variancePounds 	= FormatTextWithCommas(variancePounds);
							document.all.variationPoundSpan.innerText = "( " + variancePounds + " )";
							document.all.variationPoundSpan.style.color = "#FF0000";
						}


					}

					//function to add commas to a given string -  TODO: Put this in a .js file where it can be accessed everywhere
					function FormatTextWithCommas(oText) {
						var nf = new NumberFormat();
						nf.setNumber(oText);
						nf.setCommas(true);
						nf.setCurrency(false);
						nf.setPlaces(2);
						return nf.toFormatted()
					}

					function numberFormat(n)
					{
						var arr=new Array('0'),
						i=0;
						while (n>0)
						{
							arr[i]=''+n%1000;
							n=Math.floor(n/1000);
							i++;
						}
						arr=arr.reverse();
						for (var i in arr)
							if (i>0) //padding zeros
								while (arr[i].length<3)
									arr[i]='0'+arr[i];
									return arr.join();
					}

					function CheckForErrors(disableClickedButton, disableClickedButtonName) {
						todaysDate = new Date();
						//s = document.all.BBRefList.value;
					//	comparedStr = document.all.BB_Reference.value;
						ErrorCount = 0;

						error_text 		= "Please enter a billback number.";
						error_oSpan 	= document.all.error_BB_Reference;
						<!---  Reference Number (Text Length) --->
						if(document.all.BB_Reference.value.length == 0) {
							ErrorCount++;
							queueMessage(error_text, error_oSpan);
						}
						else
						{
							clearQueue(error_oSpan);
						}

						error_text 		= "Please enter a billback title";
						error_oSpan 	= document.all.error_BB_Title;
						<!--- Billback Title (Text Length) --->
						if(document.all.BB_Title.value.length == 0) {
							ErrorCount++;
							queueMessage(error_text, error_oSpan);
						}
						else
						{
							clearQueue(error_oSpan);
						}
						<!--- if (document.all.Negative_Billback)
						{
						<!--- Billback Type: --->
						error_text 		= "Please enter negative numbers in amount/cases/pounds.";
						error_oSpan 	= document.all.claimAmountErrorSpan;
						if (document.all.Negative_Billback.checked)
						{
							if (document.all.claimAmount.value > 0 || document.all.claimCases.value > 0 || document.all.claimPounds.value > 0)
							{
								ErrorCount++;
								queueMessage(error_text, error_oSpan);
							}
							else
							{
								clearQueue(error_oSpan);
							}
						}
						} --->
						<!--- Billback Date  --->

						error_text 				= "The billback date must be on or after the delivery span end date";
						error_oSpan 			= document.all.error_BB_Date;
						temp_bb_date			= new Date(document.all.BB_Date.value);
						temp_bb_deliv_end_date	= new Date(document.all.BB_End_Date.value);

						<!--- Received Date  --->

						error_text 				= "The received date can't be more than today.";
						error_oSpan 			= document.all.error_BB_Received_Date;
						temp_bb_received_date	= new Date(document.all.BB_Received_Date.value)

						if(temp_bb_received_date > todaysDate) {
							ErrorCount++;
							queueMessage(error_text, error_oSpan);
						}
						else
						{
							clearQueue(error_oSpan);
						}

						<!---Postmark date--->
						error_text 		= "The postmark date can't be later than today.";
						error_oSpan 	= document.all.error_Postmark_Date;
						temp_bb_pm_date		= new Date(document.all.Postmark_Date.value)

						if(temp_bb_pm_date > todaysDate) {
							ErrorCount++;
							queueMessage(error_text, error_oSpan);
						}
						else
						{
							clearQueue(error_oSpan);
						}

						if (document.all.BB_Start_Date.value == "")
						{
							error_text 		= "Please enter the delivery period start date";
							error_oSpan 	= document.all.error_BB_Start_Date;
							ErrorCount++;
							queueMessage(error_text, error_oSpan);
						}
						else
						{
							clearQueue(error_oSpan);
						}

						if (document.all.BB_End_Date.value == "")
						{
							error_text 		= "Please enter the delivery period end date";
							error_oSpan 	= document.all.error_BB_Start_Date;
							ErrorCount++;
							queueMessage(error_text, error_oSpan);
						}
						else
						{
						}

						<!--- Billback Span  --->
						error_text 		= "The delivery period end date must be after the delivery period start date";
						error_oSpan 	= document.all.error_BB_Start_Date;
						temp_bb_deliv_start_date	= new Date(document.all.BB_Start_Date.value)
						/* ::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
						  29002 - Validate bb date range, confirm with users when any of these conditions exists:
						  a.   billback span (end date – start date) is greater or equal to 500 days
						  b.   billback start date is more than 500 day in the past (from today’s date)
						  c.   billback start date is more than 500 days in the future (from today’s date)
						::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::: */
						var today      = new Date();
					  var farpast    = new Date().setDate(today.getDate() - 500);
					  var farfuture  = new Date().setDate(today.getDate() + 500);
						// console.log('farfuture = ' + $.DateFormat(farfuture,'mm/dd/yyyy'));
						// console.log('farpast = ' + $.DateFormat(farpast,'mm/dd/yyyy'));
						// console.log('1 = ' + ($.DateDiff('d', document.all.BB_Start_Date.value, document.all.BB_End_Date.value) > 500));
						// console.log('2 = ' + (temp_bb_deliv_start_date < farpast));
						// console.log('3 = ' + (temp_bb_deliv_start_date > farfuture));

						if(temp_bb_deliv_end_date < temp_bb_deliv_start_date) {
								ErrorCount++;
								queueMessage(error_text, error_oSpan);
						}
						else if ( ($.DateDiff('d', document.all.BB_Start_Date.value, document.all.BB_End_Date.value) > 500)
							        || (temp_bb_deliv_start_date < farpast)
							        || (temp_bb_deliv_start_date > farfuture) ) {
							// 29002 - warn users when bb dates are out of the normal range
							if (! confirm('Please confirm the billback start and end dates are accurate.\nClick OK to continue.  Click Cancel to update the dates.')) {
								return false;
							}
						}
						else
						{
								clearQueue(error_oSpan);
						}

						//Closing method

						var DeductionDisable = "<CFOUTPUT>#Disable_Deduction#</CFOUTPUT>";
            var BBCm_Value = 0;
            var BBCm_Desc= "";
            for (var i=0; i<document.BBForm.BB_Closing_Method.length; i++)  {
              if (document.BBForm.BB_Closing_Method[i].checked){
                BBCm_Value = document.BBForm.BB_Closing_Method[i].value
              }
            }
            if (BBCm_Value == 2)
            {
              BBCm_Desc = "Deduction";
            }
            else if (BBCm_Value == 5)
            {
              BBCm_Desc = "Credit Memo";
            }
            error_text 		= "Payee is not a <CFOUTPUT>#application.returned_customer_setting.distributor_label_singular#</CFOUTPUT>. Closing method can not be " + BBCm_Desc ;
						error_oSpan 	= document.all.error_clsing_method;

            // If the value is either 2(DED) or 5(Credit Memo) do not allow the user to save
						if(DeductionDisable == 1 && (BBCm_Value == 2 || BBCm_Value == 5)) {
							ErrorCount++;
							queueMessage(error_text, error_oSpan);
						}
						else
						{
							clearQueue(error_oSpan);
						}
						// End Closing method
						error_text 		= "Please enter a claim amount";
						error_oSpan 	= document.all.claimAmountErrorSpan;
						<!--- Billback Amount (Text Length) --->
						if(document.all.claimAmount.value.length == 0) {
							ErrorCount++;
							queueMessage(error_text, error_oSpan);
						}
						else
						{
							clearQueue(error_oSpan);
						}
	    				<!---
					<cfif appSettings.getBillbacksSalesTax() eq 1>
						error_text 		= "You cannot choose the same Tax Code more than once";
						error_oSpan 	= document.all.error_TaxCode_1;
						if((document.all.TaxCode_1.value != '') && (document.all.TaxCode_1.value == document.all.TaxCode_2.value))
						{

							    ErrorCount++;
							    queueMessage(error_text, error_oSpan);
						}
						else
						{
							    clearQueue(error_oSpan);
						}

						error_text 		= "Please select a tax code";
						error_oSpan 	= document.all.error_TaxCode_1;

						if(document.all.TaxCode_1.value == '' && (parseFloat(document.all.TaxableAmount_1.value) > 0 || parseFloat(document.all.TaxAmount_1.value) > 0))
						{

							    ErrorCount++;
							    queueMessage(error_text, error_oSpan);
						}
						else
						{
							    clearQueue(error_oSpan);
						}

						error_text 		= "You cannot choose the same Tax Code more than once";
						error_oSpan 	= document.all.error_TaxCode_2;
						if((document.all.TaxCode_2.value != '') && (document.all.TaxCode_2.value == document.all.TaxCode_3.value))
						{
							    ErrorCount++;
							    queueMessage(error_text, error_oSpan);
						}
						else
						{
							    clearQueue(error_oSpan);
						}

						error_text 		= "Please select a tax code";
						error_oSpan 	= document.all.error_TaxCode_2;

						if(document.all.TaxCode_2.value == '' && (parseFloat(document.all.TaxableAmount_2.value) > 0 || parseFloat(document.all.TaxAmount_2.value) > 0))
						{

							    ErrorCount++;
							    queueMessage(error_text, error_oSpan);
						}
						else
						{
							    clearQueue(error_oSpan);
						}

						error_text 		= "You cannot choose the same Tax Code more than once";
						error_oSpan 	= document.all.error_TaxCode_3;
						if((document.all.TaxCode_1.value != '') && (document.all.TaxCode_1.value == document.all.TaxCode_3.value))
						{
							    ErrorCount++;
							    queueMessage(error_text, error_oSpan);
						}
						else
						{
							    clearQueue(error_oSpan);
						}

						error_text 		= "Please select a tax code";
						error_oSpan 	= document.all.error_TaxCode_3;

						if(document.all.TaxCode_3.value == '' && (parseFloat(document.all.TaxableAmount_3.value) > 0 || parseFloat(document.all.TaxAmount_3.value) > 0))
						{

							    ErrorCount++;
							    queueMessage(error_text, error_oSpan);
						}
						else
						{
							    clearQueue(error_oSpan);
						}
					<cfif IsDefined("getBillbackInformation.Paid_Amount") AND getBillbackInformation.Paid_Amount neq "" AND getBillbackInformation.Paid_Amount neq 0>
						error_text  = "The value of the taxable amount cannot exceed the total approved amount";
						error_oSpan = document.all.error_TaxableAmount_1;
							if(parseFloat(document.all.TaxableAmount_1.value) > parseFloat(<cfoutput>#val(getBillbackInformation.Paid_Amount)#</cfoutput>))
							{
							    ErrorCount++;
							    queueMessage(error_text, error_oSpan);
							}
							else
							{
							    clearQueue(error_oSpan);
							}

						error_text  = "The value of the taxable amount cannot exceed the total approved amount";
						error_oSpan = document.all.error_TaxableAmount_2;
							if(parseFloat(document.all.TaxableAmount_2.value) > parseFloat(<cfoutput>#val(getBillbackInformation.Paid_Amount)#</cfoutput>))
							{
							    ErrorCount++;
							    queueMessage(error_text, error_oSpan);
							}
							else
							{
							    clearQueue(error_oSpan);
							}


						error_text  = "The value of the taxable amount cannot exceed the total approved amount";
						error_oSpan = document.all.error_TaxableAmount_3;
							if(parseFloat(document.all.TaxableAmount_3.value) > parseFloat(<cfoutput>#val(getBillbackInformation.Paid_Amount)#</cfoutput>))
							{
							    ErrorCount++;
							    queueMessage(error_text, error_oSpan);
							}
							else
							{
							    clearQueue(error_oSpan);
							}
					<cfelse>
						error_text  = "The value of the taxable amount cannot exceed the total billback amount";
						error_oSpan = document.all.error_TaxableAmount_1;
							if(parseFloat(document.all.TaxableAmount_1.value) > parseFloat(document.all.claimAmount.value))
							{
							    ErrorCount++;
							    queueMessage(error_text, error_oSpan);
							}
							else
							{
							    clearQueue(error_oSpan);
							}

						error_text  = "The value of the taxable amount cannot exceed the total billback amount";
						error_oSpan = document.all.error_TaxableAmount_2;
							if(parseFloat(document.all.TaxableAmount_2.value) > parseFloat(document.all.claimAmount.value))
							{
							    ErrorCount++;
							    queueMessage(error_text, error_oSpan);
							}
							else
							{
							    clearQueue(error_oSpan);
							}


						error_text  = "The value of the taxable amount cannot exceed the total billback amount";
						error_oSpan = document.all.error_TaxableAmount_3;
							if(parseFloat(document.all.TaxableAmount_3.value) > parseFloat(document.all.claimAmount.value))
							{
							    ErrorCount++;
							    queueMessage(error_text, error_oSpan);
							}
							else
							{
							    clearQueue(error_oSpan);
							}
					</cfif>
						error_text  = "The value of the tax amount cannot exceed the taxable amount";
						error_oSpan = document.all.error_TaxAmount_1;
							if(parseFloat(document.all.TaxAmount_1.value) > parseFloat(document.all.TaxableAmount_1.value))
							{
							    ErrorCount++;
							    queueMessage(error_text, error_oSpan);
							}
							else
							{
							    clearQueue(error_oSpan);
							}

						error_text  = "The value of the tax amount cannot exceed the taxable amount";
						error_oSpan = document.all.error_TaxAmount_2;
							if(parseFloat(document.all.TaxAmount_2.value) > parseFloat(document.all.TaxableAmount_2.value))
							{
							    ErrorCount++;
							    queueMessage(error_text, error_oSpan);
							}
							else
							{
							    clearQueue(error_oSpan);
							}


						error_text  = "The value of the tax amount cannot exceed the taxable amount";
						error_oSpan = document.all.error_TaxAmount_3;
							if(parseFloat(document.all.TaxAmount_3.value) > parseFloat(document.all.TaxableAmount_3.value))
							{
							    ErrorCount++;
							    queueMessage(error_text, error_oSpan);
							}
							else
							{
							    clearQueue(error_oSpan);
							}
						</cfif>
					--->

						<!--- SHOW CONFIRMATION BOX IF ALL IS GOOD OR SHOW THE ERROR BOX --->
						<!---var answer = "0";--->
						if(ErrorCount == 0) {
							if(temp_bb_deliv_end_date > todaysDate)
							{
								var futureConfirm = confirm("The dates you have entered are in the future - please note that the validation process \n for this claim will show deviations as the performance period has not yet arrived.")
								if(futureConfirm !="0")
								{
									BBForm.submit()
									if(disableClickedButton)
									{
										disableButton(disableClickedButtonName, true, false);
									}
								}
							}
							else {
								BBForm.submit()
								if(disableClickedButton)
								{
									disableButton(disableClickedButtonName, true, false);
								}
							}
						}
						else {
							showMessageWindow()
						}
					}

				function TwoDecimalsOnBlur(oObject){
					var nf = new NumberFormat();
					nf.setNumber(oObject.value);
					nf.setCommas(false);
					nf.setCurrency(false);
					nf.setPlaces(2);
					oObject.value = nf.toFormatted();
					<!---
					<cfif appSettings.getBillbacksSalesTax() eq 1>
					document.BBForm.TotalTaxAmount.value = parseFloat(document.BBForm.TaxAmount_1.value) + parseFloat(document.BBForm.TaxAmount_2.value) + parseFloat(document.BBForm.TaxAmount_3.value);
					document.BBForm.TotalTaxAmount.value = parseFloat(document.BBForm.TotalTaxAmount.value).toFixed(2);
					</cfif>
					--->
				}
				function MatchString(s,comparedStr){
   					var r, re;         //Declare variables.
					s = s.replace(/\s*,/ig,",").replace(/,\s*/, ",");
					s = "," + s + ",";
   					re = eval("/," + trim(comparedStr) + ",/i");
					r = s.match(re);
   					return(r);
				}
				<!--- function NegativeBBChanges(thisObj,task)
				{
				 	if (task == 1)
					{
						if (thisObj.checked)
						{
							document.BBForm.BB_Closing_Method.checked = true
							document.BBForm.BB_Closing_Method.disabled = true
							/*document.BBForm.claimAmount.value = "-"+document.BBForm.claimAmount.value
							document.BBForm.claimCases.value = "-"+document.BBForm.claimCases.value
							document.BBForm.claimPounds.value = "-"+document.BBForm.claimPounds.value */
						}
						else
						{
							document.BBForm.BB_Closing_Method.disabled = false
						}
					}
					if (task == 2)
					{
						if (document.BBForm.Negative_Billback && document.BBForm.Negative_Billback.checked)
						{
							clenseText(thisObj, '-0123456789.');
						}
						else
						{
							clenseText(thisObj, '0123456789.');
						}
					}
					if (task == 3)
					{
						if (document.BBForm.Negative_Billback && document.BBForm.Negative_Billback.checked)
						{
							if (thisObj.value > 0)
							{
								alert("Negative Billback can't have positive number. Negative sign has been added to the number.")
								thisObj.value = "-"+thisObj.value
								thisObj.focus();
							}
						}
					}
				} --->
			</SCRIPT>

			<CF_MessageWindow>
