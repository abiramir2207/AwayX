    <TD><CF_EASYDATE FORMNAME="BBForm" FIELDNAME="BB_Received_Date" FORMAT="mm/dd/yyyy" DEFAULT="#FORM.BB_Received_Date#"></TD>
	<TD class="DataTitleCell"><span id="error_Postmark_Date"></span>&nbsp;Postmark Date:</TD>
	<TD><CF_EASYDATE FORMNAME="BBForm" FIELDNAME="Postmark_Date" FORMAT="mm/dd/yyyy" DEFAULT="#FORM.Postmark_Date#"></TD>
  </tr>
</table>

	</td>
   </tr>

				<TR>
					<TD class="DataTitleCell"><span id="error_BB_Start_Date"></span>&nbsp;<span id="error_BB_End_Date"></span>&nbsp;Delivery Period Start\End:</TD>
					<TD colspan="4">
						<Table width="100%">
							<TR>
							 <td><CF_EASYDATE FORMNAME="BBForm" FIELDNAME="BB_Start_Date" FORMAT="mm/dd/yyyy" DEFAULT="#FORM.BB_Start_Date#"></td>
	<TD class="DataTitleCell">to<span style="color:##ffffff">ceived Date:</span></TD>
    <TD><CF_EASYDATE FORMNAME="BBForm" FIELDNAME="BB_End_Date" FORMAT="mm/dd/yyyy" DEFAULT="#FORM.BB_End_Date#"></TD>
	<TD class="DataTitleCell" width="250"><span id=""></span>&nbsp;</TD>
	<TD class="DataTitleCell"><span id=""></span>&nbsp;</TD>

							</TR>
						</TABLE>
					</TD>
				</TR>

		<!--- D12149 Billbacks may now have negative values without this setting --->
				<!--- <CFIF appSettings.getAllow_Negative_Billback()>
					<CFSET CheckedNegBB = "">
					<CFIF FORM.Negative_Billback EQ 1>
						<CFSET CheckedNegBB = "Checked">
					</CFIF>
				<TR>
					<TD class="DataTitleCell"><span id="error_BB_Type"></span>Billback Type:</TD>
					<TD><INPUT TYPE="CheckBox" NAME="Negative_Billback" VALUE="1" ONCLICK="javascript: NegativeBBChanges(this,1)" #CheckedNegBB#> <B>Negative</B></TD>
				</TR>
				</CFIF> --->
				<TR>
					<TD class="DataTitleCell"><span id="error_clsing_method"></span>&nbsp;Closing Method</TD>

					<CFSET CheckClosingMethod = "">
					<!--- If the app setting ("billback closing method is deduction by default") is on, then the checkbox is checked by default,
								unless the user unchecks it for the billback --->
<!--- 					<CFIF FORM.BB_Closing_Method EQ 2 OR (FORM.BB_Closing_Method EQ "" AND appSettings.getBillbackClosingMethod() eq 1)>
						<CFSET CheckClosingMethod = "Checked">
					</CFIF>
 --->
          <CFSET DisableClosingMethod = "">
					<CFIF FORM.Billback_ID NEQ "" AND (LoadBillbackData.BB_Associated_To_DD EQ 1 OR (LoadBillbackData.Billback_Status_ID EQ 4 OR LoadBillbackData.Billback_Status_ID EQ 5 OR LoadBillbackData.Billback_Status_ID EQ 7) or LoadBillbackData.Scheduled_Auto_BB) >
						<CFSET DisableClosingMethod = "Disabled">
					</CFIF>
					<Cfset DisableAmt = "">
					<cfif LoadBillbackData.Scheduled_Auto_BB>
						<Cfset DisableAmt = "Disabled">
					</cfif>

					<td colspan="2">
					<table cellpadding="0" cellspacing="0" width="95%">
					<tr>
    			  <td align="left">
             <!-----------------------------------------------------------------------------
              Dev Notes: D18281 - Solo - Add new closing method on billback entry
            	All the closing method dropdown and values now come from the DB based on
              the settings in the settings panel
            -Anand Rao/29-May-09
            ------------------------------------------------------------------------------>

              <cfquery NAME="getClosingMethods" datasource="#application.datasource#">
              SELECT  iBillback_Closing_Method_ID,
                    	vchBillback_Closing_Method_Desc,
                    	bEnabled,
                  	  tiAutoPay_BB_Status,
                  	  Deleted,
                  	  Abbreviation,
					  bDefault
              FROM  Billback_Closing_Methods WHERE Deleted = 0
              AND bEnabled = 1
              ORDER BY vchBillback_Closing_Method_Desc
              </cfquery>


			<!---Dev Notes: D20806 - Changed how default closing method works based on the default value set in the settings panel--->
			<cfloop query="getClosingMethods">
				<cfset setCheckedFlag = "" />
				<!---
				<cfif (getClosingMethods.iBillback_Closing_Method_ID EQ 2)>
			  		<cfif (FORM.BB_Closing_Method EQ 2 OR (FORM.BB_Closing_Method EQ "" AND appSettings.getBillbackClosingMethod() eq 1))>
						<cfset setCheckedFlag = "checked" />
			  		</cfif>
				<cfelseif (FORM.BB_Closing_Method EQ getClosingMethods.iBillback_Closing_Method_ID)>
			  		<cfset setCheckedFlag = "checked" />
				</cfif>
				--->
				<cfif FORM.BB_Closing_Method EQ getClosingMethods.iBillback_Closing_Method_ID>
					<cfset setCheckedFlag = "checked" />
				<cfelseif getClosingMethods.bDefault eq 1 AND len(trim(FORM.BB_Closing_Method)) EQ 0> <!--- before it was showing the default without checking to see if something had been picked --->
			  		<cfset setCheckedFlag = "checked" />
				</cfif>
				<input type="radio" name="BB_Closing_Method" value="#getClosingMethods.iBillback_Closing_Method_ID#" #setCheckedFlag# #DisableClosingMethod#><b>#getClosingMethods.vchBillback_Closing_Method_Desc#</b>
			</cfloop>
          <!--- input type="radio" name="BB_Closing_Method" value="1" <cfif FORM.BB_Closing_Method eq 1>checked</cfif> #DisableClosingMethod#><B>Payment</B>
          <input type="radio" name="BB_Closing_Method" value="2" <cfif FORM.BB_Closing_Method EQ 2 OR (FORM.BB_Closing_Method EQ "" AND appSettings.getBillbackClosingMethod() eq 1)>checked</cfif> #DisableClosingMethod#><B>Deduction</B>
					<CFIF appSettings.getBB_Allow_Off_Invoice_Closing_Method()>
					<input type="radio" name="BB_Closing_Method" value="3" <cfif FORM.BB_Closing_Method eq 3>checked</cfif> #DisableClosingMethod#><B>Off Invoice</B>
					</CFIF>
					<input type="radio" name="BB_Closing_Method" value="4" <cfif FORM.BB_Closing_Method eq 4>checked</cfif> #DisableClosingMethod#><B>Adjustment</B --->
            <!--- 18281 End  --->

					<!---  <INPUT TYPE="CheckBox" NAME="BB_Closing_Method" VALUE="2" #CheckClosingMethod# #DisableClosingMethod# /> <B>Deduction</B> --->
					  </td>
							<!---claim mechanic only works with one program per billback--->
			<!--- 33297 - Display payment dropdown only when not calling from copy billback --->
			<cfset copiedClaim = ( cgi.http_referer contains "copiedclaim" )>
			<cfif appsettings.getOneProgramPerBillback() IS 1 AND appsettings.getClaimMech_Popup() IS 2 AND len(trim(form.Billback_ID)) GT 0 AND not copiedClaim>

				<cfquery name="ProgramForBillback" datasource="#application.datasource#">
					SELECT Contract_Main.ClaimMechanics AS Program_Payment, Payment_Type.Payment_Type_ID, Payment_Type.Payment_Type_Name
					FROM Billback_Program
						INNER JOIN Contract_Main
						ON Billback_Program.Program_ID = Contract_Main.Contract_Main_ID
						INNER JOIN Program_Control_Panel_Options
						ON Program_Control_Panel_Options.ProgramControl_Panel_Options_ID = Contract_Main.ProgramType_ID
						INNER JOIN Payment_Template_Mapping
						ON Payment_Template_Mapping.Template_ID = Program_Control_Panel_Options.ProgramControl_Panel_Options_ID
						INNER JOIN Payment_Type
						ON Payment_Type.Payment_Type_ID = Payment_Template_Mapping.Payment_Type_ID
					WHERE Billback_Program.Billback_ID = '#form.Billback_ID#'
					ORDER BY Payment_Type.Payment_Type_Name
				</cfquery>

				<cfif ProgramForBillback.Recordcount GT 0>
				<!--- BJF: claim mechanic only available when program has been added---->
					<TD class="DataTitleCell" valign="bottom" width="150">Payment Method &nbsp;</TD>


					<TD colspan="4" valign="top">
						<cfif ProgramForBillback.Recordcount IS 1>
							<input type="hidden" name="claim_mechanics" value="#ProgramForBillback.Payment_Type_ID#">
							<span style="width:105px;">#ProgramForBillback.Payment_Type_Name#</span>
						<!---They need to make a selection --->
						<cfelse>
							<select name="ClaimMechanics">
								<cfloop query="ProgramForBillback">
									<option value="#ProgramForBillback.Payment_Type_ID#" <cfif len(trim(form.ClaimMechanics)) GT 0><cfif ProgramForBillback.Payment_Type_ID IS form.ClaimMechanics> selected</cfif><Cfelse><cfif ProgramForBillback.Payment_Type_ID IS ProgramForBillback.Program_Payment> selected</cfif></cfif>  >#ProgramForBillback.Payment_Type_Name#</option>
								</cfloop>
							</select>
						<!---Default it if only one --->
						</cfif>
					</TD>
				<!---  at least one record returned--->
				</cfif>

			<!---app settings---->
			</cfif>
				<!---BJF: end claim mechanic---->
                     </tr>
                    </table>
				   </td>

				</tr>
				<TR>
					<TD class="DataTitleCell">&nbsp;

					</TD>
					<TD>
						<!---TSF: Label 9231 - Added table to display the new layout for amounts and volume--->
						<TABLE border="1" cellpadding="1" cellspacing="3" class="borderNone" style="border:none">
							<TR>
								<td>&nbsp;</td>
								<td>&nbsp;</td>
								<TD><b>$ Amount</b></TD>
								<TD><b>Cases</b></TD>
								<TD><b>Pounds</b></TD>
							</TR>
							<TR>
								<td>
									<b>Claims Summary</b>
								</td>
								<td>$</td>
								<TD style="border:1px solid ##CCCCCC">
									<span id="claimAmountErrorSpan"></span>
									<cfif LoadBillbackData.Scheduled_Auto_BB or bDisableLinks>
										<SPAN id="claimAmountSpan">#numberformat(form.claimAmount, ',.__')#</SPAN>
										<input name="claimAmount" type="hidden" value="#form.claimAmount#">
									<cfelse>
										<input type="text" name="claimAmount" size="10" value="#numberformat(form.claimAmount, '_.__')#" class="money" onBlur="TwoDecimalsOnBlur(this); adjustVariance();"
										<cfif bDisableLinks EQ 1>disabled</cfif> />
									</cfif>
								</TD>
								<TD style="border:1px solid ##CCCCCC">
									<cfif LoadBillbackData.Scheduled_Auto_BB or bDisableLinks>
										<SPAN id="claimCasesSpan">#numberformat(form.claimCases, ',.__')#</SPAN>
										<input name="claimCases" type="hidden" value="#form.claimCases#">
									<cfelse>
										<input type="text" name="claimCases" size="10" value="#numberformat(form.claimCases, '_.__')#" class="money" onBlur="TwoDecimalsOnBlur(this); adjustVariance();" <cfif bDisableLinks EQ 1>disabled</cfif> />
									</cfif>
								</TD>
								<TD style="border:1px solid ##CCCCCC">
									<cfif LoadBillbackData.Scheduled_Auto_BB or bDisableLinks>
										<SPAN id="claimPoundsSpan">#trim(numberformat(form.claimPounds, ',.__'))#</SPAN>
										<input name="claimPounds" type="hidden" value="#form.claimPounds#">
									<cfelse>
										<input type="text" name="claimPounds" size="10" value="#numberformat(form.claimPounds, '_.__')#" class="money" onBlur="TwoDecimalsOnBlur(this); adjustVariance();" <cfif bDisableLinks EQ 1>disabled</cfif> />
									</cfif>
								</TD>
							</TR>
							<TR>
								<td>
									<b>Itemized Total</b>
								</td>
								<td>$</td>
								<TD style="border:1px solid ##CCCCCC">
									<SPAN id="itemizedAmountSpan">#numberFormat(variables.itemizedAmount, '_.__')#</SPAN>
									<input name="itemizedAmount" type="hidden" value="#numberFormat(variables.itemizedAmount, '_.__')#" />
								</TD>
								<TD style="border:1px solid ##CCCCCC">
									<SPAN id="itemizedCasesSpan">#numberformat(variables.itemizedCases, ',.__')#</SPAN>
									<input name="itemizedCases" type="hidden" value="#numberFormat(variables.itemizedCases, '_.__')#" />
								</TD>
								<TD style="border:1px solid ##CCCCCC">
									<SPAN id="itemizedPoundsSpan">#numberformat(variables.itemizedPounds, ',.__')#</SPAN>
									<input name="itemizedPounds" type="hidden" value="#numberFormat(variables.itemizedPounds, '_.__')#" />
								</TD>
							</TR>
							<TR>
								<td>
									<b>Variation</b>
								</td>
								<td>$</td>
								<TD style="border:1px solid ##CCCCCC">
									<SPAN id="variationAmountSpan">
										<!---if the value is negative then change the display format--->
										<cfif variables.variationAmount lt 0>
											<span style="color:##FF0000">( #numberFormat(variables.variationAmount, ',.__')# )</span>
										<cfelse>
											#numberFormat(variables.variationAmount, ',.__')#
										</cfif>
									</SPAN>
								</TD>
								<TD style="border:1px solid ##CCCCCC">
									<SPAN id="variationCaseSpan">
										<!---if the value is negative then change the display format--->
										<cfif variables.variationCases lt 0>
											<span style="color:##FF0000">( #numberFormat(variables.variationCases, ',.__')# )</span>
										<cfelse>
											#numberFormat(variables.variationCases, ',.__')#
										</cfif>
									</SPAN>
								</TD>
								<TD style="border:1px solid ##CCCCCC">
									<SPAN id="variationPoundSpan">
										<!---if the value is negative then change the display format--->
										<cfif variables.variationPounds lt 0>
											<span style="color:##FF0000">( #numberFormat(variables.variationPounds, ',.__')# )</span>
										<cfelse>
											#numberFormat(variables.variationPounds, ',.__')#
										</cfif>
									</SPAN>
								</TD>
							</TR>
						</TABLE>
					<TD>
				</TR>

