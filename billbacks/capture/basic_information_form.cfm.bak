				<CFSET Ref2MaxLength = appSettings.getBB_2Ref_Num_Max_Length()>
				<CFSET FORM.referenceNum = LEFT(FORM.referenceNum,Ref2MaxLength)>
  <tr>
<TD class="DataTitleCell"><span id="error_BB_Reference"></span>&nbsp;Billback Number:</TD>
	<TD><input name="BB_Reference" type="Text" value="#FORM.BB_Reference#" size="64" maxlength="#RefMaxLength#"></TD>
