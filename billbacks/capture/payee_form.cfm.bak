	<TR>
		<TD <CFIF FORM.Vendor_ID EQ ""> STYLE="DISPLAY:NONE;"<CFELSE> STYLE="DISPLAY:BLOCK"</CFIF> id="vendorTable">	
			<CFIF len(trim(FORM.Vendor_ID)) GT 0>
				<cfquery name="getVendorInfo" datasource="#Application.Datasource#">
					SELECT 	Vendor_Name as vendorName,
							Vendor_Master.Address_1 as vendorAddress1,
							Vendor_Master.Address_2 as vendorAddress2,	
							Vendor_Master.City as vendorCity,
							Vendor_Master.State as vendorState,
							Vendor_Master.Zipcode as vendorZipCode
				 	FROM 	Vendor_Master 
					WHERE 	Vendor_ID = '#FORM.Vendor_ID#' AND 
							Deleted = 0 AND 
							Active_Code = 'A'
				</cfquery>
			</CFIF>

			<TABLE border="0" cellspacing="0" cellpadding="3" align="center" WIDTH="100%" CLASS="Maintable">
				<TR ID="header" BGCOLOR="#ffce84">
					<TD align="left" ID="header"><B>Vendor #</TD>
					<TD ID="header"><B>Name</B></TD>
					<TD ID="header"><B>Address</B></TD>					
				</TR>

			
			<CFIF len(trim(FORM.Vendor_ID)) eq 0>
			  <tr id="noVendor">
				 <cfoutput><td colspan="100%" align="center"><span class="NoItemsFromSearchSelected">No vendor Selected</span></TD></cfoutput>
			  </tr>
			  <tr style="cursor:pointer;">
			   <td id="vendorid" nowrap></td>
			   <td id="vendorname" nowrap></td>
			   <td id="vendoraddress" nowrap></td>
	 		  </tr>
	 		  <cfelse>
				<CFOUTPUT QUERY="getVendorInfo">
				<cfset vendorAddr = "" >
				<CFIF vendorAddress1 NEQ ""><cfset vendorAddr =  vendorAddress1 & "<BR>"></CFIF>
				<CFIF vendorAddress2 NEQ ""><cfset vendorAddr =  vendorAddr & vendorAddress2 & "<BR>" ></CFIF>
				<CFIF vendorCity NEQ ""><cfset vendorAddr =  vendorAddr & vendorCity ></CFIF>
				<CFIF vendorState NEQ ""><cfset vendorAddr =  vendorAddr & "," & vendorState ></CFIF>
				<CFIF vendorZipCode NEQ ""><cfset vendorAddr =  vendorAddr & " " & vendorZipCode></CFIF>	

					<TR>
						<TD id="vendorid" NOWRAP>#Vendor_ID#</TD>
						<TD id="vendorname">#vendorName#</TD>
						<TD id="vendoraddress">#vendorAddr#&nbsp;</TD>
	 				</TR>
				</CFOUTPUT>		
			</CFIF>
			</TABLE>
		</TD>
	</TR>
	</CFIF>
	
	
	
