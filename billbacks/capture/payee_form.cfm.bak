		color:red;
	}
	
	.FormHeaderLabel {
		font-weight: bold;
		font-size: 12px;
		height: 30px;
		/*display: none;*/
	}
	
	.DataTitleCell {
		text-align : right;
		font-weight : bold;
		vertical-align : top;
	}
	
</style>

<form action="payee_form.cfm?BBID=#FORM.Billback_ID#" method="post" name="BB_Payee_Form" id="BB_Payee_Form">
<TABLE align="center" border="0" width="95%">
	<TR valign="bottom">
		<TD id="BB_Payee_Type_Data_1_Unknown" class="FormHeaderLabel" align="center"<CFIF DIST_UNKNOWN_SHOW NEQ 1> STYLE="DISPLAY:NONE;"<CFELSE> STYLE="DISPLAY:BLOCK"</CFIF>>
			<CFIF Not Scheduled_Auto_BB>Enter the available <cfoutput>#lcase(application.returned_customer_setting.distributor_label_singular)#</cfoutput> information:</CFIF>
		</TD>
		<TD id="BB_Payee_Type_Data_2_Unknown" align="center" class="FormHeaderLabel"<CFIF OP_UNKNOWN_SHOW NEQ 1> STYLE="DISPLAY:NONE;"<CFELSE> STYLE="DISPLAY:BLOCK"</CFIF>>
			<CFIF Not Scheduled_Auto_BB>Enter the available <cfoutput>#lcase(application.returned_customer_setting.operator_label_singular)#</cfoutput> information:</CFIF>
		</TD>
		<TD id="BB_Payee_Type_Data_3_Unknown" align="center" class="FormHeaderLabel"<CFIF BROKER_UNKNOWN_SHOW NEQ 1> STYLE="DISPLAY:NONE;"<CFELSE> STYLE="DISPLAY:BLOCK"</CFIF>>
			<CFIF Not Scheduled_Auto_BB>Enter the available <cfoutput>#lcase(application.returned_customer_setting.broker_label_singular)#</cfoutput> information:</CFIF>
		</TD>		
		<TD id="BB_Payee_Type_Data_4" align="center" class="FormHeaderLabel"<CFIF OTHER_SHOW NEQ 1> STYLE="DISPLAY:NONE;"<CFELSE> STYLE="DISPLAY:BLOCK"</CFIF>>
			<CFIF Not Scheduled_Auto_BB>Enter the available payee information below:</CFIF>
		</TD>
		<TD id="BB_Payee_Type_Data_4_Unknown" align="center" class="FormHeaderLabel" STYLE="DISPLAY:NONE;">
			<CFIF Not Scheduled_Auto_BB>other unknown</CFIF>
		</TD>
	</TR>
	<TR>
		<TD id="BB_Payee_Type_Data_1_Form"<CFIF DIST_SHOW NEQ 1> STYLE="DISPLAY:NONE;"<CFELSE> STYLE="DISPLAY:BLOCK"</CFIF>><!--- Distributor in our database --->
		<!---<cfset appSettings = application.oApplicationAppSettingsManager.getApplicationAppSettings() />--->
			<CFSET getDistributorInformation = QueryNew('BSA_Foodservice_Customers_ID')>
			<CFIF len(trim(Form.Distributor_ID)) GT 0>
				<cfquery name="getDistributorInformation" datasource="#Application.Datasource#">
					SELECT     dbo.BSA_Foodservice_Customers.BSA_Foodservice_Customers_ID, dbo.BSA_Foodservice_Customers.Name, 
					                      dbo.BSA_Foodservice_Customers.Ship_To, dbo.BSA_Foodservice_Customers.Address_1, dbo.BSA_Foodservice_Customers.City, 
					                      dbo.BSA_Foodservice_Customers.State, dbo.BSA_Foodservice_Customers.ZipCode,  BSA_Foodservice_Customers.Country_Code,
										  <cfif NOT variables.appSettings.getDistributorMultiPosition()>
					                      dbo.BSA_Foodservice_Customers.BSA_Foodservice_Brokers_ID, dbo.BSA_Foodservice_Brokers.Broker_Name, 
										  </cfif>
					                      dbo.Distributor_Family.Family_Name, dbo.Distributor_Buying_Groups.Buying_Group_Name, dbo.BSA_Foodservice_Customers.Shr_Ship_To
					FROM	dbo.BSA_Foodservice_Customers 
							<cfif NOT variables.appSettings.getDistributorMultiPosition()>
							LEFT JOIN	dbo.BSA_Foodservice_Brokers ON 
							dbo.BSA_Foodservice_Customers.BSA_Foodservice_Brokers_ID = dbo.BSA_Foodservice_Brokers.BSA_Foodservice_Brokers_ID 
							</cfif>
							INNER JOIN dbo.Distributor_Family ON dbo.BSA_Foodservice_Customers.Family_ID = dbo.Distributor_Family.Family_ID 
							INNER JOIN dbo.Distributor_Buying_Groups ON dbo.BSA_Foodservice_Customers.Buying_Group_ID = dbo.Distributor_Buying_Groups.Buying_Group_ID
					WHERE BSA_Foodservice_Customers_ID = '#FORM.Distributor_ID#'
				</cfquery>
			</CFIF>
            <!--- Ajax Distributor Code --->
			<TABLE border="0" cellspacing="0" cellpadding="3" align="center" WIDTH="100%" CLASS="Maintable">
				
<!--- 				<tr>
				 <td valgin="bottom" id="BB_Payee_Type_Data_1" align="center" class="FormHeaderLabel"<CFIF DIST_SHOW NEQ 1> STYLE="DISPLAY:NONE;"<CFELSE> STYLE="DISPLAY:BLOCK"</CFIF>>
			       <span id="error_distributor_select"></span><CFIF Scheduled_Auto_BB><cfoutput>Rebate Recipient<!--- #lcase(application.returned_customer_setting.distributor_label_singular)# payee ---></cfoutput><CFELSE>&nbsp;<a onClick="searchData('di')" style="cursor: pointer;"><!--- Click here to search for a  ---><cfoutput>#lcase(application.returned_customer_setting.distributor_label_singular)#</cfoutput> payee search</a></CFIF>
		         </td>
				</tr> --->
				
				<!--- D25341 Using a table to format below span
				<span id="BB_Payee_Type_Data_1" style="padding:none;top:0;display:<cfif DIST_SHOW neq 1>none;<cfelse>block;</cfif>">
				 <span id="custIdTxt" style="color:blue;">Search By Id: <input type="text" name="custId" id="custId" style="font-size:9px;border:1px solid blue;" onChange="getCustomerPayee(this.value)"  /></span>
				 <span style="margin-left: 520px;"><span id="error_distributor_select"></span><CFIF Scheduled_Auto_BB><cfoutput>Rebate Recipient<!--- #lcase(application.returned_customer_setting.distributor_label_singular)# payee ---></cfoutput><CFELSE>&nbsp;<a onClick="searchData('di')" style="cursor: pointer;">payee search<img src="/images/arrow_link.gif" style="vertical-align:bottom;" /></a></span></CFIF>
				</span>
				--->
				<tr  style="border-bottom:0px;">
					<td width="100%" colspan="100%" style="border-bottom:0px;">
						<span id="BB_Payee_Type_Data_1" style="padding:none;top:0;display:<cfif DIST_SHOW neq 1>none;<cfelse>block;</cfif>">
						<table border="0" width="100%" cellpadding="0" cellspacing="0">
							<tr>
							<td style="border-bottom:0px;" width="5%" nowrap="nowrap" valign="top">
								<span id="custIdTxt" style="color:blue; font-size : 8pt;"> Search By Id: </td><td style="border-bottom:0px;"><input type="text" size="26" name="custId" id="custId" style="font-size:9px;border:1px solid blue;" onChange="getCustomerPayee(this.value)"  /><br>(Type Id and click tab key)</span></td>
							<td style="border-bottom:0px; font-size : 8pt;" align="right" nowrap="nowrap" valign="bottom" >
								<span id="error_distributor_select"></span><CFIF Scheduled_Auto_BB><cfoutput>Rebate Recipient<!--- #lcase(application.returned_customer_setting.distributor_label_singular)# payee ---></cfoutput><CFELSE>&nbsp;<a onClick="searchData('di')" style="cursor: pointer;">payee search<img src="/images/arrow_link.gif" style="vertical-align:bottom;" /></a></CFIF>&nbsp;&nbsp;&nbsp;
							</td>
							</tr>
						</table>
						</span>
					</td>
				</tr>

				<tr><td style="border:1px solid #fff;">&nbsp;</td></tr>
				<TR ID="header" BGCOLOR="#ffce84">

					<TD align="left" ID="header"><B>Name / <cfoutput>#application.returned_customer_setting.shard_ship_to_label#</cfoutput></B></TD>
					<TD ID="header"><B>Address</B></TD>
					<cfif NOT variables.appSettings.getDistributorMultiPosition()>
					<cfoutput><TD ID="header"><B>#application.returned_customer_setting.broker_label_singular#</B></TD></cfoutput>
					</cfif>
					<cfoutput><TD ID="header"><B>#application.returned_customer_setting.family_name_label_singular# / #application.returned_customer_setting.buying_group_label_singular#</B></TD></cfoutput>
				</TR>

			<cfif getDistributorInformation.recordcount eq 0>
			<tr id="noCustSelected">
			  <cfoutput><td colspan="100%" align="center"><span class="NoItemsFromSearchSelected">No #application.returned_customer_setting.distributor_label_singular# Selected</span></td></cfoutput>
			</tr>
			<tr style="cursor:pointer;">
						<td NOWRAP id="distName"></td>
						<td id="distAddrInfo"></td>
						<cfif NOT variables.appSettings.getDistributorMultiPosition()>
						<td id="distBrokerName"></td>
						</cfif>
						<td NOWRAP id="distFamName"></td>
	 				</tr>
				<cfelse>
				<cfoutput query="getDistributorInformation">
					<tr style="cursor:pointer;">
						<td onClick="NewWindow('/profiles/Distributors/Distributor_profile.cfm?DID=#getDistributorInformation.BSA_Foodservice_Customers_ID#','name','400','450','Yes', 'No');return false;" NOWRAP id="distName">#getDistributorInformation.Name#<BR>
						<cfif trim(len(getDistributorInformation.Shr_Ship_To)) neq 0>#getDistributorInformation.Shr_Ship_To#<cfelse>#getDistributorInformation.Ship_To#</cfif>&nbsp;</TD>
						<td onClick="NewWindow('/profiles/Distributors/Distributor_profile.cfm?DID=#getDistributorInformation.BSA_Foodservice_Customers_ID#','name','400','450','Yes', 'No');return false;" id="distAddrInfo">#getDistributorInformation.Address_1#<BR>#getDistributorInformation.City#,#getDistributorInformation.State# #getDistributorInformation.ZipCode#&nbsp;#getDistributorInformation.Country_Code#</TD>
						<cfif NOT variables.appSettings.getDistributorMultiPosition()>
						<TD onClick="NewWindow('/profiles/Distributors/Distributor_profile.cfm?DID=#getDistributorInformation.BSA_Foodservice_Customers_ID#','name','400','450','Yes', 'No');return false;" id="distBrokerName">#getDistributorInformation.Broker_Name#&nbsp;</TD>
						</cfif>
						<TD onClick="NewWindow('/profiles/Distributors/Distributor_profile.cfm?DID=#getDistributorInformation.BSA_Foodservice_Customers_ID#','name','400','450','Yes', 'No');return false;" NOWRAP id="distFamName">#getDistributorInformation.Family_Name#<BR>#getDistributorInformation.Buying_Group_Name#&nbsp;</TD>
	 				</tr>
				</cfoutput>
		       </cfif>
<CFOUTPUT>
			</TABLE>
			<!--- Multi customer stuff ditributor List for Auto BB's  **** Need to update this when the multi BB users turn on Auto BB  ****--->
			<cfif (Scheduled_Auto_BB) and len(trim(Form.Distributor_ID)) GT 0> <!--- or appSettings.getMultiDistributorBB() --->
			<TABLE border="0" cellspacing="0" cellpadding="3" align="center" WIDTH="100%" CLASS="Maintable">
			<TR>
					<TD colspan="5" align="center" class="FormHeaderLabel">
						<CFIF Not Scheduled_Auto_BB>
							<a onClick="searchData('diMulti')" style="cursor: pointer;"><span style="font-size: 13px; font-weight:bold;">
								include multiple <cfoutput>#lcase(application.returned_customer_setting.Shard_Ship_To_Label)#'s</cfoutput></span>
							</a>
						<CFELSE>
							<span style="font-size: 13px; font-weight:bold;">
								<cfoutput>additional #lcase(application.returned_customer_setting.Shard_Ship_To_Label)#'s</cfoutput>
							</span>
						</CFIF>
					</TD>
				</TR>
				<TR ID="header" BGCOLOR="##ffce84">
					<TD align="left" ID="header" colspan="2"><B>Name / <cfoutput>#application.returned_customer_setting.shard_ship_to_label#</cfoutput></B></TD>
					<TD ID="header"><B>Address</B></TD>
					<cfif NOT variables.appSettings.getDistributorMultiPosition()>
					<cfoutput><TD ID="header"><B>#application.returned_customer_setting.broker_label_singular#</B></TD></cfoutput>
					</cfif>
					<cfoutput><TD ID="header"><B>#application.returned_customer_setting.family_name_label_singular# / #application.returned_customer_setting.buying_group_label_singular#</B></TD></cfoutput>
				</TR>
				<CFSET x = 0>
				<CFLOOP list="#form.multiDistList#" index="Dist">
					<cfif Dist neq FORM.Distributor_ID>
						<cfquery name="qGetDistListInfo" datasource="#Application.Datasource#">
								SELECT     dbo.BSA_Foodservice_Customers.BSA_Foodservice_Customers_ID, dbo.BSA_Foodservice_Customers.Name, 
													  dbo.BSA_Foodservice_Customers.Ship_To, dbo.BSA_Foodservice_Customers.Address_1, dbo.BSA_Foodservice_Customers.City, 
													  dbo.BSA_Foodservice_Customers.State, dbo.BSA_Foodservice_Customers.ZipCode,  BSA_Foodservice_Customers.Country_Code,
													  <cfif NOT variables.appSettings.getDistributorMultiPosition()>
													  dbo.BSA_Foodservice_Customers.BSA_Foodservice_Brokers_ID, dbo.BSA_Foodservice_Brokers.Broker_Name, 
													  </cfif>
													  dbo.Distributor_Family.Family_Name, dbo.Distributor_Buying_Groups.Buying_Group_Name, dbo.BSA_Foodservice_Customers.Shr_Ship_To
								FROM	dbo.BSA_Foodservice_Customers 
										<cfif NOT variables.appSettings.getDistributorMultiPosition()>
										INNER JOIN	dbo.BSA_Foodservice_Brokers ON 
										dbo.BSA_Foodservice_Customers.BSA_Foodservice_Brokers_ID = dbo.BSA_Foodservice_Brokers.BSA_Foodservice_Brokers_ID 
										</cfif>
										INNER JOIN dbo.Distributor_Family ON dbo.BSA_Foodservice_Customers.Family_ID = dbo.Distributor_Family.Family_ID 
										INNER JOIN dbo.Distributor_Buying_Groups ON dbo.BSA_Foodservice_Customers.Buying_Group_ID = dbo.Distributor_Buying_Groups.Buying_Group_ID
								WHERE BSA_Foodservice_Customers_ID = '#Dist#'
							</cfquery>
								<cfif Evaluate(x mod 2) eq 0>
			  						<cfset tmpBgColor = "FFFFFF" />
			 					<cfelse>
									<cfset tmpBgColor = "EAFFEA" />
								</cfif>
								<TR id="custRow_#x#" STYLE="cursor:pointer;" bgcolor="#tmpBgColor#">
									<TD><img bDelete="true" name="IMG_Delete_Scissor"  src="/images/scissor.gif" title="click here to delete this customer" border="0" onClick="deleteThisCust('#Dist#', '#tmpBgColor#')" style="cursor: pointer;">&nbsp;</TD>
									<TD onClick="NewWindow('/profiles/Distributors/Distributor_profile.cfm?DID=#Dist#','name','400','450','Yes', 'No');return false;" NOWRAP>#qGetDistListInfo.Name#<BR>
									<cfif trim(len(qGetDistListInfo.Shr_Ship_To)) neq 0>#qGetDistListInfo.Shr_Ship_To#<cfelse>#qGetDistListInfo.Ship_To#</cfif>&nbsp;</TD>
									<TD onClick="NewWindow('/profiles/Distributors/Distributor_profile.cfm?DID=#Dist#','name','400','450','Yes', 'No');return false;">#qGetDistListInfo.Address_1#<BR>#qGetDistListInfo.City#,#qGetDistListInfo.State# #qGetDistListInfo.ZipCode#&nbsp;#qGetDistListInfo.Country_Code#</TD>
									<cfif NOT variables.appSettings.getDistributorMultiPosition()>
									<TD onClick="NewWindow('/profiles/Distributors/Distributor_profile.cfm?DID=#Dist#','name','400','450','Yes', 'No');return false;" >#qGetDistListInfo.Broker_Name#&nbsp;</TD>
									</cfif>
									<TD onClick="NewWindow('/profiles/Distributors/Distributor_profile.cfm?DID=#Dist#','name','400','450','Yes', 'No');return false;" NOWRAP>#qGetDistListInfo.Family_Name#<BR>#qGetDistListInfo.Buying_Group_Name#&nbsp;</TD>
								</TR>
								<CFSET x = x + 1>
						</cfif>
				</CFLOOP>
			</TABLE>
			</cfif>
			<!--- End Multi customer stuff --->
			<!--- <table align="center">
				<TR>
					<TD>
						<span style="color: gray; font-size: 13px; font-weight:bold;">additional notes:</span><span id="distributor_notes_error"></span>
						<textarea cols="64" rows="3" name="Distributor_Notes">#FORM.Distributor_Notes#</textarea>
					</TD>
				</TR>
			</table> --->
			<input type="hidden" name="Distributor_Notes" value="#form.Distributor_Notes#">
			
		</TD>

		<TD id="BB_Payee_Type_Data_1_Unknown_Form"<CFIF DIST_UNKNOWN_SHOW NEQ 1> STYLE="DISPLAY:NONE;"<CFELSE> STYLE="DISPLAY:BLOCK"</CFIF>><!--- Unknown Distributor Information --->
			<table border="0" cellspacing="2" cellpadding="1" align="center">
				<TR>
					<TD class="DataTitleCell"><span id="unknown_distributor_name_error"></span>&nbsp;Name:</TD>
					<TD rowspan="100%" bgcolor="0000ff"><img src="/images/fill.gif" alt="" width="1" height="1" border="0"></TD>
					<TD><input type="text" name="Unknown_Distributor_Name" id="Unknown_Distributor_Name" size="50" maxlength="50" value="#FORM.Unknown_Distributor_Name#"></TD>
				</TR>
				<TR>
					<TD class="DataTitleCell"><span id="unknown_distributor_address_error"></span>&nbsp;Address 1:</TD>
					<TD><input type="text" name="Unknown_Distributor_Address_1" id="Unknown_Distributor_Address_1" size="50" maxlength="50" value="#FORM.Unknown_Distributor_Address_1#"></TD>
				</TR>
				<TR>
					<TD class="DataTitleCell">Address 2:</TD>
					<TD><input type="text" name="Unknown_Distributor_Address_2" id="Unknown_Distributor_Address_2" size="50" maxlength="50" value="#FORM.Unknown_Distributor_Address_2#"></TD>
				</TR>
				<TR>
					<TD class="DataTitleCell"><span id="unknown_distributor_city_error"></span>&nbsp;<span id="unknown_distributor_state_error"></span>&nbsp;<span id="unknown_distributor_zip_error"></span>&nbsp;City\State\Postal:</TD>
					<TD><input type="text" name="Unknown_Distributor_City" id="Unknown_Distributor_City" value="#FORM.Unknown_Distributor_City#" maxlength="50">
						&nbsp;

</CFOUTPUT>						
						<SELECT NAME="Unknown_Distributor_State" STYLE="<!--- width:	200px;  --->font-size: 10px;">
							<OPTION VALUE="0" <CFIF FORM.Unknown_Distributor_State EQ 0>selected</CFIF>>Select State</OPTION>
							<CFOUTPUT QUERY="Get_States">
								<OPTION VALUE="#State_ID#" <CFIF FORM.Unknown_Distributor_State EQ Get_States.State_ID>selected</CFIF>>#State_Code#</OPTION>
							</CFOUTPUT>
						</SELECT>
						&nbsp;
<CFOUTPUT>
						<input type="text" name="Unknown_Distributor_Zip" id="Unknown_Distributor_Zip" size="4" maxlength="10"  value="#FORM.Unknown_Distributor_Zip#" ></TD>  <!--- onkeyup="clenseText(this, '0123456789')" --->
				</TR>
				<TR>
					<TD class="DataTitleCell"><span id="unknown_distributor_Country_error"></span>&nbsp;Country:</TD>
				    <TD VALIGN="top"> 
							<CFOUTPUT>
								<SELECT NAME="Unknown_Distributor_Country_Code" id="Unknown_Distributor_Country_Code"><OPTION VALUE="" SELECTED></OPTION><CFLOOP QUERY="getCountry"><OPTION VALUE="#getCountry.Country_Code#"<cfif getCountry.Country_Code eq form.Unknown_Distributor_Country_Code> selected </cfif>>#getCountry.Country_Name#</OPTION></CFLOOP></SELECT>&nbsp;  
							</CFOUTPUT>
				    </TD>
				</TR>
			</table>
			
			<BR>
			<table align="center">
				<TR>
					<TD>
						<HR>
						<span style="color: gray; font-size: 13px; font-weight:bold;">additional notes:</span>&nbsp;<span id="unknown_distributor_notes_error"></span><BR>
						<textarea cols="64" rows="3" name="Unknown_Distributor_Notes">#FORM.Unknown_Distributor_Notes#</textarea>
					</TD>
				</TR>
			</table>	
		</TD>

</CFOUTPUT>		
		<TD id="BB_Payee_Type_Data_2_Form"<CFIF OP_SHOW NEQ 1> STYLE="DISPLAY:NONE;"<CFELSE> STYLE="DISPLAY:BLOCK"</CFIF>><!--- Operator in our database --->
			<CFSET getOperatorInformation = QueryNew('BSA_Operator_ID')>
			<CFIF len(trim(Form.operator_id)) GT 0>
				<cfquery name="getOperatorInformation" datasource="#Application.Datasource#">
					SELECT	BSA_Operator_ID, operator_name, Operator_Location_Type, Operator_City, Operator_State, Operator_Number_Of_Locations, Operator_DBA, legacy_id
					FROM 	BSA_Operator
					WHERE 	BSA_Operator_ID = '#FORM.Operator_ID#'
				</cfquery> 
			</CFIF>
            <!--- Ajax Operator Info --->
			<TABLE border="0" cellspacing="0" cellpadding="3" align="center" WIDTH="100%" CLASS="Maintable">
				<!--- D25341 Using a table to format below span
				<span id="BB_Payee_Type_Data_2" style="padding:none;top:0;display:<cfif OP_SHOW neq 1>none;<cfelse>block;</cfif>">
				<span id="operatorIdTxt" style="color:blue;">Search By Id: <input type="text" name="oprId" id="oprId" style="font-size:9px;border:1px solid blue;" onChange="getOperatorPayee(this.value)" /></span>
				<span style="margin-left: 520px;"><span id="error_operator_select"></span><CFIF Scheduled_Auto_BB><cfoutput>#lcase(application.returned_customer_setting.operator_label_singular)# payee</cfoutput><CFELSE>&nbsp;<a onClick="searchData('op')" style="cursor: pointer;">payee search<img src="/images/arrow_link.gif" style="vertical-align:bottom;" /></a></CFIF></span>
				</span>
				--->
				<tr  style="border-bottom:0px;">
					<td width="100%" colspan="100%" style="border-bottom:0px;">
						<span id="BB_Payee_Type_Data_2" style="padding:none;top:0;display:<cfif OP_SHOW neq 1>none;<cfelse>block;</cfif>">
						<table border="0" width="100%" cellpadding="0" cellspacing="0">				
						<tr>
						<td style="border-bottom:0px;" width="5%" nowrap="nowrap" valign="top">
							<span id="operatorIdTxt" style="color:blue; font-size : 8pt;">Search By Id:</td><td style="border-bottom:0px;"> <input type="text" size="26" name="oprId" id="oprId" style="font-size:9px;border:1px solid blue;" onChange="getOperatorPayee(this.value)" /><br>(Type Id and click tab key)</span></td>
						<td style="border-bottom:0px; font-size : 8pt;" align="right" nowrap="nowrap" valign="bottom" >				
							<span id="error_operator_select"></span><CFIF Scheduled_Auto_BB><cfoutput>#lcase(application.returned_customer_setting.operator_label_singular)# payee</cfoutput><CFELSE>&nbsp;<a onClick="searchData('op')" style="cursor: pointer;">payee search<img src="/images/arrow_link.gif" style="vertical-align:bottom;" /></a></CFIF>&nbsp;&nbsp;&nbsp;
						</td>
						</tr>
						</table>
						</span>
					</td>
				</tr>
				
	            <tr><td style="border:1px solid #fff;">&nbsp;</td></tr>
				<TR ID="header" BGCOLOR="#ffce84">
						<TD ID="header" align="left" NOWRAP><B><cfoutput>#application.returned_customer_setting.operator_label_singular#</cfoutput> Name</B></TD>
						<TD ID="header" align="left" WIDTH="150" NOWRAP><B>Location<BR>Type</B></TD>
						<TD ID="header" align="left" NOWRAP><B>City<BR>State</B></TD>
						<TD ID="header" align="left" NOWRAP><B>## of<BR>Locations</B>&nbsp;</TD>
						<TD ID="header" align="left" VALIGN="bottom" WIDTH="30%" NOWRAP><B>Doing Business As</B></TD>
				</TR>

			<cfif getOperatorInformation.recordcount eq 0>
			 <tr id="operatorEmpty">
			  <td colspan="100%" align="center"><span class="NoItemsFromSearchSelected"><cfoutput>No #application.returned_customer_setting.operator_label_singular#</cfoutput> Selected</span></td>					
			 </tr>
			 <tr STYLE="cursor:pointer;">
			  <td id="oprName" nowrap></td>
			  <td id="oprLocType" nowrap></td>
			  <td id="oprLocation" nowrap></td>
			  <td id="oprNumLocations" nowrap></td>
			  <td id="oprDba"></td>
	 		  </tr>	
				<cfelse>
				<CFOUTPUT QUERY="getOperatorInformation">
					<TR STYLE="cursor:pointer;">
						<TD id="oprName" NOWRAP onClick="NewWindow('/profiles/operators/operator_profile.cfm?OID=#trim(getOperatorInformation.BSA_Operator_ID)#','name','400','450','Yes', 'No');return false;">#getOperatorInformation.operator_name#<CFIF trim(getOperatorInformation.legacy_id) EQ "">&nbsp;[#getOperatorInformation.BSA_Operator_Id#]<cfelse>&nbsp;[#getOperatorInformation.legacy_id#]</cfif></TD>
						<TD id="oprLocType" NOWRAP onClick="NewWindow('/profiles/operators/operator_profile.cfm?OID=#trim(getOperatorInformation.BSA_Operator_ID)#','name','400','450','Yes', 'No');return false;">#getOperatorInformation.Operator_Location_Type#&nbsp;</TD>
						<TD id="oprLocation" NOWRAP onClick="NewWindow('/profiles/operators/operator_profile.cfm?OID=#trim(getOperatorInformation.BSA_Operator_ID)#','name','400','450','Yes', 'No');return false;">#getOperatorInformation.Operator_City# - #getOperatorInformation.Operator_State#&nbsp;</TD>
						<TD id="oprNumLocations" NOWRAP onClick="NewWindow('/profiles/operators/operator_profile.cfm?OID=#trim(getOperatorInformation.BSA_Operator_ID)#','name','400','450','Yes', 'No');return false;">#numberformat(getOperatorInformation.Operator_Number_Of_Locations,'_,___,___')#&nbsp;</TD>
						<TD id="oprDba" onClick="NewWindow('/profiles/operators/operator_profile.cfm?OID=#trim(getOperatorInformation.BSA_Operator_ID)#','name','400','450','Yes', 'No');return false;">#getOperatorInformation.Operator_DBA#&nbsp;</TD>
	 				</TR>
				</CFOUTPUT>
				<cfset Can_Associated_Ship_To = 1 />				
			</CFIF>
					
			</TABLE>
			<table>
			<tr style="border-bottom:none;">
			 <td>&nbsp;</td>
			</tr>	
			</table>
<CFOUTPUT>	
			<!------ Associate Distributor to Payee ----->
 
			<cfif Can_Associated_Ship_To EQ 1>
			<cfif Not appSettings.getMultiDistributorBB()><!---Associate only one distributor--->
			<TABLE border="0" cellspacing="0" cellpadding="3" align="center" WIDTH="100%" CLASS="Maintable">
			    <!--- D25341 Using a table to format below span
			    <span id="showCustomerSearch" style="padding:none;top:0;display:<cfif OP_SHOW neq 1>none;<cfelse>block;</cfif>">
				    <span id="associateShipToIdTxt" style="color:blue;">Search By Id: <input type="text" name="shipToAssociateId" id="shipToAssociateId" style="font-size:9px;border:1px solid blue;" onChange="getMultiDist(this.value)" />
            </span>
				    <span style="margin-left:420px;"><span id="error_Associate_ShipTo"></span><cfoutput><a onClick="AssociateShipTo('operator_form')" style="cursor: pointer;">associate a #application.returned_customer_setting.Shard_Ship_To_Label# to this #lcase(application.returned_customer_setting.operator_label_singular)#</cfoutput><img src="/images/arrow_link.gif" style="vertical-align:bottom;" /></a>
            </span>
				</span>
			    --->
				<tr  style="border-bottom:0px;">
					<td width="100%" colspan="100%" style="border-bottom:0px;">
						<span id="showCustomerSearch" style="padding:none;top:0;display:<cfif OP_SHOW neq 1>none;<cfelse>block;</cfif>">
						<table border="0" width="100%" cellpadding="0" cellspacing="0">
							<tr>
							<td style="border-bottom:0px;" width="5%" nowrap="nowrap" valign="top">
								<span id="associateShipToIdTxt" style="color:blue;  font-size : 8pt;">Search By Id: </td><td style="border-bottom:0px;"><input type="text" size="26" name="shipToAssociateId" id="shipToAssociateId" style="font-size:9px;border:1px solid blue;" onChange="getMultiDist(this.value)" /><br>(Type Id and click tab key)</span></td>
							<td style="border-bottom:0px; font-size : 8pt;" align="right" nowrap="nowrap" valign="bottom" >
								<span><span id="error_Associate_ShipTo"></span><cfoutput><a onClick="AssociateShipTo('operator_form')" style="cursor: pointer;">associate a #application.returned_customer_setting.Shard_Ship_To_Label# to this #lcase(application.returned_customer_setting.operator_label_singular)#</cfoutput><img src="/images/arrow_link.gif" style="vertical-align:bottom;" /></a></span>&nbsp;&nbsp;&nbsp;
							</td>
							</tr>
						</table>
						</span>
					</td>
				</tr>
<!--- 				<TR>
					<TD COLSPAN="100%" ALIGN="Center" STYLE="Border-Bottom: None">	<BR>	
						<B><SPAN ID="error_Associate_ShipTo"></SPAN><a onClick="AssociateShipTo('operator_form')" style="cursor: pointer;"><FONT SIZE="2">associate a <CFOUTPUT>#application.returned_customer_setting.Shard_Ship_To_Label# to this #lcase(application.returned_customer_setting.operator_label_singular)#</CFOUTPUT></FONT></a></B>
					</TD>
				</TR> --->
			 <tr>
			 <td style="border:none;">&nbsp;</td>
			  </tr>
				<TR id="multiDistHead" style="<cfif form.operator_id eq "">display:none</cfif>">
					<TD COLSPAN="100%" STYLE="Border-Bottom:None">
						<TABLE border="0" cellspacing="0" cellpadding="3" align="center" WIDTH="100%" CLASS="Maintable">
							<TR ID="header" BGCOLOR="ffce84">
								<TD align="left" ID="header"><B>Name / #application.returned_customer_setting.shard_ship_to_label#</B></TD>
								<TD ID="header"><B>Address</B></TD>
								<cfif NOT variables.appSettings.getDistributorMultiPosition()>
								<TD ID="header"><B>#application.returned_customer_setting.broker_label_singular#</B></TD>
								</cfif>
								<TD ID="header"><B>#application.returned_customer_setting.family_name_label_singular# / #application.returned_customer_setting.buying_group_label_singular#</B></TD>
							</TR>
							<CFIF FORM.Associated_Ship_To NEQ "" AND GetAssociatedShipToInfo.recordcount GT 0>
							<CFLOOP QUERY="GetAssociatedShipToInfo">
							<TR STYLE="cursor:pointer;">
								<TD onClick="NewWindow('/profiles/Distributors/Distributor_profile.cfm?DID=#BSA_Foodservice_Customers_ID#','name','400','450','Yes', 'No');return false;" NOWRAP>#Name#<BR>
								<cfif trim(len(Shr_Ship_To)) neq 0>#Shr_Ship_To#<cfelse>#Ship_To#</cfif>&nbsp;</TD>
								<TD onClick="NewWindow('/profiles/Distributors/Distributor_profile.cfm?DID=#BSA_Foodservice_Customers_ID#','name','400','450','Yes', 'No');return false;">#Address_1#<BR>#City#,#State# #ZipCode#&nbsp;</TD>
								<cfif NOT variables.appSettings.getDistributorMultiPosition()>
								<TD onClick="NewWindow('/profiles/Distributors/Distributor_profile.cfm?DID=#BSA_Foodservice_Customers_ID#','name','400','450','Yes', 'No');return false;" >#Broker_Name#&nbsp;</TD>
								</cfif>
								<TD onClick="NewWindow('/profiles/Distributors/Distributor_profile.cfm?DID=#BSA_Foodservice_Customers_ID#','name','400','450','Yes', 'No');return false;" NOWRAP>#Family_Name#<BR>#Buying_Group_Name#&nbsp;</TD>
			 				</TR>
							</CFLOOP>
							</CFIF>
						</TABLE>
					</TD>
				</TR>				
				
			</TABLE>
			<div id="multiShipToTable"></div>
			<!------ Associate Multiple Distributors to Payee ----->
			<!--- Multi customer stuff ditributor List--->
			<cfelse>
			<TABLE border="0" cellspacing="0" cellpadding="3" align="center" WIDTH="100%" CLASS="Maintable">
				<span id="associateMultiDist" style="padding:none;top:0;display:<cfif form.operator_id neq "">block<cfelse>none</cfif>;">
				 <span id="associateShipToIdTxt" style="color:blue;">Search By Id:</span> <span id="shipText" style="position:absolute;"><input type="text" name="shipToAssociateId" id="shipToAssociateId" style="font-size:9px;border:1px solid blue;"/><textarea name="shipToAssociateIdBig" id="shipToAssociateIdbig" title="Multiple Ship To Id's must be separated by comma's" cols="25" rows="5" style="display:none;"></textarea></span>
				<span style="margin-left: 525px;"><span id="error_Associate_ShipTo"></span><cfoutput><a onClick="searchData('diMultiOp')" style="cursor: pointer;">associate #lcase(application.returned_customer_setting.Shard_Ship_To_Label)#s to this #lcase(application.returned_customer_setting.operator_label_singular)#</cfoutput><img src="/images/arrow_link.gif" style="vertical-align:bottom;" /></a></span>
				</span>
				
			 <tr>
			 <td style="broder:none;">&nbsp;</td>
			  </tr>
<!--- 				<tr id="associateMultiDist">
					<td COLSPAN="100%" ALIGN="Center" STYLE="Border-Bottom: None"><BR>
						<CFIF Not Scheduled_Auto_BB><a onClick="searchData('diMultiOp')" style="cursor: pointer;"><span style="font-size: 13px; font-weight:bold;">associate <cfoutput>#lcase(application.returned_customer_setting.Shard_Ship_To_Label)#'s to this #lcase(application.returned_customer_setting.operator_label_singular)#</cfoutput></span></a><CFELSE><span style="font-size: 13px; font-weight:bold;"><cfoutput>#lcase(application.returned_customer_setting.distributor_label_plural)#</cfoutput></span></CFIF>
					</td>
				</tr> --->
				<TR id="multiDistHead" style="<cfif form.operator_id eq "">display:none</cfif>">
					<TD COLSPAN="100%" STYLE="Border-Bottom:None">
						<table border="0" cellspacing="0" cellpadding="3" align="center" WIDTH="100%" CLASS="Maintable">
							<tr ID="header" BGCOLOR="ffce84">
								<TD align="left" ID="header" colspan="2"><B>Name / <cfoutput>#application.returned_customer_setting.shard_ship_to_label#</cfoutput></B></TD>
								<TD ID="header"><B>Address</B></TD>
								<cfif NOT appSettings.getDistributorMultiPosition()>
									<cfoutput>
									<TD ID="header"><B>#application.returned_customer_setting.broker_label_singular#</B></TD>
									</cfoutput>
								</cfif>
									<cfoutput>
									<TD ID="header"><B>#application.returned_customer_setting.family_name_label_singular# / #application.returned_customer_setting.buying_group_label_singular#</B></TD>
									</cfoutput>
							</tr>
							
							<CFSET x = 0>
							<CFLOOP list="#form.multiDistList#" index="Dist">
								<cfif Dist neq '00000000-0000-0000-0000-000000000000'> <!--- don't show the empty distributo record  *** probably need to keep this out of the distributor list in the first place **** --->
								<cfquery name="qGetDistListInfo" datasource="#Application.Datasource#">
										SELECT     dbo.BSA_Foodservice_Customers.BSA_Foodservice_Customers_ID, dbo.BSA_Foodservice_Customers.Name, 
										                      dbo.BSA_Foodservice_Customers.Ship_To, dbo.BSA_Foodservice_Customers.Address_1, dbo.BSA_Foodservice_Customers.City, 
										                      dbo.BSA_Foodservice_Customers.State, dbo.BSA_Foodservice_Customers.ZipCode,  BSA_Foodservice_Customers.Country_Code,
															  <cfif NOT appSettings.getDistributorMultiPosition()>
										                      dbo.BSA_Foodservice_Customers.BSA_Foodservice_Brokers_ID, dbo.BSA_Foodservice_Brokers.Broker_Name, 
															  </cfif>
										                      dbo.Distributor_Family.Family_Name, dbo.Distributor_Buying_Groups.Buying_Group_Name, dbo.BSA_Foodservice_Customers.Shr_Ship_To
										FROM	dbo.BSA_Foodservice_Customers 
												<cfif NOT appSettings.getDistributorMultiPosition()>
												INNER JOIN	dbo.BSA_Foodservice_Brokers ON 
												dbo.BSA_Foodservice_Customers.BSA_Foodservice_Brokers_ID = dbo.BSA_Foodservice_Brokers.BSA_Foodservice_Brokers_ID 
												</cfif>
												INNER JOIN dbo.Distributor_Family ON dbo.BSA_Foodservice_Customers.Family_ID = dbo.Distributor_Family.Family_ID 
												INNER JOIN dbo.Distributor_Buying_Groups ON dbo.BSA_Foodservice_Customers.Buying_Group_ID = dbo.Distributor_Buying_Groups.Buying_Group_ID
										WHERE BSA_Foodservice_Customers_ID = '#Dist#'
							  </cfquery>
							  <cfif Evaluate(x mod 2) eq 0>
			  						<cfset tmpBgColor = "FFFFFF" />
			 					<cfelse>
									<cfset tmpBgColor = "EAFFEA" />
								</cfif>
										<tr id="custRow_#x#" STYLE="cursor:pointer;" bgcolor="#tmpBgColor#">
											<TD><img bDelete="true" name="IMG_Delete_Scissor"  src="/images/scissor.gif" title="click here to delete this customer" border="0" onClick="deleteThisCust('#Dist#', '#tmpBgColor#')" style="cursor: pointer;">&nbsp;</TD>
											<TD onClick="NewWindow('/profiles/Distributors/Distributor_profile.cfm?DID=#Dist#','name','400','450','Yes', 'No');return false;" NOWRAP>
												
													<cfif listfind(alertList,Dist)><cfset showAlertMessage = 1><font color="##FF0000">Can Not Delete</font><br></cfif>#qGetDistListInfo.Name#<BR>
													<cfif trim(len(qGetDistListInfo.Shr_Ship_To)) neq 0>#qGetDistListInfo.Shr_Ship_To#<cfelse>#qGetDistListInfo.Ship_To#</cfif>&nbsp;</TD>
											<TD onClick="NewWindow('/profiles/Distributors/Distributor_profile.cfm?DID=#Dist#','name','400','450','Yes', 'No');return false;">#qGetDistListInfo.Address_1#<BR>#qGetDistListInfo.City#,#qGetDistListInfo.State# #qGetDistListInfo.ZipCode#&nbsp;#qGetDistListInfo.Country_Code#</TD>
											<cfif NOT appSettings.getDistributorMultiPosition()>
											<TD onClick="NewWindow('/profiles/Distributors/Distributor_profile.cfm?DID=#Dist#','name','400','450','Yes', 'No');return false;" >#qGetDistListInfo.Broker_Name#&nbsp;</TD>
											</cfif>
											<TD onClick="NewWindow('/profiles/Distributors/Distributor_profile.cfm?DID=#Dist#','name','400','450','Yes', 'No');return false;" NOWRAP>#qGetDistListInfo.Family_Name#<BR>#qGetDistListInfo.Buying_Group_Name#&nbsp;</TD>
						 				</tr>
										<CFSET x = x + 1> <!--- counter for rowcolor --->
								</cfif>
							</CFLOOP>
						</TABLE><cfif showAlertMessage eq 1><font color="##FF0000">A <cfoutput>#lcase(application.returned_customer_setting.Shard_Ship_To_Label)#</cfoutput> can not be removed from a billback if it has products associated with it on the programs page.</font></cfif>
					</TD>
				</TR>
			</TABLE>
			<div id="multiShipToTable"></div>
			
			</cfif>
			<!--- End Multi customer stuff --->
			</cfif>
			<!---<BR>

			 <table align="center">
				<TR>
					<TD>
						<span style="color: gray; font-size: 13px; font-weight:bold;">Additional Notes:</span><span id="operator_notes_error"></span>
						<textarea cols="64" rows="3" name="Operator_Notes">#FORM.Operator_Notes#</textarea>
					</TD>
				</TR>
			</table>	 --->		
			<input type="hidden" name="Operator_Notes" value="#form.Operator_Notes#">
		</TD>
        
		<TD id="BB_Payee_Type_Data_2_Unknown_Form"<CFIF OP_UNKNOWN_SHOW NEQ 1> STYLE="DISPLAY:NONE;"<CFELSE> STYLE="DISPLAY:BLOCK"</CFIF>><!--- Unknown Operator --->
			<table border="0" cellspacing="2" cellpadding="1" align="center">
				<TR>
					<TD class="DataTitleCell"><span id="unknown_operator_name_error"></span>&nbsp;Name:</TD>
					<TD rowspan="100%" bgcolor="0000ff"><img src="/images/fill.gif" alt="" width="1" height="1" border="0"></TD>
					<TD><input type="text" name="Unknown_Operator_Name" id="Unknown_Operator_Name" size="50" maxlength="50" value="#FORM.Unknown_Operator_Name#"></TD>
				</TR>
				<TR>
					<TD class="DataTitleCell"><span id="unknown_operator_address_error"></span>&nbsp;Address 1:</TD>
					<TD><input type="text" name="Unknown_Operator_Address_1" id="Unknown_Operator_Address_1" size="50" maxlength="50" value="#FORM.Unknown_Operator_Address_1#"></TD>
				</TR>
				<TR>
					<TD class="DataTitleCell">Address 2:</TD>
					<TD><input type="text" name="Unknown_Operator_Address_2" id="Unknown_Operator_Address_2" size="50" maxlength="50" value="#FORM.Unknown_Operator_Address_2#"></TD>
				</TR>
				<TR>
					<TD class="DataTitleCell"><span id="unknown_operator_city_error"></span>&nbsp;<span id="unknown_operator_state_error"></span>&nbsp;<span id="unknown_operator_zip_error"></span>&nbsp;City\State\Postal:</TD>
					<TD><input type="text" name="Unknown_Operator_City" id="Unknown_Operator_City" value="#FORM.Unknown_Operator_City#" maxlength="50">
						&nbsp;
</CFOUTPUT>
						<SELECT NAME="Unknown_Operator_State" STYLE="<!--- width:	200px;  --->font-size: 10px;">
							<OPTION VALUE="0" <CFIF FORM.Unknown_Operator_State EQ 0>selected</CFIF>>Select State</OPTION>
							<CFOUTPUT QUERY="Get_States">
								<OPTION VALUE="#State_ID#" <CFIF FORM.Unknown_Operator_State EQ Get_States.State_Code>selected</CFIF>>#State_Code#</OPTION>
							</CFOUTPUT>
						</SELECT>
						&nbsp;
<CFOUTPUT>
						<input type="text" name="Unknown_Operator_Zip" id="Unknown_Operator_Zip" size="4" maxlength="10" value="#FORM.Unknown_Operator_Zip#"></TD>    <!--- onkeyup="clenseText(this, '0123456789')" --->
				</TR>
				<TR>
					<TD class="DataTitleCell"><span id="unknown_Operator_Country_error"></span>&nbsp;Country:</TD>
				    <TD VALIGN="top"> 
							<CFOUTPUT>
								<SELECT NAME="Unknown_Operator_Country_Code" id="Unknown_Operator_Country_Code"><OPTION VALUE="" SELECTED></OPTION><CFLOOP QUERY="getCountry"><OPTION VALUE="#getCountry.Country_Code#"<cfif getCountry.Country_Code eq form.Unknown_Operator_Country_Code> selected </cfif>>#getCountry.Country_Name#</OPTION></CFLOOP></SELECT>&nbsp;  
							</CFOUTPUT>
					</TD>
				</TR>
			</table>
			
			<BR>
			<table align="center">
				<TR>
					<TD>
						<HR>
						<span style="color: gray; font-size: 13px; font-weight:bold;">Additional Notes:</span>&nbsp;<span id="unknown_operator_notes_error"></span><BR>
						<textarea cols="64" rows="3" name="Unknown_Operator_Notes">#FORM.Unknown_Operator_Notes#</textarea>
					</TD>
				</TR>
			</table>				
		</TD>
</CFOUTPUT>
		<TD id="BB_Payee_Type_Data_3_Form"<CFIF BROKER_SHOW NEQ 1> STYLE="DISPLAY:NONE;"<CFELSE> STYLE="DISPLAY:BLOCK"</CFIF>><!--- Broker in our database --->
			<CFSET getBrokerInformation = QueryNew('BSA_Foodservice_Brokers_ID')>
			<CFIF len(trim(Form.Broker_ID)) GT 0>
				<cfquery name="getBrokerInformation" datasource="#Application.Datasource#">
					SELECT     dbo.Service_Zones.Zone_Name AS Zone_Name, dbo.Service_Regions.Region_Name AS Region_name, dbo.BSA_Foodservice_Brokers.Broker_Name,dbo.BSA_Foodservice_Brokers.Broker_Shard,dbo.BSA_Foodservice_Brokers.Address,dbo.BSA_Foodservice_Brokers.ADDRESS_2,dbo.BSA_Foodservice_Brokers.City,dbo.BSA_Foodservice_Brokers.State,dbo.BSA_Foodservice_Brokers.Zip, dbo.BSA_Foodservice_Brokers.BSA_Foodservice_Brokers_ID
					FROM       dbo.BSA_Foodservice_Brokers LEFT JOIN
			                   dbo.Service_Regions ON dbo.BSA_Foodservice_Brokers.Service_Region_ID = dbo.Service_Regions.Service_Region_ID LEFT JOIN
							   dbo.Service_Zones ON dbo.BSA_Foodservice_Brokers.Service_Zone_ID = dbo.Service_Zones.Service_Zone_ID
					WHERE BSA_Foodservice_Brokers_ID = '#FORM.Broker_ID#'
				</cfquery> 
			</CFIF>
            <!--- Ajax Broker Code --->
			<TABLE border="0" cellspacing="0" cellpadding="3" align="center" CLASS="Maintable" width="100%">
				<!--- D25341 Using a table to format below span
				<span id="BB_Payee_Type_Data_3" style="padding:none;top:0;display:<cfif BROKER_SHOW neq 1>none;<cfelse>block;</cfif>">
				<span id="brokerIdTxt" style="color:blue;">Search By Id: <input type="text" name="brkrId" id="brkrId" style="font-size:9px;border:1px solid blue;" onChange="getBrokerPayee(this.value)" /></span>
				<span style="margin-left:520px;"><span id="error_broker_select"></span><CFIF Scheduled_Auto_BB><cfoutput>#lcase(application.returned_customer_setting.broker_label_singular)# payee</cfoutput><CFELSE>&nbsp;<a onClick="searchData('br')" style="cursor: pointer;">payee search<img src="/images/arrow_link.gif" style="vertical-align:bottom;" /></a></CFIF></span>
				</span>
				--->
				<tr  style="border-bottom:0px;">
					<td width="100%" colspan="100%" style="border-bottom:0px;">
						<span id="BB_Payee_Type_Data_3" style="padding:none;top:0;display:<cfif BROKER_SHOW neq 1>none;<cfelse>block;</cfif>">
						<table border="0" width="100%" cellpadding="0" cellspacing="0">
							<tr>
							<td style="border-bottom:0px;" width="5%" nowrap="nowrap" valign="top">
								<span id="brokerIdTxt" style="color:blue; font-size : 8pt;">Search By Id: </td><td style="border-bottom:0px;"><input type="text" size="26" name="brkrId" id="brkrId" style="font-size:9px;border:1px solid blue;" onChange="getBrokerPayee(this.value)" /><br>(Type Id and click tab key)</span></td>
							<td style="border-bottom:0px; font-size : 8pt;" align="right" nowrap="nowrap" valign="bottom" >								
								<span id="error_broker_select"></span><CFIF Scheduled_Auto_BB><cfoutput>#lcase(application.returned_customer_setting.broker_label_singular)# payee</cfoutput><CFELSE>&nbsp;<a onClick="searchData('br')" style="cursor: pointer;">payee search<img src="/images/arrow_link.gif" style="vertical-align:bottom;" /></a></CFIF>&nbsp;&nbsp;&nbsp;
							</td>
							</tr>
						</table>
						</span>
					</td>
				</tr>
				
				<tr><td style="border:1px solid #fff;">&nbsp;</td></tr>
				<TR ID="header" BGCOLOR="#ffce84">
					<TD align="left" NOWRAP ID="header"><B>Name / ID</B></TD>
					<TD align="left" ID="header"><B>Address</B></TD>
					<cfoutput><TD align="left" ID="header"><B>#application.returned_customer_setting.region_label_singular# / #application.returned_customer_setting.zone_label_singular#</B></TD></cfoutput>
</TR>
                
                <cfif getBrokerInformation.recordcount eq 0>
				  <tr id="brkrEmpty">
						<cfoutput><td colspan="100%" align="center"><span class="NoItemsFromSearchSelected">No #application.returned_customer_setting.broker_label_singular# Selected</span></td></cfoutput>
					</tr>
					<tr style="cursor:pointer;">
						<td id="brkrname" nowrap></td>
						<td id="brkrAddress" nowrap></td>
						<td id="brkrRegion" nowrap></td>
	 				</tr>
				<cfelse>
				<CFOUTPUT QUERY="getBrokerInformation">
					<tr STYLE="cursor:pointer;">
						<td id="brkrname" nowrap onClick="NewWindow('/Profiles/Brokers/Broker_profile.cfm?BID=#getBrokerInformation.BSA_Foodservice_Brokers_ID#','name','400','450','Yes', 'No');">#getBrokerInformation.Broker_Name#<BR>#getBrokerInformation.Broker_Shard#&nbsp;</td>
						<td id="brkrAddress" nowrap onClick="NewWindow('/Profiles/Brokers/Broker_profile.cfm?BID=#getBrokerInformation.BSA_Foodservice_Brokers_ID#','name','400','450','Yes', 'No');">#getBrokerInformation.Address#<BR><cfif len(trim(address_2))>#getBrokerInformation.ADDRESS_2#<BR></cfif>#getBrokerInformation.City#,#getBrokerInformation.State# #getBrokerInformation.Zip#&nbsp;</td>
						<td id="brkrRegion" nowrap onClick="NewWindow('/Profiles/Brokers/Broker_profile.cfm?BID=#getBrokerInformation.BSA_Foodservice_Brokers_ID#','name','400','450','Yes', 'No');">#getBrokerInformation.Region_Name#<BR>#getBrokerInformation.Zone_Name#&nbsp;</td>
	 				</tr>
				</CFOUTPUT>
				<cfset Can_Associated_Ship_To = 1 />
			</cfif>
<CFOUTPUT>
			</TABLE>
			
			<cfif Can_Associated_Ship_To EQ 1>
			<cfif Not appSettings.getMultiDistributorBB()><!---Associate only one distributor--->
			<TABLE border="0" cellspacing="0" cellpadding="3" align="center" WIDTH="100%" CLASS="Maintable">
				<tr  style="border-bottom:0px;">
					<td width="100%" colspan="100%" style="border-bottom:0px;">
						<span id="showCustomerSearchBrk" style="padding:none;top:0;display:<cfif BROKER_SHOW neq 1>none;<cfelse>block;</cfif>">
						<table border="0" width="100%" cellpadding="0" cellspacing="0">
							<tr>
							<td style="border-bottom:0px;" width="5%" nowrap="nowrap" valign="top">
								<span id="associateShipToIdTxtBrk" style="color:blue;  font-size : 8pt;">Search By Id: </td><td style="border-bottom:0px;"><input type="text" size="26" name="shipToAssociateIdBrk" id="shipToAssociateIdBrk" style="font-size:9px;border:1px solid blue;" onChange="getMultiDist(this.value)" /><br>(Type Id and click tab key)</span></td>
							<td style="border-bottom:0px; font-size : 8pt;" align="right" nowrap="nowrap" valign="bottom" >
								<span><span id="error_Associate_ShipToBrk"></span><cfoutput><a onClick="AssociateShipTo('broker_form')" style="cursor: pointer;">associate a #application.returned_customer_setting.Shard_Ship_To_Label# to this #lcase(application.returned_customer_setting.broker_label_singular)#</cfoutput><img src="/images/arrow_link.gif" style="vertical-align:bottom;" /></a></span>&nbsp;&nbsp;&nbsp;
							</td>
							</tr>
						</table>
						</span>
					</td>
				</tr>
			 <tr>
			 <td style="border:none;">&nbsp;</td>
			  </tr>
				<TR id="multiDistHeadBrk" style="<cfif FORM.Broker_ID eq "">display:none</cfif>">
					<TD COLSPAN="100%" STYLE="Border-Bottom:None">
						<TABLE border="0" cellspacing="0" cellpadding="3" align="center" WIDTH="100%" CLASS="Maintable">
							<TR ID="header" BGCOLOR="ffce84">
								<TD align="left" ID="header"><B>Name / #application.returned_customer_setting.shard_ship_to_label#</B></TD>
								<TD ID="header"><B>Address</B></TD>
								<cfif NOT variables.appSettings.getDistributorMultiPosition()>
								<TD ID="header"><B>#application.returned_customer_setting.broker_label_singular#</B></TD>
								</cfif>
								<TD ID="header"><B>#application.returned_customer_setting.family_name_label_singular# / #application.returned_customer_setting.buying_group_label_singular#</B></TD>
							</TR>
							<CFIF FORM.Associated_Ship_To NEQ "" AND GetAssociatedShipToInfo.recordcount GT 0>
							<CFLOOP QUERY="GetAssociatedShipToInfo">
							<TR STYLE="cursor:pointer;">
								<TD onClick="NewWindow('/profiles/Distributors/Distributor_profile.cfm?DID=#BSA_Foodservice_Customers_ID#','name','400','450','Yes', 'No');return false;" NOWRAP>#Name#<BR>
								<cfif trim(len(Shr_Ship_To)) neq 0>#Shr_Ship_To#<cfelse>#Ship_To#</cfif>&nbsp;</TD>
								<TD onClick="NewWindow('/profiles/Distributors/Distributor_profile.cfm?DID=#BSA_Foodservice_Customers_ID#','name','400','450','Yes', 'No');return false;">#Address_1#<BR>#City#,#State# #ZipCode#&nbsp;</TD>
								<cfif NOT variables.appSettings.getDistributorMultiPosition()>
								<TD onClick="NewWindow('/profiles/Distributors/Distributor_profile.cfm?DID=#BSA_Foodservice_Customers_ID#','name','400','450','Yes', 'No');return false;" >#Broker_Name#&nbsp;</TD>
								</cfif>
								<TD onClick="NewWindow('/profiles/Distributors/Distributor_profile.cfm?DID=#BSA_Foodservice_Customers_ID#','name','400','450','Yes', 'No');return false;" NOWRAP>#Family_Name#<BR>#Buying_Group_Name#&nbsp;</TD>
			 				</TR>
							</CFLOOP>
							</CFIF>
						</TABLE>
					</TD>
				</TR>				
				
			</TABLE>
			<div id="multiShipToTableBrk"></div>
			<!------ Associate Multiple Distributors to Payee ----->
			<!--- Multi customer stuff ditributor List --->
		<cfelse>
			<TABLE border="0" cellspacing="0" cellpadding="3" align="center" WIDTH="100%" CLASS="Maintable">
				<span id="associateMultiDistBrk" style="padding:none;top:0;display:<cfif form.broker_id neq "">block<cfelse>none</cfif>;">
				 <span id="associateShipToIdTxtBrk" style="color:blue;">Search By Id:</span> <span id="shipText" style="position:absolute;"><input type="text" name="shipToAssociateIdBrk" id="shipToAssociateIdBrk" style="font-size:9px;border:1px solid blue;"/><textarea name="shipToAssociateIdBigBrk" id="shipToAssociateIdbigBrk" title="Multiple Ship To Id's must be separated by comma's" cols="25" rows="5" style="display:none;"></textarea></span>
				<span style="margin-left: 525px;"><span id="error_Associate_ShipToBrk"></span><cfoutput><a onClick="searchData('diMultiBr')" style="cursor: pointer;">associate #lcase(application.returned_customer_setting.Shard_Ship_To_Label)#s to this #lcase(application.returned_customer_setting.broker_label_singular)#</cfoutput><img src="/images/arrow_link.gif" style="vertical-align:bottom;" /></a></span>
				</span>
				
			 <tr>
			 <td style="broder:none;">&nbsp;</td>
			  </tr>
				<TR id="multiDistHeadBrk" style="<cfif form.broker_id eq "">display:none</cfif>">
					<TD COLSPAN="100%" STYLE="Border-Bottom:None">
						<table border="0" cellspacing="0" cellpadding="3" align="center" WIDTH="100%" CLASS="Maintable">
							<tr ID="header" BGCOLOR="ffce84">
								<TD align="left" ID="header" colspan="2"><B>Name / <cfoutput>#application.returned_customer_setting.shard_ship_to_label#</cfoutput></B></TD>
								<TD ID="header"><B>Address</B></TD>
								<cfif NOT appSettings.getDistributorMultiPosition()>
									<cfoutput>
									<TD ID="header"><B>#application.returned_customer_setting.broker_label_singular#</B></TD>
									</cfoutput>
								</cfif>
									<cfoutput>
									<TD ID="header"><B>#application.returned_customer_setting.family_name_label_singular# / #application.returned_customer_setting.buying_group_label_singular#</B></TD>
									</cfoutput>
							</tr>
							
							<CFSET x = 0>
							<CFLOOP list="#form.multiDistList#" index="Dist">
								<cfif Dist neq '00000000-0000-0000-0000-000000000000'> <!--- don't show the empty distributo record  *** probably need to keep this out of the distributor list in the first place **** --->
								<cfquery name="qGetDistListInfo" datasource="#Application.Datasource#">
										SELECT     dbo.BSA_Foodservice_Customers.BSA_Foodservice_Customers_ID, dbo.BSA_Foodservice_Customers.Name, 
										                      dbo.BSA_Foodservice_Customers.Ship_To, dbo.BSA_Foodservice_Customers.Address_1, dbo.BSA_Foodservice_Customers.City, 
										                      dbo.BSA_Foodservice_Customers.State, dbo.BSA_Foodservice_Customers.ZipCode,  BSA_Foodservice_Customers.Country_Code,
															  <cfif NOT appSettings.getDistributorMultiPosition()>
										                      dbo.BSA_Foodservice_Customers.BSA_Foodservice_Brokers_ID, dbo.BSA_Foodservice_Brokers.Broker_Name, 
															  </cfif>
										                      dbo.Distributor_Family.Family_Name, dbo.Distributor_Buying_Groups.Buying_Group_Name, dbo.BSA_Foodservice_Customers.Shr_Ship_To
										FROM	dbo.BSA_Foodservice_Customers 
												<cfif NOT appSettings.getDistributorMultiPosition()>
												INNER JOIN	dbo.BSA_Foodservice_Brokers ON 
												dbo.BSA_Foodservice_Customers.BSA_Foodservice_Brokers_ID = dbo.BSA_Foodservice_Brokers.BSA_Foodservice_Brokers_ID 
												</cfif>
												INNER JOIN dbo.Distributor_Family ON dbo.BSA_Foodservice_Customers.Family_ID = dbo.Distributor_Family.Family_ID 
												INNER JOIN dbo.Distributor_Buying_Groups ON dbo.BSA_Foodservice_Customers.Buying_Group_ID = dbo.Distributor_Buying_Groups.Buying_Group_ID
										WHERE BSA_Foodservice_Customers_ID = '#Dist#'
							  </cfquery>
							  <cfif Evaluate(x mod 2) eq 0>
			  						<cfset tmpBgColor = "FFFFFF" />
			 					<cfelse>
									<cfset tmpBgColor = "EAFFEA" />
								</cfif>
										<tr id="custRow_#x#" STYLE="cursor:pointer;" bgcolor="#tmpBgColor#">
											<TD><img bDelete="true" name="IMG_Delete_Scissor"  src="/images/scissor.gif" title="click here to delete this customer" border="0" onClick="deleteThisCust('#Dist#', '#tmpBgColor#')" style="cursor: pointer;">&nbsp;</TD>
											<TD onClick="NewWindow('/profiles/Distributors/Distributor_profile.cfm?DID=#Dist#','name','400','450','Yes', 'No');return false;" NOWRAP>
												
													<cfif listfind(alertList,Dist)><cfset showAlertMessage = 1><font color="##FF0000">Can Not Delete</font><br></cfif>#qGetDistListInfo.Name#<BR>
													<cfif trim(len(qGetDistListInfo.Shr_Ship_To)) neq 0>#qGetDistListInfo.Shr_Ship_To#<cfelse>#qGetDistListInfo.Ship_To#</cfif>&nbsp;</TD>
											<TD onClick="NewWindow('/profiles/Distributors/Distributor_profile.cfm?DID=#Dist#','name','400','450','Yes', 'No');return false;">#qGetDistListInfo.Address_1#<BR>#qGetDistListInfo.City#,#qGetDistListInfo.State# #qGetDistListInfo.ZipCode#&nbsp;#qGetDistListInfo.Country_Code#</TD>
											<cfif NOT appSettings.getDistributorMultiPosition()>
											<TD onClick="NewWindow('/profiles/Distributors/Distributor_profile.cfm?DID=#Dist#','name','400','450','Yes', 'No');return false;" >#qGetDistListInfo.Broker_Name#&nbsp;</TD>
											</cfif>
											<TD onClick="NewWindow('/profiles/Distributors/Distributor_profile.cfm?DID=#Dist#','name','400','450','Yes', 'No');return false;" NOWRAP>#qGetDistListInfo.Family_Name#<BR>#qGetDistListInfo.Buying_Group_Name#&nbsp;</TD>
						 				</tr>
										<CFSET x = x + 1> <!--- counter for rowcolor --->
								</cfif>
							</CFLOOP>
						</TABLE><cfif showAlertMessage eq 1><font color="##FF0000">A <cfoutput>#lcase(application.returned_customer_setting.Shard_Ship_To_Label)#</cfoutput> can not be removed from a billback if it has products associated with it on the programs page.</font></cfif>
					</TD>
				</TR>
			</TABLE>
			<div id="multiShipToTableBrk"></div>
			
			</cfif>
			<!--- End Multi customer stuff --->
			</cfif>
		<!--- 	<BR>
			<table align="center">
				<TR>
					<TD>
						<!---<HR color="7A9AB1" width="100%" style="height: 1px;">--->
						<span style="color: gray; font-size: 13px; font-weight:bold;">Additional Notes:</span><span id="broker_notes_error"></span>
						<textarea cols="64" rows="3" name="Broker_Notes">#FORM.Broker_Notes#</textarea>
					</TD>
				</TR>
			</table> --->		
			<input type="hidden" name="Broker_Notes" value="#form.Broker_Notes#">
		</TD>
</CFOUTPUT>		
<CFOUTPUT>
		<TD id="BB_Payee_Type_Data_3_Unknown_Form"<CFIF BROKER_UNKNOWN_SHOW NEQ 1> STYLE="DISPLAY:NONE;"<CFELSE> STYLE="DISPLAY:BLOCK"</CFIF>><!--- Unknown Broker --->
			<table border="0" cellspacing="2" cellpadding="1" align="center">
				<TR>
					<TD class="DataTitleCell"><span id="unknown_broker_name_error"></span>&nbsp;Name:</TD>
					<TD rowspan="100%" bgcolor="0000ff"><img src="/images/fill.gif" alt="" width="1" height="1" border="0"></TD>
					<TD><input type="text" name="Unknown_Broker_Name" id="Unknown_Broker_Name" size="50" maxlength="50" value="#Form.Unknown_Broker_Name#"></TD>
				</TR>
				<TR>
					<TD class="DataTitleCell"><span id="unknown_broker_address_error"></span>&nbsp;Address 1:</TD>
					<TD><input type="text" name="Unknown_Broker_Address_1" id="Unknown_Broker_Address_1" size="50" maxlength="50" value="#Form.Unknown_Broker_Address_1#"></TD>
				</TR>
				<TR>
					<TD class="DataTitleCell">Address 2:</TD>
					<TD><input type="text" name="Unknown_Broker_Address_2" id="Unknown_Broker_Address_2" size="50" maxlength="50" value="#Form.Unknown_Broker_Address_2#"></TD>
				</TR>
				<TR>
					<TD class="DataTitleCell"><span id="unknown_broker_city_error"></span>&nbsp;<span id="unknown_broker_state_error"></span>&nbsp;<span id="unknown_broker_zip_error"></span>&nbsp;City\State\Postal:</TD>
					<TD><input type="text" name="Unknown_Broker_City" id="Unknown_Broker_City" value="#form.Unknown_Broker_City#" maxlength="50">
</CFOUTPUT>
						&nbsp;
						<SELECT NAME="Unknown_Broker_State" STYLE="<!--- width:	200px;  --->font-size: 10px;">
							<OPTION VALUE="0" <CFIF FORM.Unknown_Broker_State EQ 0>selected</CFIF>>Select State</OPTION>
							<CFOUTPUT QUERY="Get_States">
								<OPTION VALUE="#State_ID#" <CFIF FORM.Unknown_Broker_State EQ Get_States.State_ID>selected</CFIF>>#State_Code#</OPTION>
							</CFOUTPUT>
						</SELECT>
						&nbsp;
<CFOUTPUT>
						<input type="text" name="Unknown_Broker_Zip" id="Unknown_Broker_Zip" size="4" maxlength="10" value="#Form.Unknown_Broker_Zip#" ></TD>  <!--- onkeyup="clenseText(this, '0123456789')" --->
				</TR>
				<TR>
					<TD class="DataTitleCell"><span id="unknown_Broker_Country_error"></span>&nbsp;Country:</TD>
				     <TD VALIGN="top"> 
							<CFOUTPUT>
								<SELECT NAME="Unknown_Broker_Country_Code" id="Unknown_Broker_Country_Code"><OPTION VALUE="" SELECTED></OPTION><CFLOOP QUERY="getCountry"><OPTION VALUE="#getCountry.Country_Code#"<cfif getCountry.Country_Code eq form.Unknown_Broker_Country_Code> selected </cfif>>#getCountry.Country_Name#</OPTION></CFLOOP></SELECT>&nbsp;  
							</CFOUTPUT>
					</TD>
				</TR>
			</table>
			
			<BR>
			<table align="center">
				<TR>
					<TD>
						<HR color="7A9AB1" width="100%" style="height: 1px;">
						<span style="color: gray; font-size: 13px; font-weight:bold;">Additional Notes:</span>&nbsp;<span id="unknown_broker_notes_error"></span><BR>
						<textarea cols="64" rows="3" name="Unknown_Broker_Notes">#FORM.Unknown_Broker_Notes#</textarea>
					</TD>
				</TR>
			</table>	
		</TD>
</CFOUTPUT>				
<CFOUTPUT>
		<TD id="BB_Payee_Type_Data_4_Form"<CFIF OTHER_SHOW NEQ 1> STYLE="DISPLAY:NONE;"<CFELSE> STYLE="DISPLAY:BLOCK"</CFIF>><!--- unknown entity --->
			<table border="0" cellspacing="2" cellpadding="1" align="center">
				<TR>
					<TD class="DataTitleCell"><span id="other_address_error"></span>&nbsp;Name:</TD>
					<TD rowspan="100%" bgcolor="0000ff"><img src="/images/fill.gif" alt="" width="1" height="1" border="0"></TD>
					<TD><input type="text" name="Other_Name" id="Other_Name" size="50" maxlength="50" value="#FORM.Other_Name#"></TD>
				</TR>
				<TR>
					<TD class="DataTitleCell"><span id="other_name_error"></span>&nbsp;Address 1:</TD>
					<TD><input type="text" name="Other_Address_1" id="Other_Address_1" size="50" maxlength="50" value="#FORM.Other_Address_1#"></TD>
				</TR>
				<TR>
					<TD class="DataTitleCell">Address 2:</TD>
					<TD><input type="text" name="Other_Address_2" id="Other_Address_2" size="50" maxlength="50" value="#FORM.Other_Address_2#"></TD>
				</TR>
				<TR>
					<TD class="DataTitleCell"><span id="other_city_error"></span>&nbsp;<span id="other_state_error"></span>&nbsp;<span id="other_zip_error"></span>&nbsp;City\State\Postal:</TD>
					<TD><input type="text" name="Other_City" id="Other_City" value="#form.Other_City#" maxlength="50">
						&nbsp;
</CFOUTPUT>
						<SELECT NAME="Other_State" STYLE="<!--- width:	200px;  --->font-size: 10px;">
							<OPTION VALUE="0" <CFIF FORM.Other_State EQ 0>selected</CFIF>>Select State</OPTION>
							<CFOUTPUT QUERY="Get_States">
								<OPTION VALUE="#State_ID#" <CFIF FORM.Other_State EQ Get_States.State_ID>selected</CFIF>>#State_Code#</OPTION>
							</CFOUTPUT>
						</SELECT>
						&nbsp;
<CFOUTPUT>
						<input type="text" name="Other_Zip" id="Other_Zip" size="4" maxlength="10" value="#Form.Other_Zip#"></TD>   <!--- onkeyup="clenseText(this, '0123456789')" --->
				</TR>
				<TR>
					<TD class="DataTitleCell"><span id="other_country_error"></span>Country:</TD>
					<TD VALIGN="top"> 
							<CFOUTPUT>
								<SELECT NAME="Other_Country_Code" id="Other_Country_Code"><OPTION VALUE="" SELECTED></OPTION><CFLOOP QUERY="getCountry"><OPTION VALUE="#getCountry.Country_Code#"<cfif getCountry.Country_Code eq form.Other_Country_Code> selected </cfif>>#getCountry.Country_Name#</OPTION></CFLOOP></SELECT>&nbsp;  
							</CFOUTPUT>
					</TD>
				</TR>
			</table>
			
			<!------ Associate Distributor to Payee ----->
			<cfif 1 EQ 1>
			<TABLE border="0" cellspacing="0" cellpadding="3" align="center" WIDTH="100%" CLASS="Maintable">
				<TR>
					<TD COLSPAN="100%" ALIGN="Center" STYLE="Border-Bottom: None">	<BR><BR>	
						<B><SPAN ID="error_Associate_ShipTo_Other"></SPAN><a onClick="AssociateShipTo('BB_Payee_Form')" style="cursor: pointer;"><FONT SIZE="2">Associate a <CFOUTPUT>#application.returned_customer_setting.Shard_Ship_To_Label#</CFOUTPUT> to this payee</FONT></a></B>
					</TD>
				</TR>
				<CFIF FORM.Associated_Ship_To NEQ "" AND GetAssociatedShipToInfo.recordcount GT 0>
				<TR>
					<TD COLSPAN="100%" STYLE="Border-Bottom:None">
						<TABLE border="0" cellspacing="0" cellpadding="3" align="center" WIDTH="100%" CLASS="Maintable">
							<TR ID="header" BGCOLOR="ffce84">
								<TD align="left" ID="header"><B>Name / #application.returned_customer_setting.shard_ship_to_label#</B></TD>
								<TD ID="header"><B>Address</B></TD>
								<cfif NOT variables.appSettings.getDistributorMultiPosition()>
								<TD ID="header"><B>#application.returned_customer_setting.broker_label_singular#</B></TD>
								</cfif>
								<TD ID="header"><B>#application.returned_customer_setting.family_name_label_singular# / #application.returned_customer_setting.buying_group_label_singular#</B></TD>
							</TR>
							
							<CFLOOP QUERY="GetAssociatedShipToInfo">
							<TR STYLE="cursor:pointer;">
								<TD onClick="NewWindow('/profiles/Distributors/Distributor_profile.cfm?DID=#BSA_Foodservice_Customers_ID#','name','400','450','Yes', 'No');return false;" NOWRAP>#Name#<BR>
								<cfif trim(len(Shr_Ship_To)) neq 0>#Shr_Ship_To#<cfelse>#Ship_To#</cfif>&nbsp;</TD>
								<TD onClick="NewWindow('/profiles/Distributors/Distributor_profile.cfm?DID=#BSA_Foodservice_Customers_ID#','name','400','450','Yes', 'No');return false;">#Address_1#<BR>#City#,#State# #ZipCode#&nbsp;#country_code#</TD>
								<cfif NOT variables.appSettings.getDistributorMultiPosition()>
