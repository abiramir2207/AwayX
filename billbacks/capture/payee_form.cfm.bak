<!--- load bb --->

<cfset variables.appSettings = application.oApplicationAppSettingsManager.getApplicationAppSettings() />
<!--- <cfdump var="#appSettings.getMultiDistributorBB()#"> --->
<CFSET Ship_To_For_Operator = variables.appSettings.getBB_Payee_Operator_Ship_To_Req()>
<CFSET Ship_To_For_Broker = variables.appSettings.getBBPayeeBrokerShipToReq()>

<CFINCLUDE TEMPLATE="/get_access_profile.cfm">
<cfinclude template="/Script/cf/ListCompare.cfm">
<cfset disableUnknown = 0>
<cfif LEFT(application.returned_customer_setting.Customer_Keyword,5) EQ "Heinz">
	<cfset disableUnknown = 1>
</cfif>

<cfset Can_Associated_Ship_To = 0 />
<cfparam name="URL.BBID"								default="">
<cfparam name="Form.Billback_ID"						default="">
<cfparam name="Form.Load_ID_From_Form"					default="0">
<CFPARAM NAME="FORM.Vendor_ID" DEFAULT="">
<cfparam name="Scheduled_Auto_BB"						default="0">
<cfparam name="showAlertMessage" default="0">
<cfparam name="alertList" default="">
<CFSET is_an_unknown_payee = 0>
<CFSET LoadBillback = 0>
<CFIF len(trim(URL.BBID)) GT 0 AND (FORM.Load_ID_From_Form EQ 0)>
	<CFSET Form.Billback_ID = URL.BBID>
	<CFSET LoadBillback = 1>
</CFIF>

<cfset CountDistributor = 0/><!--- D30517: Item not appearing on Billback 'programs' page after importing it --->
<cfset savedPayeeType = 0 />
<cfset savedPayeeID = "" />
<CFIF LoadBillback EQ 1>
	<cfquery name="LoadBillbackData" datasource="#Application.Datasource#">
		SELECT 
			BB_Title,
			BB_Date,
			BB_Start_Date,
			BB_End_Date,
			BB_Amount,
			BB_Reference,
			BB_Creator_ID,
			BB_Creator_Notes,
			BB_Code,
			BB_Creator_User_Position_ID,
			--BB_Is_Locked,
			--BB_Locked_By_User_ID,
			--BB_Lock_Date,
			Billback_Status_ID,
			Billback_Payee_Type_ID,
			BB_UP,
			BB_PNF,
			Created_Date,
			Deleted,
			Scheduled_Auto_BB,
			BB_Closing_Method
		FROM Billback
		WHERE Billback_ID = '#Form.Billback_ID#'
	</cfquery>
	
<!--- D30517: Item not appearing on Billback 'programs' page after importing it START	 --->
<cfquery name="CheckDistributors" datasource="#Application.Datasource#">	
SELECT top 1 bp.billback_id, bp.Billback_Program_ID, bp.Product_ID, COUNT(*) as cnt
FROM  Billback_Product bp
WHERE bp.Billback_ID = '#Form.Billback_ID#'
ANd   bp.Deleted = 0
GROUP BY bp.billback_id, bp.Billback_Program_ID, bp.Product_ID
HAVING COUNT(*) > 1
</cfquery>	
	
<cfset CountDistributor = CheckDistributors.recordcount>
<!--- D30517: Item not appearing on Billback 'programs' page after importing it END	 --->	

<cfset Scheduled_Auto_BB = LoadBillbackData.Scheduled_Auto_BB>
	<cfset savedPayeeType = LoadBillbackData.Billback_Payee_Type_ID />
	<CFSWITCH expression="#LoadBillbackData.Billback_Payee_Type_ID#">
		<CFCASE value="1"><!--- di --->
			<cfquery name="getPayeeData" datasource="#Application.Datasource#">
				SELECT *
				FROM Billback_Distributor
				WHERE Billback_ID = '#Form.Billback_ID#' AND Deleted = 0
			</cfquery>
			<cfset savedPayeeID = getPayeeData.Distributor_ID />
<!--- 			<cfif len(getPayeeData.Distributor_ID) EQ 0>
				<CFSET is_an_unknown_payee = 1>
			</cfif>
 --->		</CFCASE>

		<CFCASE value="2"><!--- op --->
			<cfquery name="getPayeeData" datasource="#Application.Datasource#">
				SELECT *
				FROM Billback_Operator
				WHERE Billback_ID = '#Form.Billback_ID#' AND Deleted = 0
			</cfquery>
				
			<CFPARAM NAME="FORM.Associated_Ship_To" DEFAULT="#getPayeeData.Associated_Ship_To#">
<!--- 			<cfif len(getPayeeData.Operator_ID) EQ 0>
				<CFSET is_an_unknown_payee = 1>
			</cfif>	 --->		
		</CFCASE>

		<CFCASE value="3"><!--- br --->
			<cfquery name="getPayeeData" datasource="#Application.Datasource#">
				SELECT *
				FROM Billback_Broker
				WHERE Billback_ID = '#Form.Billback_ID#' AND Deleted = 0
			</cfquery>
<!--- 			<cfif len(getPayeeData.Broker_ID) EQ 0>
				<CFSET is_an_unknown_payee = 1>
			</cfif>		 --->			
		</CFCASE>

		<CFCASE value="4"><!--- other --->
			<cfquery name="getPayeeData" datasource="#Application.Datasource#">
				SELECT *
				FROM Billback_Unidentified_Payee
				WHERE Billback_ID = '#Form.Billback_ID#' AND Deleted = 0
			</cfquery>
			<CFPARAM NAME="FORM.Associated_Ship_To" DEFAULT="#getPayeeData.Associated_Ship_To#">
		</CFCASE>
		
		<cfcase value="5"><!--- unidentified distributor --->
			<cfquery name="getPayeeData" datasource="#Application.Datasource#">
				SELECT *
				FROM Billback_Distributor
				WHERE Billback_ID = '#Form.Billback_ID#' AND Deleted = 0
			</cfquery>			
			<CFSET is_an_unknown_payee = 1>
		</cfcase>
		<cfcase value="6"><!--- unidentified operator --->
			<cfquery name="getPayeeData" datasource="#Application.Datasource#">
				SELECT *
				FROM Billback_Operator
				WHERE Billback_ID = '#Form.Billback_ID#' AND Deleted = 0
			</cfquery>
			<CFSET is_an_unknown_payee = 1>
		</cfcase>
		<cfcase value="7"><!--- unidentified broker --->
			<cfquery name="getPayeeData" datasource="#Application.Datasource#">
				SELECT *
				FROM Billback_Broker
				WHERE Billback_ID = '#Form.Billback_ID#' AND Deleted = 0
			</cfquery>
			<CFSET is_an_unknown_payee = 1>
		</cfcase>
	</CFSWITCH>
	<CFIF LoadBillbackData.Billback_Payee_Type_ID EQ 1 OR LoadBillbackData.Billback_Payee_Type_ID EQ 2 OR LoadBillbackData.Billback_Payee_Type_ID EQ 3>
		<CFSET FORM.Vendor_ID = getPayeeData.Uploaded_Vendor_ID>
	</CFIF>
</CFIF>
<!---  end load bb --->
<cfparam name="FORM.BB_Payee_Type" 						default="0">
<cfparam name="Form.Default_Payee"						default="1">

<CFIF Not IsDefined("FORM.Associated_Ship_To")>
	<CFPARAM NAME="FORM.Associated_Ship_To" DEFAULT="">
</CFIF>

<CFIF FORM.Associated_Ship_To NEQ "">
	<CFQUERY NAME="GetAssociatedShipToInfo" DATASOURCE="#Application.Datasource#">
		SELECT  BSA_Foodservice_Customers.BSA_Foodservice_Customers_ID, BSA_Foodservice_Customers.Name, 
				BSA_Foodservice_Customers.Ship_To, BSA_Foodservice_Customers.Address_1, BSA_Foodservice_Customers.City, 
				BSA_Foodservice_Customers.State, BSA_Foodservice_Customers.ZipCode, BSA_Foodservice_Customers.Country_Code,
				<cfif NOT variables.appSettings.getDistributorMultiPosition()>
				BSA_Foodservice_Customers.BSA_Foodservice_Brokers_ID, BSA_Foodservice_Brokers.Broker_Name, 
				</cfif>
				Distributor_Family.Family_Name, Distributor_Buying_Groups.Buying_Group_Name, BSA_Foodservice_Customers.Shr_Ship_To
		FROM	BSA_Foodservice_Customers 
		<cfif NOT variables.appSettings.getDistributorMultiPosition()>
		INNER JOIN	BSA_Foodservice_Brokers 
		ON 		BSA_Foodservice_Customers.BSA_Foodservice_Brokers_ID = BSA_Foodservice_Brokers.BSA_Foodservice_Brokers_ID 
		</cfif>
		INNER JOIN Distributor_Family 
		ON 		BSA_Foodservice_Customers.Family_ID = Distributor_Family.Family_ID 
		INNER JOIN Distributor_Buying_Groups 
		ON 		BSA_Foodservice_Customers.Buying_Group_ID = Distributor_Buying_Groups.Buying_Group_ID
		WHERE 	BSA_Foodservice_Customers_ID = 	'#FORM.Associated_Ship_To#'
												
	</CFQUERY>
</CFIF>

<CFIF LoadBillback EQ 1>
	<CFIF len(trim(LoadBillbackData.Billback_Payee_Type_ID)) GT 0>
		<!--- mapp the db value to the object index of the radio buttons --->
		<CFSWITCH expression="#LoadBillbackData.Billback_Payee_Type_ID#">
			<CFCASE value="1"><!--- dis --->
				<CFSET FORM.Default_Payee = 1>			
			</CFCASE>
			<CFCASE value="2"><!--- op ---> 
				<CFSET FORM.Default_Payee = 2>			
			</CFCASE>
			<CFCASE value="3"><!--- br --->
				<CFSET FORM.Default_Payee = 3>			
			</CFCASE>
			<CFCASE value="4"><!--- other --->
				<CFSET FORM.Default_Payee = 4>
			</CFCASE>
			<CFCASE value="5"><!--- unknown dis --->
				<CFSET FORM.Default_Payee = 1>			
			</CFCASE>
			<CFCASE value="6"><!--- unknown op --->
				<CFSET FORM.Default_Payee = 2>			
			</CFCASE>
			<CFCASE value="7"><!--- unknown br --->
				<CFSET FORM.Default_Payee = 3>			
			</CFCASE>			
		</CFSWITCH>
	</CFIF>
	<CFSET BB_Closing_method = LoadBillbackData.BB_Closing_Method>
<CFELSE>
	<cfquery name="LoadBillbackData_Two" datasource="#Application.Datasource#">
		SELECT 
			Billback_Payee_Type_ID,
			BB_Closing_Method
		FROM Billback
		WHERE Billback_ID = '#Form.Billback_ID#'
	</cfquery>
	<CFSET BB_Closing_method = LoadBillbackData_Two.BB_Closing_Method>
	<!--- <CFSET FORM.Default_Payee = LoadBillbackData_Two.Billback_Payee_Type_ID>  --->
	<cfset savedPayeeType = LoadBillbackData_Two.Billback_Payee_Type_ID />
	<cfif savedPayeeType eq 1>
		<cfquery name="getPayeeData" datasource="#Application.Datasource#">
			SELECT *
			FROM Billback_Distributor
			WHERE Billback_ID = '#Form.Billback_ID#' AND Deleted = 0
		</cfquery>
		<cfset savedPayeeID = getPayeeData.Distributor_ID />
	</cfif>

</CFIF>


<!--- 
	1	Broker
	2	Distributor
	3	Operator
	4	Other
 --->
<CFPARAM name="FORM.Broker_List" default="">
<CFSET FORM.Broker_List = trim(FORM.Broker_List)>
<CFIF len(FORM.Broker_List) GT 0 AND FORM.Load_ID_From_Form EQ 1>
	<CFIF FORM.Broker_List NEQ "0">
		<CFSET FORM.Broker_ID = FORM.Broker_List>
	</CFIF>
 </CFIF>
 
<CFPARAM name="FORM.Distributor_List" default="">
<CFSET FORM.Distributor_List = trim(FORM.Distributor_List)>
<CFIF len(FORM.Distributor_List) GT 0 AND FORM.Load_ID_From_Form EQ 1>
	<CFIF FORM.Distributor_List NEQ "0">
		<CFSET FORM.Distributor_ID = FORM.Distributor_List>
	</CFIF>
 </CFIF>
 
 <CFPARAM name="FORM.Operator_List" default="">
<CFSET FORM.Operator_List = trim(FORM.Operator_List)>
<CFIF len(FORM.Operator_List) GT 0 AND FORM.Load_ID_From_Form EQ 1>
	<CFIF FORM.Operator_List NEQ "0">
		<CFSET FORM.operator_iD = FORM.Operator_List>
	</CFIF>
<CFELSEIF LEN(FORM.Operator_List) EQ 0 AND IsDefined("getPayeeData.Operator_ID") AND LEN(getPayeeData.Operator_ID) GT 0>
	<CFSET FORM.operator_id = getPayeeData.Operator_ID>
</CFIF>
<!---<cfdump var="#form#"><cfabort>--->
<cfparam name="form.multiDistList"	default = "">
<cfset billbackSummaryManager = CreateObject("component", "components.Billback.BillbackSummaryManager") >
<cfset prodList = billbackSummaryManager.getBBProdDistIdList(FORM.Billback_ID)>
<cfset currentList = billbackSummaryManager.getBBCurrDistIdList(FORM.Billback_ID)>

<cfif form.multidistList eq "" and not isdefined("Form.FIELDNAMES")>
	<cfset getMultiDistList = billbackSummaryManager.getMultiDistList(form.Billback_ID) />
	<cfset form.multiDistList = valuelist(getMultiDistList.Distributor_ID)> 
<cfelse>
	<!--- Clean up the distributorList --->
	<cfset insertList = form.multiDistList>
	<cfset deleteList = ListCompare(currentList, insertList)>
	<cfset alertList  = ListCompare(prodList, insertList)>
	<cfset form.alertList = alertList>
</cfif>
 
<!--- Distributor Fields --->
<cfparam name="Form.Distributor_ID"						default="">
<cfparam name="Form.Distributor_Notes"					default="">

<!--- Unknown Distributor Fields --->
<cfparam name="Form.Unknown_Distributor_Name"			default="">
<cfparam name="Form.Unknown_Distributor_Address_1"		default="">
<cfparam name="Form.Unknown_Distributor_Address_2"		default="">
<cfparam name="Form.Unknown_Distributor_City"			default="">
<cfparam name="Form.Unknown_Distributor_State"			default="">
<cfparam name="Form.Unknown_Distributor_Zip"			default="">
<cfparam name="Form.Unknown_Distributor_Country_Code"			default="">
<cfparam name="Form.Unknown_Distributor_Notes"			default="">

<CFIF LoadBillback EQ 1 AND is_an_unknown_payee EQ 0 AND isdefined("getPayeeData.Distributor_ID") AND FORM.Load_ID_From_Form EQ 0>
	<CFSET FORM.Distributor_ID = getPayeeData.Distributor_ID>
	<CFSET FORM.Distributor_List = FORM.Distributor_ID>
	<CFSET Form.Distributor_Notes = getPayeeData.BB_Distributor_Notes>
</CFIF>

<CFIF LoadBillback EQ 1 AND is_an_unknown_payee EQ 1>
	<CFIF LoadBillbackData.Billback_Payee_Type_ID EQ 5>
		<CFSET Form.Unknown_Distributor_Name 		= getPayeeData.BB_Distributor_Name>
		<CFSET Form.Unknown_Distributor_Address_1 	= getPayeeData.BB_Distributor_Address1>
		<CFSET Form.Unknown_Distributor_Address_2 	= getPayeeData.BB_Distributor_Address2>
		<CFSET Form.Unknown_Distributor_City 		= getPayeeData.BB_Distributor_City>
		<CFSET Form.Unknown_Distributor_State 		= getPayeeData.BB_Distributor_State>
		<CFSET Form.Unknown_Distributor_Zip 		= getPayeeData.BB_Distributor_Zipcode>
		<CFSET Form.Unknown_Distributor_Country_Code 		= getPayeeData.BB_Distributor_Country_Code>
		<CFSET Form.Unknown_Distributor_Notes 		= getPayeeData.BB_Distributor_Notes>
	</CFIF>
</CFIF>


<!--- Broker Fields --->
<cfparam name="Form.Broker_ID"							default="">
<cfparam name="Form.Broker_Notes"						default="">

<!--- Unknown Broker Fields --->
<cfparam name="Form.Unknown_Broker_Name"				default="">
<cfparam name="Form.Unknown_Broker_Address_1"			default="">
<cfparam name="Form.Unknown_Broker_Address_2"			default="">
<cfparam name="Form.Unknown_Broker_City"				default="">
<cfparam name="Form.Unknown_Broker_State"				default="">
<cfparam name="Form.Unknown_Broker_Zip"					default="">
<cfparam name="Form.Unknown_Broker_Country_Code"					default="">
<cfparam name="Form.Unknown_Broker_Notes"				default="">

<CFIF LoadBillback EQ 1 AND is_an_unknown_payee EQ 0 AND isdefined("getPayeeData.Broker_ID") AND FORM.Load_ID_From_Form EQ 0>
	<CFSET FORM.Broker_ID = getPayeeData.Broker_ID>
	<CFSET Form.Broker_Notes = getPayeeData.BB_Broker_Notes>
</CFIF>

<CFIF LoadBillback EQ 1 AND is_an_unknown_payee EQ 1>
	<CFIF LoadBillbackData.Billback_Payee_Type_ID EQ 7>
		<CFSET Form.Unknown_Broker_Name 		= getPayeeData.BB_Broker_Name>
		<CFSET Form.Unknown_Broker_Address_1 	= getPayeeData.BB_Broker_Address1>
		<CFSET Form.Unknown_Broker_Address_2 	= getPayeeData.BB_Broker_Address2>
		<CFSET Form.Unknown_Broker_City 		= getPayeeData.BB_Broker_City>
		<CFSET Form.Unknown_Broker_State 		= getPayeeData.BB_Broker_State>
		<CFSET Form.Unknown_Broker_Zip 			= getPayeeData.BB_Broker_Zipcode>
		<CFSET Form.Unknown_Broker_Country_Code 			= getPayeeData.BB_Broker_Country_Code>
		<CFSET Form.Unknown_Broker_Notes 		= getPayeeData.BB_Broker_Notes>
	</CFIF>
</CFIF>

<!--- Operator Fields --->
<cfparam name="Form.operator_id"						default="">
<cfparam name="Form.Operator_Notes"						default="">

<!--- Unknown Operator Fields --->
<cfparam name="Form.Unknown_Operator_Name"				default="">
<cfparam name="Form.Unknown_Operator_Address_1"			default="">
<cfparam name="Form.Unknown_Operator_Address_2"			default="">
<cfparam name="Form.Unknown_Operator_City"				default="">
<cfparam name="Form.Unknown_Operator_State"				default="">
<cfparam name="Form.Unknown_Operator_Zip"				default="">
<cfparam name="Form.Unknown_Operator_Country_Code"				default="">
<cfparam name="Form.Unknown_Operator_Notes"				default="">

<CFIF LoadBillback EQ 1 AND is_an_unknown_payee EQ 0 AND isdefined("getPayeeData.Operator_ID") AND FORM.Load_ID_From_Form EQ 0>
	<CFSET FORM.operator_id = getPayeeData.Operator_ID>
	<CFSET Form.Operator_Notes = getPayeeData.BB_Operator_Notes>
</CFIF>

<CFIF LoadBillback EQ 1 AND is_an_unknown_payee EQ 1>
	<CFIF LoadBillbackData.Billback_Payee_Type_ID EQ 6>
		<CFSET Form.Unknown_Operator_Name 		= getPayeeData.BB_Operator_Name>
		<CFSET Form.Unknown_Operator_Address_1 	= getPayeeData.BB_Operator_Address1>
		<CFSET Form.Unknown_Operator_Address_2 	= getPayeeData.BB_Operator_Address2>
		<CFSET Form.Unknown_Operator_City 		= getPayeeData.BB_Operator_City>
		<CFSET Form.Unknown_Operator_State 		= getPayeeData.BB_Operator_State>
		<CFSET Form.Unknown_Operator_Zip 		= getPayeeData.BB_Operator_Zipcode>
		<CFSET Form.Unknown_Operator_Country_Code 	= getPayeeData.BB_Operator_Country_Code>
		<CFSET Form.Unknown_Operator_Notes 		= getPayeeData.BB_Operator_Notes>
	</CFIF>
</CFIF>


<!--- Other Fields --->	
<cfparam name="Form.Other_Name"							default="">
<cfparam name="Form.Other_Address_1"					default="">
<cfparam name="Form.Other_Address_2"					default="">
<cfparam name="Form.Other_City"							default="">
<cfparam name="Form.Other_State"						default="">
<cfparam name="Form.Other_Country_code"						default="">
<cfparam name="Form.Other_Zip"							default="">
<cfparam name="Form.Other_Notes"						default="">

<CFIF LoadBillback EQ 1 AND is_an_unknown_payee EQ 0>
	<CFIF LoadBillbackData.Billback_Payee_Type_ID EQ 4>
		<CFSET Form.Other_Name 			= getPayeeData.BB_UP_Name>
		<CFSET Form.Other_Address_1 	= getPayeeData.BB_UP_Address1>
		<CFSET Form.Other_Address_2 	= getPayeeData.BB_UP_Address2>
		<CFSET Form.Other_City 			= getPayeeData.BB_UP_City>
		<CFSET Form.Other_State 		= getPayeeData.BB_UP_State>
		<CFSET Form.Other_Country_Code 		= getPayeeData.BB_UP_Country_Code>
		<CFSET Form.Other_Zip 			= getPayeeData.BB_UP_Zipcode>
		<CFSET Form.Other_Notes 		= getPayeeData.BB_UP_Notes>
	</CFIF>
</CFIF>

<cfparam name="disablelinks" default="0">
<cfparam name="actionchange" default="0">

<cfif appsettings.getBillbackModifyAgree() EQ 1>
<cfquery name="getBB_AgreedInfo" datasource="#Application.Datasource#">
	SELECT 	count(*) as BB_AgreedCount
	FROM 	BB_Agreed_Info 
	WHERE 	Billback_ID =  '#Form.Billback_ID#'
	AND Deleted = 0	
</cfquery>	
<cfquery name="getBB_ModifyAgree" datasource="#Application.Datasource#">
	SELECT 	BB_modify_agree,BB_Modify_Agree_User
	FROM 	Billback 
	WHERE 	Billback_ID =  '#Form.Billback_ID#'
	AND Deleted = 0	
</cfquery>	

<cfif getBB_AgreedInfo.BB_AgreedCount GT 0>
<cfset disablelinks = 1>
</cfif>

<cfif getBB_AgreedInfo.BB_AgreedCount EQ 0>
<cfset actionchange = 0>
<cfelseif getBB_ModifyAgree.BB_modify_agree EQ 1 and getBB_AgreedInfo.BB_AgreedCount GT 0 and getBB_ModifyAgree.BB_Modify_Agree_User EQ request.AccessStructure.user_id>
<cfset actionchange = 0>
<cfset disablelinks = 0>
<cfelseif getBB_ModifyAgree.BB_modify_agree EQ 0 and getBB_AgreedInfo.BB_AgreedCount GT 0>
<cfset actionchange = 1>
<cfelseif getBB_ModifyAgree.BB_modify_agree EQ 1 and getBB_AgreedInfo.BB_AgreedCount GT 0 and getBB_ModifyAgree.BB_Modify_Agree_User NEQ request.AccessStructure.user_id>
<cfset actionchange = 1>
</cfif>
</cfif>


<!--- xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx --->
<!--- Get the states																				 --->
<!--- xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx --->
<CFQUERY NAME="Get_States" datasource="#application.datasource#">
	Select s.*, c.Country_Sort_Order
	from _states s
	join _country c on s.Country_ID = c.Country_ID
	ORDER BY  isnull(c.Country_Sort_Order, c.country_id) ASC
</CFQUERY>
<!--- Country code --->
<CFQUERY NAME="getCountry" datasource="#application.datasource#">
	SELECT *
	FROM _Country
	where active = 1
	ORDER BY Country_id ASC
</CFQUERY>

<cfset OnlyDistributorsUnderMe = 1 />
<cfif Get_Profile_Settings.BB_Add_Payee_Any_Position EQ 1>
	<cfset OnlyDistributorsUnderMe = 0 />
</cfif>

<CFSET PAGE_TITLE="Payee">
<!DOCTYPE HTML PUBLIC "-//W3C//DTD HTML 4.0 Transitional//EN">

<HTML>
<HEAD>
	<TITLE><CFOUTPUT>#PAGE_TITLE#</CFOUTPUT></TITLE>
	<LINK REL="STYLESHEET" TYPE="text/css" HREF="/common_files/main_style.css">
	<style type="text/css">
	 .odd{background-color: #EAFFEA;}
	 #tooltip {
	position: absolute;
	z-index: 3000;
	font-family: Arial;
	border: 1px solid #000;
	width: 130px;
	padding:10px;
	height: 25px;
	opacity: 0.8;
	background-color: #FFF;
}
#tooltip h3 {
	margin-bottom: 0.75em;
	font-size: 8pt;
	width: 130px;
	text-align: center;
}
#tooltip div { width: 220px; text-align: left; }
     </style>

	<SCRIPT language="JavaScript" src="/script/javascript/string_functions.js"></SCRIPT>
	<script>
		function initPage() {
<!--- 			<CFSET x = (form.default_payee - 1)>
			
			<CFIF x EQ 0>
				<CFSET x = 1>
			</CFIF> --->
			
			<CFOUTPUT>
			for(var y=0; y<BB_Payee_Type.length;y++){
				if(BB_Payee_Type[y].value == #form.default_payee#){
					/* true or false based on browser - IE 10 and above or IE 9 and below. 
					'1' as an argument below means "true". */
					BB_Payee_Type[y].checked = checkOrUncheckBeforeFireEvent(1);
					callfireEvent(document,document.BB_Payee_Type[y],'Click');
				}
			}
			</CFOUTPUT>
			
			<CFIF is_an_unknown_payee EQ 1 AND disableUnknown EQ 0>
				/* true or false based on browser - IE 10 and above or IE 9 and below. 
				'1' as an argument below means "true". */
				is_unknown.checked = checkOrUncheckBeforeFireEvent(1);
				callfireEvent(document,document.is_unknown,'Click');
			</CFIF>
		}
	</script>
	<cfinclude template="iframe_style.cfm">
	<link rel="stylesheet" type="text/css" href="/common_files/impromptu.css">
</HEAD>

<BODY BGCOLOR="White" TEXT="Black" LINK="Blue" VLINK="Blue" ALINK="Red" LEFTMARGIN="0" TOPMARGIN="0" onLoad="initPage();">
<SCRIPT SRC="/Script/javascript/dhtml.js"></SCRIPT>
<SCRIPT SRC="/Common_Files/Delete_Functions.js"></SCRIPT>
<!--- AjaxCFC calls --->
<script type="text/javascript" src="/Script/javascript/Ajax_JS/jquery-1.2.1-min.js"></script>
<script type="text/javascript" src="/Script/javascript/Ajax_JS/jquery.AjaxCFC.js"></script>
<script type="text/javascript" src="/Script/javascript/Ajax_JS/jquery.flydom-3.1.0.js"></script>
<script type="text/javascript" src="/Script/javascript/Ajax_JS/jquery.dimensions.js"></script>
<script type="text/javascript" src="/Script/javascript/Ajax_JS/jquery.bgiframe.js"></script>
<script type="text/javascript" src="/Script/javascript/Ajax_JS/jquery.tooltip.min.js"></script>

<script type="text/javascript" src="/Script/javascript/jquery-impromptu.3.1.min.js"></script>

	<script type="text/javascript">
		// additional files
		// $.AjaxCFC({require:'dDumper'});
		// more additional files
		// $.AjaxCFC({require:'jquery.fastSerialize'});

		// optional global settings
		// using these setters also automatically include dependencies
		$.AjaxCFCHelper.setDebug(false);
		$.AjaxCFCHelper.setBlockUI(false);
		$.AjaxCFCHelper.setUseDefaultErrorHandler(true);
		$.AjaxCFCHelper.setSerialization('json'); // json, wddx
	</script>
<script>
  
	var lastknownselectedradio = 0;
	function toggleDataScreens() {
		//is_unknown.disabled = false; 
		
		BB_Payee_Type_Data_1.style.display 					= 'none';
		BB_Payee_Type_Data_1_Form.style.display 			= 'none';
		BB_Payee_Type_Data_1_Unknown.style.display 			= 'none';
		BB_Payee_Type_Data_1_Unknown_Form.style.display 	= 'none';
		
		BB_Payee_Type_Data_2.style.display 					= 'none';
		BB_Payee_Type_Data_2_Form.style.display 			= 'none';
		BB_Payee_Type_Data_2_Unknown.style.display 			= 'none';
		BB_Payee_Type_Data_2_Unknown_Form.style.display 	= 'none';
		// multiDistHead.style.display                         = 'none';
	
		BB_Payee_Type_Data_3.style.display 					= 'none';
		BB_Payee_Type_Data_3_Form.style.display 			= 'none';
		BB_Payee_Type_Data_3_Unknown.style.display 			= 'none';
		BB_Payee_Type_Data_3_Unknown_Form.style.display 	= 'none';
				
		BB_Payee_Type_Data_4.style.display 					= 'none';
		BB_Payee_Type_Data_4_Form.style.display 			= 'none';
		BB_Payee_Type_Data_4_Unknown.style.display 			= 'none';
		BB_Payee_Type_Data_4_Unknown_Form.style.display 	= 'none';

		
			eval('BB_Payee_Type_Data_'+event.srcElement.value+'.style.display = "block"')
			eval('BB_Payee_Type_Data_'+event.srcElement.value+'_Form.style.display = "block"')
			document.all.selected_bb_payee_type.value = event.srcElement.value
			document.all.selected_bb_payee_type_is_unknown.value = 0

			lastknownselectedradio = event.srcElement.value;
		
		// set a spacer so that there is enough space for message display
		var divHeight = parseFloat(document.all.divSpacer.style.height);
		if(isNaN(divHeight)) divHeight = 0;
		
		var newDivHeight = 500-window.document.body.scrollHeight+divHeight;
		if(newDivHeight<=0) newDivHeight = 10;
		
		document.all.divSpacer.style.height = newDivHeight;
		
		document.BB_Payee_Form.Default_Payee.value = event.srcElement.value;
		
		try { window.parent.dyniframesize(); } catch (err) { };
		
	}

	function searchData(typeofdata){
		switch (typeofdata) {
			case "br" :
				NewWindow("../search_screens/pm_select_brokers.cfm?Formname=broker_form", "brokerwindow", 850, 600, "yes", "yes")
			break;

			case "di" :
				NewWindow("../search_screens/PM_select_distributors.cfm?Formname=distributor_form&OnlyDistributorsUnderMe=<cfoutput>#OnlyDistributorsUnderMe#</cfoutput>", "distributorwindow", 850, 600, "yes", "yes")
			break;
			case "diMulti" :
				NewWindow("../search_screens/PM_select_distributors.cfm?Formname=multiDist_form&SelectSingleSearchResultOnly=0&FieldName=multiDistList&OnlyDistributorsUnderMe=<cfoutput>#OnlyDistributorsUnderMe#</cfoutput>", "distributorwindow", 850, 600, "yes", "yes")
			break;
			
			case "diMultiOp" :
				NewWindow("../search_screens/PM_select_distributors.cfm?Formname=operator_form&SelectSingleSearchResultOnly=0&FieldName=multiDistList&OnlyDistributorsUnderMe=<cfoutput>#OnlyDistributorsUnderMe#</cfoutput>", "distributorwindow", 850, 600, "yes", "yes")
			break;

			case "diMultiBr" :
				NewWindow("../search_screens/PM_select_distributors.cfm?Formname=broker_form&SelectSingleSearchResultOnly=0&FieldName=multiDistList&OnlyDistributorsUnderMe=<cfoutput>#OnlyDistributorsUnderMe#</cfoutput>", "distributorwindow", 850, 600, "yes", "yes")
			break;

			case "op" :
				NewWindow("../search_screens/PM_select_operators.cfm?Formname=operator_form", "operatorwindow", 850, 600, "yes", "yes")
			break;
			
			case "vn":
				if (document.BB_Payee_Form.distributor_id.value != "") 
				{
					NewWindow("/GL_Code/Vendor_Management/Vendor_Cross_Ref_Search.cfm?Formname=BB_Payee_Form&Distributor_ID="+document.BB_Payee_Form.distributor_id.value, "Vensearchwindow", 850, 600, "yes", "yes")
				}
				else
				{
					NewWindow("/GL_Code/Vendor_Management/Vendor_Cross_Ref_Search.cfm?Formname=BB_Payee_Form&operator_id="+document.BB_Payee_Form.operator_id.value, "Vensearchwindow", 850, 600, "yes", "yes")
				}				
			break;
			
			case "vm":
				if (document.BB_Payee_Form.distributor_id.value != "") 
				{
					NewWindow("/GL_Code/Vendor_Management/Vendor_Master_Search.cfm?Formname=BB_Payee_Form", "Vensearchwindow", 850, 600, "yes", "yes")
				}
				else
				{
					NewWindow("/GL_Code/Vendor_Management/Vendor_Master_Search.cfm?Formname=BB_Payee_Form", "Vensearchwindow", 850, 600, "yes", "yes")
				}				
			break;
			
		}
	}
	
	function AssociateShipTo(formName)
	{
		NewWindow("../search_screens/PM_select_distributors.cfm?Formname=" + formName + "&FieldName=Associated_Ship_To&OnlyDistributorsUnderMe=<cfoutput>#OnlyDistributorsUnderMe#</cfoutput>", "distributorwindow", 850, 600, "yes", "yes")
	}
	
	function deleteThisCust(custID, bgCol)
		{	
			var srcObj = event.srcElement;
			var trObj = getParentObject(srcObj, "tr");
			var trIndex = trObj.rowIndex;

			/* If payee selected is a "broker" */
			if(document.all.selected_bb_payee_type.value == 3){
				var FINALITEMLIST = document.broker_form.multiDistList.value;	
			}
			/* If payee selected is an "operator" */
			else{
				var FINALITEMLIST = document.operator_form.multiDistList.value;	
			}
			var resultString = ListDeleteItem(FINALITEMLIST, ",", custID);
			var bDelete = true;
			var startDataCol = 1;
			var objGroupLevel;
			//document.KnownProgramForm.Count_ID.value = Program_Count_ID;
			if(resultString == FINALITEMLIST)
			{
				resultString = ListAppendItem(FINALITEMLIST, ",", custID);
				bDelete = false;
			}
			/* If payee selected is a "broker" */
			if(document.all.selected_bb_payee_type.value == 3){
				document.broker_form.multiDistList.value = resultString;
			}
			/* If payee selected is an "operator" */
			else{
				document.operator_form.multiDistList.value = resultString;
			}

			document.BB_Payee_Form.multiDistList.value = resultString;
			document.all.multiDistList.value = resultString;
			var empty_String = "<IMG SRC=\"/Images/fill.gif\" width=\"1\" height=\"1\">";	
			if(trObj)
			{
				if(bDelete)
				{ 
					trObj.height = trObj.offsetHeight;
					
					//trObj.cells[trObj.cells.length-1].innerHTML = empty_String;
					for (i=1; i<=trObj.cells.length-2; i++)
					{
					disableDiv(trObj.cells[i+startDataCol], true, false);
					}
					
					propogateProperty(trObj, "style.backgroundColor", "#DDDDDD", false);
					propogateProperty(trObj, "style.textDecoration", "line-through", true);				
					
					srcObj.title = "undo customer deletion";
					srcObj.src = undodeleteImg.src;
					//document.KnownProgramForm.Data_Action_ID.value = 5;
					//document.KnownProgramForm.prodUpdate.value = 1;
					//resetnavigate();
				}
				else
				{
					
					for (i=1; i<=trObj.cells.length-2; i++)
					{
					disableDiv(trObj.cells[i+startDataCol], false, false);
					}
					//var bgCol = "FFFFFF";
					//if(trObj.rowIndex % 2 == 1)
					//{
					//	bgCol = "C6FFC6";
					//}
					propogateProperty(trObj, "style.backgroundColor", bgCol, false);
					propogateProperty(trObj, "style.textDecoration", "none", false);
					
					srcObj.title = "delete this customer";
					srcObj.src = deleteImg.src;
					//document.KnownProgramForm.prodUpdate.value = 1;
					propogateProperty(trObj, "style.backgroundColor", "FFFFFF", false, true);
					
				}
	
				srcObj.bDelete = !bDelete;
				trObj.bDelete = (bDelete?1:0);
			}
			
		}
		
		function getCustomerPayee(id){
			if (id)
			{
			$.AjaxCFC({
            url: "/components/billback/BBPayee.cfc", // your CFC
            method: "customerPayeeInfo",
            //data: id,
			data: {"shipTo":id,"bBySingleId":1},
            serialization: "json",
            success: function(r){ 
            if (r.recordcount > 0){
            // Change or add Distributor Name
						if(r.data[0].shr_ship_to != ''){
            $("#distName").html(r.data[0].name + "<br />" + r.data[0].shr_ship_to);
						}
						else{
					  $("#distName").html(r.data[0].name + "<br />" + r.data[0].ship_to);
						}
            $("#distName").click(function() {
              NewWindow('/profiles/Distributors/Distributor_profile.cfm?DID='+r.data[0].bsa_foodservice_customers_id,'name','400','450','Yes', 'No');
              return false;
             });
            // Change or add distributor Address Info
            $("#distAddrInfo").html(r.data[0].address_1 + "<br />");
            $("#distAddrInfo").append(r.data[0].city + ",");
            $("#distAddrInfo").append(r.data[0].state + " ");
            $("#distAddrInfo").append(r.data[0].zipcode + " ");
            $("#distAddrInfo").append(r.data[0].country_code);
            $("#distAddrInfo").click(function() {
              NewWindow('/profiles/Distributors/Distributor_profile.cfm?DID='+r.data[0].bsa_foodservice_customers_id,'name','400','450','Yes', 'No');
              return false;
             });
			<cfif not variables.appSettings.getDistributorMultiPosition()>
            // Change or add Broker Name
            $("#distBrokerName").html(r.data[0].broker_name);
            $("#distBrokerName").click(function() {
              NewWindow('/profiles/Distributors/Distributor_profile.cfm?DID='+r.data[0].bsa_foodservice_customers_id,'name','400','450','Yes', 'No');
              return false;
             });
            </cfif>
			$("#distFamName").html(r.data[0].family_name + "<br />");
			$("#distFamName").append(r.data[0].buying_group_name);
			$("#distFamName").click(function() {
              NewWindow('/profiles/Distributors/Distributor_profile.cfm?DID='+r.data[0].bsa_foodservice_customers_id,'name','400','450','Yes', 'No');
              return false;
             });
			document.all.BB_Payee_Form.distributor_id.value = r.data[0].bsa_foodservice_customers_id;
			$("#noCustSelected").hide();
			 	try { window.parent.dyniframesize(); } catch (err) { };    
             }
			else
			{
				alert('There is no <cfoutput>#lcase(application.returned_customer_setting.distributor_label_singular)#</cfoutput> listed with that ID');
				document.all.BB_Payee_Form.custId.focus();
				return false;
			}
            }
           });
		 }
		}
		
		  function getBrokerPayee(id){
		   if (id)
		   {
			$.AjaxCFC({
            url: "/components/billback/BBPayee.cfc", // your CFC
            method: "vendorPayee",
            data: id,
            serialization: "json",
            success: function(r){ 
            if (r.recordcount > 0){
            // Change or add Broker Name
            $("#brkrname").html(r.data[0].broker_name + "<br />" + r.data[0].broker_shard);
            
            // Add click event to cell so we can show the new broker
            $("#brkrname").click(function() {
             NewWindow('/Profiles/Brokers/Broker_profile.cfm?BID='+r.data[0].bsa_foodservice_brokers_id,'name','400','450','Yes', 'No');
             });
            
            // Change or add Broker Address Info
            $("#brkrAddress").html(r.data[0].address);
            if (r.data[0].address_2 != "")
            {
            	$("#brkrAddress").append( "<br />" + r.data[0].address_2 + "<br />");
            }
            $("#brkrAddress").append(r.data[0].city + ",");
            $("#brkrAddress").append(r.data[0].state + " ");
            $("#brkrAddress").append(r.data[0].zip + " ");
             // Add click event to cell so we can show the new broker
            $("#brkrAddress").click(function() {
             NewWindow('/Profiles/Brokers/Broker_profile.cfm?BID='+r.data[0].bsa_foodservice_brokers_id,'name','400','450','Yes', 'No');
             });
            $("#brkrRegion").html(r.data[0].region_name + "<br />");
			$("#brkrRegion").append(r.data[0].zone_name);
			// Add click event to cell so we can show the new broker
			$("#brkrRegion").click(function() {
             NewWindow('/Profiles/Brokers/Broker_profile.cfm?BID='+r.data[0].bsa_foodservice_brokers_id,'name','400','450','Yes', 'No');
             });
			// The form fields need to be updated with the new value for saving
			document.all.broker_form.broker_id.value = r.data[0].bsa_foodservice_brokers_id;
			document.all.broker_form.Broker_List.value = r.data[0].bsa_foodservice_brokers_id;
			document.all.BB_Payee_Form.broker_id.value = r.data[0].bsa_foodservice_brokers_id;
			// Hide the No Brokers found message
			$("#brkrEmpty").hide();
			<cfset Can_Associated_Ship_To = 1 />;
			$("#associateMultiDistBrk").show();
			$("#multiDistHeadBrk").show();
			$("#showCustomerSearchBrk").show();
    			$("#shipToAssociateIdBrk").show(); 
			try { window.parent.dyniframesize(); } catch (err) { };
             }
			else
			{
				alert('There is no <cfoutput>#application.returned_customer_setting.broker_label_singular#</cfoutput> listed with that ID');
				document.all.broker_form.brkrId.focus();
				return false;
			}
            }
           });
		 }
		}
		
			  function getOperatorPayee(id){
		  if (id)
		  {
			$.AjaxCFC({
            url: "/components/billback/BBPayee.cfc", // your CFC
            method: "operatorPayee",
            data: id,
            serialization: "json",
            success: function(r){ 
            if (r.recordcount > 0){
            // Change or add Broker Name
            $("#oprName").html(r.data[0].operator_name + "<br />");
             if (r.data[0].legacy_id == "")
             {
             	$("#oprName").append(r.data[0].bsa_operator_id);
             }
             else {
             	$("#oprName").append(r.data[0].legacy_id);
             }
            // Add click event to cell so we can show the new broker
            $("#oprName").click(function() {
             NewWindow('/profiles/operators/operator_profile.cfm?OID='+r.data[0].bsa_operator_id,'name','400','450','Yes', 'No');
             return false;
             });
            
            // Change or add Broker Address Info
            $("#oprLocType").html(r.data[0].operator_location_type);
             // Add click event to cell so we can show the new broker
            $("#oprLocType").click(function() {
              NewWindow('/profiles/operators/operator_profile.cfm?OID='+r.data[0].bsa_operator_id,'name','400','450','Yes', 'No');
              return false;
             });
            $("#oprLocation").html(r.data[0].operator_city + " - ");
			$("#oprLocation").append(r.data[0].operator_state);
			// Add click event to cell so we can show the new broker
			$("#oprLocation").click(function() {
              NewWindow('/profiles/operators/operator_profile.cfm?OID='+r.data[0].bsa_operator_id,'name','400','450','Yes', 'No');
              return false;
             });
             
             $("#oprNumLocations").html(r.data[0].operator_number_of_locations + "&nbsp;");
             $("#oprNumLocations").click(function() {
             NewWindow('/profiles/operators/operator_profile.cfm?OID='+r.data[0].bsa_operator_id,'name','400','450','Yes', 'No');
             return false;
             });
             
             $("#oprDba").html("&nbsp;" + r.data[0].operator_dba);
             $("#oprDba").click(function() {
             NewWindow('/profiles/operators/operator_profile.cfm?OID='+r.data[0].bsa_operator_id,'name','400','450','Yes', 'No');
             return false;
             });

			// The form fields need to be updated with the new value for saving
			document.all.operator_form.operator_id.value = r.data[0].bsa_operator_id;
			document.all.BB_Payee_Form.operator_id.value = r.data[0].bsa_operator_id;
			document.all.operator_form.Operator_List.value = r.data[0].bsa_operator_id;
			// Hide the No Brokers found message
			$("#operatorEmpty").hide();
			<cfset Can_Associated_Ship_To = 1 />;
			$("#associateMultiDist").show();
			$("#multiDistHead").show();
			$("#showCustomerSearch").show();
    	$("#shipToAssociateId").show(); 
		try { window.parent.dyniframesize(); } catch (err) { };     
			//$("#shipToAssociateId").focus();
             }
			else
			{
				alert('There is no <cfoutput>#application.returned_customer_setting.operator_label_singular#</cfoutput> listed with that ID');
				document.all.operator_form.oprId.focus();
				return false;
			}
            }
           });
		 }
		}
		
		function getMultiDist(id){
		if (id)
		{
		var canAssociateMultiple = <cfoutput>#appSettings.getMultiDistributorBB()#</cfoutput>
		var Shr_Ship_To_OR_Ship_To;
		$.AjaxCFC({
		url: "/components/billback/BBPayee.cfc", // your CFC
		method: "customerPayeeInfo",
		data: id,
  serialization: "json",
  success: function(r){ 
     /* If payee selected is a "broker" */
     if(document.all.selected_bb_payee_type.value == 3){
	var frmName = 'broker_form';
	var multi_ship_To_Table = 'multiShipToTableBrk';
     }
     /* If payee selected is an "operator" */
     else{
	var frmName = 'operator_form';
	var multi_ship_To_Table = 'multiShipToTable';
     }

  // If the bsa_foodservice_customers_id exists in the list then don't add it again
 if (r.recordcount > 0 && ListFindItem('document.'+frmName+'.multiDistList.value',",",r.data[0].bsa_foodservice_customers_id) == -1){   
   // If only one Distributor can be added then
   // delete any table rows that may exist
   if (canAssociateMultiple == 0) { 
	    $('#'+multi_ship_To_Table+' tr').remove();
	
			if(r.data[0].shr_ship_to != ''){
				Shr_Ship_To_OR_Ship_To = r.data[0].shr_ship_to;
			}
			else{
				Shr_Ship_To_OR_Ship_To = r.data[0].ship_to;
			}
     // Re-populate table with new customer Id using jquery plugin
     // called jquery.flydom-3.1.0.js
    $('#'+multi_ship_To_Table).createAppend(
     'table', { border: '0', cellspacing: '0', cellpadding: '3', align: 'center', width: '100%', className: 'MainTable'}, [
      'tr', {}, [
         'td',{colSpan:'2', style: 'cursor:pointer'},"<img bDelete='true' name='IMG_Delete_Scissor' src='/images/scissor.gif' onclick=\"deleteThisCust(\'" + r.data[0].bsa_foodservice_customers_id + "')\" title='click here to delete this customer' border='0' />",
         'td', { style: 'color: black;' }, r.data[0].name + "<br />" + Shr_Ship_To_OR_Ship_To,
         'td', { style: 'color: black;' }, r.data[0].address_1 + "<br />" + r.data[0].city + "," + r.data[0].state + " " + r.data[0].zipcode + " " + r.data[0].country_code,
         <cfif not variables.appSettings.getDistributorMultiPosition()>
         // Change or add Broker Name
         'td', {style: 'color:black;'},'&nbsp;' + r.data[0].broker_name,
         </cfif>
         'td', {style: 'color:black;'}, r.data[0].family_name + "<br />" + r.data[0].buying_group_name
       ]
     ]
      );
 // we only want to store one value here. If multiple ship to's have been 
 // entered then we grab only the first value

 	document.BB_Payee_Form.Associated_Ship_To.value = r.data[0].bsa_foodservice_customers_id;//D32305 When selecting a distr to associate to operator payee can't enter distr num
	/* If payee selected is a "broker" */
	if(document.all.selected_bb_payee_type.value == 3){
		document.broker_form.multiDistList.value = r.data[0].bsa_foodservice_customers_id;
	}
	/* If payee selected is an "operator" */
	else{
		document.operator_form.multiDistList.value = r.data[0].bsa_foodservice_customers_id;
	}
	document.BB_Payee_Form.multiDistList.value = r.data[0].bsa_foodservice_customers_id;
	document.all.multiDistList.value = r.data[0].bsa_foodservice_customers_id;
	}
	// If the multidistributor app setting is on then we loop
	// through all the values returned
	else {
	var Shr_Ship_To_OR_Ship_To;
	for (i = 0; i < r.recordcount; i++) {
	if(r.data[i].shr_ship_to != ''){
	Shr_Ship_To_OR_Ship_To = r.data[i].shr_ship_to;
	}
	else{
	Shr_Ship_To_OR_Ship_To = r.data[i].ship_to;
	}
	$('#'+multi_ship_To_Table).createAppend(
	'table', { border: '0', cellspacing: '0', cellpadding: '3', align: 'center', width: '100%', className: 'MainTable'}, [
  'tr', {}, [
         'td',{colSpan:'2', style: 'cursor:pointer'},"<img bDelete='true' name='IMG_Delete_Scissor' src='/images/scissor.gif' onclick=\"deleteThisCust(\'" + r.data[i].bsa_foodservice_customers_id + "')\" title='click here to delete this customer' border='0' />",
         'td', { style: 'color: black;' }, r.data[i].name + "<br />" + Shr_Ship_To_OR_Ship_To,
         'td', { style: 'color: black;' }, r.data[i].address_1 + "<br />" + r.data[i].city + "," + r.data[i].state + " " + r.data[i].zipcode + " " + r.data[i].country_code,
         <cfif not variables.appSettings.getDistributorMultiPosition()>
         // Change or add Broker Name
         'td', {style: 'color:black;'},'&nbsp;' + r.data[i].broker_name,
         </cfif>
         'td', {style: 'color:black;'}, r.data[i].family_name + "<br />" + r.data[i].buying_group_name
       ]
     ]
      );
	if (document.operator_form.multiDistList.value.length >= 1) {
	document.operator_form.multiDistList.value += "," + r.data[i].bsa_foodservice_customers_id;
	document.BB_Payee_Form.multiDistList.value = document.operator_form.multiDistList.value;
 	document.all.multiDistList.value = document.operator_form.multiDistList.value;

	}
	else {
	document.operator_form.multiDistList.value = r.data[i].bsa_foodservice_customers_id;
	document.BB_Payee_Form.multiDistList.value = r.data[i].bsa_foodservice_customers_id;
	 document.all.multiDistList.value = r.data[i].bsa_foodservice_customers_id;
	}
	}
   }
   // alternate row colors
      $('#'+multi_ship_To_Table +' tr:nth-child(odd)').addClass("odd");
	/*Milan 14351 - To be on the safe side, add this function to dynamically change the size of the page,
	while adding multiple distributors */
	try { window.parent.dyniframesize(); } catch (err) { };
	}

 	 }

 	});
	}

	}	

		
		  function getVendor(id){
		   if (id)
		   {
			$.AjaxCFC({
            url: "/components/billback/BBPayee.cfc", // your CFC
            method: "getVendorById",
            data: id,
            serialization: "json",
            success: function(r){ 
            if (r.recordcount > 0){
			$("#vendorTable").show();
              // Change or add Broker Name
            $("#vendorid").html(r.data[0].vendor_id);

            // Change or add Broker Address Info
            $("#vendorname").html(r.data[0].vendorname);
            
			if (r.data[0].address_1 != "")
            {
            	$("#vendoraddress").html(r.data[0].vendoraddress1 + "<br />");
            }
			if (r.data[0].address_2 != "")
            {
            	$("#vendoraddress").append(r.data[0].vendoraddress2 + "<br />");
            }
			if (r.data[0].city != "")
			{
				$("#vendoraddress").append(r.data[0].vendorcity + ",");
			}			
            if (r.data[0].state != "")
			{
			  $("#vendoraddress").append(r.data[0].vendorstate + " ");
			}
            if (r.data[0].zipcode != "")
			{
			  $("#vendoraddress").append(r.data[0].vendorzipcode + " ");
			}

			// The form fields need to be updated with the new value for saving
			document.all.BB_Payee_Form.Vendor_ID.value = r.data[0].vendor_id;
			// Hide the No Brokers found message
			$("#noVendor").hide();
			try { window.parent.dyniframesize(); } catch (err) { };
             }
			else
			{
				alert('There is no vendor listed with that ID');
				document.all.BB_Payee_Form.vendorId.value = '';
				document.all.BB_Payee_Form.vendorId.focus();
				return false;
			}
            }
           });
		 }
		}
		
		$(document).ready(function() {
    	 var canAssociateMultiple = <cfoutput>#appSettings.getMultiDistributorBB()#</cfoutput>    
		if(canAssociateMultiple !=0){
		/* If payee selected is a "broker" */
		  if(document.all.selected_bb_payee_type.value == 3){
			var shipTo_Associate_Id = 'shipToAssociateIdBrk';
			var shipTo_Associate_Id_big = 'shipToAssociateIdbigBrk';
		  }
		  /* If payee selected is an "operator" */
		  else{
			var shipTo_Associate_Id = 'shipToAssociateId';
			var shipTo_Associate_Id_big = 'shipToAssociateIdbig';
		  }

		  $('#'+shipTo_Associate_Id).focus(function(){
		   	$('#'+shipTo_Associate_Id).animate({ height: 'hide', opacity: 'hide' }, 'fast');
		  });	
		  
		  $('#'+shipTo_Associate_Id).blur(function(){
		   	 $('#'+shipTo_Associate_Id_big).animate({ height: 'show', opacity: 'show' }, 'slow');		   	 
		   	 });

		  $('#'+shipTo_Associate_Id_big).focus(function(){
		   	  if ($('#'+shipTo_Associate_Id_big).is(':visible') == true) {
		   	  	this.focus();
		   	  }		   	 
		   	 });
		  
		  $('#'+shipTo_Associate_Id_big).blur(function() {
		   	getMultiDist(this.value);
		    $('#'+shipTo_Associate_Id_big).val("");
		    $('#'+shipTo_Associate_Id_big).animate({ height: 'hide', opacity: 'hide' }, 'fast');
			$('#'+shipTo_Associate_Id).animate({ height: 'show', opacity: 'show' }, 'slow');
		   }
		  );
		   
		 $('#'+shipTo_Associate_Id_big).Tooltip({
  			delay: 0,
  			track: true,
  			event: "focus"
		 });
		}});
		

</script>


<CFSET DIST_SHOW = 0>
<CFSET DIST_UNKNOWN_SHOW = 0>
<CFSET OP_SHOW = 0>
<CFSET OP_UNKNOWN_SHOW = 0>
<CFSET BROKER_SHOW = 0>
<CFSET BROKER_UNKNOWN_SHOW = 0>
<CFSET OTHER_SHOW = 0>

<CFSWITCH EXPRESSION="#form.default_payee#">
	<CFCASE VALUE="1">
		<CFIF is_an_unknown_payee EQ 0>
			<CFSET DIST_SHOW = 1>
		<CFELSE>
			<CFSET DIST_UNKNOWN_SHOW = 1>
		</CFIF>
	</CFCASE>
	<CFCASE VALUE="2">
		<CFIF is_an_unknown_payee EQ 0>
			<CFSET OP_SHOW = 1>
		<CFELSE>
			<CFSET OP_UNKNOWN_SHOW = 1>
		</CFIF>
	</CFCASE>
	<CFCASE VALUE="3">
		<CFIF is_an_unknown_payee EQ 0>
			<CFSET BROKER_SHOW = 1>
		<CFELSE>
			<CFSET BROKER_UNKNOWN_SHOW = 1>
		</CFIF>
	</CFCASE>
	<CFCASE VALUE="4">
		<CFSET OTHER_SHOW = 1>
	</CFCASE>
</CFSWITCH>
<CFSET Payee_Label_Text = "#application.returned_customer_setting.distributor_label_singular#,#application.returned_customer_setting.operator_label_singular#,#application.returned_customer_setting.broker_label_singular#">

&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; 
<CFINCLUDE TEMPLATE="/helpsystem/help_link.cfm">


<CFIF Not Scheduled_Auto_BB> <!--- Lock down the Form if it is scheduled...Decisions are made by the software for the Auto BB --->
<TABLE align="center">
	<TR>
		<TD align="center">select the payee:</TD>
		<cfoutput><TD>
    <!--- D18281 Anand Rao/29-May-09 Added BB_Closing_Method EQ 5 in condition for Credit Memo --->
		<input type="Radio" name="BB_Payee_Type" value="1"  onclick="toggleDataScreens()" labeltext="#ListGetAt(Payee_Label_Text, 1)#"<CFIF DIST_SHOW OR DIST_UNKNOWN_SHOW>  CHECKED</CFIF>>#application.returned_customer_setting.distributor_label_singular#&nbsp;
		<input type="Radio" name="BB_Payee_Type" value="2" onClick="toggleDataScreens()" labeltext="#ListGetAt(Payee_Label_Text, 2)#"<CFIF OP_SHOW OR OP_UNKNOWN_SHOW>  CHECKED</CFIF> <CFIF BB_Closing_method EQ 2 OR BB_Closing_method EQ 5>DISABLED</CFIF>>#application.returned_customer_setting.operator_label_singular#<!--- Operator --->&nbsp;
		<input type="Radio" name="BB_Payee_Type" value="3" onClick="toggleDataScreens()" labeltext="#ListGetAt(Payee_Label_Text, 3)#"<CFIF BROKER_SHOW OR BROKER_UNKNOWN_SHOW>  CHECKED</CFIF> <CFIF disableUnknown OR BB_Closing_method EQ 2 OR BB_Closing_method EQ 5>DISABLED</CFIF>>#application.returned_customer_setting.broker_label_singular#&nbsp;
		<!--- <input type="Radio" name="BB_Payee_Type" value="4" onClick="toggleDataScreens()" labeltext="#ListGetAt(Payee_Label_Text, 4)#"<CFIF OTHER_SHOW>  CHECKED</CFIF>>Other&nbsp; --->
			<!--- Dev Note: Milan 10380 --->
			
			<!---BJF per label D10783 all unknowns are being removed--->
		<!--- <cfif variables.appSettings.getAllowUnKnownPayeeInBillback() ><input type="Checkbox" name="is_unknown" onClick="toggleDataScreens()" <CFIF (OTHER_SHOW EQ 1) OR (disableUnknown EQ 1)>DISABLED</CFIF> <CFIF OTHER_SHOW EQ 0 AND is_an_unknown_payee EQ 1> CHECKED</CFIF>>Unknown <span id="unknownLabel">#ListGetAt(Payee_Label_Text, form.default_payee)#</span>
		<cfelse><span id="unknownLabel" style="visibility:hidden"></span><input type="hidden" name="is_unknown" value="0"></cfif>---></TD></cfoutput>
	</TR>
</TABLE>
<cfelse>
	<cfoutput>
		<CFIF DIST_SHOW OR DIST_UNKNOWN_SHOW>
			<input type="Hidden" name="BB_Payee_Type" value="1">
		<CFELSEIF OP_SHOW OR OP_UNKNOWN_SHOW>
			<input type="Hidden" name="BB_Payee_Type" value="2">
		<CFELSEIF BROKER_SHOW OR BROKER_UNKNOWN_SHOW>	
			<input type="Hidden" name="BB_Payee_Type" value="3">
		<CFELSEIF OTHER_SHOW>	
			<input type="Hidden" name="BB_Payee_Type" value="4">
		</CFIF>
			<span style="visibility: hidden;"><input type="Checkbox" name="is_unknown"></span>	
	</cfoutput>
	
</CFIF> 
