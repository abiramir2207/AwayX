<CF_MessageWindow>
<SCRIPT>
	var bFormSubmitted = 0;
	function CheckForErrors(redirect, disableClickedButtonName) {

		ErrorCount = 0;
		is_unkown_type = 0;
		var shiptToLabel = "<cfoutput>#LCase(application.returned_customer_setting.shard_ship_to_label)#</cfoutput>";
		<cfoutput>
		var savedPayeeType = "#savedPayeeType#";
		var savedPayeeID = "#savedPayeeID#";
		var showDistributorChoices = 0;
		var showOperatorChoices = 0;
		var showBrokerChoices = 0;
		var prodList = "#prodList#";
		var CountDistributor = "#CountDistributor#";//D30517: Item not appearing on Billback 'programs' page after importing it
		</cfoutput>
		
		//Use the app setting "Allow Multi Distributor Billbacks:"
		<cfif appSettings.getMultiDistributorBB()>
			var associatedShipTo = document.BB_Payee_Form.multiDistList.value;
		<cfelse>
			var associatedShipTo = document.BB_Payee_Form.Associated_Ship_To.value;
		</cfif>

		switch(lastknownselectedradio) {
		
			

			case "1": //distributor
				

						<!---  DISTRIBUTOR is selected --->
						error_text 		= "Please select a <cfoutput>#lcase(application.returned_customer_setting.distributor_label_singular)#</cfoutput>";
						error_oSpan 	= document.all.error_distributor_select;

						if(document.all.distributor_id.value.length == 0) {
							ErrorCount++;
							queueMessage(error_text, error_oSpan);
						}
						else
						{
							clearQueue(error_oSpan);
						}

						<!---  notes --->
						error_text 		= "Notes may not be longer than 4000 characters. Please reduce the length of your notes.";
						error_oSpan 	= document.all.distributor_notes_error;
						if(document.all.Distributor_Notes.value.length > 3999) {
							ErrorCount++;
							queueMessage(error_text, error_oSpan);
						}
						else
						{
							clearQueue(error_oSpan);
						}	
						
						<!---  D29495: check for payee selection change --->						
						if(ErrorCount == 0 && savedPayeeType != "0" && savedPayeeType != ""){
							if(	(savedPayeeType == 1 && savedPayeeID != document.all.distributor_id.value && associatedShipTo != document.all.distributor_id.value) || 
								(savedPayeeType == 2 && associatedShipTo != document.all.distributor_id.value) ||
								(savedPayeeType != 1 && savedPayeeType != 2)
								){
								//payee was distributor but is different from previously selected payee and is different from previous associated ship to
								//or payee was operator and current payee is different from previous associated ship to
								//or payee was not distributor or operator 
								showDistributorChoices = 1;
							}
						}
					
			break;

			case "2": //Operator
			
						var checkShipTo = "<CFOUTPUT>#Ship_To_For_Operator#</CFOUTPUT>";	
									
						<!---  operator is selected --->
						error_text 		= "Please select an <cfoutput>#application.returned_customer_setting.operator_label_singular#</cfoutput>";
						error_oSpan 	= document.all.error_operator_select;
						if(document.operator_form.operator_id.value.length == 0) {
							ErrorCount++;
							queueMessage(error_text, error_oSpan);
						}
						else
						{
							clearQueue(error_oSpan);
						}
						if (checkShipTo == 1)
						{				
							<!---  operator is selected --->
							error_text 		= "Please associate a " +shiptToLabel +" to this <cfoutput>#application.returned_customer_setting.operator_label_singular#</cfoutput>.";
							error_oSpan 	= document.all.error_Associate_ShipTo;
							<!---  D29495: check for payee selection change 
							Require associated ship to
							--->
							if (associatedShipTo == "")  {
								ErrorCount++;
								queueMessage(error_text, error_oSpan);
							}
							else
							{
								clearQueue(error_oSpan);
							}
						}
						
						<!---  notes --->
						error_text 		= "Notes may not be longer than 4000 characters. Please reduce the length of your notes.";
						error_oSpan 	= document.all.operator_notes_error;
						if(document.all.Operator_Notes.value.length > 3999) {
							ErrorCount++;
							queueMessage(error_text, error_oSpan);
						}
						else
						{
							clearQueue(error_oSpan);
						}	
						
						<!---  D29495: check for payee selection change --->						
						//compare prodList (distributor id for saved products) with multiDistList/Associated_Ship_To (associatedShipTo)
						if(ErrorCount == 0 && prodList.length){
							var arAssociatedShipTo = associatedShipTo.split(",");
							var arProdList = prodList.split(",");
							//check if there are any products associated to distributors that are not in currect associated distributor selection
							Inner:
							for(var i=0;i<arProdList.length;i++){
								 if($.inArray(arProdList[i], arAssociatedShipTo) == -1){
									showOperatorChoices = 1;
									break Inner;
								}
								
							}
						}							
					
								
			break;
			
			case "3": //broker
						var checkShipTo = "<CFOUTPUT>#Ship_To_For_Broker#</CFOUTPUT>";
				
						<!---  Broker is selected --->
						error_text 		= "Please select a <cfoutput>#lcase(application.returned_customer_setting.broker_label_singular)#</cfoutput>";
						error_oSpan 	= document.all.error_broker_select;
						if(document.broker_form.broker_id.value.length == 0) {
							ErrorCount++;
							queueMessage(error_text, error_oSpan);
						}
						else
						{
							clearQueue(error_oSpan);
						}

						if (checkShipTo == 1)
						{				
							<!---  broker is selected --->
							error_text 		= "Please associate a " +shiptToLabel +" to this <cfoutput>#application.returned_customer_setting.broker_label_singular#</cfoutput>.";
							error_oSpan 	= document.all.error_Associate_ShipTo;
							<!---  check for payee selection change 
							Require associated ship to
							--->
							if (associatedShipTo == "")  {
								ErrorCount++;
								queueMessage(error_text, error_oSpan);
							}
							else
							{
								clearQueue(error_oSpan);
							}
						}

						<!---  notes --->
						error_text 		= "Notes may not be longer than 4000 characters. Please reduce the length of your notes.";
						error_oSpan 	= document.all.broker_notes_error;
						if(document.all.Broker_Notes.value.length > 3999) {
							ErrorCount++;
							queueMessage(error_text, error_oSpan);
						}
						else
						{
							clearQueue(error_oSpan);
						}
						
					
						<!---  check for payee selection change --->						
						//compare prodList (distributor id for saved products) with multiDistList/Associated_Ship_To (associatedShipTo)
						if(ErrorCount == 0 && prodList.length){
							var arAssociatedShipTo = associatedShipTo.split(",");
							var arProdList = prodList.split(",");
							//check if there are any products associated to distributors that are not in currect associated distributor selection
							Inner:
							for(var i=0;i<arProdList.length;i++){
								 if($.inArray(arProdList[i], arAssociatedShipTo) == -1){
									showBrokerChoices = 1;
									break Inner;
								}
								
							}
						}
			break;
		}
		
			<!--- SHOW CONFIRMATION BOX IF ALL IS GOOD OR SHOW THE ERROR BOX --->
			if(ErrorCount == 0) 
			{
			
				if(redirect == "powerpunch")
				{
					BB_Payee_Form.RedirectTo.value="power_punch.cfm";
				}
				if(redirect == "bigbillback")
				{					
					BB_Payee_Form.RedirectTo.value="/billbacks/BigBillbacks/enter_bulk_information.cfm";
				}
				
				<cfoutput>
				if(showDistributorChoices){
									
					// show distibutor options window to user start
					var sHtml = 'You are electing to change the Payee from the previously saved Payee.  The identity you are trying to save represents one or more conflicts with the identities currently saved at the product level for this billback.  Please select one of two choices:';
					sHtml += '<br><br>';
					sHtml += '<a href="##" onclick="javascript:SaveWithOption(\'DistributorPayeeRemoveExisting\');return true;">A. Click here to save selection and remove existing product entries for other #lcase(application.returned_customer_setting.distributor_label_plural)#.</a>';
					sHtml += '<br><br>';
					sHtml += '<a href="##" onclick="javascript:SaveWithOption(\'DistributorPayeeRetainExisting\');return true;">B. Click here to retain the existing entries for this billback, even though they do not all align with the new Payee selected.  Make this selection if your billback pays to a #lcase(application.returned_customer_setting.distributor_label_singular)# on behalf of others, as is often the case with centralized claims from customers such as U.S. Food Service.</a>';
					//D30517: Item not appearing on Billback 'programs' page after importing it START
					// we provide this option to user when payeetype is "DISTRIBUTOR" and we changing payee then we provide this option to user
					if ((savedPayeeType == 1) && (CountDistributor == 0)) {
					sHtml += '<br><br>';
					sHtml += '<a href="##" onclick="javascript:SaveWithOption(\'DistributorPayeeReplaceExisting\');return true;">C. Click here to update all existing entries to match the new entity you selected.  Make this selection if your billback pays to a single distributor on behalf of the same distributor.</a>';
					}
					//D30517: Item not appearing on Billback 'programs' page after importing it END					
					$.prompt(sHtml,
						{ 
						buttons:{Cancel: false},
						callback: function(v,m,f){
							return true;							
						}
					});
					// show distibutor options window to user end
					return false;
				}
				
				if(showOperatorChoices || showBrokerChoices){
					// show operator options window to user start
					$.prompt("By saving this change, you will lose the existing relationships between the individual #lcase(application.returned_customer_setting.distributor_label_plural)# that may be associated with the item level details.  <br/><br/> Would you like to proceed?",
						{ 
						buttons:{Yes: true,Cancel: false},
						callback: function(v,m,f){
							if(v)submitForm();
							return true;
						}
					});
					// show operator options window to user end
					return false;
				}
				
				</cfoutput>

				submitForm();
				
			}
		
		
			else {
				showMessageWindow()
			}	
	}
	
	function submitForm() {
		if(!bFormSubmitted){
			document.all.BB_Payee_Form.action = "payee_action.cfm";
			document.all.BB_Payee_Form.submit()
			disableButton('save_table', true, false);
			<cfif appSettings.getUse_Big_Billbacks()>
				disableButton('save_bigbillback_table', true, false);
			</cfif>
			bFormSubmitted = 1;
		}
	}
	
	function SaveWithOption(sOption) {
		$.prompt.close();
		document.all.BB_Payee_Form.saveOverwriteOption.value = sOption;
		submitForm();
	}

</SCRIPT>

<CFSET InfoBar_BBID = Billback_ID>
<cfinclude template="billback_load_infobar.cfm">
<script>
try { window.parent.dyniframesize(); } catch (err) { };
</script>
</BODY>
</HTML>