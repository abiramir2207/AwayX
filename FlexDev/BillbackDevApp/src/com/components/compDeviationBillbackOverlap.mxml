<?xml version="1.0" encoding="utf-8"?>
<!---
 	This is a ItemRenderer for displaying the image based on the field DEVIATION_BILLBACK_OVERLAP 
 	from the query result 
-->
<mx:HBox xmlns:mx="http://www.adobe.com/2006/mxml" width="100%" height="20" horizontalGap="1" 
		horizontalAlign="center" verticalAlign="middle">
	<mx:Script xmlns:mx="http://www.adobe.com/2006/mxml">
		<![CDATA[
			import com.asfusion.mate.events.Dispatcher;
			
			import flash.external.ExternalInterface;
			
			import mx.controls.Alert;
			import mx.controls.advancedDataGridClasses.AdvancedDataGridListData;
			import mx.events.CloseEvent;
			import mx.utils.ObjectUtil;
			private var columnIndex:Number;
			public var URLgeneratedDBO:String = "/billbacks/Deviation/Deviation_Product_Date_Overlap.cfm?Billback_Product_Detail_ID=";
			public var URLOverLap:String = "/billbacks/common/overLapReport.cfm?BBID=";
		]]>
</mx:Script>
	<!-- 	useHandCursor="{(data.Dummy_Program=='0')&amp;&amp;(data.UnKnown_Item=='0')}" 
				buttonMode="{(data.Dummy_Program=='0')&amp;&amp;(data.UnKnown_Item=='0')}"  -->
  <mx:Image xmlns:mx="http://www.adobe.com/2006/mxml" 
				id="imgDBO"	
				width="12"
				height="12"
				source="{getSource(data.DEVIATION_BILLBACK_OVERLAP)}" 
				useHandCursor="{((data.Third_Party_BB_Upload == '3' &amp;&amp; ((data.Dummy_Program=='0') &amp;&amp; (data.UnKnown_Item=='0'))) || ((data.Third_Party_BB_Upload != '3') &amp;&amp; (data.UnKnown_Item=='0')))}"				 
				buttonMode="{((data.Third_Party_BB_Upload == '3' &amp;&amp; ((data.Dummy_Program=='0') &amp;&amp; (data.UnKnown_Item=='0'))) || ((data.Third_Party_BB_Upload != '3') &amp;&amp; (data.UnKnown_Item=='0')))}" 								 
				mouseChildren="false"
				click="fnDBOClick();"
				toolTip="{data.DEVIATION_BILLBACK_OVERLAP_PERCENT}%"
				>
				<mx:Script>
				<![CDATA[
					/** 
					 * This holds the image to be displayed basesd on the DEVIATION_BILLBACK_OVERLAP 
					 * field from the query result
					 */
					private  var imgDBOHolder:Class;
				
					/** 
					 * This function determines which image has to be displayed for the 
					 * Deviation Overlap Validation column in the grid.
					 */				
					private function getSource(recType:String):Object
					{
						/* 
							21398:
							These images were shown on scrolling breaking through the 
							if condition, so this was removed, so that the images would
							be shown for dummy program and unknown item rows also.
						*/ 
				 		/*
										Added a condition "{data.BB_Product_Type_ID=='1'||data.BB_Product_Type_ID=='2'}" for OL, AU, VL as
										we will not be showing the x or the tick marks on these. x or tick on these columns are throwing an 
										error as they won't exist on these columns for Lumpsum & Growth.  
						*/							
						/* if((data.Dummy_Program=='0')&&(data.UnKnown_Item=='0'))
						
						{ */
							if ((data.BB_Product_Type_ID=='1'||data.BB_Product_Type_ID=='2') && data.DEVIATION_BILLBACK_OVERLAP == 1)   
							{
								[Embed(source='/assets/Images/no.gif')]
								var imgNo:Class;
								imgDBOHolder = imgNo;
							}
							else if ((data.BB_Product_Type_ID=='1'||data.BB_Product_Type_ID=='2') && data.DEVIATION_BILLBACK_OVERLAP == 0)
							{
								[Embed(source="/assets/Images/yes.gif")]
								var imgYes:Class;
								imgDBOHolder = imgYes; 
							}
							else
							{
								imgDBOHolder:Class;
							}
						/* }
						else
						{
							imgDBOHolder:Class;
						}  */			
						return imgDBOHolder;
					}  
	
						/* ******************************************************************
						The data.* would not work in the initialization above as the data.* 
							is not created and is available only later
						********************************************************************/
									
						/** 
						* This function will open a popup window with the link 
						* "/billbacks/Deviation/Deviation_Product_Date_Overlap.cfm" 
						*  passing Billback_Product_Detail_ID to it.
						*/
						private function fnDBOClick():void
						{
							/* 
								This will disable the click for the highlighted rows for the 
								Unknown_Item and Dummy_Program 
							*/
							/* if (Third_Party_BB_Upload is 3 and (dummy_program is 1 OR Unknown_ITem is 1)) OR (Third_Party_BB_Upload NEQ 3 AND Unknown_ITem is 1) */
							// if ((data.Dummy_Program=='0')&&(data.UnKnown_Item=='0'))
							var strRequestURL:String = "";
							if (parentDocument.sBBOverlapDeviationBasedOnOperator == "1")
							{
								strRequestURL = URLOverLap + data.Billback_ID + "&Product_ID=" + data.Product_ID;
								ExternalInterface.call("f = function() { window.open('"+strRequestURL+"','win','toolbar=no,scrollbars=yes,resizable=1,width=780,height=650'); }");
							}
							else if ((parentDocument.sBBOverlapDeviationBasedOnOperator == "0") && (data.Third_Party_BB_Upload == '3' && ((data.Dummy_Program=='0') && (data.UnKnown_Item=='0'))) || ((data.Third_Party_BB_Upload != '3')&&(data.UnKnown_Item=='0')))	
							{
								strRequestURL = URLgeneratedDBO + data.Billback_Product_Detail_ID;
								// This will open the URL in a a new window
								//navigateToURL(new URLRequest(strRequestURL),"_blank")
								ExternalInterface.call("f = function() { window.open('"+strRequestURL+"','win','toolbar=no,scrollbars=yes,resizable=1,width=780,height=650'); }");
							}							
							 
							
						}
											
					]]>
				</mx:Script>
	</mx:Image>
</mx:HBox> 			

 