	xmlns:mx="http://www.adobe.com/2006/mxml"
	xmlns="http://mate.asfusion.com/" xmlns:mate="http://mate.asfusion.com/">
	<mx:Script>
		<![CDATA[
			import com.asfusion.mate.core.*;
			import com.asfusion.mate.events.UnhandledFaultEvent;
			import mx.events.*;
			import com.events.*;
			import com.models.*;
			import com.vos.*;
			import com.views.*;
	]]>
	</mx:Script>
	<mate:Debugger level="{Debugger.ALL}" />
	<!-- load up an instance of the remote objects -->
	<!-- Added requestTimeout property --> 
	<!-- Remote Services  _________________________________________________________________________ -->
	<mx:RemoteObject id="roMainService" destination="ColdFusion" source="mvc.Models.Billback.BillbackDevAppManager"  requestTimeout="1800"  makeObjectsBindable="true"/>
	<mx:RemoteObject id="roErrorService" destination="ColdFusion" source="mvc.models.ErrorService" requestTimeout="1800"/>
	<!-- Remote Services  ***************************************************************************************** -->
	<!--<mx:RemoteObject id="MainService" destination="ColdFusion" source="mvc.models._ProjectTemplate._ProjectTemplateService" />-->
	<!--- Search functionality including initial dataload <p>roSearchService : <strong>mvc.models.Distributor.DistributorSearchService</strong></p> -->
	<!--- roErrorService : <strong>mvc.models.ErrorService</strong> -->
	<mx:RemoteObject id="ErrorService" destination="ColdFusion" source="mvc.models.ErrorService" requestTimeout="1800" />

	<!-- FlexEvent.PREINITIALIZE __________________________________________________________________ -->
	<!---
		FlexEvent Preinitialize initializes the various ObjectBuilders used 	
	-->	
	<EventHandlers type="{FlexEvent.PREINITIALIZE}" id="ePREINITIALIZE">
		<ObjectBuilder generator="{BBMainManager}" id="oManager" cache="global" />
		<ObjectBuilder generator="{BBSettingsManager}" id="oSettingsManager" cache="global" />
	<!-- FlexEvent.PREINITIALIZE   ******************************************************************************** -->
	<!---@see com.models.SettingsManager#loadURLParameters()
			Invoke : com.models.SettingsManager.loadURLParameters()-->
	<!-- <EventHandlers type="{FlexEvent.PREINITIALIZE}" id="ePREINITIALIZE">
		<ObjectBuilder generator="{MainManager}" id="oManager" cache="global" />
		<ObjectBuilder generator="{SettingsManager}" id="oSettingsManager" cache="global" / -->
		<ObjectBuilder generator="{BAError}" id="oBAError" cache="global" />
		<MethodInvoker generator="{BBSettingsManager}" method="loadURLParameters" cache="global" />
	<!-- 	<MethodInvoker generator="{SettingsManager}" method="loadURLParameters" cache="global" /> -->
	</EventHandlers>
	
	<!-- FlexEvent.APPLICATION_COMPLETE     ************************************************************************* -->
	<!-- EventHandlers type="{FlexEvent.CREATION_COMPLETE}" id="eCREATION_COMPLETE" -->
 
		<!--call db for other settings-->
 
		<!--<EventAnnouncer type="{MainEvent.LOAD_APP_SETTINGS}" generator="{MainEvent}" >
			<Property sourceCache="global" source="{BBSettingsManager}" sourceKey="settings.sBBID" targetKey="sBBID"/>
		</EventAnnouncer>-->
	<!-- /EventHandlers -->
	
	<!-- FlexEvent.APPLICATION_COMPLETE ___________________________________________________________ -->
<!--
		FlexEvent Creation_Complete: It Announces the events and does the following:
		GET_BILLBACK_HEADER: Gets the header details about the billback
		GET_BILLBACK_DETAILS:  Gets the Details about the Billback and all the 
		records that needs to be displayed in the Datagrid.
	-->
	<EventHandlers type="{FlexEvent.CREATION_COMPLETE}" id="eCREATION_COMPLETE">
		<EventAnnouncer type="{MainEvent.GET_BILLBACK_HEADER}" generator="{MainEvent}" >
			<Property sourceCache="inherit" source="{BBSettingsManager}" sourceKey="settings.sBBID" targetKey="sBBID"/>
			<Property sourceCache="inherit" source="{BBSettingsManager}" sourceKey="settings.sUserId" targetKey="sUserId"/>
		</EventAnnouncer>		
		<EventAnnouncer type="{MainEvent.GET_BILLBACK_DETAILS}" generator="{MainEvent}" >
			<Property sourceCache="inherit" source="{BBSettingsManager}" sourceKey="settings.sBBID" targetKey="sBBID"/>
		</EventAnnouncer>	
	</EventHandlers>
 
    <!-- ************************************************
    	 ADD NEW EventHandlers Here   *******************
         ************************************************-->

  <!---
  	This event hanlder gets 
  -->
    
	<!--<EventHandlers type="{MainEvent.LOAD_APP_SETTINGS}" id="eLOAD_APP_SETTINGS">
		<RemoteObjectInvoker instance="{roMainService}" showBusyCursor="true" method="getSettingsObject" arguments="{event.sUserId}" >
			<!- - result sequence gets executed when service returns with a result - - >
