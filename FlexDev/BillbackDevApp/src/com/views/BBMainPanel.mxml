			/* This function is being called from 2 places:
			1- "nTotalDeviation" above. So, whenever the value of "nTotalDeviation" is set,
			the function is called to show the value.
			2. It is possible that "adgColVarClaimExp" may not exist in the first step, and so
			as a backup, this function is being called on "creationComplete" too.
			
			Either one of the above steps will happen first. The other step will act as a backup.
			*/
			private function addTotalDeviation():void{
				if(adgColVarClaimExp)
				{
					if ((nTotalDeviation != 0) && (StringUtil.trim(nTotalDeviation.toString()) != '') && (nTotalDeviation != 0.0))
					{
						this.adgColVarClaimExp.headerText = 'Total Deviation: ' + dollarFormatter2.format(nTotalDeviation).toString();
					}
					else
					{
						for ( var x:int = 0; x < this.dpBBData.length; ++x )
						{
							//nTotalDeviation  = parseFloat(nTotalDeviation.toString())  + parseFloat(item.Variation_Claim_Expected);
							if (!isNaN(parseFloat(this.dpBBData.getItemAt(x).Variation_Claim_Expected)))
							{							
								nTotalDeviation  = parseFloat(nTotalDeviation.toString())  + parseFloat(this.dpBBData.getItemAt(x).Variation_Claim_Expected);
							}
						}
						this.adgColVarClaimExp.headerText = 'Total Deviation ' + dollarFormatter2.format(nTotalDeviation).toString();	
					}
				}		
			}
			
