				{
					this.sFilterText = this.txtFilter.text;
					dgData.dataProvider.filterFunction = AllFilterFunc;
					dgData.dataProvider.refresh();
				}
			}	
			
			// Show Deviated Only 
			public function fnShowDeviated(cbSelected:String):void
			{
				this.sDeviatedFilter = this.cbShowDeviated.selected;
				dgData.dataProvider.filterFunction = AllFilterFunc;
				dgData.dataProvider.refresh();				
			}
			
			public function AllFilterFunc(item:Object):Boolean
			{
				// check if the item starts with the string in the text field
				var retVal:Boolean = true;
				
				if (this.sFilterText != "")
				{
					if (this.sViewOperatorinBillbackDeviation == '1')
					{
						if ( 
							(item['Program'].toUpperCase().indexOf(this.sFilterText.toUpperCase()) == -1) &&
							(item['Distributor'].toUpperCase().indexOf(this.sFilterText.toUpperCase()) == -1 ) &&
							(item['Item'].toUpperCase().indexOf(this.sFilterText.toUpperCase()) == -1) && 
							(item['Operator_Details'].toUpperCase().indexOf(this.sFilterText.toUpperCase()) == -1) &&
							(item['Discount_Type_Desc'].toUpperCase().indexOf(this.sFilterText.toUpperCase()) == -1)
						)
						{	
							retVal = false;
						}
						else
						{
							retVal = true;	
						}
					}
					else
					{
						if (
							(item['Program'].toUpperCase().indexOf(this.sFilterText.toUpperCase()) == -1) &&
							(item['Distributor'].toUpperCase().indexOf(this.sFilterText.toUpperCase()) == -1 ) &&
							(item['Item'].toUpperCase().indexOf(this.sFilterText.toUpperCase()) == -1) &&  
							(item['Discount_Type_Desc'].toUpperCase().indexOf(this.sFilterText.toUpperCase()) == -1)
						)	
						{	
							retVal = false;
						}
						else
						{
							retVal = true;	
						}
					}
				}
				
				if (this.sDeviatedFilter == true)
				{
					if (item['Variation_Claim_Expected'] != 0 && retVal)	
					{	
						retVal = true;
					}
					else
					{
						retVal = false;	
					}
				} 
				return retVal;
			}
			
			private function fnDownloadDeviation(evtObj:Object):void
			{
				var winjsOverlapReport:String="/Billbacks/common/downloadDeviation.cfm?BBID=" + this.sBBID + "&userID=" + this.sUserID +"&source=" + this.sCallerSource;
				var jscommand:String = "window.open('"+winjsOverlapReport+"','DownloadDeviation','height=200,width=300,toolbar=no,scrollbars=yes,left=0,top=0,screenX=0,screenY=0,resizable=yes');"
				var url:URLRequest=new URLRequest("javascript:" + jscommand + " void(0);");   
				navigateToURL(url, "_self");
			}
			
			
			public function dgData_creationCompleteHandler(event:FlexEvent):void
			{
				// TODO Auto-generated method stub
				
				if (this.bCbDeviationChecked == true)
				{
					this.cbShowDeviated.selected = true;
				}
			}
			
			
