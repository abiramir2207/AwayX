			/**
			 * This function fnPositionRatePrecisionToolTip gets called from within the styleFunction
			 * it will re-position the tool tip a little higher 
			 * so that the long tool tip text will not hide the contents of the data grid.
			 */
			public function fnPositionRatePrecisionToolTip(event:ToolTipEvent):void
			{
				var pt:Point = event.currentTarget.contentToGlobal(new Point(0,0));
				ToolTipManager.currentToolTip.y = pt.y - 20;
			}
			
			
			/**
			 * This function fnEnableButtons gets called from within the styleFunction
			 * and there is a variable that is set once this function is called to make sure
			 * that this does not get called multiple times. This will enable all the 
			 * buttons on the screen after the data is loaded on the screen, so that 
			 * the user will not be able to click on the buttons when the grid is loading
			 * and therefore will not be able to approve empty records.
			 */
			
			public function fnEnableButtons():void
			{
				
				if (this.sBBEditable == "1" && sBBApproveExpRateLessTol=="1")
				{
					this.btnExpectedAmtLT.enabled = true;
				}
				if (this.sBBEditable == "1")
				{
					this.btnApprove.enabled 		 = true;
					// this.btnVolOverride.enabled  = true;
					this.btnRateOverride.enabled = true;
					this.btnSave.enabled 				 = true;
					this.btnRecalc.enabled 			 = true;
					this.btnClaimedAmt.enabled 	 = true;
					this.btnExpectedAmt.enabled  = true;
					this.btnDisagree.enabled 		 = true;
				}
				this.btnVolOverride.enabled  = true;
				
				if (this.sBBAllDupGroupID == null || this.sBBAllDupGroupID == "")
				{
					this.txtDuplicate.text = "";
				}
				else
				{	
					this.txtDuplicate.text = "* Duplicate Billback *";
				}	
			}
			
