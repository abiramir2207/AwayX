															&amp;&amp; (((data.Third_Party_BB_Upload == '3') &amp;&amp; (data.Dummy_Program == '0' &amp;&amp; data.UnKnown_Item =='0'))|| (data.Third_Party_BB_Upload != '3')
															))) &amp;&amp; (data.Denied != '1'))}"
															tabIndex="15" />
										</mx:HBox>	
									</mx:Component>
								</mx:itemRenderer>
