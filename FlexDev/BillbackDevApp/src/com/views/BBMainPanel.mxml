													   editorDataField="sValRate" sortCompareFunction="sortCompareFunc"><!-- labelFunction="fnFormatDollars2" -->
								<mx:itemRenderer>          
									<mx:Component> 
										<mx:HBox horizontalScrollPolicy="off" verticalScrollPolicy="off" verticalAlign="middle"
												 implements ="mx.managers.IFocusManagerComponent"  paddingLeft="3">  
											<mx:CurrencyFormatter id="dollarFormatter" precision="3"  useNegativeSign="true" />
											<mx:Script>
												<![CDATA[
													[Bindable]
													public var sValRate:String; 
													
													private var sOriginalText:String;
													
													override public function drawFocus(draw:Boolean):void 
													{
														trace(' DRAW :: ' + draw);
														if(draw){
															focusManager.setFocus( IFocusManagerComponent( txtRateMan ) );
															txtRateMan.setSelection(0,txtRateMan.text.length);
														}
													}		
													override public function setFocus():void 
													{
														trace(' SETFOCUS :: ' + focusManager.getFocus());
														trace(' SETFOCUS2 :: ' + txtRateMan.text);
														focusManager.setFocus( IFocusManagerComponent( txtRateMan ) );
														txtRateMan.setSelection(0,txtRateMan.text.length);
														sOriginalText = txtRateMan.text.replace('$','');
													}
													private function fnRateChange(txtNumber:String):Boolean
													{	txtNumber = txtNumber.replace('$','');
														trace(' FOCUSOUT :: ' + focusManager.getFocus() + ' :: ' + txtNumber);
														var bSuccess:Boolean = false;
														if(txtNumber != '' && Object(focusManager.getFocus()).name.toString().indexOf('OK') == -1){
															bSuccess = fnChkDecPlaces(txtNumber);
															if(bSuccess){
																sValRate=txtNumber; 
															}
														}
														return bSuccess;
													}		
													private function setRateMan(s:String):void{
														s = s.replace('$','');
														trace(' SETRATE :: ' + this.data.Manual_Rate + ' :: ' + sOriginalText + ' :: ' + s);
														if(this.data.Manual_Rate != sOriginalText){
															if(fnRateChange(s)){
																outerDocument.fnSetRateManual(this);
															}
														} 
													}
													
													public function fnChkDecPlaces(txtNumber:String):Boolean
													{
														var iPointPos:Number = txtNumber.indexOf(".");
														var chrToCheck:String = txtNumber.substr(iPointPos+4,1);
														var strWholePart:String = txtNumber.substr(0,iPointPos);
														var strTwoDecimals:String = txtNumber.substr(iPointPos+1,3);
														var bSuccess:Boolean = true;
														if (iPointPos != -1)
														{
															if (chrToCheck != "")
															{
																mx.controls.Alert.show("Only three decimal places allowed!!")
																txtRateMan.text = strWholePart + "." + strTwoDecimals;
																sValRate = strWholePart + "." + strTwoDecimals;
																bSuccess = false;
																//txtRateMan.setFocus();
															}
														}
														return bSuccess;
													} 
													private function fnFormatDollars2(item:String):String 
													{
														var s:String = dollarFormatter.format(item)
														return s;
													}
												]]>
											</mx:Script> 	
											<mx:Binding destination="sValRate" source="data.Manual_Rate"/>  
											<mx:TextInput    restrict="0-9.,\-" maxChars="9" id="txtRateMan" 
															 textAlign="right" width="70" paddingLeft="2" height="18" 
															 text="{fnFormatDollars2(parseFloat(data.Manual_Rate).toString())}"   
															 tabIndex="5" 
