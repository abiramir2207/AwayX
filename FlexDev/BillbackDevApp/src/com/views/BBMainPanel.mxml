							<!-- START PROGRAM PRICE labelFunction="fnFormatDollars" -->
							<mx:AdvancedDataGridColumn headerText="Manual" editable="true"  visible="{sBBDevOvPrice=='1'}" 
													   width="90" id="adgColManualProgramPrice" dataField="Manual_Program_Price" rendererIsEditor="true" 
													   editorDataField="stringPrgVal" sortCompareFunction="sortCompareFunc">
								<mx:itemRenderer>          
									<mx:Component>            
										<mx:HBox horizontalScrollPolicy="off" verticalScrollPolicy="off" verticalAlign="middle"
												 implements ="mx.managers.IFocusManagerComponent"  paddingLeft="3">   
											<mx:Script>
												<![CDATA[
													[Bindable]
													public var stringPrgVal:String; 
													
													override public function drawFocus(draw:Boolean):void 
													{
														txtPrgMan.setFocus();
													} 
													public function fnChkDecPlaces(txtNumber:String):void
													{
														var iPointPos:Number = txtNumber.indexOf(".");
														var chrToCheck:String = txtNumber.substr(iPointPos+3,1);
														var strWholePart:String = txtNumber.substr(0,iPointPos);
														var strTwoDecimals:String = txtNumber.substr(iPointPos+1,2);
														if (iPointPos != -1)
														{
															if (chrToCheck != "")
															{
																mx.controls.Alert.show("Only two decimal places allowed!!")
																txtPrgMan.text = strWholePart + "." + strTwoDecimals;
																txtPrgMan.setFocus();
															}
														}	
													}				             		
												]]>
											</mx:Script> 	
											<mx:Binding destination="stringPrgVal" source="data.Manual_Program_Price"/>  
											<mx:TextInput    restrict="0-9.,\-" maxChars="9" id="txtPrgMan"
															 textAlign="right" width="70" paddingLeft="2" toolTip="Hit &lt;Enter&gt; after entering value" height="18" 
															 enabled="{((((data.Editable_Rate=='0') &amp;&amp; (data.Selected_Program_Price_Type=='3') 
															 &amp;&amp; (((data.Third_Party_BB_Upload == '3') &amp;&amp; (data.Dummy_Program == '0' &amp;&amp; data.UnKnown_Item =='0'))|| (data.Third_Party_BB_Upload != '3')
															 ))) &amp;&amp; (data.Denied != '1'))}" 
															 mouseEnabled="{((((data.Editable_Rate=='0') &amp;&amp; (data.Selected_Program_Price_Type=='3') 
															 &amp;&amp; (((data.Third_Party_BB_Upload == '3') &amp;&amp; (data.Dummy_Program == '0' &amp;&amp; data.UnKnown_Item =='0'))|| (data.Third_Party_BB_Upload != '3')
															 ))) &amp;&amp; (data.Denied != '1'))}" 
															 text="{data.Manual_Program_Price}"   
															 editable="{((((data.Editable_Rate=='0') &amp;&amp; (data.Selected_Program_Price_Type=='3') 
															 &amp;&amp; (((data.Third_Party_BB_Upload == '3') &amp;&amp; (data.Dummy_Program == '0' &amp;&amp; data.UnKnown_Item =='0'))|| (data.Third_Party_BB_Upload != '3')
															 ))) &amp;&amp; (data.Denied != '1'))}"  
															 visible="{data.Editable_Rate=='0'}" 
															 tabIndex="16" 
															 change="fnChkDecPlaces(txtPrgMan.text);stringPrgVal=txtPrgMan.text"
															 enter="outerDocument.fnSetPrgManual(this)"
															 /> 
										</mx:HBox>
									</mx:Component>
								</mx:itemRenderer>
							</mx:AdvancedDataGridColumn>						  
							<!-- END: Manual Program Price -->						  
							
