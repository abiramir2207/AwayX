			/* ****************************************************** 
			Function to display the Toop tip on the Header of the 
			datagrid
			*******************************************************/
			/**
			 * This function returns the tip to be displayed when the user mouse overs 
			 * one of the following column headers: <strong>UP, DT, OL, AU, VL, RT</strong>
			 * 
			 * @return A tooltip of String type is returned   
			 */				
			
			private function fnAdvDGDataTipFunction(object:Object):String
			{
				if(object.hasOwnProperty("dataField")) 
				{
					switch(object.dataField)
					{
						case "DEVIATION_UNAUTHORIZED_PAYEE":
							return "Unauthorized Payee";	// compUnauthorizedPayee - UP
							break;
						case "DEVIATION_PROGRAM_DATES":
							return "Date match validation"; //compDeviationProgramDates - DT 
							break;
						case "DEVIATION_BILLBACK_OVERLAP":
							return "Date overlap validation"; // compDeviationBillbackOverlap - OL
							break;
						case "DEVIATION_UNAUTHORIZED_PRODUCT":
							return "Authorization validation"; // compDeviationUnauthorizedProducts - AU
							break;
						case "DEVIATION_VOLUME":
							return "Volume validation"; // compDeviationVolume - VL
							break;
						case "DEVIATION_RATE":
							return "Rate validation"; //compDeviationRate - RT
							break;
						case "Count_Flag":
							return "Count Flag";
							break;
						case "E_Volume":
							return "Expected Volume";
							break;
						case "Expected_Invoice_Price":
