															 ))) &amp;&amp; (data.Denied != '1'))}"
															 mouseEnabled="{((((data.Editable_Rate=='1') &amp;&amp; (data.Selected_Rate_Type=='3') 
															 &amp;&amp; (((data.Third_Party_BB_Upload == '3') &amp;&amp; (data.Dummy_Program == '0' &amp;&amp; data.UnKnown_Item =='0'))|| (data.Third_Party_BB_Upload != '3')
															 ))) &amp;&amp; (data.Denied != '1'))}" 
															 />  
											<!-- enter="outerDocument.fnSetRateManual(this)"   change="fnChkDecPlaces(txtRateMan.text);sValRate=txtRateMan.text" 
											toolTip="Hit &lt;Enter&gt; after entering value" -->
										</mx:HBox>
