<?xml version="1.0" encoding="utf-8"?>
<mx:Canvas xmlns:mx="http://www.adobe.com/2006/mxml" width="100%" height="100%"
	creationComplete="createModule(ItemSearchMod, ismURL)">
	 <mx:Script>
        <![CDATA[
            import mx.managers.PopUpManager;
            import mx.modules.ModuleManager;
            import mx.modules.IModuleInfo;
            import com.shared.events.MainEvent;
    		import com.asfusion.mate.events.Dispatcher;
			
            [Bindable] public var ismURL:String = "com/ItemSearch/ItemSearch.swf";
            private function processLogin():void {
                // Check credentials (not shown) then remove pop up.
                PopUpManager.removePopUp(this);
            }
          
		      public function createModule(m:ModuleLoader, s:String):void {
		            if (!m.url) {
		                m.url = s;
		                return;
		            }
		            m.loadModule();
		        }
		        
		       public function removeModule(m:ModuleLoader):void {
		            m.unloadModule();
		        }
		      public function closeItemSearch():void {
                // Create a non-modal TitleWindow container. -->old in: win:DisplayObject
                /* var helpWindow:IFlexDisplayObject =
                    PopUpManager.createPopUp(win, ItemSearchWindow, false); */
           		var event:MainEvent = new MainEvent(MainEvent.SEARCH_ITEMS);
           		event.sState = "adminState";
				var d:Dispatcher = new Dispatcher();
				d.dispatchEvent(event);
            }
        ]]>
    </mx:Script>

 	<mx:Canvas width="100%" height="100%">
 	<mx:VBox>
 		<mx:Button 
            label="Cancel"
            click="closeItemSearch();"/>   <!--click="PopUpManager.removePopUp(this);"-->
         <mx:ModuleLoader id="ItemSearchMod" width="100%" />
 	</mx:VBox>
	   
    </mx:Canvas>
        <!--<mx:Button click="processLogin();" label="OK"/> -->
        

</mx:Canvas>
