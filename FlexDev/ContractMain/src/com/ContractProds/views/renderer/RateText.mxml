<mx:VBox xmlns:mx="http://www.adobe.com/2006/mxml" width="85"
	 paddingBottom="0" paddingLeft="0" paddingRight="0" paddingTop="0"
    implements="mx.controls.listClasses.IDropInListItemRenderer,mx.managers.IFocusManagerComponent">
    <mx:Script>
        <![CDATA[
			import mx.collections.ArrayCollection;
			import mx.collections.ListCollectionView;
			import mx.controls.AdvancedDataGrid;
			import mx.controls.advancedDataGridClasses.AdvancedDataGridItemRenderer;
			import mx.controls.advancedDataGridClasses.AdvancedDataGridListData;
			import mx.controls.listClasses.BaseListData;
			import mx.controls.listClasses.ListData;
			import mx.events.FlexEvent;
			import mx.formatters.NumberFormatter;


            private var _listData:AdvancedDataGridListData;
            // Define a property for returning the new value to the cell.
            [Bindable]
            public var value:Object;            

            // Implement the drawFocus() method for the VBox.
            override public function drawFocus(draw:Boolean):void {
                txtInp.setFocus();
            }
             // Implement the setFocus() method for the VBox.
            override public function setFocus():void {
                txtInp.setFocus();
            }

            override public function get data():Object {
                return super.data;
            }
            [Bindable]
            override public function set data(value:Object):void {
            	var s:String = '';
					s = _listData.dataField;
					s = s.replace('.prodRate.rate','');
                txtInp.text = value[s]['prodRate']['rate'];
                
            } 
            public function get listData():BaseListData
            {
                return _listData;
            }

            public function set listData(value:BaseListData):void
            {
                _listData = AdvancedDataGridListData(value);
            } 
     		 private function setRate(sTxt:String):void{
          		var s:String = '';
			
				s = _listData.dataField;
				s = s.replace('.prodRate.rate','');
            	this._listData.item[s]['prodRate']['rate'] = sTxt;
				
				if(this._listData.item.marketPrice){

					var varianceMp:Number;
					if (this._listData.item[s]['prodRate']['uom'].uomId == 2){
						this._listData.item[s+'.prodRate.varianceMP'] = this._listData.item[s+'.prodRate.rateMPLB'] - this._listData.item[s]['prodRate']['rate'];
						varianceMp = (this._listData.item[s+'.prodRate.varianceMP']/this._listData.item[s+'.prodRate.rateMPLB'])*100;
					}
					else{
						this._listData.item[s+'.prodRate.varianceMP'] = this._listData.item[s+'.prodRate.rateMPCS'] - this._listData.item[s]['prodRate']['rate'];
						varianceMp = (this._listData.item[s+'.prodRate.varianceMP']/this._listData.item[s+'.prodRate.rateMPCS'])*100;
					}
					
					this._listData.item[s+'.prodRate.variancePercMP'] = varianceMp;
				}
				
				/*  var adg:AdvancedDataGrid = this._listData.owner as AdvancedDataGrid;
				var ac:ArrayCollection = adg.dataProvider as ArrayCollection;
				ac.disableAutoUpdate(); */
				//adg.dataProvider.refresh();
			 }
            
            public var _decFormat:NumberFormatter =  new NumberFormatter();
            public function formatDecimal(s:String):String 
		    {
		    	_decFormat.precision = 4
		    	if(!isNaN(Number(s))){
		    		return _decFormat.format(s);
		    	}
		    	else{
		    		return '';
		    	}
				
		    }

        ]]>
    </mx:Script>
    <mx:Binding destination="value" source="txtInp.text"/>
    
   <!-- <mx:ComboBox id="cbo" editable="false" width="80" labelField="abbreviation" change="setUom(this.cbo.selectedItem as Uom);" />-->
    <mx:TextInput id="txtInp" 
    		editable="true" text="" 
    		change="setRate(this.txtInp.text)" width="75"/>
    <mx:NumberValidator 
    	precision="4" precisionError="The max precision is 4 deciamls."
    	source="{txtInp}" 
    	property="text" 
    	required="false" 
		invalidCharError="Please enter a valid number."
		domain="real" 
		invalid="txtInp.text=formatDecimal(txtInp.text)" 
		allowNegative="false" 
		negativeError="Please enter a positive number."/>
</mx:VBox>
