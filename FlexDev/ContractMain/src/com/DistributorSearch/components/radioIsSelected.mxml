<mx:HBox xmlns:mx="http://www.adobe.com/2006/mxml" horizontalAlign="center"
    implements="mx.controls.listClasses.IDropInListItemRenderer" >

    <mx:Script>
    <![CDATA[
    	import mx.collections.ArrayCollection;
        import mx.controls.DataGrid;
        import mx.controls.dataGridClasses.DataGridListData;
        import mx.controls.listClasses.BaseListData;
        import mx.controls.RadioButtonGroup;
        
		[Bindable]
        public var varCbSelected:Boolean; 
        private var _listData:BaseListData;
        private var _dataField:String;

        private var myDG:DataGrid;
		private var radIsSelectedGroup:RadioButtonGroup = new RadioButtonGroup();
		
        public function get listData():BaseListData {
          return _listData;
        }
        public function set listData( value:BaseListData ):void {
            _listData = value;
            myDG = _listData.owner as DataGrid;
            _dataField = (value as DataGridListData).dataField;

        }
        override public function set data(value:Object):void {
                super.data = value;
				varCbSelected=rdo.selected;
				 //myDG.invalidateList();
            }
         private function onCBchange(event:Event):void
			{
			   var dp:Array = myDG.dataProvider.source as Array;
			  // var i:int = 0;
			   if(myDG.selectedItem){
				   	for each(var item:Object in dp)
				   	{
				   		//if the item we are on (in the loop) matches the selected item -> selected = true.  All others are false
				   		if(item.distGuid  == myDG.selectedItem.distGuid){
	                        item.isSelected = true;
	                    }
	                    else
	                    {
	                        item.isSelected = false;
	                    }
	                   // i++;
				    }
			   }   
			   myDG.invalidateList();
			}
    ]]>
    </mx:Script>
     <mx:RadioButton id="rdo"
        height="100%" width="50%" 
        selected="{data.isSelected}" 
        click="onCBchange(event);" />

</mx:HBox>


