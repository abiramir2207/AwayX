<?xml version="1.0" encoding="utf-8"?>
<mx:Module xmlns:mx="http://www.adobe.com/2006/mxml" layout="vertical" 
	paddingBottom="0" paddingLeft="0" paddingRight="0" paddingTop="0"
	xmlns:view="com.DistributorSearch.views.*" 
	xmlns:maps="com.DistributorSearch.maps.*" 
	xmlns:vos="com.DistributorSearch.vos.*" 
	width="100%" height="100%" 
	implements="com.shared.IModuleInterface" 
	creationComplete="applyRuntimeStyleSheet();" preinitialize="saveSettings();">
	<!-- preinitialize="applyRuntimeStyleSheet();" creationComplete="applyRuntimeStyleSheet();" preloader="com.components.baProgressBar"  preloader="com.DistributorSearch.components.baProgressBar"
	implements="com.shared.IModuleInterface" -->
	
	<mx:Script><![CDATA[
			import com.DistributorSearch.events.*;
			import com.DistributorSearch.models.SettingsManager;
			
			import mx.controls.Alert;
			import mx.styles.StyleManager;
			import mx.utils.ObjectUtil;
		
        public function applyRuntimeStyleSheet():void {
			//styleManager.loadStyleDeclarations("/flex/Program/assets/styles/mainFx46.swf") 
			styleManager.loadStyleDeclarations("/flex/mainFx410.swf") 
			
        }
        // interfaces don't support vars, only functions so have to convert to getter/setters
		private var _programId:int;
		public function get programId():int
		{
			return _programId;
		}
		public function set programId (value:int):void
		{
			_programId = value;
		}
	
		private var _customerId:String;
		public function get customerId():String
		{
			return _customerId;
		}
		public function set customerId(value:String):void
		{
			_customerId = value;
		}
		
		private var _oneDistSelection:Boolean;
		public function get oneDistSelection():Boolean
		{
			return _oneDistSelection;
		}
		public function set oneDistSelection(value:Boolean):void
		{;
			_oneDistSelection = value;
			//this.saveSettings();
		}
		
		public function saveSettings():void{
			var e:SearchEvent = new SearchEvent(SearchEvent.SAVE_SETTINGS);
			e.programId = this._programId;
			e.oneDistSelection = this.oneDistSelection;
			this.dispatchEvent(e);
		}
  		]]>
	</mx:Script>
	
	<!-- Event Maps __________________________________________________ -->
	<maps:MainEventMap dispatcher="{this}" />
	<!--<maps:ModelMap />-->
	
	<!-- Views _______________________________________________________ -->
	
	<mx:HBox width="1000" height="620">
		<view:SearchPanel />
	</mx:HBox>
</mx:Module>
