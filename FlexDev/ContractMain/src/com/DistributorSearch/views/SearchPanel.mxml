	<!-- States _______________________________________________________ -->
	<mx:states>
		<mx:State name="fullRight">
			<mx:SetProperty target="{pnlSelected}" name="x" value="-210" />
			<mx:RemoveChild target="{pnlSelected}" />
			<mx:SetProperty target="{col1}" name="width" value="0%" />
			<mx:SetProperty target="{col2}" name="width" value="100%" />
			<mx:SetProperty target="{fullBox}" name="height" value="100%" />
			<mx:SetProperty target="{pnlAll}" name="height" value="100%" />
			<mx:SetProperty target="{pnlAll}" name="width" value="100%" />
		</mx:State>
	</mx:states>
	
	<mx:transitions>
		<mx:Transition id="showAll" fromState="fullRight" toState="">
			<mx:Sequence>
				<mx:Move duration="300" target="{pnlSelected}" />
				<mx:Resize duration="300" target="{pnlAll}" />
			</mx:Sequence>
		</mx:Transition>
		<mx:Transition id="showRight" fromState="" toState="fullRight">
			<mx:Parallel>
				<mx:Fade duration="300" target="{pnlSelected}" alphaFrom="0" alphaTo="1"/>
				<mx:Resize duration="300" target="{pnlAll}" />
			</mx:Parallel>
		</mx:Transition>
	</mx:transitions>

	<mx:constraintColumns>
		<mx:ConstraintColumn id="col1" width="40%"/>
		<mx:ConstraintColumn id="col2" width="60%"/>
	</mx:constraintColumns>
	
	<mx:constraintRows>
		<mx:ConstraintRow id="row1" height="60%"/>
		<mx:ConstraintRow id="row2" height="40%"/>
	</mx:constraintRows>


	<!-- Views _______________________________________________________ -->
<mx:HDividedBox id="fullBox" height="100%" width="100%" paddingTop="0" paddingRight="0" paddingBottom="0" paddingLeft="0" top="2" right="2" bottom="2" left="2">

	<!--*******************************	LIST UTILITY (LEFT NAV SEARCH OPTIONS)	********************************************* 185 603
	headerColors="['0xffce84','0xffffff']"-->
