			bottom="row2:2" height="100%" left="col2:2" right="2" top="2"
			name="productSelectionUtility" title="{this.distLabel} Search Results: {this.dgItems.dataProvider.length} {sRecordMessage}">  <!-- Program: {this.oSettings.appFlex.ProgramId}-->
		<mx:VBox height="100%" width="100%" horizontalAlign="left">
		
		<!--*******************************	FILTER FIELDS	***************************************************************-->
			<mx:HBox width="100%" height="20" verticalAlign="middle">
				<mx:VBox height="100%">
					<mx:HBox width="100%">
