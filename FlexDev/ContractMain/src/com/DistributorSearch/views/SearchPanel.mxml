			 name="selectedProducts" title="{this.distLabel} Search Options" top="2" right="col1:2" bottom="row1:2" left="2">
		<mx:VBox height="100%" width="100%">
			<mx:VBox width="100%" height="20">
				<!--<mx:Text text="[ Record Count: {this.dgItems.dataProvider.length} ]" />-->
			</mx:VBox>
			<mx:VBox width="100%" height="100%">
				<!--SHOW THE TABNAVIGATOR WITH THE SEARCH OPTIONS-->
				<view:optionsTabNav id="vOptTab" />
			</mx:VBox>
		</mx:VBox> 
		</mx:Panel>
	<!--  headerColors="['0xffce84','0xffffff']"  -->
