		/* 	******************************************************************************* */
		/* SEARCH filter() -> calls setFilter() -> goes to model.searchManager.itemFilterFunc */ 	
			private function filter(event:Event):void
				{
					/* clear the check boxes */
					this.chBoxReset();
					/* check if there is any criteria to filter on */
					if(vOptTab.searchField.text.length > 0 || 
								vOptTab.cbo1.selectedIndex != 0 || 
								vOptTab.cbo2.selectedIndex != 0 || 
								vOptTab.cbo3.selectedIndex != 0 || 
								vOptTab.cbo4.selectedIndex != 0 ||
								vOptTab.cbo5.selectedIndex != 0 ||
								vOptTab.cbo6.selectedIndex != 0)
					{
						/* now apply the filters to dp -> dispath FILTER event */
						setFilter();
					}
					else if(vOptTab.searchField.text == '') /* there is no criteria to filter on so reload the dp */
					{
						filterReset(event);
					}

				}
				
			/* keep track of comboBox selections and then Dispatch the FILTER event.*/
			private function setFilter():void {
					
					var arrCboSelection:Array = new Array();
					var n:String;
					var c:ComboBox;
					/* keep track of current combo box selections */
					for (var i:Number = 1; i < 7; i++) 
							{  /* if combo box does not have "all..." then it is selected add to array */
								n = "cbo" + i;
								c = vOptTab.vbxSearch.getChildByName(n) as ComboBox;
								if (c.selectedLabel.indexOf(this.AllText) == -1)
									{ arrCboSelection.push("cbo" + i)}
							}
 
					/* set the data we need to pass to Filter Function Event */
					var event:SearchEvent = new SearchEvent(SearchEvent.FILTER);
						event.searchFieldText =  vOptTab.searchField.text;
						event.f1	=  vOptTab.cbo1.selectedLabel;
						event.f2	=  vOptTab.cbo2.selectedLabel;
						event.f3	=  vOptTab.cbo3.selectedLabel;
						event.f4	=  vOptTab.cbo4.selectedLabel;
						event.f5	=  vOptTab.cbo5.selectedLabel;
						event.f6	=  vOptTab.cbo6.selectedLabel;
						/* dispatch the event */
	               		this.dispatchEvent(event);
	               		//cboBoxReset();
	/*XXXXXXXXXXXXX UNCOMMENT TO RETAIN CONTEXT SENSITIVE SEARCHES XXXXXXXXXXXXXXXXXXXXXX*/
	               	/* update filter selections 
	               	if (arrCboSelection.indexOf("cbo1") > -1){vOptTab.cbo1.selectedIndex = 1;}
					if (arrCboSelection.indexOf("cbo2") > -1){vOptTab.cbo2.selectedIndex = 1;}
					if (arrCboSelection.indexOf("cbo3") > -1){vOptTab.cbo3.selectedIndex = 1;}
					if (arrCboSelection.indexOf("cbo4") > -1){vOptTab.cbo4.selectedIndex = 1;}
					if (arrCboSelection.indexOf("cbo5") > -1){vOptTab.cbo5.selectedIndex = 1;}
					if (arrCboSelection.indexOf("cbo6") > -1){vOptTab.cbo6.selectedIndex = 1;} */    
	            }
	         
	         /* dispatch RESET_FILTER event and update UI selections */   
			private function filterReset(e:Event):void {
					vOptTab.searchField.text='';
		           	var event:SearchEvent = new SearchEvent(SearchEvent.RESET_FILTER);
	               	this.dispatchEvent(event);
		   			this.cboBoxReset();
		   			this.chBoxReset();
		   			/* make datagrid look empty for user 
		   			this.items = new ArrayCollection(); */
	            }
	            
	       /* 	******************************************************************************* */
	        /* Reset all of the Combo Boxes to have nothing selected */
	        private function cboBoxReset():void {
					vOptTab.cbo1.selectedIndex = 0;
		   			vOptTab.cbo2.selectedIndex = 0;
		   			vOptTab.cbo3.selectedIndex = 0;
		   			vOptTab.cbo4.selectedIndex = 0;
		   			vOptTab.cbo5.selectedIndex = 0;
		   			vOptTab.cbo6.selectedIndex = 0;
	            }
	            
	 		/* Clear the Check Boxes for use again */
	         private function chBoxReset():void {
					vOptTab.chFilterSelected.selected = false;
					//this.chSelectAll.selected = false;
	            }
	         
	         /* Reset scrollbar to the top */   
	       	 public function resetScrollbarPosition(e:Event):void{
				dgItems.scrollToIndex(0);
				}
	            
			/* Handle chFilterSelected checkBox click -> Display on the selected items (filter on isSelected) */
	        private function filterSelected(evt:Event):void 
			 	{
					
					if (vOptTab.chFilterSelected.selected == 1) /*  display selected items */
						{	
							var event:SearchEvent = new SearchEvent(SearchEvent.FILTER_SELECTED);
							this.dispatchEvent(event);	
						}
					else /* bring us back to the last state of filtering */
						{
						 var e:KeyboardEvent = new KeyboardEvent(KeyboardEvent.KEY_DOWN);
						 filter(e);
						}
				}
				
	        /* Handle datagrid row double click (or enter key) -> toggle isSelected value for All selected Rows */
	         private function selectDgRow(event:ListEvent):void
					{
					if(this.oneDistSelection == true)
	                	/* Template setting one_distributor is true so we can only select one (must deselect) all others */
						{
					      var dp:Array = this.dgItems.dataProvider.source as Array;
						   for each(var item:Object in dp)
						   	{
						   		//if the item we are on (in the loop) matches the selected item -> selected = true.  All others are false
						   	if(item.distGuid  == this.dgItems.selectedItem.distGuid)
						   		{
			                       item.isSelected = true;   	/* ***dgItems.dataProvider[event.currentTarget.selectedIndex]*** */
			                    }
			                    else
			                    {
			                        item.isSelected = false;
			                    }
						    }
						}
					else
						/* Allow multiselect -> select all*/
						{	//Alert.show('xxx ' + this.oneDistSelection)
							/* Loop over selectedItems array (mx.controls.listClasses.ListBase) */
							var arrSelectedRows:Array = event.currentTarget.selectedItems;
							var b:Boolean;
							for each(var o:Object in arrSelectedRows)
								{
								  b = !o.isSelected;
								  o.isSelected = b;
								}
							dgItems.invalidateList();
						}
					   
					}		
			/*  handler for when a user presses enter on a DG row */
			 private function enterRow(e:KeyboardEvent):void 
			 	{                
			 		if (e.keyCode == Keyboard.ENTER) 
			 		/* ITEM_DOUBLE_CLICK calls selectRow()   */                   
			 		dgItems.dispatchEvent(new ListEvent(ListEvent.ITEM_DOUBLE_CLICK));
			 	}
			 	
			 /* Handle when user hits enter key in seach box -> call the filter() method */
			 private function enterSearchBox(event:KeyboardEvent):void 
			 	{                
			 		if (event.keyCode == Keyboard.ENTER)
			 		/* call main filter method */                       
			 		this.filter(event);
			 	}
			 	
			 /* Handle when user hits enter key on a form element -> dispatch the click event for the element */
			 private function enterButton(event:KeyboardEvent):void 
			 	{                
			 		if (event.keyCode == Keyboard.ENTER)
			 		{
				 		// Create new event object.
			            var mev:MouseEvent = new MouseEvent(MouseEvent.CLICK);
			            // Dispatch click event to the target of original keydown event.
			            event.currentTarget.dispatchEvent(mev);                 
				 	}
			 	}
			 
			 /* Handle when user hits enter key on a checkbox */
			 private function enterCheckBox(event:KeyboardEvent):void 
			 	{                
			 		if (event.keyCode == Keyboard.ENTER)
			 		{
				 		// Create new event object.
			            var mev:MouseEvent = new MouseEvent(MouseEvent.CLICK);
			            // Dispatch click event to the target of original keydown event.
			            event.currentTarget.selected = !event.currentTarget.selected;                 
				 	}
			 	}
			 
			/* Handle the Import Items Button Click ****************************** */
			private function callImportItems(e:Event):void
				{
					/* Dispatch Event */
					var event:SearchEvent = new SearchEvent(SearchEvent.IMPORT_ITEMS);
					this.dispatchEvent(event);
				}
			/* Handle the Cancel Button Click ****************************** */
			private function cancelClick(e:Event):void
			{
				/* Dispatch Event */
				/* Close the popup from the main App */
				var event:MainEvent = new MainEvent(MainEvent.CLOSE_PAYEE);
				this.dispatchEvent(event);
			}
			/* ******************************************************************* */
			/* *****	USER LIST FUNCTIONS	************************************** */
			/* ******************************************************************* */
			/* Handle the Create List Button click */
			private function callCreateList(e:Event):void
				{
					/* Dispatch Event */
					var event:SearchEvent = new SearchEvent(SearchEvent.CREATE_LIST);
					event.iList = vOptTab.txtCrList.text;
					this.dispatchEvent(event);
					/* clear the Filter Selected checkbox */
					this.chBoxReset();
				}
				
			/* Handle the Get List Items Button Click (btnGetListItems)  or (lsUserList) DOUBLE_CLICK */
			private function getUserListItems(e:Event):void
				{
					if(vOptTab.lsUserList.selectedItems.length == 0)
					{
						Alert.show("Please select a list to display");
					}
					else
					{
						/* Dispatch Event */
						var event:SearchEvent = new SearchEvent(SearchEvent.GET_USERLIST_ITEMS);
						event.arrUserListItems = vOptTab.lsUserList.selectedItem.DATA;
						this.dispatchEvent(event);
						this.chBoxReset();
						/* flag the items as selected */
						//this.chSelectAll.selected = true;
						//this.selectAll();
					}
				}
				
			/*  handler for when a user presses enter on a Saved user List row (lsUserList)*/
			 private function enterUserListRow(event:KeyboardEvent):void 
			 	{                
			 		if (event.keyCode == Keyboard.ENTER) 
			 		/* ITEM_DOUBLE_CLICK calls getUserList()   */                   
			 		vOptTab.lsUserList.dispatchEvent(new ListEvent(ListEvent.ITEM_DOUBLE_CLICK));
			 	}

			/* Handle the Save My Lists Button Click (btnSaveUserList)*/
			private function saveUserList(e:Event):void
				{
					if(vOptTab.tListName.text.length == 0)
					{
						Alert.show("Please enter a name for your saved list");
					}
					else
					{
						if(arrUserList.length > 24)
						{
							Alert.show("The limit for the favorites list is 25. Either delete one or edit an existing one.");
						}	
						else
						{
							/* First filter so we only see selected items */
							var fEvent:SearchEvent = new SearchEvent(SearchEvent.FILTER_SELECTED);
							this.dispatchEvent(fEvent);
							/* create an array of the selected items */
							var tmpArrItems:Array = new Array();
							for each(var oItem:Object in this.items)
									{
										if(oItem['isSelected'] == 1 && tmpArrItems.indexOf(oItem['baItem']) == -1)
											{tmpArrItems.push(oItem['baItem'])}
									}
							/* Dispatch Event */
							var event:SearchEvent = new SearchEvent(SearchEvent.SAVE_USERLIST);
							event.userId = this.oSettings.userId;
							event.arrUserListItems = tmpArrItems;
							event.userListItemsName = vOptTab.tListName.text;
							this.dispatchEvent(event);
						}
					}
				}
				
			/* Handle the Get My Lists Button Click (btnGetLists)*/
			private function deleteUserList(e:Event):void
				{
					/* update the dp */
					if(vOptTab.lsUserList.selectedItems.length == 0)
					{
						Alert.show("Please select a list to delete");
					}
					else
					{
						/* Dispatch Event */
						var event:SearchEvent = new SearchEvent(SearchEvent.DELETE_USERLIST);
						event.userListId = vOptTab.lsUserList.selectedItem.USER_DISTRIBUTOR_LIST_ID;
						this.dispatchEvent(event);
					}
				}
				
			/* Based on template setting one_distributor insert a column of checkboxes or radio buttons.
				@ called from dgItems.creationComplete AND below from <mate:Listener type="{SearchEvent.SET_DG_SELECTION}"*/
			private function addSelectionGridColumn(dataField:String):void
	            {	/* make sure that the dg is alive  AND The isSelected Column Has Not been created yet AND The appsettings have been loaded*/
	                if(this.dgItems && this.dgItems.hasOwnProperty('columns') && this.dgItems.columns.length  && this.dgItems.columns[0].dataField.indexOf('isSelected') == -1)
	                {
		                var dgc:DataGridColumn = new DataGridColumn(dataField);
		                dgc.headerText="";
		                dgc.sortable = false;
		                dgc.dataField = dataField;
		                //for payee search we only selet one
		               // dgc.itemRenderer=  new ClassFactory(radioIsSelected);
						//Alert.show('add col: ' + this.oneDistSelection + ' :: ooooo' + ObjectUtil.toString(this.oSettings));
		               if(this.oneDistSelection == true)
		                	//Template setting one_distributor is true so use a radioButton
							{
							    dgc.itemRenderer=  new ClassFactory(radioIsSelected);
							}
						else
							//Allow multiselect -> use checkbox
							{
								dgc.itemRenderer=  new ClassFactory(chBoxIsSelected);
		                		dgc.headerRenderer= new ClassFactory(chBoxSelectAll);		
							}
		            	dgc.editorDataField="varCbSelected";
		            	dgc.rendererIsEditor = true;
		            	dgc.width = 20;
		                var cols:Array = this.dgItems.columns.filter(removeCol);
		                cols.unshift(dgc);
		                this.dgItems.columns = cols;
		                this.dgItems.allowMultipleSelection = !this.oneDistSelection
		               //Alert.show(ObjectUtil.toString(this.oneDistSelection) + '  DONE::  ');
	                }
	            }

	         /* filter function used to remove isSelected column from dgItems.columns array*/
	         private function removeCol(element:*, index:int, arr:Array):Boolean {
            		return (element['dataField'] != 'isSelected');
        		}
	            
			/* Handle user clicking on panel icons to hide or show list panel */
			private function toggleState(state:String):void
				{
					if(state == "fullRight")
					{
						this.currentState = "fullRight";
						iconRight.visible = false;
						iconAllR.visible = true;
						iconRight.includeInLayout = false;
						iconAllR.includeInLayout = true;
					}
					else if(state == "fullAll")
					{
						this.currentState = "";
						iconAllR.visible = false;
						iconRight.visible = true;
						iconAllR.includeInLayout = false;
						iconRight.includeInLayout = true;
					}
				}
				
			private function Call_Sort_Data(evt:DataGridEvent):void {
               	/* Reset the scrollbar position to the top. */
				var e:SearchEvent = new SearchEvent(SearchEvent.RESET_SCROLLBAR_POSITION);
       			this.dispatchEvent(e);
            }
 

		]]>
	</mx:Script>
