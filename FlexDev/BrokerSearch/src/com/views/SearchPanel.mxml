			FOR TESTING ONLY XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX */

		]]>
	</mx:Script>

	<!-- States _______________________________________________________ -->
	<mx:states>
		<mx:State name="fullRight">
			<mx:SetProperty target="{pnlSelected}" name="x" value="-210" />
			<mx:RemoveChild target="{pnlSelected}" />
			<mx:SetProperty target="{col1}" name="width" value="0%" />
			<mx:SetProperty target="{col2}" name="width" value="100%" />
			<mx:SetProperty target="{fullBox}" name="height" value="100%" />
			<mx:SetProperty target="{pnlAll}" name="height" value="100%" />
			<mx:SetProperty target="{pnlAll}" name="width" value="100%" />
		</mx:State>
	</mx:states>
	
	<mx:transitions>
		<mx:Transition id="showAll" fromState="fullRight" toState="">
			<mx:Sequence>
				<mx:Move duration="300" target="{pnlSelected}" />
				<mx:Resize duration="300" target="{pnlAll}" />
			</mx:Sequence>
		</mx:Transition>
		<mx:Transition id="showRight" fromState="" toState="fullRight">
			<mx:Parallel>
				<mx:Fade duration="300" target="{pnlSelected}" alphaFrom="0" alphaTo="1"/>
				<mx:Resize duration="300" target="{pnlAll}" />
			</mx:Parallel>
		</mx:Transition>
	</mx:transitions>

	<mx:constraintColumns>
		<mx:ConstraintColumn id="col1" width="40%"/>
		<mx:ConstraintColumn id="col2" width="60%"/>
	</mx:constraintColumns>
	
	<mx:constraintRows>
		<mx:ConstraintRow id="row1" height="60%"/>
		<mx:ConstraintRow id="row2" height="40%"/>
	</mx:constraintRows>


	<!-- Views _______________________________________________________ -->
<mx:HDividedBox id="fullBox" height="100%" width="100%" paddingTop="0" paddingRight="0" paddingBottom="0" paddingLeft="0" top="2" right="2" bottom="2" left="2">

	<!--*******************************	LIST UTILITY (LEFT NAV)	*********************************************-->
	<mx:Panel id="pnlSelected" backgroundColor="0xffffff" headerColors="['0xffce84','0xffffff']" color="0x333333" minWidth="228" minHeight="600"
			 name="selectedProducts" title="{this.brokerLabel} Search Options" top="2" right="col1:2" bottom="row1:2" left="2">
		<mx:VBox height="100%" width="100%">
			<!--<mx:VBox width="100%" height="20" creationPolicy="queued" creationIndex="3">
				<mx:Text text="[ Record Count: {this.dgItems.dataProvider.length} ]" />
			</mx:VBox>
			-->
			<mx:VBox width="100%" height="100%" creationPolicy="queued" creationIndex="0">

				<mx:TabNavigator id="tbNavList" width="100%" height="100%" creationComplete="this.tbNavList.selectedIndex = 0">
					<mx:Canvas label="search" width="100%" height="100%">
						<mx:VBox  id="vbxSearch" label="search {this.brokerLabel}s" width="100%" height="100%" paddingLeft="5" paddingRight="5">
							
							<mx:TextInput tabEnabled="true" text="" id="searchField" width="200" height="{iTextInputHeight}"
								toolTip="Keyword search on any of the fields:&#13;{this.brokerLabel} Id, {this.brokerLabel} name, {this.lblCol1}, {this.lblCol2}, {this.lblCol3}, {this.lblCol4}." 
								keyDown="enterSearchBox(event);"/>
							
							<mx:HBox width="100%">
								<!--- Search Button in Seach tab: Filters brokers in datagrid based on currrent criteria-->
								<mx:Button height="{iButtonHeight}" id="btnFilter" label="search" width="63" tabEnabled="true"  click="filter();" keyDown="enterSearchBox(event);" toolTip="search"  />
								<!--- Reset Button in Seach tab: Clears all filters and reloads all available brokers in the datagrid-->
								<mx:Button height="{iButtonHeight}" id="btnReset" label="reset" width="63" tabEnabled="true" click="searchField.text='';filterReset()" />
							</mx:HBox>
							<!--- view selected check box: when checked, only selected items are displayed-->
							<mx:CheckBox id="chFilterSelected" label="view selected" click="filterSelected();" toolTip="show only the currently selected items"/>
							<mx:VBox id="vbxFilter" paddingBottom="0" paddingLeft="0" paddingRight="0" paddingTop="0">
							<!--- Combo Box provides Filter Criteria to filterFunction-->
							<mx:ComboBox toolTip="Filter: {this.lblCol1}" id="cbo1" dataProvider="{dp1}" change="filter()" width="175" height="{iComboBoxHeight}"	tabEnabled="true" rowCount="15"></mx:ComboBox>
							<!--- Combo Box provides Filter Criteria to filterFunction-->
							<mx:ComboBox toolTip="Filter: {this.lblCol2}" id="cbo2" dataProvider="{dp2}" change="filter()" width="175" height="{iComboBoxHeight}" tabEnabled="true" rowCount="15"></mx:ComboBox>
							<!--- Combo Box provides Filter Criteria to filterFunction-->
							<mx:ComboBox toolTip="Filter: {this.lblCol3}" id="cbo3" dataProvider="{dp3}" change="filter()" width="175" height="{iComboBoxHeight}" tabEnabled="true" rowCount="15"></mx:ComboBox>
							<!--- Combo Box provides Filter Criteria to filterFunction-->
							<mx:ComboBox toolTip="Filter: {this.lblCol4}" id="cbo4" dataProvider="{dp4}" change="filter()" width="175" height="{iComboBoxHeight}" tabEnabled="true" rowCount="15"></mx:ComboBox>
							<!--- Combo Box provides Filter Criteria to filterFunction-->
							<mx:ComboBox toolTip="Filter: {this.lblCol5}" id="cbo5" dataProvider="{dp5}" change="filter()" width="175" height="{iComboBoxHeight}" tabEnabled="true" rowCount="15"></mx:ComboBox>
							<!--- Combo Box provides Filter Criteria to filterFunction-->
							<mx:ComboBox toolTip="Filter: {this.lblCol6}" id="cbo6" dataProvider="{dp6}" change="filter()" width="175" height="{iComboBoxHeight}" tabEnabled="true" rowCount="15" includeInLayout="false" visible="false"></mx:ComboBox>
							</mx:VBox>
						</mx:VBox>
					</mx:Canvas>
					<mx:Canvas label="create list" width="100%" height="100%">
						<mx:VBox  id="crList" label="create list" width="100%" height="100%" paddingLeft="5">
							<mx:TextArea height="300" width="95%" id="txtCrList"
								 toolTip="To search for a list of {this.brokerLabel}s:&#13;Type or paste in a list of {this.brokerLabel} numbers.  Separate each {this.brokerLabel} number by the enter key. Click search."
								 wordWrap="false" editable="true" enabled="true">
								<mx:text></mx:text>
							</mx:TextArea>
							<!--- Search Button in create list tab determines valid and invalid items and displays them-->
							<mx:Button height="{iButtonHeight}" id="btnCreateList" label="search" click="callCreateList(this.txtCrList.text);"/>
						</mx:VBox>
					</mx:Canvas>
					<mx:Canvas label="favorites" width="100%" height="100%">
						<mx:VBox id="svSearch" label="saved list" width="100%" height="100%" paddingLeft="5">
							<mx:List id="lsUserList" dataProvider="{arrUserList}" 
									labelField="LIST_NAME" height="300" width="95%"
									doubleClickEnabled="true" itemDoubleClick="this.getUserListItems();"
									keyDown="enterUserListRow(event);" 
									toolTip="To save a list of your favorite {this.brokerLabel}s:&#13;Place a checkmark next to the {this.brokerLabel}s you want to save.  Give your list of favorite {this.brokerLabel}s a name in the field called 'Favorites Name'. Click save.&#13;&#13;To see one of your favorites:&#13;Double click on the Favorites Name.&#13;The Favorites list will appear on the right hand side." />
							<mx:HBox>
								<!--- Search button in favorites tab displays valid items from the selected saved list-->
								<mx:Button height="{iButtonHeight}" id="btnGetListItems" label="search" click="getUserListItems();" toolTip="Display the items in the selected list"/>
								<!--- Delete button in favorites tab deletes selected saved list-->
								<mx:Button height="{iButtonHeight}" id="btnDeleteList" label="delete" click="deleteUserList();" toolTip="Delete the selected list"/>
							</mx:HBox>
							<!--- Save button in favorites tab saves all the currently checked items to a new list (if a name is specified in the list name textbox)-->
							<mx:Button height="{iButtonHeight}" id="btnSaveUserList" label="save selected" click="saveUserList();" toolTip="Save selected {this.brokerLabel}s"/>
							<mx:Text text="list name:"/>
							<mx:TextInput id="tListName" height="{iTextInputHeight}" maxChars="20" width="150"/>
						</mx:VBox>
					</mx:Canvas>
				</mx:TabNavigator>
			</mx:VBox>
		</mx:VBox> 
		</mx:Panel>
		<mx:Panel id="pnlAll" backgroundColor="0xffffff" headerColors="['0xffce84','0xffffff']" color="0x333333"
			bottom="row2:2" height="100%" left="col2:2" right="2" top="2"
			name="productSelectionUtility" title="{this.brokerLabel} Search Results: {this.dgItems.dataProvider.length} records">  <!-- Program: {this.oSettings.appFlex.ProgramId}-->
		<mx:VBox height="100%" width="100%" horizontalAlign="left" creationPolicy="queued" creationIndex="3">
		
		<!--*******************************	FILTER FIELDS	***************************************************************-->
			<mx:HBox width="100%" height="20" verticalAlign="middle"  creationPolicy="queued" creationIndex="1">
				<mx:VBox height="100%">
					<mx:HBox width="100%">
						<mx:Image id="iconRight" 
							source="/Flex/assets/images/fullScreen.png"
							width="20" height="20" click="toggleState('fullRight')" toolTip="Click for Right Panel Full Screen"/>
						<mx:Image id="iconAllR" 
							source="/Flex/assets/images/sharedScreen.png"
							width="20" height="20" click="toggleState('fullAll')" toolTip="Click for both Panels Shared Screen" visible="false" includeInLayout="false" />
						
					</mx:HBox>
					<!--<mx:CheckBox id="chSelectAll" label="select all" click="selectAll();" toolTip="select all {this.brokerLabel}s" includeInLayout="false" />-->
				</mx:VBox>
				<mx:Spacer width="20" />
				<mx:CheckBox id="chShowcol1" label="{this.lblCol1}" click="showHide('dgCol1','col1');" toolTip="show or hide {this.lblCol1}"/>
				<!--- Check Box to Show Hide datagrid Column-->
				<mx:CheckBox id="chShowcol2" label="{this.lblCol2}" click="showHide('dgCol2','col2');" toolTip="show or hide {this.lblCol2}" />
				<!--- Check Box to Show Hide datagrid Column-->
				<mx:CheckBox id="chShowcol3" label="{this.lblCol3}" click="showHide('dgCol3','col3');" toolTip="show or hide {this.lblCol3}" />
				<!--- Check Box to Show Hide datagrid Column-->
				<mx:CheckBox id="chShowcol4" label="{this.lblCol4}" click="showHide('dgCol4','col4');" toolTip="show or hide {this.lblCol4}" />
				<!--- Check Box to Show Hide datagrid Column-->
				<mx:CheckBox id="chShowcol5" label="{this.lblCol5}" click="showHide('dgCol5','col5');" toolTip="show or hide {this.lblCol5}" />
				<!--- Check Box to Show Hide datagrid Column-->
				<!--<mx:CheckBox id="chShowcol6" label="{this.lblCol6}" click="showHide('dgCol6','col6');" toolTip="show or hide {this.lblCol6}" />-->
			</mx:HBox>
			
			<!--*********************************	DATA GRID ********************************************************************-->
			<mx:DataGrid dragEnabled="false" allowMultipleSelection="true" liveScrolling="true"
				id="dgItems" dataProvider="{items}" editable="true"
				width="100%" height="100%" top="0" left="0" right="0" bottom="0" doubleClickEnabled="true" 
				itemDoubleClick="selectRow(event);" keyDown="enterRow(event);"  tabEnabled="true"
				toolTip="Select a row by:&#13;clicking the check box or&#13;double clicking a Row or &#13;highlighting the row(s) and pressing ENTER"
				headerRelease="Call_Sort_Data(event)">
				<mx:columns>
					<mx:DataGridColumn width="20" dataField="isSelected" rendererIsEditor="true"
						headerRenderer="com.components.chBoxSelectAll"
						itemRenderer="com.components.chBoxIsSelected" 
                		editorDataField="varCbSelected"/>
			     
					<mx:DataGridColumn dataField="baItem" headerText="{this.brokerLabel} ID" width="100" editable="false" />
					<mx:DataGridColumn dataField="Description" headerText="{this.brokerLabel} Name" width="200" editable="false" />
					<mx:DataGridColumn dataField="Address" headerText="Address" width="300" editable="false" />
					<mx:DataGridColumn id="dgCol1" dataField="col1" headerText="{this.lblCol1}" width="100" editable="false" visible="false" />
					<mx:DataGridColumn id="dgCol2" dataField="col2" headerText="{this.lblCol2}" width="100" editable="false" visible="false" />
					<mx:DataGridColumn id="dgCol3" dataField="col3" headerText="{this.lblCol3}" width="100" editable="false" visible="false" />
					<mx:DataGridColumn id="dgCol4" dataField="col4" headerText="{this.lblCol4}" width="100" editable="false" visible="false" />
					<mx:DataGridColumn id="dgCol5" dataField="col5" headerText="{this.lblCol5}" width="100" editable="false" visible="false" />
					<mx:DataGridColumn id="dgCol6" dataField="col6" headerText="{this.lblCol6}" width="100" editable="false" visible="false" />
				</mx:columns>
			</mx:DataGrid>
		
		</mx:VBox>
			<!--- "import selected" Button : returns all checked items to wrapper javascript which then passes them to the calling page via a form submit-->
			<mx:Button height="{iButtonHeight}" label="import selected" click="callImportItems();"  tabEnabled="true"/>
			<!--<mx:Text height="30" text="Memory Usage: Tot= {totmem.toFixed(2)} MB | Max= {maxmem.toFixed(2)} MB"/>-->

		</mx:Panel>
		
		</mx:HDividedBox>
	<!--</mx:HBox>-->
	<!--*********************************	BOTTOM PANEL (Import Button) ************************************************************-->
	

</mx:Canvas>
