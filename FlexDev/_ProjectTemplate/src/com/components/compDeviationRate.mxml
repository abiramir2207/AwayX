<?xml version="1.0" encoding="utf-8"?>
<!---
 	This is a ItemRenderer for displaying the image based on the field DEVIATION_RATE 
 	from the query result 
-->
<mx:HBox xmlns:mx="http://www.adobe.com/2006/mxml" width="100%" height="20" horizontalGap="1" horizontalAlign="center" verticalAlign="middle">
	<mx:Script xmlns:mx="http://www.adobe.com/2006/mxml">
		<![CDATA[
			import mx.controls.Alert;
			import mx.utils.ObjectUtil;
			import flash.external.ExternalInterface
			import com.asfusion.mate.events.Dispatcher;
			import mx.events.CloseEvent;
			import mx.controls.advancedDataGridClasses.AdvancedDataGridListData;
			public var URLgeneratedDR:String = "/billbacks/Deviation/Deviation_Product_Rate.cfm?Billback_Product_Detail_ID="; 
		]]>
</mx:Script>
  <mx:Image xmlns:mx="http://www.adobe.com/2006/mxml" 
			id="imgDR"	
			width="12"
			height="12"
			source="{getSource(data.DEVIATION_RATE)}" 
			useHandCursor="true" 
			buttonMode="true" 
			mouseChildren="false"
			click="fnDRClick()">    
			<!-- 	toolTip="Deviation Rate" -->
			<mx:Script>
				<![CDATA[
					/** 
					* This holds the image to be displayed basesd on the DEVIATION_RATE 
					* field from the query result
					*/						
					private var imgDRHolder:Class;
					
					/** 
				 	* This function determines which image has to be displayed for the 
				 	* Rate Validation column in the grid.
				 	*/					
				  private function getSource(recType:String):Object
					{
						// Do not display the Tick or "X" image incase of
						// Dummy program or unknow Item 
						if((data.Dummy_Program=='0')&&(data.UnKnown_Item=='0'))
						{
							if (data.DEVIATION_RATE == 1)   
							{
								[Embed(source='/assets/Images/no.gif')]
							 	var imgNo:Class;
							 	imgDRHolder = imgNo;
							}
							else if (data.DEVIATION_RATE == 0)
							{
								[Embed(source="/assets/Images/yes.gif")]
							 	var imgYes:Class;
								imgDRHolder = imgYes; 
							}
							else
							{
								imgDRHolder:Class;
							}
						}
						else
						{
							imgDRHolder:Class;
						}
						return imgDRHolder;
					}  
					/**
					*	This function will open a popup window with the link 
					* "/billbacks/Deviation/Deviation_Growth_New.cfm", if the product type
					* is Growth or "/billbacks/Deviation/Deviation_Lumpsum.cfm", if 
					* the product type is Lumpsum or "/billbacks/Deviation/Deviation_Product_Rate.cfm" 
					* if the product type is Fixed Price or Rebate, passing the 
					* Billback_Program_ID. The data.* would not work in the 
					* initialization above as the data.* is not created and is available only later
					*/					
					private function fnDRClick():void
					{
						var strRequestURL:String = "";
						if(data.BB_Product_Type_ID=="4")
						{
							strRequestURL = "/billbacks/Deviation/Deviation_Growth_New.cfm?Billback_Program_ID=" + data.Billback_Program_ID;
						}
						else if (data.BB_Product_Type_ID=="3")
						{
							strRequestURL = "/billbacks/Deviation/Deviation_Lumpsum.cfm?Billback_Program_ID=" + data.Billback_Program_ID;
						}
						else
						{
							strRequestURL = URLgeneratedDR + data.Billback_Product_Detail_ID + "&BB_Product_Type_ID=" + data.BB_Product_Type_ID;
						}
						ExternalInterface.call("f = function() { window.open('"+strRequestURL+"','win','toolbar=no,scrollbars=yes,resizable=1,width=780,height=650'); }");						
					}					
				]]>
			</mx:Script>
	</mx:Image>
</mx:HBox> 			

 