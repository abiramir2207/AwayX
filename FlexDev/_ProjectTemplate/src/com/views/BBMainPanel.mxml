		 	* and name of this function which sets the Expected Rate to be the 
		 	* Claimed Rate and set the Rate_Override to 1. 
			* 
			* @param evtObj This holds each row in the datagrid as an Object
		  */			
			public function fnRateOverride(evtObj:Object):void
			{
				nTotalApproved = 0;
				fnCallRecalculate(evtObj,"fnRateOverride","0");	
				dgData.dataProvider.refresh();
				dgData.invalidateList();
			}
			
		]]>
	</mx:Script>
  
