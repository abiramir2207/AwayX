						    			paddingLeft="6" enabled="{(outerDocument.sBBStatusID=='2') &amp;&amp; (data.Dummy_Program=='0') &amp;&amp; (data.UnKnown_Item=='0')}"/><!--  -->
						    		</mx:HBox>		
						    	</mx:Component>
								</mx:itemRenderer>
