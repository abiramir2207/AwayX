			 * which is the last button element and it adds the eventListeners for 
			 * all the buttons.  It adds the eventListeners of type MouseEvent.Click 
			 * and KeyboardEvent.KEY_DOWN 
			 */
			public function fnInitListeners():void  
			{ 
				// Event Listener for the "Volume Override" Button
				this.btnVolOverride.addEventListener(MouseEvent.CLICK,fnVolOverride,false,0,true)
			 	this.btnVolOverride.addEventListener(KeyboardEvent.KEY_DOWN,fnEnterButton,false,0,true);
				
				// Event Listener for the "Rate Override" Button
				this.btnRateOverride.addEventListener(MouseEvent.CLICK,fnRateOverride,false,0,true)
			 	this.btnRateOverride.addEventListener(KeyboardEvent.KEY_DOWN,fnEnterButton,false,0,true);
				
				// Event Listener for the "Save" Button 
				this.btnSave.addEventListener(MouseEvent.CLICK,fnDoActions,false,0,true)
			 	this.btnSave.addEventListener(KeyboardEvent.KEY_DOWN,fnEnterButton,false,0,true);
			
				// Event Listener for the "Approve" Button
				this.btnApprove.addEventListener(MouseEvent.CLICK,fnDoActions,false,0,true)
			 	this.btnApprove.addEventListener(KeyboardEvent.KEY_DOWN,fnEnterButton,false,0,true);
			  
			  // Event Listener for the "Recalc" Button
				this.btnRecalc.addEventListener(MouseEvent.CLICK,fnDoActions,false,0,true)
				this.btnRecalc.addEventListener(KeyboardEvent.KEY_DOWN,fnEnterButton,false,0,true);
			 	
			 	// Event Listener for the "Approve Claimed Amount" Button
				this.btnClaimedAmt.addEventListener(MouseEvent.CLICK,fnClaimedAmountClicked,false,0,true)
				this.btnClaimedAmt.addEventListener(KeyboardEvent.KEY_DOWN,fnEnterButton,false,0,true);
				
				// Event Listener for the "Approve Expected Amount" Button	
				this.btnExpectedAmt.addEventListener(MouseEvent.CLICK,fnExpectedAmountClicked,false,0,true)
				this.btnExpectedAmt.addEventListener(KeyboardEvent.KEY_DOWN,fnEnterButton,false,0,true);  
			}
 			
 			/**
 			* This function is called when the user hits enter key on a form element 
 			* and it inturn dispatch a MouseEvent.CLICK for the same element.
 			*/ 
			private function fnEnterButton(event:KeyboardEvent):void 
			{                
				if (event.keyCode == Keyboard.ENTER)
			 	{
					// Create new event object.
			    var evtMouseClick:MouseEvent = new MouseEvent(MouseEvent.CLICK);
			    // Dispatch click event to the target of original keydown event.
			    event.currentTarget.dispatchEvent(evtMouseClick);                 
				}
			}

 
