 			private function fnAdvDGDataTipFunction(object:Object):String
    	{
    		if(object.hasOwnProperty("dataField")) 
    		{
        	switch(object.dataField)
        	{
						case "DEVIATION_UNAUTHORIZED_PAYEE":
							return "Unauthorized Payee";
							break;
	        	case "DEVIATION_PROGRAM_DATES":
            	return "Date match validation";
            	break;
        		case "DEVIATION_BILLBACK_OVERLAP":
            	return "Date overlap validation";
            	break;
	        	case "DEVIATION_UNAUTHORIZED_PRODUCT":
            	return "Authorization validation";
            	break;
  	      	case "DEVIATION_VOLUME":
            	return "Volume validation";
            	break;
    	    	case "DEVIATION_RATE":
            	return "Rate validation";
            	break;
            case "Count_Flag":
            	return "Count Flag";
            	break;
            case "E_Volume":
            	return "Expected Volume";
            	break;
            case "Expected_Invoice_Price":
            	return "Expected Invoice Price";
            	break;
            case "Claim_Invoice_Price":
            	return " Claimed Invoice Price";
            	break;	
            case "Variation_Claim_Expected":
            	return "Total Deviation";
            	break;	
        	}
  			}
    		return "";
    	}

