			/**
			* This function takes the Event parameter and assigns the strAction variable 
			* accordingly and based on the strAction does an approval and takes the user to a 
			* different page or saves and runs the deviation.
			* strAction: This variable holds the value <strong>"doSaveApprove"</strong> 
			* or <strong>"doSaveRecalc"</strong> so if the value is 
			* <strong>"doSaveApprove"</strong> then the page is saved and then 
			* redirected to the Approve cfm page.  If the value is 
			* <strong>"doSaveRecalc"</strong> then the page is saved and 
			* Deviation is run.
			*   
			* @param e This param holds the event that called this function 
			* 
			*/
			public function fnDoActions(e:Event):void
			{
				var strAction:String = "";
				switch (e.currentTarget.id)
				{
					case "btnSave":
						strAction = "doSave"
						break;
					case "btnApprove":
						btnClaimedAmt.enabled = false;
						btnApprove.enabled = false;
						btnExpectedAmt.enabled = false;
						strAction = "doSaveApprove"
						break;	
					case "btnRecalc":
						strAction = "doSaveRecalc"
						break;
				}
				
				var eventSaveChanges:MainEvent = new MainEvent(MainEvent.SAVE_CHANGES);
				eventSaveChanges.Billback_ID 	 = this.sBBID;
				eventSaveChanges.sUserId 		 	 = this.sUserID;
				eventSaveChanges.dgEditedSet 	 = this.dpBBData.source;
				eventSaveChanges.doAction			 = strAction;
				this.dispatchEvent(eventSaveChanges);
				 
				if (strAction =='doSaveRecalc')
				{
					// for deviation recalculation
					var eventReloadGrid:MainEvent = new MainEvent(MainEvent.GET_BILLBACK_DETAILS);
					eventReloadGrid.sBBID 	 			= this.sBBID;
					this.dispatchEvent(eventReloadGrid);
					nTotalApproved = 0;
					dgData.dataProvider.refresh();
					dgData.invalidateList();
				}
			} 
	
			/**
			 * This function gets called by the event MainEvent.APPROVE which checks
			 * to see if the parameter has a value of "doSaveApprove" and redirects 
			 * to the approval page if it is true.
			 */
			public function fnApprovePageRedirector(strAct:String):void
			{
				if (strAct == 'doSaveApprove')
						{
						// call the save function before calling the approval
							var winjscommand:String="/Billbacks/Approval/payment.cfm?BBID=" + this.sBBID + "&source=flexBB"; 
							var url:URLRequest= new URLRequest(winjscommand);   
						 	navigateToURL(url, "_self"); 
				}
			}
	

