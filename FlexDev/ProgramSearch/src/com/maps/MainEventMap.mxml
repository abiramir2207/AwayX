			<Properties ArchiveYear = "" />
			<Properties showCatalog = "false" />
		</EventAnnouncer>-->	
	</EventHandlers>	
	
	<!--- Call this Event right after the application creation is Complete -->
	<EventHandlers type="{FlexEvent.CREATION_COMPLETE}" dispatcherType="global" id="FlexEvent_CREATION_COMPLETE">
