	<!--- 
	  Remote Filter data call___________________________________________________________		
      @see #SearchProgramDataService
      ** RemoteInvoke: SearchProgramDataService.filterData
      @see com.models.ProgramSearchManager#setRoFilter() 
      ** Handler: ProgramSearchManager.setRoFilter  
  	-->
	<EventHandlers type="{SearchProgramEvent.RO_FILTER_PROGRAMS}" id="SearchProgramEvent_RO_FILTER_PROGRAMS">
		<RemoteObjectInvoker instance="{SearchProgramDataService}" showBusyCursor="true" method="filterData" 
			arguments="{[event.eDistributor_Info,event.eOperator_Info,event.eItem_Info,event.eStatus,event.userId,event.eBuyingGroups,event.eFamilyName,
			event.eUName,event.ePositions,event.eProgramInfo,event.eBudgetClasses]}">
			<!-- result sequence gets executed when service returns with a result -->
			<resultHandlers>
				<MethodInvoker generator="{ProgramSearchManager}" method="setRoFilter" arguments="{resultObject}" />
				<EventAnnouncer generator="{SearchProgramEvent}"  type="{SearchProgramEvent.FILTER_RESULTS}">
					<Properties eStatus="{event.eStatus}" />
					<Properties eTemplate="{event.eTemplate}" />
					<Properties eRSP="{event.eRSP}" />
					<Properties eBuyingGroups="{event.eBuyingGroups}" />
					<Properties eFamilyName="{event.eFamilyName}" />
					<Properties eUName ="{event.eUName}" />
					<Properties ePositions="{event.ePositions}" />
					<Properties eProgramInfo="{event.eProgramInfo}" />
					<Properties eReportType="{event.eReportType}" />
					<Properties eConditions="{event.eConditions}" />
					<Properties eProgram_Info="{event.eProgram_Info}" />
					<Properties eDistributor_Info="{event.eDistributor_Info}" />
					<Properties eOperator_Info="{event.eOperator_Info}" />
					<Properties eItem_Info="{event.eItem_Info}" />
					<Properties eBudgetClasses="{event.eBudgetClasses}" />
					<Properties eBusinessSegments ="{event.eBusinessSegments}" />
    			</EventAnnouncer>
			</resultHandlers>
			<!-- server fault -->
			<faultHandlers>
				<!--announce error event -->
				<EventAnnouncer type="{SearchProgramEvent.BSA_ERROR}" generator="{SearchProgramEvent}" >
					<Properties sBaError="SEARCH SERVICE (get remote filter array)" />
					<Properties oBaError="{fault}" />
				</EventAnnouncer>
			</faultHandlers>
		</RemoteObjectInvoker>
	</EventHandlers>
	<!-- END END Remote Filter Data call -->
	
