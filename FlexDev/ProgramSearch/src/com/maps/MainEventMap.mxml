	<!--- 
	  GET Program data through HTTPService___________________________________________________________	
      @see #MainProgramService
      ** HTTPServiceInvoke: MainProgramService
      @see com.models.ProgramSearchManager#saveCSVData() 
      ** Handler: ProgramSearchManager.saveCSVData 
  	 -->
	<EventHandlers type="{SearchProgramEvent.GET}" id="SearchProgramEvent_GET">
	<HTTPServiceInvoker  instance="{MainProgramService}" url="/flex/HTTPService/program/getHTTPServiceData.cfm">
		<Request 
			sStartDate ="{event.sStartDate}"
			sEndDate ="{event.sEndDate}" 
			userId ="{event.userId}"
			showCatalog = "{event.showCatalog}"
			Include_work_in_progress_below_me = "{event.Include_work_in_progress_below_me}"
			Creating_User_Position = "{event.Creating_User_Position}"

			 />
			<!-- result sequence gets executed when service returns with a result -->
			<resultHandlers>
				<MethodInvoker generator="{ProgramSearchManager}" method="saveCSVData" arguments="{[resultObject,event.showCatalog,event.sStartDate,event.sEndDate,event.Creating_User_Position,event.Include_work_in_progress_below_me]}" />
				<!-- We do not need the status filter below as it is already being done above using event called FILTER_STATUS_RESULTS -->
				<!--if a status is passed send it to search panel to invoke the filter
				<EventAnnouncer type="{SearchProgramEvent.SET_FILTER}" generator="{SearchProgramEvent}" >
					<Properties eStatus="{event.eStatus}" />
				</EventAnnouncer>
				-->
				<!-- Sort the Grid by its default values (column name and sort order)
				<EventAnnouncer type="{SearchProgramEvent.DATA_GRID_SORT}" generator="{SearchProgramEvent}" />
				-->
			</resultHandlers>
			<!-- server fault -->
			<faultHandlers>
				<!--announce error event -->
				<EventAnnouncer type="{SearchProgramEvent.BSA_ERROR}" generator="{SearchProgramEvent}" >
					<Properties sBaError="SEARCH SERVICE (get programs)" />
					<Properties oBaError="{fault}" />
				</EventAnnouncer>
			</faultHandlers>
		</HTTPServiceInvoker>
	</EventHandlers>



	<EventHandlers type="{SearchProgramEvent.IMPORT_ITEMS}" id="eIMPORT_ITEMS">
