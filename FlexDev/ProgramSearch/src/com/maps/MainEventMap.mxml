			<resultHandlers>
				<MethodInvoker generator="{ProgramSettingsManager}" method="setAppSettings" arguments="{resultObject}" />
			</resultHandlers>
			<!-- server fault -->
			<faultHandlers>
				<!--announce error event -->
				<EventAnnouncer type="{SearchProgramEvent.BSA_ERROR}" generator="{SearchProgramEvent}" >
					<Properties sBaError="SEARCH SETTINGS SERVICE (load app settings event = LOAD_APP_SETTINGS)" />
					<Properties oBaError="{fault}" />
				</EventAnnouncer>
			</faultHandlers>
		</RemoteObjectInvoker>
			<EventAnnouncer type="{SearchProgramEvent.GET_USERLIST}" generator="{SearchProgramEvent}" >
				<Property sourceCache="inherit" source="{ProgramSettingsManager}" sourceKey="settings.userId" targetKey="userId" />
			</EventAnnouncer>
	</EventHandlers>
	
