	<!--- FlexEvent.PREINITIALIZE __________________________________________________________________-->
	<EventHandlers type="{FlexEvent.PREINITIALIZE}" id="FlexEvent_PREINITIALIZE">
		<ObjectBuilder generator="{ProgramSearchManager}" id="oProgramSearchManager" cache="global" />
		<ObjectBuilder generator="{ProgramSettingsManager}" id="oSettingsManager" cache="global" />		
		<ObjectBuilder generator="{BAError}" id="oBAError" cache="global" />
		<ObjectBuilder generator="{ListManager}" id="oListManager" cache="global" />
		<MethodInvoker generator="{ProgramSettingsManager}" method="loadURLParameters"   cache="global" />

		<EventAnnouncer type="{SearchProgramEvent.LOAD_APP_SETTINGS}" generator="{SearchProgramEvent}" >
		<!-- Call the "SearchProgramEvent.EVT_LOADCOMBOS" to load the search options dropdowns, right after the 
		setting are loaded. The event call exists on "ProgramSettingsManager.as".
		-->
			<Property sourceCache="global" source="{ProgramSettingsManager}" sourceKey="settings.userId" targetKey="userId"/>
			<Property source="{ProgramSettingsManager}" sourceKey="settings.timeZoneOffset" targetKey="timeZoneOffset" />
			<Property source="{ProgramSettingsManager}" sourceKey="settings.useDayLightSavingsTime" targetKey="useDayLightSavingsTime" />
		</EventAnnouncer>				
		<!--Get Programs -->
		<!--<EventAnnouncer type="{SearchProgramEvent.GET}" generator="{SearchProgramEvent}" >
