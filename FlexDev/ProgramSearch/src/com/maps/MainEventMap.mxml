	<EventHandlers type="{SearchProgramEvent.EVT_LOADCOMBOS}" id="SearchProgramEvent_EVT_LOADCOMBOS">
		<!-- initialize all the drop downs on the page -->	
		<RemoteObjectInvoker instance="{SearchProgramDataService}" showBusyCursor="true" method="getAllTemplate">
			<!-- result sequence gets executed when service returns with a result -->
			<resultHandlers>
				<MethodInvoker generator="{ProgramSearchManager}" method="fnGetAllTemplate" arguments="{resultObject}" />
			</resultHandlers>
			<!-- server fault -->
			<faultHandlers>
				<!--announce error event -->
				<EventAnnouncer type="{SearchProgramEvent.BSA_ERROR}" generator="{SearchProgramEvent}" >
					<Properties sBaError="TEMPLATE ERROR" />
					<Properties oBaError="{fault}" />
				</EventAnnouncer>
			</faultHandlers>
		</RemoteObjectInvoker>
		
	 	<RemoteObjectInvoker instance="{SearchProgramDataService}" showBusyCursor="true" method="getAllStatus">
			<!-- result sequence gets executed when service returns with a result -->
			<resultHandlers>
				<MethodInvoker  generator="{ProgramSearchManager}" method="fnGetAllStatus" arguments="{resultObject}" />
					<!-- Earlier, we used to set the status passed from the scorecard as the status selected in the status dropdown and then
						  search based on the status of the dropdown, but since we do not know the order of the Mate call, the filter function 
						  ("setStatusFilter" on programsearchpanel file used to fired even before the status dropdown was populated. So, we 
						  separated the code for filtering and dropdown status selection. Now the filtering is independent of the dropdown status 
						  selection. The dropdown status selection happens when the dropdown gets populated and that is why the event "SET_FILTER"
						  is being called from here. The filtering on the other hand happens using the event "FILTER_STATUS_RESULTS". The statuses
						  are filtered in 2 ways - one is flitering the grid based on what is already available to flex and the other is when Flex
						  needs to make a CF call to get the program id's to filter. This happens on Agreed, Under Review and Pending Approval.
					-->
					<EventAnnouncer type="{SearchProgramEvent.SET_FILTER}" generator="{SearchProgramEvent}" >
						<Property sourceCache="inherit" source="{ProgramSettingsManager}" sourceKey="settings.status" targetKey="eStatus"/>
					</EventAnnouncer>
					
			</resultHandlers>
			<!-- server fault -->
			<faultHandlers>
				<!-- announce error event -->
				<EventAnnouncer type="{SearchProgramEvent.BSA_ERROR}" generator="{SearchProgramEvent}" >
					<Properties sBaError="STATUS ERROR" />
					<Properties oBaError="{fault}" />
				</EventAnnouncer>
			</faultHandlers>
		</RemoteObjectInvoker>		

