<?xml version="1.0" encoding="utf-8"?>
<!--- This is the popup for program details. -->
<mx:TitleWindow xmlns:mx="http://www.adobe.com/2006/mxml"
				backgroundColor="0xffffff"
				close="PopUpManager.removePopUp(this);"
				color="0x333333"
				headerColors="['0xffce84','0xffffff']"
				layout="vertical"
				creationComplete="init()"
				name="Program Details"
				showCloseButton="true"
				title="Program Details">
	<mx:Script>
		<![CDATA[
			import com.events.*;
			import com.maps.*;
			import com.models.*;
			import com.views.*;
			import com.vos.*;
			
			import flash.display.DisplayObject;
			import flash.events.Event;
			
			import mx.collections.ArrayCollection;
			import mx.collections.ItemResponder;
			import mx.controls.Alert;
			import mx.core.Application;
			import mx.core.IFlexDisplayObject;
			import mx.events.*;
			import mx.managers.CursorManager;
			import mx.managers.PopUpManager;
			import mx.rpc.events.AbstractEvent;
			import mx.rpc.events.FaultEvent;
			import mx.rpc.events.ResultEvent;
			import mx.utils.ArrayUtil;
			import mx.utils.ObjectUtil;
			
			public var Program_ID:int;
			public var Status_ID:int = 0;
			private var Revision_Message :String;
			private var Revision_Msg :String;
			
			[Bindable] public   var Contract_Quantity : String;
			[Bindable] public 	var Program_Spend: String;
			[Bindable] public 	var Abbreviation : String;
			[Bindable] public 	var Approver_User : String;
			[Bindable] public 	var Approval_Date : String;
			[Bindable] public 	var RFA_User : String;
			[Bindable] public 	var Broker_Approved_Date : String;
			[Bindable] public 	var Contract_reference_number : String;
			[Bindable] public 	var Locked_By :String;
			[Bindable] public 	var Contract_Is_Locked : Number;
			[Bindable] public 	var Business_Unit_Desc : String;
			[Bindable] public 	var Modifying_program : Number;
			[Bindable] public 	var Modifying_User : String;
			[Bindable] public 	var Cancelled_By : String;
			[Bindable] public 	var Cancelled_Date :String;
			
			[Bindable] public 	var Renewal_Info :String;
			[Bindable] public 	var Business_Segment_Setting :Boolean;
			[Bindable] public 	var Interface_Info :String;
			[Bindable] public 	var Attachment_Info :String;
			[Bindable] public 	var Program_Details :ArrayCollection;
			[Bindable] public 	var CRA_Details :ArrayCollection;
			[Bindable] public 	var WorkFlowData :ArrayCollection;
			[Bindable] public 	var NRAData :ArrayCollection;
			[Bindable] public 	var Program_Revision_Count :String;
			[Bindable] public 	var sApprovalStandardOn:String = "";
			[Bindable] public 	var ShowCRAInfo:Boolean = true;
			[Bindable] public 	var sSendToSAP:String;
			[Bindable] public 	var sStatus:String = "";
			[Bindable] public 	var bQuoteLetters:Boolean = false;
			[Bindable] public 	var sQuoteLetters:String;
			[Bindable] public 	var sGLAccount:String;
			[Bindable] public 	var ShowNRAInfo:Boolean = true;
			
			private function init():void
			{
				var event:SearchProgramEvent = new SearchProgramEvent(SearchProgramEvent.GET_PROGRAM_DETAILS);
				event.eProgramDetailsInfo = Program_ID;
				dispatchEvent(event);
				
				var event1:SearchProgramEvent = new SearchProgramEvent(SearchProgramEvent.GET_PROGRAM_AUTORENEW_INFO);
				event1.eAutoRenewInfo = Program_ID;
				dispatchEvent(event1);
				
				var event2:SearchProgramEvent = new SearchProgramEvent(SearchProgramEvent.GET_INTERFACE_INFO);
				event2.eInterfaceInfo = Program_ID;
				dispatchEvent(event2);
				
				var event3:SearchProgramEvent = new SearchProgramEvent(SearchProgramEvent.GET_ATTACHMENT_INFO);
				event3.eAttachmentInfo = Program_ID;
				dispatchEvent(event3);
				
				var event4:SearchProgramEvent = new SearchProgramEvent(SearchProgramEvent.GET_PROGRAM_REVISION_COUNT);
				event4.eProgramRevisionCountInfo = Program_ID;
				dispatchEvent(event4);
				
				var event5:SearchProgramEvent = new SearchProgramEvent(SearchProgramEvent.GET_GL_ACCOUNT_INFO);
				event5.eGLAccountInfo = Program_ID;
				dispatchEvent(event5);
				
				var event6:SearchProgramEvent = new SearchProgramEvent(SearchProgramEvent.GET_BUSINESS_SEGMENT_SETTING);
				dispatchEvent(event6);
				
				var event7:SearchProgramEvent = new SearchProgramEvent(SearchProgramEvent.GET_WORKFLOW_DATA);
				event7.eWorkflowData = Program_ID
				dispatchEvent(event7);
				
				/* value being passed to the popup page. Replace all spaces
				with a new line
				*/
				var pattern:RegExp = /[" "]/gi;
				sGLAccount = sGLAccount.replace(pattern,"\n");
				
				/* For RFA, we fire the "GET_CRA_DETAILS" event after "Program_Details"
				ArrayCollection is populated from the "GET_PROGRAM_DETAILS" event.
				*/
				if(Status_ID == 2){
					ShowCRAInfo = true;
				}
				//(sStatus == 'Catalog') &&
				if((sQuoteLetters == '1')){
					bQuoteLetters = true;
				}
				CursorManager.removeBusyCursor();
			}
			
			[Bindable]
			private function ShowRevision():String{
				Revision_Message = '';
				if(Program_Revision_Count > '0'){
					Revision_Message = 'This program has been Revised'
				}
				else if(Program_Details.getItemAt(0).Revision_of_Contract_Main_ID != ''
					&& Program_Details.getItemAt(0).Is_A_Revision == 1
				){
					Revision_Message = 'This is a Revision'
					
				}
				
				return Revision_Message;
			}
			
			[Bindable]
			private function IsARevision():String{
				Revision_Msg = '';
				if(Program_Details.getItemAt(0).Revision_of_Contract_Main_ID != ''
					&& Program_Details.getItemAt(0).Is_A_Revision == 1
				){
					Revision_Msg = 'This is a Revision'
						
				}
						
				return Revision_Msg;;
			}			
			
			public var ShowSAPReferences:show_sap_references;
			private function openSAPDetails(Program_ID:int):void{
				if(sSendToSAP == '1')
				{
					ShowSAPReferences = show_sap_references(PopUpManager.createPopUp(Application.application as DisplayObject,show_sap_references,true));
					ShowSAPReferences.Program_ID = Program_ID;
					ShowSAPReferences.height=400;
					ShowSAPReferences.width=400;
					PopUpManager.centerPopUp(ShowSAPReferences);
				}
			}
			
			private function showRevisionDetails(Program_ID:int,status:int) : void{
				var winjscommand:String ='/reportwriter/performance_reports/revisionreport.cfm?Contract_main_id='+Program_ID+'&Contract_Status='+status;
				var jscommand:String = "window.open('"+winjscommand+"','win','height=550,width=1200,toolbar=no,scrollbars=yes,resizable=yes');"
				var url:URLRequest = new URLRequest("javascript:" + jscommand + " void(0);");
				navigateToURL(url, "_self");
			}
			
			/* Print/Email function */
			private function openPrintEmailPage(Program_ID:int,Action:String) : void{
				var winjscommand:String ="/CID_Wrapper.cfm?ID="+Program_ID+"&Page_Relocate=/common_files/contracts/email_fax_handler.cfm&Action="+Action;
				var jscommand:String = "window.open('"+winjscommand+"','winPrint','height=2000,width=2000,toolbar=no,scrollbars=yes,left=0,top=0,screenX=0,screenY=0,resizable=no');"
				var url:URLRequest = new URLRequest("javascript:" + jscommand + " void(0);");
				navigateToURL(url, "_self");
			}
			
			/* Copy function which calls "CopyProgram" function */
			private function openCopyProgramPage(Program_ID:int):void{
				Alert.show("Are you sure you want to copy this program?", "Confirm Copy!", Alert.YES | Alert.NO, this, CopyProgram);
			}
			
			/* openLetters function */
			private function openLetters(Program_ID:int) : void{
				var winjscommand:String ="/CID_Wrapper.cfm?ID="+Program_ID+"&Page_Relocate=/common_files/contracts/letters/distributors.cfm&Action=quoteletters";
				var jscommand:String = "window.open('"+winjscommand+"','winPrint','height=800,width=800,toolbar=no,scrollbars=yes,left=0,top=0,screenX=0,screenY=0,resizable=no');"
				var url:URLRequest = new URLRequest("javascript:" + jscommand + " void(0);");
				navigateToURL(url, "_self");
			}
			
			private function CopyProgram(CloseEvent:Object):void{
				/* CloseEvent.detail is 1 for "yes" and 2 for "no" */
				if(CloseEvent.detail == 1){
					var winjscommand:String ="/CID_Wrapper.cfm?ID="+Program_ID+"&Page_Relocate=/common_files/contracts/email_fax_handler.cfm&Action=copy";
					var jscommand:String = "window.open('"+winjscommand+"','winPrint','height=2000,width=2000,toolbar=no,scrollbars=yes,left=0,top=0,screenX=0,screenY=0,resizable=yes');"
					var url:URLRequest = new URLRequest("javascript:" + jscommand + " void(0);");
					navigateToURL(url, "_self");
				}
			}
		
			private function showPriorVersionDetails(Program_ID:int) : void{
				var winjscommand:String ='/common_files/contracts/prior_version_interface_info.cfm?Contract_main_id='+Program_ID;
				var jscommand:String = "window.open('"+winjscommand+"','win','height=450,width=1050,toolbar=no,scrollbars=yes,resizable=yes');"
				var url:URLRequest = new URLRequest("javascript:" + jscommand + " void(0);");
				navigateToURL(url, "_self");
			}		
			
			/* Convert the datagridcolumn into date format. Call the <mx:DateFormatter>
			for that purpose
			*/
			private function dateLabel(item:Object, column:DataGridColumn):String
			{
				return DisplayDateFormat.format(item[column.dataField]);
			}
			
			private function buildToolTip(item:Object):String
			{
				var myString:String = "";
				if(item != null && item.Agree_Reasons.length)
				{
					myString = "AGREE REASONS:\n";
					myString = myString + item.Agree_Reasons.join("\n");
				}
				return myString;
			}
			

			private function getWidthPositionWorkflow(item:Object,column:DataGridColumn):String 
			{ 
				var colText:String = item[column.dataField]; 

				var nPositionDatalength:int;
				nPositionDatalength = 0;
				
				for each(var oItem:Object in WorkFlowData)
				{
					if(nPositionDatalength < oItem['Position'].toString().length)
					{
						/* The value is the length of the "position" data content. */
						nPositionDatalength = oItem['Position'].toString().length;
					}
				}
				resetWidthWorkflow(nPositionDatalength,column,colText);
				
				return colText; 
			}
			
			private function getWidthPositionCRA(item:Object,column:DataGridColumn):String 
			{ 
				var colText:String = item[column.dataField]; 
				
				var nPositionDatalength:int;
				nPositionDatalength = 0;
				
				for each(var oItem:Object in CRA_Details)
				{
					if(nPositionDatalength < oItem['Position_Label'].toString().length)
					{
						/* The value is the length of the "position" data content. */
						nPositionDatalength = oItem['Position_Label'].toString().length;
					}
				}
				resetWidthCRAandNRA(nPositionDatalength,column,colText);				
				return colText; 
			}
			
			private function getWidthPositionNRA(item:Object,column:DataGridColumn):String 
			{ 
				var colText:String = item[column.dataField]; 
				
				var nPositionDatalength:int;
				nPositionDatalength = 0;
				
				for each(var oItem:Object in NRAData)
				{
					if(nPositionDatalength < oItem['Position_Label'].toString().length)
					{
						/* The value is the length of the "position" data content. */
						nPositionDatalength = oItem['Position_Label'].toString().length;
					}
				}
				resetWidthCRAandNRA(nPositionDatalength,column,colText);				
				return colText; 
			}			
			
			private function resetWidthWorkflow(nPositionDatalength:int,column:DataGridColumn,colText:String):void 
			{ 
				/* The data grid width should be the column's content. 
				The column width of 100 can fit about 15 characters,
				so, the text length should be multiplied by 6.6 (100/15)
				*/
				column.width = nPositionDatalength * 6.6;
			
				/* We do not want the width of one column to take up the whole 
				datagrid's width and so we need to set up max width.
				240 is the best guess at this point and can be changed. It is the max width.
				*/
				if(column.width > 240)
				{
					column.width = 240;			
				}
			}
			
			private function resetWidthCRAandNRA(nPositionDatalength:int,column:DataGridColumn,colText:String):void 
			{ 
				/* The data grid width should be the column's content. 
				The column width of 100 can fit about 15 characters,
				so, the text length should be multiplied by 6.6 (100/15)
				*/
				column.width = nPositionDatalength * 6.6;
				
				/* We do not want the width of one column to take up the whole 
				datagrid's width and so we need to set up max width.
				300 is the best guess at this point and can be changed. It is the max width.
				*/
				if(column.width > 300)
				{
					column.width = 300;			
				}
			}
			/* The issue was that when a user manually increased the column size, then the labelfunction restricted 
			the width to what was defined as max width in the function (resetWidthWorkflow or resetWidthCRAandNRA). 
			To get rid of that restriction,calling the removeLabelFunction to set labelFunction to null.
			*/
			private function removeLabelFunction():void 
			{ 
				/* position */
				/* Resetting it to NULL */
				dgWorkflow.columns[2].labelFunction=null;
				dgCRA.columns[1].labelFunction=null;
				dgNRA.columns[1].labelFunction=null;
			}
			
		]]>
	</mx:Script>
	
	<mx:NumberFormatter id="DisplayFormat"
						thousandsSeparatorTo=","
						useThousandsSeparator="true"
						/>
	
	
