		<mx:Text visible="{Program_Details.getItemAt(0).Position_Approved_Label != ''}" includeInLayout="{Program_Details.getItemAt(0).Position_Approved_Label != ''}" textAlign="left" data="{Program_Details.getItemAt(0).Approver_User + ', ' + Program_Details.getItemAt(0).Position_Approved_Label + ', ' + Program_Details.getItemAt(0).Approval_Date}"/>
		If 'Position_Approved_Label' is blank
		<mx:Text visible="{Program_Details.getItemAt(0).Position_Approved_Label == ''}" includeInLayout="{Program_Details.getItemAt(0).Position_Approved_Label == ''}" textAlign="left" data="{Program_Details.getItemAt(0).Approver_User + ', ' + Program_Details.getItemAt(0).Approval_Date}"/>
		</mx:VBox>
		<mx:VBox verticalGap="1"  width="33%" visible="{Program_Details.getItemAt(0).Contract_Status_Type_IDX == 2}" includeInLayout="{Program_Details.getItemAt(0).Contract_Status_Type_IDX == 2}">
		<mx:Label text="Requesting Approval" fontWeight="bold" textAlign="left" />
		<mx:Text id="Requesting_Approval" textAlign="left"  data="{Program_Details.getItemAt(0).RFA_User + ', ' + Program_Details.getItemAt(0).Broker_Approved_Date}"/>
		</mx:VBox>
		<mx:VBox width="33%" visible="{Program_Details.getItemAt(0).Contract_Status_Type_IDX == 2}" includeInLayout="{Program_Details.getItemAt(0).Contract_Status_Type_IDX == 2}">
		</mx:VBox>
		</mx:HBox>
		-->
		
		
		<mx:HBox width="100%">
			<mx:Label text="Workflow" fontWeight="bold" textAlign="left"/>
		</mx:HBox>
		<mx:HBox width="100%">
			<!-- Using labelFunction for the "position" column to get the size of the column. This is utimately used to set the width of the column.
			Also using columnStretch below.
			-->
			<mx:DataGrid id="dgWorkflow" columnStretch="removeLabelFunction()" textAlign="left" dataProvider="{WorkFlowData}" rowCount="{WorkFlowData.length &lt; 10 ? WorkFlowData.length : 10}" width="100%" dataTipFunction="buildToolTip">
				<mx:columns>
					<mx:DataGridColumn dataField="Action" width="50" headerText="Action" showDataTips="true"/>
					<mx:DataGridColumn dataField="Name" width="110" headerText="Name" showDataTips="true"/>
					<mx:DataGridColumn dataField="Position" width="120"  headerText="Position" showDataTips="true"/><!--labelFunction="getWidthPositionWorkflow"-->
					<mx:DataGridColumn dataField="Profiles_Desc" width="110" headerText="Profile" showDataTips="true"/>
					<mx:DataGridColumn dataField="Authority_Sequence_Name"  width="120" headerText="Authority Sequence" showDataTips="true"/>
					<mx:DataGridColumn dataField="Action_Date"  width="90" headerText="Date"  showDataTips="true" labelFunction="dateLabel" />
				</mx:columns>
			</mx:DataGrid>
		</mx:HBox>
		<mx:HBox visible="{CRA_Details.length &lt; 1 ? false : true}" includeInLayout="{CRA_Details.length &lt; 1 ? false : true}" width="100%">
			<mx:Label text="CRA" fontWeight="bold" textAlign="left"/>
			<mx:Label text="[currently responsible for approval]" textAlign="left"/>
		</mx:HBox>
		<mx:HBox visible="{CRA_Details.length &lt; 1 ? false : true}" includeInLayout="{CRA_Details.length &lt; 1 ? false : true}" width="100%">
			<!-- Using labelFunction for the "position" column to get the size of the column. This is utimately used to set the width of the column.
			Also using columnStretch below.
			-->
			<mx:DataGrid id="dgCRA" columnStretch="removeLabelFunction()" textAlign="left" dataProvider="{CRA_Details}" rowCount="{CRA_Details.length &lt; 10 ? CRA_Details.length : 10}" width="100%">
				<mx:columns>
					<mx:DataGridColumn dataField="User_Full_Name"  width="100" headerText="Name"/>
					<mx:DataGridColumn dataField="Position_Label" width="110"  headerText="Position"/><!--labelFunction="getWidthPositionCRA"-->
					<mx:DataGridColumn dataField="Profiles_Desc"  width="110" headerText="Profile"/>
					<mx:DataGridColumn dataField="Authority_Sequence_Name"  width="140" headerText="Authority Sequence"/>
				</mx:columns>
			</mx:DataGrid>
		</mx:HBox>
		
		<mx:HBox visible="{NRAData.length &lt; 1 ? false : true}" includeInLayout="{NRAData.length &lt; 1 ? false : true}" width="100%">
			<mx:Label text="NRA" fontWeight="bold" textAlign="left"/>
			<mx:Label text="- after the above person(s) take action, below is a list of person(s) that may need to take approval action." textAlign="left"/>
		</mx:HBox>
		<mx:HBox visible="{NRAData.length &lt; 1 ? false : true}" includeInLayout="{NRAData.length &lt; 1 ? false : true}" width="100%">
			<!-- Using labelFunction for the "position" column to get the size of the column. This is utimately used to set the width of the column.
			Also using columnStretch below.
			-->
			<mx:DataGrid id="dgNRA" columnStretch="removeLabelFunction()" textAlign="left" dataProvider="{NRAData}"  rowCount="{NRAData.length &lt; 4 ? NRAData.length : 4}" width="100%">
				<mx:columns>
					<mx:DataGridColumn dataField="User_Full_Name"  width="100" headerText="Name" />
					<mx:DataGridColumn dataField="Position_Label" width="110"  headerText="Position"/><!--labelFunction="getWidthPositionNRA"-->
					<mx:DataGridColumn dataField="Profiles_Desc"  width="110" headerText="Profile"/>
					<mx:DataGridColumn dataField="Authority_Sequence_Name"  width="140" headerText="Authority Sequence" />
				</mx:columns>
			</mx:DataGrid>
		</mx:HBox>
		
	</mx:VBox>
</mx:TitleWindow>
