			/* Populate objGridColumnSize object for column width.
			This function adjusts the width of the grid columns when users adjust the slider ontrol.
			It can work the other way too - By manually adjusting the grid column's width, the slider
			control also adjusts.
			*/
			public function callSetColumnSize(columnHeader:String,type:String):void
			{
				
				for(var i:int = 0;i<dg.columns.length;i++){
					var col:DataGridColumn = DataGridColumn(dg.columns[i]);
					/* When the user either adjusts the "Status" column manually or by adjusting the slider control. */
					if(col.headerText == 'Status' && columnHeader == 'Status')
					{	
						/* If the user has manually adjusted the width of the "status " column,adjust the slider accordingly.*/
						if(type =='header'){
								sliderStatusSize.value = col.width;
						}
							this.objGridColumnSize.status = sliderStatusSize.value;
					}	
					if(col.headerText == 'RFA Age' && columnHeader == 'RFA Age')
					{
						if(type =='header'){
							sliderRFAAgeSize.value = col.width;
						}				
						this.objGridColumnSize.rfaAge = sliderRFAAgeSize.value;		
					}				
					if(col.headerText == 'Program' && columnHeader == 'Program')
					{
						if(type =='header'){
							sliderProgramSize.value = col.width;
						}	
						this.objGridColumnSize.program = sliderProgramSize.value;		
					}
					if(col.headerText == 'Title' && columnHeader == 'Title')
					{
						if(type =='header'){
							sliderTitleSize.value = col.width;
						}	
						this.objGridColumnSize.title = sliderTitleSize.value;		
					}
					if(col.headerText == 'Type' && columnHeader == 'Type')
					{
						if(type =='header'){
							sliderTypeSize.value = col.width;
						}	
						this.objGridColumnSize.type = sliderTypeSize.value;		
					}	
					if(col.headerText == 'Start Date' && columnHeader == 'Start Date')
					{
						if(type =='header'){
							sliderStartDateSize.value = col.width;
						}	
						this.objGridColumnSize.startDate = sliderStartDateSize.value;	
					}
					if(col.headerText == 'End Date' && columnHeader == 'End Date')
					{
						if(type =='header'){
							sliderEndDateSize.value = col.width;
						}	
						this.objGridColumnSize.endDate = sliderEndDateSize.value;		
					}
					if(col.headerText == 'RSP' && columnHeader == 'RSP')
					{
						if(type =='header'){
							sliderRSPSize.value = col.width;
						}	
						this.objGridColumnSize.rsp = sliderRSPSize.value;	
					}
					/* (start) optional columns, based on setting */
					if(col.headerText == sDisplayTradeDollarsLabel && columnHeader == sDisplayTradeDollarsLabel)
					{
						if(type =='header'){
							sliderTradeDollarsSize.value = col.width;
						}	
						this.objGridColumnSize.tradeDollars = sliderTradeDollarsSize.value;	
					}
					if(col.headerText == sDisplayPaymentDollarsLabel && columnHeader == sDisplayPaymentDollarsLabel)
					{
						if(type =='header'){
							sliderPaymentDollarsSize.value = col.width;
						}	
						this.objGridColumnSize.paymentDollars = sliderPaymentDollarsSize.value;	
					}
					if(col.headerText == sDisplayVolumeLabel && columnHeader == sDisplayVolumeLabel)
					{
						if(type =='header'){
							sliderVolumeSize.value = col.width;
						}	
						this.objGridColumnSize.volume = sliderVolumeSize.value;	
					}
					if(col.headerText == 'More Info' && columnHeader == 'More Info')
					{
						if(type =='header'){
							sliderMoreInfoSize.value = col.width;
						}	
						this.objGridColumnSize.moreInfo = sliderMoreInfoSize.value;	
					}
					if(col.headerText == sBusinessSegmentsLabel && columnHeader == sBusinessSegmentsLabel)
					{
						if(type =='header'){
							sliderBusinessSegmentSize.value = col.width;
						}	
						this.objGridColumnSize.businessSegment = sliderBusinessSegmentSize.value;	
					}					
				}

				var eventSetColumnSize:SearchProgramEvent = new SearchProgramEvent(SearchProgramEvent.SET_COLUMN_SIZE);
				eventSetColumnSize.eSearchGridColumnSize = this.objGridColumnSize;
				this.dispatchEvent(eventSetColumnSize);
