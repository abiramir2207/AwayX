									labelField="User_Name"
									width="189"
									dataProvider="{dpUsers}"
									change="SetUserPosition();"
									rowCount="{Combo_Box_Size}"
									height="{iComboBoxHeight}">
								</mx:ComboBox>
							</mx:VBox>
							
							<mx:VBox verticalAlign="top" verticalGap="0">
								<ba:MultiComboBox
									toolTip="filter:User Position" 
									id="UserPositions" 
									labelField="Position_Label_And_ID"
									width="189"
									dataProvider="{dpUserPositions}"
									selectedIndex = "{siUserPositions}"
									change="UserName.selectedIndex=0;FilterPrograms();"
									rowCount="{Combo_Box_Size}"
									height="{iComboBoxHeight}"
									dropdownWidth="{iComboBoxContentWidth}">
								</ba:MultiComboBox>
							</mx:VBox>		
							<mx:VBox verticalAlign="top" verticalGap="0">
								<mx:ComboBox 
									toolTip="filter:Program Actions" 
									id="Report_List" 
									labelField="Report_info"
									width="189"
									dataProvider="{dpReportType}"
									change="FilterPrograms()"
									rowCount="{Combo_Box_Size}"
									height="{iComboBoxHeight}">
								</mx:ComboBox>
							</mx:VBox>
							<mx:VBox verticalAlign="top" verticalGap="0">
								<ba:MultiComboBox
									toolTip="filter:Budget Classes" 
									id="budgetClasses" 
									labelField="Budget_Class_Desc"
									width="189"
									dataProvider="{dpBudgetClasses}"
									change="FilterPrograms()"
									rowCount="{Combo_Box_Size}"
									height="{iComboBoxHeight}"
									visible="{bshowbudgetDropdown}"
									includeInLayout="{bshowbudgetDropdown}">
								</ba:MultiComboBox>
							</mx:VBox>							
							<mx:VBox verticalAlign="top" verticalGap="4">
								<!-- (start) optional filter, based on setting -->
								<ba:MultiComboBox
									toolTip="filter:{sBusinessSegmentsLabel}" 
									id="businessSegments" 
									labelField="Business_Unit_Desc"
									width="189"
									dataProvider="{dpBusinessSegments}"
									change="FilterPrograms()"
									rowCount="{Combo_Box_Size}"
									height="{iComboBoxHeight}"
									visible="{bshowBusinessSegment}"
									includeInLayout="{bshowBusinessSegment}">
								</ba:MultiComboBox>								
								
								<!-- (end) optional filter, based on setting -->
								<mx:HBox verticalAlign="top" horizontalGap="3">
									<mx:Button 
										click="FilterPrograms()"
										label="search"
										height="{iButtonHeight}"
										keyDown="enterButton(event);">
									</mx:Button>	
									<mx:Button 
										click="ResetFilters()"
										label="reset"
										height="{iButtonHeight}">
									</mx:Button>		
								</mx:HBox>
								<mx:HBox verticalAlign="bottom">
									<mx:Button
										toolTip="Create a Program"
										id="CreateProgram" 
										click="createProgram()"
										label="create program"
										height="{iButtonHeight}"
										visible="{bCreateProgramAccess}"
										includeInLayout="{bCreateProgramAccess}">
									</mx:Button>
									<mx:Button
										toolTip="Generate Excel file"
										id="btnExportXLS" 
										click="callExportXLS()"
										label="download data"
										height="{iButtonHeight}">
									</mx:Button>
								</mx:HBox>
								<mx:HBox horizontalGap="5" fontSize="9" fontFamily="Century Gothic" verticalAlign="middle">
									<mx:Label text="Data View" fontSize="10" fontWeight="bold" width="65" fontFamily="Verdana"/>
									<mx:RadioButtonGroup id="DataLoadType" itemClick="loadData(event);"/>
									
									<mx:RadioButton groupName="DataLoadType" id="rdoProgram" value="Program" scaleX="0.7" scaleY="0.7"/>
									<mx:Label text="program" color="#4169E1" fontSize="9" fontFamily="Century Gothic" />
									
									<mx:Label text="OR"  fontSize="9" fontFamily="Verdana" fontWeight="bold" visible="{bPrgReadOnlyCatalogAccess}" includeInLayout="{bPrgReadOnlyCatalogAccess}" />
									
									<mx:RadioButton groupName="DataLoadType" id="rdoCatalog" value="Catalog" scaleX="0.7" scaleY="0.7" visible="{bPrgReadOnlyCatalogAccess}" includeInLayout="{bPrgReadOnlyCatalogAccess}" />					
									<mx:Label text="catalog" color="#4169E1" fontSize="9" fontFamily="Century Gothic" visible="{bPrgReadOnlyCatalogAccess}" includeInLayout="{bPrgReadOnlyCatalogAccess}"/>
								</mx:HBox>				
							</mx:VBox>
							<mx:VBox verticalAlign="bottom" verticalGap="1">
								<mx:HBox horizontalGap="5" verticalAlign="middle">
									<mx:RadioButtonGroup id="ArchiveSearch" itemClick="loadData(event);"/>
									
									<mx:RadioButton groupName="ArchiveSearch" id="rdoCurrent" value="Current" scaleX="0.7" scaleY="0.7" />
									<mx:Label id="lblCurrent" text="current" color="#4169E1" fontSize="9" fontFamily="Century Gothic" />
									
									<mx:Label text="OR" id="lblOR" fontSize="9" fontFamily="Verdana" fontWeight="bold" />
						
									<mx:RadioButton groupName="ArchiveSearch" id="rdoArchiveDateRange" value="DateRange" scaleX="0.7" scaleY="0.7" />
									<mx:Label id="lblDateRange" text="date range" color="#4169E1" fontSize="9" fontFamily="Century Gothic" />
								</mx:HBox>
								<mx:HBox id="dtDateRange" horizontalGap="5" horizontalAlign="left" width="255" horizontalScrollPolicy="off">
									<mx:DateField id="dtStart"  
												  editable="true"
												  width="90" />
									<mx:DateField id="dtEnd"
												  editable="true"
												  width="90" />
								</mx:HBox>
								<mx:HBox horizontalGap="0" fontSize="9" fontFamily="Century Gothic" verticalAlign="middle">
									<mx:Label text="Favorites" fontSize="10" fontWeight="bold" width="59" fontFamily="Verdana"/>
									<mx:Label text="(Click on the 'tools' tab to access)" fontSize="9" color="#4169E1" width="100%" fontFamily="Verdana"/>
								</mx:HBox>	
								<mx:HBox>
									<mx:Text text="Name:" />
									<mx:TextInput id="tListName"  maxChars="25" width="135" height="{iTextInputHeight}" toolTip="To access your favorites, go to the favorites tab.&#13;To save a favorite&#13;Enter your search criteria &#13;In the name field, enter a name for your favorite&#13;Click Save" />
									<mx:Button id="btnSaveUserList" label="save" click="saveUserList();" toolTip="Save selected query for later use" height="{iButtonHeight}"/>
								</mx:HBox>
							</mx:VBox>
							
							<mx:VBox verticalAlign="bottom" verticalGap="0">
								<mx:HBox verticalAlign="bottom">
								</mx:HBox>
							</mx:VBox>
							
						</mx:VBox>
					</mx:Canvas>
					<mx:Canvas label="create list" width="100%" height="100%" click="hideDeleteOption();">
						<mx:VBox  id="crList" label="create list" width="100%" height="100%" paddingLeft="5">
							<mx:TextArea height="300" width="180" id="txtCrList"
										 toolTip="To search for a list of programs:&#13;Type or paste in a list of programs.{sExactListMatchingOnMessage} Separate each program by the enter key. Click search."
										 wordWrap="false" editable="true" enabled="true"
										 keyUp="this.updateCreateList()">
							</mx:TextArea>
							<mx:Button id="btnCreateList" label="search" click="callCreateList(this.txtCrList.text);" height="{iButtonHeight}"/>
						</mx:VBox>
					</mx:Canvas>
					<mx:Canvas label="tools" width="100%" height="100%" click="hideDeleteOption();">
						<mx:VBox id="svSearch" label="favorites" width="100%" height="100%" paddingLeft="5">
							<mx:List id="lsUserList" dataProvider="{arrUserList}" 
									 labelField="LIST_NAME" height="200" width="180"
									 doubleClickEnabled="true" itemDoubleClick="this.getUserListItems();"
									 keyDown="enterUserListRow(event);"
									 toolTip="To see one of your favorites:&#13;Double click on the Favorites Name.&#13;The Favorites list will appear on the right hand side." />
							<mx:HBox>
								<mx:Button id="btnGetListItems" label="search" click="getUserListItems();" toolTip="Display the programs in the selected list" height="{iButtonHeight}"/>
								<mx:Button id="btnDeleteList" label="delete" click="deleteUserList();" toolTip="Delete the selected list" height="{iButtonHeight}"/>
