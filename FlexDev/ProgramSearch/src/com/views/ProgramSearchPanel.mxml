											value="{this.objGridColumnSize.moreInfo}"
											liveDragging="true"
											change="callSetColumnSize('More Info','slider')" /> 			
							</mx:HBox>	
							<mx:HBox verticalAlign="bottom" visible="{bshowBusinessSegment}" includeInLayout="{bshowBusinessSegment}">
								<mx:Label text="{sBusinessSegmentsLabel}"  width="65" />
								<mx:CheckBox id="cbBusinessSegmentShowColumn"
											 data="{}" 
											 scaleX="0.7" 
											 scaleY="0.7"
											 click="callColumnsHideShow()"
											 selected="{this.objGridColumnSize.includeColumnList.indexOf('businessSegment:1') != -1}" />
								<mx:HSlider id="sliderBusinessSegmentSize"
											minimum="30"
											maximum="425"
											value="{this.objGridColumnSize.businessSegment}"
											liveDragging="true"
											change="callSetColumnSize(sBusinessSegmentsLabel,'slider')" /> 			
							</mx:HBox>							
							<!-- (end) optional columns, based on setting -->
							<mx:HBox verticalAlign="bottom">
								<mx:Button id="btnSaveColumnSize" label="save" click="saveColumnSize()" toolTip="save the search grid column size" />
							</mx:HBox>
							
							<mx:HBox width="100%">
								<mx:HRule width="100%" />
							</mx:HBox>
							
							<mx:HBox>
								<mx:Label text="docs" fontWeight="bold" />
							</mx:HBox>
							<mx:HBox>
								<mx:Label fontSize="9" text="[" width="7" />
								<mx:Label fontSize="9" width="98" text="upload documents" color="blue" click="updateSearchAndUploadDocs(1)" useHandCursor="true" mouseChildren="false" buttonMode="true" toolTip="Click here to upload documents for programs"/>			 	
								<mx:Label fontSize="9" text="]" width="7" />
							</mx:HBox>
							<mx:HBox visible="{bSearchDocuments}" includeInLayout="{bSearchDocuments}" >
								<mx:Label fontSize="9" text="[" width="8"  />
								<mx:Label fontSize="9" width="98" text="search documents" color="blue" click="updateSearchAndUploadDocs(2)" useHandCursor="true" mouseChildren="false" buttonMode="true" toolTip="Click here to search documents for programs"/>			 	
								<mx:Label fontSize="9" text="]" width="8"  />
							</mx:HBox>
						</mx:VBox> 
					</mx:Canvas>
				</mx:TabNavigator>		
</mx:VBox>
		</mx:Panel>
		<mx:Panel id="pnlAll" backgroundColor="0xffffff" headerColors="['0xffce84','0xffffff']" color="0x333333"
				  bottom="row2:2" height="100%" left="col2:2" right="2" top="2"
				  name="ProgramSearchResultsUtility" 
				  title="Program Search Results: {this.dg.dataProvider.length} records">
			<mx:VBox height="100%" width="100%" horizontalAlign="left">
				<!--*******************************	FILTER FIELDS	*************************************************************** visible="{iInclude_work_in_progress_below_me == 0}"-->
				<mx:HBox width="100%" height="20"><!-- borderStyle="solid"-->
					<mx:VBox height="100%" width="80%">
						<mx:HBox width="100%">
							<mx:HBox width="5%">
								<mx:Image id="iconRight" 
										  useHandCursor="true" buttonMode="true"	mouseChildren="false"
										  source="/Flex/assets/images/fullScreen.png"
										  width="20" height="20" click="toggleState('fullRight')" toolTip="Click for Right Panel Full Screen"/>
								<mx:Image id="iconAllR" 
										  useHandCursor="true" buttonMode="true"	mouseChildren="false"
										  source="/Flex/assets/images/sharedScreen.png"
										  width="20" height="20" click="toggleState('fullAll')" toolTip="Click for both Panels Shared Screen" visible="false" includeInLayout="false" />
							</mx:HBox>
							<mx:HBox width="35%">
								<mx:Button id="btnRefreshData"
										   label="refresh data" 
										   click="dispatchSearchEventGet();"
										   height="{iButtonHeight}" 
										   toolTip="Reload data set from server. Current data in view was loaded: {dSODate}"
										   />
								
								<mx:Button id="btnImport" 
										   label="import selected" 
										   tabEnabled="true" 
										   height="{iButtonHeight}" 
										   visible="{this.oSettings.importlist_type}" 
										   includeInLayout="{this.oSettings.importlist_type}"/>
								
								<mx:Text id="dataAsOf" text=" Data as of: {dSODate}" styleName="red" toolTip="The time stamp for the data in the current view."/>
							</mx:HBox>
							<mx:HBox width="50%">
								<mx:Text text="[mass approve]" click="getSelectedEntries('MassApprove')" visible="{bMassApproveSelection}" includeInLayout="{bMassApproveSelection}" textAlign="right"  useHandCursor="true" mouseChildren="false" buttonMode="true"/>
								<mx:Text text="[edit won/lost status]" click="getSelectedEntries('EditStatus')" visible="{bBidRequestTemplateSelection}" includeInLayout="{bBidRequestTemplateSelection}" textAlign="right" useHandCursor="true" mouseChildren="false" buttonMode="true"/>
								<mx:Text text="[claim rates report]" click="getSelectedEntries('ClaimRatesReport')" visible="{bShowClaimRatesReportSelection}" includeInLayout="{bShowClaimRatesReportSelection}" textAlign="right" useHandCursor="true" mouseChildren="false" buttonMode="true"/>
								<mx:Text text="[pricing report]" click="getSelectedEntries('PricingReport')" visible="{bShowPricingReportSelection}" includeInLayout="{bShowPricingReportSelection}" textAlign="right" useHandCursor="true" mouseChildren="false" buttonMode="true"/>
								<mx:Text text="[release settlement]" click="getSelectedEntries('Release')" visible="{bShowRelease}" includeInLayout="{bShowRelease}" textAlign="right" useHandCursor="true" mouseChildren="false" buttonMode="true"/>
							</mx:HBox>
						</mx:HBox>
					</mx:VBox>
				</mx:HBox>		
				<mx:HBox width="100%" height="100%" verticalAlign="top">
					<!-- Dev Note:38364 - Do not add "horizontalScrollPolicy="off" on the grid as now we have a feature where we can increase/decrease the width of the grid columns using a slider control.
					The width of the columns can also be increased by manually dragging the columns. This will automatically adjust the slider control. User can then save the data.					
					Whenever we increase the size of a column, the other columns should remain fixed and if necessary a horizontal scrollbar should appear.
					-->
					<mx:DataGrid horizontalScrollPolicy="on" allowMultipleSelection="true" id="dg" editable="true" dataProvider="{dgProgramData}" width="100%"  height="100%" verticalAlign="top" headerRelease="Call_Sort_Data(event)" columnStretch="callColumnWidthResize(event)" headerShift="callColumnsHideShow();">
						<mx:columns>
							<!-- Below is the default SEQUENCE of columns, which gets overwritten by the sequence of columns in "this.objGridColumnSize.includeColumnList".
							Some of the columns below - "program_trade_spend","program_payment" and "program_volume" are using the "visible" attribute along with a boolean variable 
							to show/hide that column. That "show/hide" will also get overwritten by "show/hide" status in "this.objGridColumnSize.includeColumnList".
							-->
							<mx:DataGridColumn dataField="isSelected" visible="{bShowCheckBoxOptionSelection}" rendererIsEditor="true" itemRenderer="com.components.chBoxIsSelected" headerRenderer="com.components.chBoxSelectAll" editorDataField="varCbSelected" sortable="false" width="15" minWidth="15" />
							<mx:DataGridColumn dataField="contract_main_id" headerText="" visible="{bShowDeleteOptionSelection &amp;&amp; this.tbNavList.selectedIndex == 0}" editable="false" rendererIsEditor="true"  itemRenderer="com.components.ScissorComp" width="25"  />		  	  
							<mx:DataGridColumn dataField="BidRequest_Status"  sortable="false" visible="{bBidRequestTemplateSelection}" rendererIsEditor="true" itemRenderer="com.components.BidRequestStatus" headerText="Bid Status" editorDataField="varStatusSelected" width="70" />
							<mx:DataGridColumn dataField="status_abbreviation" headerText="Status" editable="false" width="{this.objGridColumnSize.status}" />							
							<mx:DataGridColumn dataField="rfa_age" headerText="RFA Age" editable="false" width="{this.objGridColumnSize.rfaAge}" />
							<mx:DataGridColumn dataField="contract_number" headerText="Program" editable="false" itemRenderer="com.components.program_summary" width="{this.objGridColumnSize.program}"  />
							<mx:DataGridColumn dataField="contract_title" headerText="Title" editable="false" itemRenderer="com.components.contract_title" width="{this.objGridColumnSize.title}" />
							<mx:DataGridColumn dataField="created_type" headerText="Type" editable="false" width="{this.objGridColumnSize.type}" />	      
							<mx:DataGridColumn dataField="contract_start_date" headerText="Start Date" labelFunction="dateLabel" editable="false" width="{this.objGridColumnSize.startDate}" />
							<mx:DataGridColumn dataField="contract_end_date" headerText="End Date" labelFunction="dateLabel" editable="false" width="{this.objGridColumnSize.endDate}" />    
							<mx:DataGridColumn dataField="rsp_user" headerText="RSP" editable="false" width="{this.objGridColumnSize.rsp}" />
							<mx:DataGridColumn dataField="business_segment" headerText="{sBusinessSegmentsLabel}" editable="false" width="{this.objGridColumnSize.businessSegment}" visible="{bshowBusinessSegment}" />	 
							<!-- (start) optional columns, based on setting. Use "labelFunction" for formatting and "sortCompareFunction" for numeric sorting for these columns.
							Note: The reason why the data type is NOT modified to "NUMBER" on data load is because after formatting the values using "NumberFormatter", the
							data type is modified to string and then the sorting happens as if it were a string. Reconverting to "NUMBER" data type gives an incorrect value.
							-->
							<mx:DataGridColumn dataField="program_trade_spend" labelFunction="programTradeSpend_FormatNumber" sortCompareFunction="programTradeSpend_sortCompareFunc" headerText="{sDisplayTradeDollarsLabel}" editable="false" width="{this.objGridColumnSize.tradeDollars}" visible="{bDisplayTradeDollars}" />
							<mx:DataGridColumn dataField="program_payment" sortCompareFunction="programPayment_sortCompareFunc" headerText="{sDisplayPaymentDollarsLabel}" editable="false" itemRenderer="com.components.payment_history" width="{this.objGridColumnSize.paymentDollars}" visible="{bDisplayPaymentDollars}" />
							<mx:DataGridColumn dataField="program_volume" labelFunction="programVolume_FormatNumber" sortCompareFunction="programVolume_sortCompareFunc" headerText="{sDisplayVolumeLabel}" editable="false" width="{this.objGridColumnSize.volume}" visible="{bDisplayVolume}" />
							<!-- (end) optional columns -->
							<mx:DataGridColumn dataField="payment_history" sortable="false" id="colPH"  headerText="More Info" editable="false" itemRenderer="com.components.program_details" width="{this.objGridColumnSize.moreInfo}" />	
						</mx:columns>
					</mx:DataGrid>
				</mx:HBox>
</mx:VBox>
</mx:Panel>
</mx:HDividedBox>
</mx:Canvas>