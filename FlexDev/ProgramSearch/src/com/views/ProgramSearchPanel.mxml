			public function SortGridData(event:SearchProgramEvent):void{	 

				var bCaseInsensitive:Boolean;		
				if(sScorecardSortMethod == "1"){
					bScorecardSortMethod = true;
				}
				else{
					bScorecardSortMethod = false;
				}
				
				/* If the sort is on any date field, make CaseInsensitive as false. If it is set as true, then the records do not get sorted as date */
				if(sScorecardSortOption == "contract_start_date" 
					|| sScorecardSortOption == "contract_end_date" ){
					bCaseInsensitive = false;
				}
				else{
					bCaseInsensitive = true;
				}
				
				var dataSortField:SortField = new SortField();
				
				/* sort column */
				dataSortField.name = sScorecardSortOption;
				/* sort case-insensitive  */
				dataSortField.caseInsensitive = bCaseInsensitive;
				/* sort order */
				dataSortField.descending = bScorecardSortMethod;			
				
				var dataSort:Sort = new Sort();
				dataSort.fields = [dataSortField];	
				dgProgramData.sort = dataSort;
				
				dgProgramData.refresh();   
				
				/* The default sort order should be the reverse of the order that was used
				to load the data. For eg: if contract_title is the field on which we need
				to sort by default and the order of sort is Desc.  bsortOrder should now
				be ASC. This is only useful if the user clicks on the default sort field
				(Contract_title for some clients) even before sorting by any other field after 
				program load  */
				bsortOrder = !bScorecardSortMethod;
			}
			private function Call_Sort_Data(evt:DataGridEvent):void {
				/* Hang out a while, wait a frame. This was required because the 
				sort arrow disappeared with the "event.preventDefault()" in 
				Sort_Data event.
				*/
				callLater(Sort_Data, [evt]);
				
				/* Reset the scrollbar position to the top. */
				var e:SearchProgramEvent = new SearchProgramEvent(SearchProgramEvent.RESET_SCROLLBAR_POSITION);
				this.dispatchEvent(e);
			}
			
			private function Sort_Data(event:DataGridEvent):void 
			{	
				/* Flex sorting is case-sensitive by default. Contract_title and rsp_user 
				are the only fields where I had that issue, rest of the fields have the 
				same case for all the rows.
				*/
				if(event.dataField == 'contract_title' || event.dataField =='rsp_user')
				{	   	
					dgProgramData.sort = new Sort();
					
					dgProgramData.sort.fields = [new SortField(event.dataField,true,bsortOrder)];
					/* Milan (24459) - Do not remove the code - dgProgramData.refresh();
					This ensures that the data is sorted correctly, i.e. case-insensitive.
					*/ 
					dgProgramData.refresh();
					
					event.preventDefault();
					
					bsortOrder = !bsortOrder;
				}	
				else
				{
					/* The default sorting order on any column is ASCENDING. Here false
					means "ASCENDING". Once the user clicks on any other field, except the
					default(Contract_title for some clients), we ned to make sure that
					the Sort order is ASCENDING , next time the user sorts on the default
					field
					*/
					bsortOrder = false;
				}	
			}
			
			/* IF (keyword search on Distributor, Operator, or Item or Dropdown search on Buying group or Family) OR (One of the RFA status filters is selected) 
			Dispatch the event RO_FILTER_PROGRAMS which will send the request to CF and return an Array of Contract_Main IDs.*/	
			private function setFilter():void{
				
				var strBGLabel:String = 'Show All ' + sBuyingGroupLabel;
				var strFNLabel:String = 'Show All ' + sFamilyLabel;  
				var strUserPositionID:String = '';
				var strUserID:String = '0';
				var selectedEntriesCounter:Number = 0;
				
				/* Even though "PositionID" is int, the program records are string and so "positionID" is a string here too.
				We used the selectedLabel earlier but when the position dropdown label changed to "positionname(positionID)"
				format, the filtering is being done by ID instead. */			
				if(UserPositions.selectedLabel == 'Show All Positions'){
					strUserPositionID = UserPositions.selectedLabel;
				}
				else{
					/* Get the multiple position list */
					for each(var oItem:Object in UserPositions.selectedItems)
					{
						selectedEntriesCounter = selectedEntriesCounter + 1;
							strUserPositionID = strUserPositionID + oItem.User_Positions_ID 
							if(selectedEntriesCounter != UserPositions.selectedItems.length){
								strUserPositionID = strUserPositionID + ",";
							}
					}
				}
				
				/* The filtering is being done by ID and not "description". */
				if(UserName.selectedLabel == 'Show All Users'){
					strUserID = UserName.selectedLabel;
				}
				else{
					strUserID = UserName.selectedItem.Sales_Person_ID;
				}
				
				/* When we do a multiple selection search involving combination of flex filtering and sql query 
				(For eg: Pending Approval and work in progress), the first condition here gets executed.
				When the results of the sql query are returned, then since the comma-delimited list still
				has both (or multiple) statuses, the flex filter works for all the statues.
				Note: FILTER_RESULTS event fires flex filter.
				*/
				if (Distributor_Info.text.length > 0 || Operator_Info.text.length > 0 || Item_Info.text.length > 0 
					|| ProgramStatus.selectedLabel.indexOf('Pending Approval' ) != -1 
					|| ProgramStatus.selectedLabel.indexOf('Agreed' ) != -1 
					|| ProgramStatus.selectedLabel.indexOf('Under Review' ) != -1 
					|| (ProgramInfo.selectedLabel.indexOf('CRA' ) != -1 && (UserName.selectedIndex != 0 || UserPositions.selectedIndex != 0))
					|| budgetClasses.selectedIndex != 0
					|| BuyingGroups.selectedLabel != strBGLabel 
					|| FamilyName.selectedLabel != strFNLabel)
				{	
					
					var event:SearchProgramEvent = new SearchProgramEvent(SearchProgramEvent.RO_FILTER_PROGRAMS); //FILTER USING SQL ON SERVER
					event.userId 			= iUserID;
					event.eStatus 			= ProgramStatus.selectedLabel;
					event.eTemplate 		= ProgramTemplate.selectedLabel;
					event.eRSP				= Responsible_Sales_Person.selectedLabel;
					event.eBuyingGroups 	= BuyingGroups.selectedLabel;
					event.eFamilyName		= FamilyName.selectedLabel;
					event.eUName			= strUserID;
					event.ePositions		= strUserPositionID;
					event.eProgramInfo 		= ProgramInfo.selectedLabel;
					event.eReportType		= Report_List.selectedLabel;
					event.eConditions		= Conditions.selectedLabel;
					event.eProgram_Info 	= Program_Info.text;
					event.eDistributor_Info = Distributor_Info.text;
					event.eOperator_Info 	= Operator_Info.text;
					event.eItem_Info 		= Item_Info.text;
					event.eBudgetClasses	= budgetClasses.selectedLabel;
					event.eBusinessSegments = businessSegments.selectedLabel;
					
					this.dispatchEvent(event);
				}
				else /* ELSE run a local filter on the dp using the AS filterfunction*/
				{
					var event1:SearchProgramEvent = new SearchProgramEvent(SearchProgramEvent.FILTER_RESULTS);//LOCAL FILTER
					event1.eStatus 			= ProgramStatus.selectedLabel;
					event1.eTemplate 		= ProgramTemplate.selectedLabel;
					event1.eRSP				= Responsible_Sales_Person.selectedLabel;
					event1.eBuyingGroups 	= BuyingGroups.selectedLabel;
					event1.eFamilyName		= FamilyName.selectedLabel;
					event1.eUName			= strUserID;
					event1.ePositions		= strUserPositionID;
					event1.eProgramInfo 	= ProgramInfo.selectedLabel;
					event1.eReportType		= Report_List.selectedLabel;
					event1.eConditions		= Conditions.selectedLabel;
					event1.eProgram_Info 	= Program_Info.text;
					event1.eDistributor_Info = Distributor_Info.text;
					event1.eOperator_Info 	= Operator_Info.text;
					event1.eItem_Info 		= Item_Info.text;
					event1.eBudgetClasses	= budgetClasses.selectedLabel;
					event1.eBusinessSegments = businessSegments.selectedLabel;
					this.dispatchEvent(event1);	
				}	   		
			}
			
			public function dispatchSearchEventGet():void{
				
				var e_Dispatcher:Dispatcher = new Dispatcher();
				
				var e:SearchProgramEvent = new SearchProgramEvent(SearchProgramEvent.GET);
				var e1:SearchProgramEvent = new SearchProgramEvent(SearchProgramEvent.HIDE_INFO);
				//Alert.show(iUserID.toString());
				//Alert.show(e.Creating_User_Position.toString());
				e.userId = iUserID;
				e.Creating_User_Position = iCreating_User_Position;
				e.Include_work_in_progress_below_me = iInclude_work_in_progress_below_me;
				
				/* Get Catalog records from the db */
				if(DataLoadType.selectedValue == 'Catalog')
				{
					e.sStartDate = '';
					e.sEndDate = '';
					e.showCatalog = 1;
					e_Dispatcher.dispatchEvent(e);
					e_Dispatcher.dispatchEvent(e1);        				
				}
				else
				{	/* Get "Current" records from the db */
					if(ArchiveSearch.selectedValue == 'Current')
					{
						e.sStartDate = '';
						e.sEndDate = '';
						e.showCatalog = 0;
						e.Include_work_in_progress_below_me = e.Include_work_in_progress_below_me
						e.Creating_User_Position = e.Creating_User_Position;
						e_Dispatcher.dispatchEvent(e);
					}
					/* If the user selects the "DateRange" option. */
					else if(ArchiveSearch.selectedValue == 'DateRange')
					{
						/* The purpose of using "dateFormatter.format":
						 - To convert the date in "mm/dd/yyyy" format.
						 - The value gets converted to string datatype.
						It is useful to use string datatype to avoid timezone issues.
						*/
						e.sStartDate = dateFormatter.format(dtStart.selectedDate);
						e.sEndDate = dateFormatter.format(dtEnd.selectedDate);						
						e.showCatalog = 0;
						
						/* If the user clicks on the Refresh button and the date range is not entered. */
						if(e.sStartDate == '' || e.sEndDate == '')
						{
							Alert.show('Please enter the data range.');
						}
						/* "e.sStartDate" and "e.sEndDate" are not being used for comparison as they are of "string" dataType. */
						else if(dtStart.selectedDate.getTime() >  dtEnd.selectedDate.getTime()) 
						{
							Alert.show('The end date must be after the start date.');
						}
						else
						{
							e_Dispatcher.dispatchEvent(e);
						}
						e_Dispatcher.dispatchEvent(e1);  
					}
				}				
				ResetControls(0);
			}
			
			
			
			
			
			
			private function showReportLink(ReportType:String):void{
				/* For Claim rates and pricing report, we check for app setting and the type
				of report selected, but for Mass Approve,Edit Won Lost Status and Delete, 
				we only check the report selected as the logic for including these in the 
				dropdown already exists in ProgramSearchManager.		    
				*/
				
				var bShowMassApprove:Boolean;
				bShowMassApprove = false;
				
				bShowClaimRatesReportSelection = false;
				bShowPricingReportSelection = false;
				bBidRequestTemplateSelection =  false;
				bMassApproveSelection =  false;
				bShowDeleteOptionSelection = false;
				bShowCheckBoxOptionSelection = true;
				bShowRelease = false;
				
				/* User Searched for Claim Reports */
				if(bShowClaimRatesReport == true){
					if(ReportType == 'Claim Rates')
					{
						bShowClaimRatesReportSelection = true;
					}
				}
				
				/* User Searched for Pricing Reports */  		
				if(bShowPricingReport == true){
					if(ReportType == 'Pricing')
					{
						bShowPricingReportSelection = true;
					}
				} 
				
				/* User Searched for items to delete */
				if(ReportType == 'Delete'){
					bShowDeleteOptionSelection = true; 	
					bShowCheckBoxOptionSelection =  false;	
				}
				
				/* If Bid Request is on */
				if(bBidRequestTemplate == true)
				{
					/*	If the user searches for Bid Request programs,Show the user the 
					'Edit Won Lost Status' link 
					*/
					if(ReportType == 'Edit Won/Lost Status')
					{
						bBidRequestTemplateSelection =  true;
					}
				}
				
				/* Is Mass Approve on */
				if(sMassRFAProgramApprove == '1')
				{
					bShowMassApprove = true;			   	
				}
				
				/*	If Mass Approve is on and the user searches for mass approve,Show the user the 
				'Mass Approve' link 
				*/  
				if(bShowMassApprove == true)
				{
					if(ReportType == 'Mass Approve')
					{
						bMassApproveSelection =  true;
					}
				}	
				
				/* User Searched for items to delete */
				if(ReportType == 'Release'){
					bShowRelease = true;
				}
			}	   	
