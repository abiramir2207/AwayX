			private function loadData(event:ItemClickEvent):void{	
				
				/* We do not want to load any data, when we click on the "year" radio button */
				if(event.currentTarget.selectedValue != 'DateRange')
				{
					
					var event1:SearchProgramEvent = new SearchProgramEvent(SearchProgramEvent.LOAD_SO_ITEMS);
					event1.userId = iUserID;
					/* Reset the "date range" dates. */
					event1.sStartDate = '';
					event1.sEndDate = '';
					
					/* If the user clicks on the 'Catalog' radio button */
					if(event.currentTarget.selectedValue == 'Catalog')
					{
						/* Hide the "Current" and "year" options */
						ShowHideControls(false,false);
						/* Reset the "date range" dates. */
						dtStart.text = '';
						dtEnd.text = '';
						
						event1.showCatalog 	= 1;
						event1.eStatus 		= 'Catalog';		   			
					}
					else
					{
						event1.showCatalog 	= 0;
						event1.eStatus 		= '';
					}
					
					/* If the user either clicks on the 'Current' or  'Program' radio buttons. 
					Note: Clicking on the "Program" radio button, also checks the radio button 
					for 'Current'. */
					if(event.currentTarget.selectedValue == 'Current' || event.currentTarget.selectedValue == 'Program')
					{
						/* Hide the "Current" and "year" options */
						ShowHideControls(true,false);
						/* Reset the "date range" dates. */
						dtStart.text = '';
						dtEnd.text = '';
						
						/* Check the radio button for 'Current' */
						ArchiveSearch.selection = rdoCurrent;
					}
					this.dispatchEvent(event1);
					ResetControls(1);
				}
				else
				{
					ShowHideControls(true,true);
				}
				
			}
			
