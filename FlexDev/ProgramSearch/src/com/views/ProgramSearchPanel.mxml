					</mx:HBox>				
				</mx:VBox>
				
				<mx:TabNavigator id="tbNavList" width="100%" height="100%"
								 creationComplete="this.tbNavList.selectedIndex = 0" tabWidth="79">
					<mx:Canvas label="search" width="100%" height="100%" horizontalScrollPolicy="off">
						<!-- Change "veriticalGap" here to alter veriticalGap between the controls on the screen -->		
