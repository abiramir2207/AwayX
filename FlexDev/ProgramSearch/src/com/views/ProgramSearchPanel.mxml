							<mx:VBox verticalAlign="top" verticalGap="0">
								<mx:HBox verticalAlign="top" horizontalGap="0" >
									<mx:Label text="Program" width="70" />
									<mx:TextInput 
										tabEnabled="true" 
										text="" 
										id="Program_Info" 
										toolTip="Keyword search on any of the fields:&#13; ID, Title, {sReferenceNumberLabel}."
										keyDown="enterSearchBox(event);" 
										height="{iTextInputHeight}"
										width="160"/>
								</mx:HBox>
							</mx:VBox>
							<mx:VBox verticalAlign="top" verticalGap="0">
								<mx:HBox verticalAlign="top" horizontalGap="0">
									<mx:Label text="{sDistributorLabel}" width="70"/>
									<mx:TextInput 
										tabEnabled="true" 
										text="" 				
										id="Distributor_Info" 					  	
										toolTip="Keyword search on any of the fields:&#13;{sShardShipToLabel}, Name, City, State,&#13;{sFamilyLabel} ID, {sFamilyLabel} Name,&#13;{sBuyingGroupLabel} ID, {sBuyingGroupLabel} Name." 
										keyDown="enterSearchBox(event);"
										height="{iTextInputHeight}"
										width="160" />
								</mx:HBox>
							</mx:VBox>
							<mx:VBox verticalAlign="top" verticalGap="0">
								<mx:HBox verticalAlign="top" horizontalGap="0">
									<mx:Label text="{sOperatorLabel}" width="70"/>
									<mx:TextInput 
										tabEnabled="true" 
										text=""
										id="Operator_Info" 		  	
										toolTip="Keyword search on any of the fields:&#13; ID, Name, City, State, Zip, Location Type."
										keyDown="enterSearchBox(event);"
										height="{iTextInputHeight}"
										width="160" />
								</mx:HBox>
							</mx:VBox>	
							<mx:VBox verticalAlign="top" verticalGap="3">
								<mx:HBox verticalAlign="top" horizontalGap="0">
									<mx:Label text="Item" width="70"/>
									<mx:TextInput 
										tabEnabled="true" 
										text=""
										id="Item_Info" 					  	
										toolTip="Keyword search on any of the fields:&#13; {sItemLabel}, Description, Brand Name, {sQbrandLabel},&#13;{sTypeCodeLabel}, {sTypeGroupLabel}." 
										keyDown="enterSearchBox(event);"
										height="{iTextInputHeight}"
										width="160" />
								</mx:HBox>
								<mx:HBox verticalAlign="bottom">
									<mx:Button 
										click="FilterPrograms()"
										label="search"
										height="{iButtonHeight}"
										keyDown="enterButton(event);">
									</mx:Button>	
									<mx:Button 
										click="ResetFilters()"
										label="reset"
										height="{iButtonHeight}">
									</mx:Button>
								</mx:HBox>
								<mx:VBox verticalAlign="top" verticalGap="0">						
									<mx:Text text="Hold Ctrl key to multi-select from the drop downs" fontSize="9" color="#4169E1" />		  		
									<ba:MultiComboBox
										toolTip="filter:Program Status" 
										id="ProgramStatus"  
										labelField="Contract_Status_Type_Desc"
										width="189"
										dataProvider="{dpStatus}"
										change="FilterPrograms()"
										top="0"
										rowCount="{Combo_Box_Size}"
										height="{iComboBoxHeight}">
									</ba:MultiComboBox> 
								</mx:VBox>
							</mx:VBox>
							
							<mx:VBox verticalAlign="top" verticalGap="0">
								<ba:MultiComboBox 
									toolTip="filter:Program Template" 
									id="ProgramTemplate" 
									labelField="Created_Type"
									width="189"
									dataProvider="{dpTemplate}"
									change="FilterPrograms()"
									rowCount="{Combo_Box_Size}"
									height="{iComboBoxHeight}"
									dropdownWidth="{iComboBoxContentWidth}">
								</ba:MultiComboBox>	
							</mx:VBox>
							
							<mx:VBox verticalAlign="top" verticalGap="0">
								<ba:MultiComboBox 
									toolTip="filter:Responsible Sales Person" 
									id="Responsible_Sales_Person" 
									labelField="User_Name"
									width="189"
									dataProvider="{dpRSP}"
									change="FilterPrograms()"
									rowCount="{Combo_Box_Size}"
									height="{iComboBoxHeight}">
								</ba:MultiComboBox>
							</mx:VBox>
							
							<mx:VBox verticalAlign="top" verticalGap="0">
								<ba:MultiComboBox 
									toolTip="filter:{sBuyingGroupLabel}" 
									id="BuyingGroups" 
									labelField="Buying_Group_Name"
									width="189"
									dataProvider ="{dpBuyingGroups}"
									change="FilterPrograms()"
									rowCount="{Combo_Box_Size}"
									height="{iComboBoxHeight}">
								</ba:MultiComboBox>
							</mx:VBox>
							
							<mx:VBox verticalAlign="top" verticalGap="0">
								<ba:MultiComboBox 
									toolTip="filter:{sFamilyLabel}" 
									id="FamilyName" 
									labelField="Family_Name"
									width="189"
									dataProvider="{dpFamilyNames}"
									change="FilterPrograms()"
									rowCount="{Combo_Box_Size}"
									height="{iComboBoxHeight}">
								</ba:MultiComboBox>
							</mx:VBox>
							<mx:VBox verticalAlign="top" verticalGap="0">
								<ba:MultiComboBox 
									id="Conditions" 
									width="189"
									dataProvider="{dpConditions}"
									change="FilterPrograms()"
									rowCount="{Combo_Box_Size}"
									height="{iComboBoxHeight}">
								</ba:MultiComboBox>	
							</mx:VBox>
							<mx:VBox verticalAlign="top" verticalGap="0">
								<ba:MultiComboBox 
									toolTip="filter: Program" 
									id="ProgramInfo" 
									change="FilterPrograms()"
									labelField="Program_info"
									width="189"
									dataProvider="{dpProgram}"
									rowCount="{Combo_Box_Size}"
									height="{iComboBoxHeight}">
								</ba:MultiComboBox>	
							</mx:VBox>
							<!-- The programs are filtered after SetUserPosition() sets the
