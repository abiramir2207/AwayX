			private function MassApproval(CloseEvent:Object) : void{ 
				/* CloseEvent.detail is 1 for "yes" and 2 for "no" (It was applicable with  Alert.YES and Alert.NO. Not being used anymore) */
				/* CloseEvent.detail is 4 for "ok" and 8 for "cancel" */
				if(CloseEvent.detail == 4){
					var url:URLRequest = new URLRequest("/scorecard/massapproval.cfm?massApprovalProgramList="+this.strImportItems+"&FromFlex=1");
					navigateToURL(url, "_self");   
				}  
			}
			
