			/* This has been added due to a timing issue:
			When any option on the "users" dropdown gets changed, the user position
			of that user should be set on the "user position" dropdown.
			Earlier, on the "Change" event of the "Users" drodown, this was the code:
			"SetUserPosition();FilterPrograms()". Due to this, sometimes the user position
			dropdown did not have the position selected. Now the programs are being filtered
			below after the position dropdown has the position selected.
			*/
			private function CallFilterPrograms(event:SearchProgramEvent):void{
				FilterPrograms();
			}
			
			private function FilterPrograms():void{	
				if(Program_Info.text.length > 0 || Distributor_Info.text.length > 0 ||
					Operator_Info.text.length > 0 || Item_Info.text.length > 0 ||
					ProgramStatus.selectedIndex != 0 ||	ProgramTemplate.selectedIndex != 0 || 
					Responsible_Sales_Person.selectedIndex != 0 || BuyingGroups.selectedIndex != 0 ||
					FamilyName.selectedIndex != 0 || UserPositions.selectedIndex != 0 || 
					ProgramInfo.selectedIndex != 0 || UserName.selectedIndex != 0  || 
					Report_List.selectedIndex != 0 || Conditions.selectedIndex != 0 || 
					budgetClasses.selectedIndex != 0 || businessSegments.selectedIndex  != 0
				)
				{				
					setFilter();
					
					var event:SearchProgramEvent = new SearchProgramEvent(SearchProgramEvent.DATA_GRID_SORT);
					this.dispatchEvent(event);
				}
				else
				{
					ResetFilters();
				}
				showReportLink(Report_List.selectedLabel);
			}
			
			/*On initial load, see if a status was passed in.  If yes, filter the data on status sent.  
			This is triggered via a <mate:Listener /> tag on this page ********/
			private function setStatusFilter(event:SearchProgramEvent):void{
				var comboLabel:String = '';
				var eStatus:String = event.eStatus;
				if(eStatus != ''){
					
					for ( var i:Number=0; i<ProgramStatus.dataProvider.length; i++ )
					{							
						/*some of the dp values are string and some are objects (from cf).*/
						if(ProgramStatus.dataProvider[i].hasOwnProperty('Contract_Status_Type_Desc')){
							comboLabel = ProgramStatus.dataProvider[i].Contract_Status_Type_Desc;
						}
						else{
							comboLabel = ProgramStatus.dataProvider[i].toString()
						}
						/*if an option in the comboBox ProgramStatus == the status passsed in, select it and fire the filter routine*/									   	
						if (comboLabel == eStatus){
							ProgramStatus.selectedIndex = i;
							//this.setFilter();
							break;
						}
					}
					
				}
			}
			
			
