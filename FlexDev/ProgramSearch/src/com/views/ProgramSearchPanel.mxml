			private function callColumnsHideShow():void
			{
				var arrColSize:Array = new Array();
				/*
				 Note:The order of columns below, i.e. status,rfaAge,program etc
				is the same order of the columns below on "nx:datagrid". If the user
				did not change the column sequence on the grid, the array antries will
				be saved in the default order of columns on nx:datagrid".
				If a user uses "drag and drop" to change the column sequence, then the order of
				sequence in "datagridColumns" array automatically changes. So that this function
				is called to update the "includeColumnList" array for the sequence of columns,
				"headerShift" event on the grid calls this function.
				*/			
				
				/* "isSelected" is the checkbox column and will always be shown */
				arrColSize.push('isSelected:1');
				/* Hide the next two columns. These columns will only be shown when a user takes certain action.
				By default, i.e. on data load, it willl always be OFF.
				*/
				arrColSize.push('contractMainID:0');
				arrColSize.push('BidRequestStatus:0');
								
				for(var i:int = 0;i<dg.columns.length;i++){
					var col:DataGridColumn = DataGridColumn(dg.columns[i]);
					
					if(col.dataField== 'status_abbreviation')
					{	
						col.visible = cbStatusShowColumn.selected;
						arrColSize.push('status:'+int(cbStatusShowColumn.selected));
					}
					if(col.dataField== 'rfa_age')
					{	
						col.visible = cbRFAAgeShowColumn.selected;
						arrColSize.push('rfaAge:'+int(cbRFAAgeShowColumn.selected));
					}
					if(col.dataField== 'contract_number')
					{	
						col.visible = cbProgramShowColumn.selected;
						arrColSize.push('program:'+int(cbProgramShowColumn.selected));
					}	
					if(col.dataField== 'contract_title')
					{	
						col.visible = cbTitleShowColumn.selected;
						arrColSize.push('title:'+int(cbTitleShowColumn.selected));
					}	
					if(col.dataField== 'created_type')
					{	
						col.visible = cbTypeShowColumn.selected;
						arrColSize.push('type:'+int(cbTypeShowColumn.selected));
					}	
					if(col.dataField== 'contract_start_date')
					{	
						col.visible = cbStartDateShowColumn.selected;
						arrColSize.push('startDate:'+int(cbStartDateShowColumn.selected));
					}	
					if(col.dataField== 'contract_end_date')
					{	
						col.visible = cbEndDateShowColumn.selected;
						arrColSize.push('endDate:'+int(cbEndDateShowColumn.selected));
					}	
					if(col.dataField== 'rsp_user')
					{	
						col.visible = cbRSPShowColumn.selected;
						arrColSize.push('rsp:'+int(cbRSPShowColumn.selected));
					}	
					if(col.dataField== 'program_trade_spend')
					{	
						col.visible = cbTradeDollarsShowColumn.selected;
						arrColSize.push('tradeDollars:'+int(cbTradeDollarsShowColumn.selected));
					}						
					if(col.dataField== 'program_payment')
					{	
						col.visible = cbPaymentDollarsShowColumn.selected;
						arrColSize.push('paymentDollars:'+int(cbPaymentDollarsShowColumn.selected));
					}	
					if(col.dataField== 'program_volume')
					{	
						col.visible = cbVolumeShowColumn.selected;
						arrColSize.push('volume:'+int(cbVolumeShowColumn.selected));
					}					
					if(col.dataField== 'payment_history')
					{	
						col.visible = cbMoreInfoShowColumn.selected;
						arrColSize.push('moreInfo:'+int(cbMoreInfoShowColumn.selected));
					}
					if(col.dataField== 'business_segment')
					{	
						col.visible = cbBusinessSegmentShowColumn.selected;
						arrColSize.push('businessSegment:'+int(cbBusinessSegmentShowColumn.selected));
					}						
				}

				this.objGridColumnSize.includeColumnList = arrColSize;
				
				/* "SET COLUMN SIZE" is not only used to set the column size but also the "SEQUENCE" and "HIDE/SHOW" status
				of the columns which is stored in the "includeColumnList" array.
				*/
				var eventSetColumnSize:SearchProgramEvent = new SearchProgramEvent(SearchProgramEvent.SET_COLUMN_SIZE);
				eventSetColumnSize.eSearchGridColumnSize = this.objGridColumnSize;
				this.dispatchEvent(eventSetColumnSize);				
			}
			
