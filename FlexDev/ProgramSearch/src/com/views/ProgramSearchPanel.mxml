			/* This function is called on "data load". */
			public function resetColumnOrder(e:Event):void{
				tmpArray = [];
				datagridColumns = dg.columns;
				var arrColumn:Array = new Array();
				var colDataField:String;	
				
				/* Loop through the sequence of columns stored in the db. The data is in "FieldName:Hide/Show" format.
				Eg: "title:1" or "rsp:0". The list of columns is stored in a sequence in the db - It is the seqeunce saved
				by the user. The "hide/show" for every column is also stored in the db. If the user has not saved this data,
				default data will be used.
				*/
				for(var i:Number=0; i<this.objGridColumnSize.includeColumnList.length; i++){
					arrColumn = this.objGridColumnSize.includeColumnList[i].split(':');
					/* data column */
					colDataField = getColumnDataField(arrColumn[0]);
					/* data column - hide/show */
					var bShowColumn:Boolean = (arrColumn[1] == "1") ? true : false;
					
					/* Loop through the datagrid columns. This list and order will be the order at the bottom of this file,
					where "mx:DataGrid" is used. If the column exists in both - db and "mx:DataGrid", then the hide/show 
					status (bShowColumn) of that column will come from the db.
					*/
					for(var j:Number=0; j<datagridColumns.length; j++){
						if(colDataField == datagridColumns[j].dataField){
							//trace(arrColumn[i], "MATCHES", datagridColumns[j].dataField);
							datagridColumns[j].visible = bShowColumn;
							/* Add columns to "tmpArray" */
							tmpArray.push(datagridColumns[j]);
						}
					}
				}
				
				/* In case, a new column is added on the "mx:DataGrid" below and a new entry for that column is not made in the db 
				(table - Program_Search_Grid_Field_Include). That column will still be added.
				*/
				for(var m:Number=0; m<datagridColumns.length; m++){	
					var columnFound:Boolean = false;
					for(var n:Number=0; n<this.objGridColumnSize.includeColumnList.length; n++){
						arrColumn = this.objGridColumnSize.includeColumnList[n].split(':');
						colDataField = getColumnDataField(arrColumn[0]);
					
						if(colDataField == datagridColumns[m].dataField){
							columnFound = true;
						}
					}
					/* If the column is not found in "includeColumnList", i.e. in the db, then add that column to the array in the same
					position as it is in the "mx:DataGrid" below.
					*/
					if(columnFound == false){
							/* Add columns to "tmpArray" in the same sequence as in the "mx:DataGrid" below. */
							tmpArray.splice(m,0,datagridColumns[m]);						
					}

				}	
				
				/* reset the grid columns */
				dg.columns = tmpArray;
			}
			
