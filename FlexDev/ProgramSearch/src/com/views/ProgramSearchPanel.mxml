			/* Get program id's selected by the user to mass approve, change won/lost status,
			claim rates report or pricing report  
			*/
			public function getSelectedEntries(Type:String):void
			{
				var strBidRequestStatus:String;
				for each(var oItem:Object in dg.dataProvider.source)
				{
					if(oItem['isSelected'] == true)
					{
						if(Type == 'EditStatus'){	
							/* The reason why below filter is important is due to this:
							If a user selects an option, say "Claim rates" from the "action"
							dropdown and chooses (checkbox) a few programs. Now changes the option to
							"pricing" on the dropdown. Some of the selected programs are not
							filtered for the "pricing report" but are still checked and so
							when a user generates the pricing report, those older selections 
							come up too. We cannnot "uncheck" selected records on filter as 
							the user might select records by using secondary filters too.
							eg: First select template x, choose 2 programs, then select template y,
							choose 3 more programs. If we uncheck on filter, those older selections will
							be lost. So, here we are looking for programs where the respective
							condition is met - Either pricing or edit status or claim report
							or mass approve etc.
							Note: The filter logic here comes from "programFilterFunc" function
							on "programSearchManager.as".
							*/		
							if(oItem['is_catalog'] == 0 && oItem['status_id'] ==  10)
							{
								if(oItem['BidRequest_Status'] == 4){
									strBidRequestStatus = '4';
								}
								else
								{
									strBidRequestStatus = '2';
								}
								arrImportItems.push(oItem['contract_main_id'] + '_' + strBidRequestStatus)
							}
						}									
						else
						{
							/* The reason why below filter is important is due to this:
							If a user selects an option, say "Claim rates" from the "action"
							dropdown and chooses (checkbox) a few programs. Now changes the option to
							"pricing" on the dropdown. Some of the selected programs are not
							filtered for the "pricing report" but are still checked and so
							when a user generates the pricing report, those older selections 
							come up too. We cannnot "uncheck" selected records on filter as 
							the user might select records by using secondary filters too.
							eg: First select template x, choose 2 programs, then select template y,
							choose 3 more programs. If we uncheck on filter, those older selections will
							be lost. So, here we are looking for programs where the respective
							condition is met - Either pricing or edit status or claim report
							or mass approve etc.
							Note: The filter logic here comes from "programFilterFunc" function
							on "programSearchManager.as".
							*/									
							if(Type == 'ClaimRatesReport')
							{
								if(oItem['is_catalog'] == 0 && oItem['include_claim_rates_report'] == '1')
								{
									arrImportItems.push(oItem['contract_main_id'])
								}
							}
							else if (Type == 'PricingReport'){
								if(oItem['is_catalog'] == 0 && oItem['include_pricing_report'] == '1')
								{
									arrImportItems.push(oItem['contract_main_id'])	
								}										
							}								
							else if (Type == 'MassApprove'){
								if(oItem['is_catalog'] == 0 && oItem['status_id'] == 2)
								{
									arrImportItems.push(oItem['contract_main_id'])	
								}										
							}
							else if (Type == 'Release'){
								if(oItem['is_catalog'] == 0 && oItem['release_eligible'] == 1)
								{
									arrImportItems.push(oItem['contract_main_id'])	
								}										
							}						
								/* This condition is not being used. */
							else{
								arrImportItems.push(oItem['contract_main_id'])	
							}
						}
					}
					
				}
				
				/* "this" makes "strImportItems" available outside the function */			
				this.strImportItems = arrImportItems.toString();
				if(Type == 'MassApprove'){
					MassApprovalConfirm();	
				}
				else if(Type == 'EditStatus'){
					var pattern:RegExp = /[,]/gi;
					
					editSelectedProgramStatusConfirm();
				}
				else if(Type == 'ClaimRatesReport'){
					this.strReportType = '1';
					ShowReportConfirm();				
				}
				else if(Type == 'PricingReport'){
					this.strReportType = '2';
					ShowReportConfirm();					
				}
				else if(Type == 'Release'){
					ShowReleaseConfirm();					
				}
			}
			
