<?xml version="1.0" encoding="utf-8"?>
<!--- This is the popup for program summary. -->
<mx:VBox xmlns:mx="http://www.adobe.com/2006/mxml" horizontalScrollPolicy="off">
<mx:HBox horizontalGap="1">
<mx:Text text="[{data.contract_number}]" color="{getColor(data.is_catalog,data.Best_Plan_Program)}" id="program_num" click="openProgram(data.contract_main_id,data.is_catalog)" useHandCursor="{data.is_catalog == 0}" mouseChildren="false" buttonMode="true" toolTip="Click here to view/edit program"/>
	<mx:Script>
	<![CDATA[
		import com.maps.*;
		import com.views.*;
		import com.models.*;
		import com.events.*;
		import mx.controls.Alert;
		import mx.utils.ObjectUtil;
		import mx.core.Application;
		//import flash.system.Capabilities;
		
		private function getColor(Catalog:String, BestPlanProgram:String):int
		{
			var colorCode:int = 0;
			
			if(Catalog == '1')
			{
				/* Color:Lavender Blush4 */
				colorCode = 0x817679;
			}

			if(BestPlanProgram == '1')
			{
				/* Color:Lavender Blush4 */
				colorCode = 0xFF000D;
			}
			
			return colorCode;
		}
		
		/* Program Summary */		
		private function openProgram(Program_ID:int,Catalog:String) : void{
			//var ResolutionX:Number = Capabilities.screenResolutionX;
			//var ResolutionX:Number = Capabilities.screenResolutionX;
			/* Make the widow name dynamic, so that multiple windows can open */
			var win_name:String = 'winSummary_' + Program_ID;
			
		 if(Catalog == '0')
		 {
 	        var winjscommand:String ="/CID_Wrapper.cfm?Program_ID="+Program_ID+"&Page_Relocate=/common_files/contracts/contract_edit_menu.cfm";
			/* The height/width of the window should be a little less than 1360/768. This ensures that the scrollbar is always visible  */
			var jscommand:String = "window.open('"+winjscommand+"','"+win_name+"','height=710,width=1345,left=0,top=0,toolbar=no,scrollbars=yes,screenX=0,screenY=0,resizable=yes');"   
			var url:URLRequest = new URLRequest("javascript:" + jscommand + " void(0);");   
			navigateToURL(url, "_self");
		 }
	   }
   ]]>    
	</mx:Script>

	</mx:HBox>
</mx:VBox>