<?xml version="1.0" encoding="utf-8"?>
<mx:Canvas xmlns:mx="http://www.adobe.com/2006/mxml" 
	xmlns:mate="http://mate.asfusion.com/"
	 xmlns:ba="com.shared.components.*" paddingBottom="5" paddingLeft="5" paddingRight="5" paddingTop="5"
	resizeEffect="Resize" resize="true"  horizontalScrollPolicy="off" verticalScrollPolicy="off" 
	width="100%" height="100%">

	<mx:Script>
		<![CDATA[
			import com.shared.events.*;
			import com.shared.models.*;
			import com.shared.vos.*;
			import mx.collections.ArrayCollection;
			import flash.events.*;
			import mx.controls.Alert;
			import mx.utils.ObjectUtil;
			import mx.events.ModuleEvent;
            import mx.modules.ModuleManager;
            import mx.modules.IModuleInfo;
            import com.Admin.IModuleInterface;
            import mx.core.Application;
/* demo start 	******************************************************************************* */
			[Bindable] public var oSettings:Settings = new Settings();
			[Bindable] public var oUser:Object = new Object();
			[Bindable] public var var1:String = "";
			[Bindable] public var var2:String = "";
			[Bindable] public var acData:ArrayCollection = new ArrayCollection();
					  // public var oGridData:GridData = new GridData();
			 import flash.net.*;
			 import flash.external.*;
       		public function callWrapper():void {
		          
		           /*  var h:URLRequest = new URLRequest("javascript:{document.getElementById('MassContractProdUpd').style.height = '800px'}");
		            navigateToURL(h,"_self");
		            var w:URLRequest = new URLRequest("javascript:{document.getElementById('MassContractProdUpd').style.width = '800px'}");
		            navigateToURL(w,"_self"); */
		           ExternalInterface.call(
										    "function( id, h ) { document.getElementById(id).style.height = h + '%'; }",
										    ExternalInterface.objectID,
										    100
											);
					ExternalInterface.call(
										    "function( id, w ) { document.getElementById(id).style.width = w + '%'; }",
										    ExternalInterface.objectID,
										    100
											);	
			        }
			private function showUser() : void 
				{
					this.txtArea.text = "User:  " + ObjectUtil.toString(this.oUser);
					this.callWrapper();

				}
				
			private function showApp() : void 
				{
					this.txtArea.text = "AppSettings:  " + ObjectUtil.toString(oSettings.appSettings) ;
				}
			
			private function showCustomApp() : void 
				{
					this.txtArea.text = "Custom App:  " + ObjectUtil.toString(oSettings.appFlex);
				}
				
			private function showAC() : void 
				{
					this.txtArea.text = "ArrayCollection:  " + ObjectUtil.toString(this.acData);
				}
/* 	demo end ******************************************************************************* */

	 		
        
            [Bindable]
            public var selectedItem:Object;

            [Bindable]
            public var currentModuleName:String;
            
            private function applyModuleSettings(e:Event):void {
                // Cast the ModuleLoader's child to the interface.
                // This child is an instance of the module.
                // You can now call methods on that instance.
                var ichild:* = mod.child as IModuleInterface;                
                if (mod.child != null) {                    
                    // Call setters in the module to adjust its
                    // appearance when it loads.
                 //   ichild.setAdjusterID(myId.text);
                    ichild.setBackgroundColor("red");
                } else {                
                    trace("Uh oh. The mod.child property is null");                 
                }
                // Set the value of a local variable by calling a method
                // on the interface.
                currentModuleName = ichild.getModuleName();
            }
            
            private function reloadModule():void {
                mod.unloadModule();
                mod.loadModule();
            }
            public function createModule(m:ModuleLoader, s:String):void {
            if (!m.url) {
                m.url = s;
                return;
            }
            m.loadModule();
        }
        
        public function removeModule(m:ModuleLoader):void {
            m.unloadModule();
        }
		]]>
	</mx:Script>

	<!-- Views _______________________________________________________ -->
<mx:HDividedBox id="fullBox" height="100%" width="100%" paddingTop="0" paddingRight="0" paddingBottom="0" paddingLeft="0" top="2" right="2" bottom="2" left="2">

	<!--******************************* (Left Options Panel)	*********************************************-->
	<mx:Panel id="pnlSelected" backgroundColor="0xffffff" headerColors="['0xffce84','0xffffff']" color="0x333333" minWidth="185" minHeight="603"
			 name="Left Panel" title="Options" top="2" right="col1:2" bottom="row1:2" left="2">
		<mx:VBox height="100%" width="100%">
		<!--******************************* START	Left Options Panel	***************************************************************-->
			<mx:Text text="{this.var2}" />
			<mx:DataGrid dataProvider="{this.acData}">
				<mx:columns>
					<mx:DataGridColumn headerText="Item" dataField="baData"/>
					<mx:DataGridColumn headerText="Action" dataField="isSelected"/>
				</mx:columns>
			</mx:DataGrid>
			<!--<mx:Button label="Show User Info" click="showUser();" />
			<mx:Button label="Show App Info" click="showApp();" />
			<mx:Button label="Show Custom App Info" click="showCustomApp();" />
			<mx:Button label="Show ArrayCollection" click="showAC();" />-->
	
		<!--******************************* END		Left Options Panel	***************************************************************-->		
		</mx:VBox>
	</mx:Panel>
	
	<!--******************************* (Main Panel)	*********************************************-->
	<mx:Panel id="pnlAll" backgroundColor="0xffffff" headerColors="['0xffce84','0xffffff']" color="0x333333"
			bottom="row2:2" height="100%" left="col2:2" right="2" top="2"
			name="Main Panel" title="Title">
		<mx:VBox height="100%" width="100%" horizontalAlign="left" creationPolicy="queued" creationIndex="4">
		<!--******************************* START	Main Panel UI	***************************************************************-->
		
		<mx:TextArea id="txtArea" width="400" height="20" text="{ObjectUtil.toString(this.acData)}" 
			visible="false" includeInLayout="false" />
			
			
		

		<mx:Canvas width="100%" height="100%">
	        <mx:ModuleLoader id="mod" width="100%" />
	        <!-- url="com.Admin.Admin.swf" 
	            ready="applyModuleSettings(event)"-->
    	</mx:Canvas> 
    	
    	<!--*******************************	END		Main Panel UI	***************************************************************-->
		</mx:VBox>   
    	<!--<mx:Button id="b1" label="Reload Module" click="reloadModule()"/>-->
    	<mx:HBox> 
    			<mx:Button 
                    label="Load" 
                    click="createModule(mod, l2.text)"
                />
                <mx:Button 
                    label="Unload" 
                    click="removeModule(mod)"
                />
                <mx:Label id="l2" text="com/Admin/Admin.swf"/>
        </mx:HBox> 
			

	</mx:Panel>
		
</mx:HDividedBox>

	<!--*********************************	BOTTOM PANEL  ************************************************************-->
	

</mx:Canvas>
