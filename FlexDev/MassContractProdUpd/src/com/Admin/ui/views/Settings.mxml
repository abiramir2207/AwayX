<?xml version="1.0" encoding="utf-8"?>

<mx:Canvas xmlns:mx="http://www.adobe.com/2006/mxml" height="100%">
	<mx:Script>
		<![CDATA[

			import com.Admin.ui.presenters.AdminPM;
			import mx.utils.ObjectUtil;
			
			[Bindable]
			public var model:AdminPM;
			
			
			
		]]>
	</mx:Script>
    
	<mx:VBox width="100%" height="450">
		<mx:Label text="Mass Contract Prod Update Admin: Select Criteria"/>
		<mx:HBox width="100%" height="50%">
			<mx:VBox height="100%">
				<mx:HBox>
					<mx:Label text="Sub Product"/>
					<mx:Button label="Get Prod" click="model.showItemSearch(this);"/>
				</mx:HBox>
				<mx:TextInput />
				<mx:HBox>
					<mx:Label text="New Product"/>
					<mx:Button label="Get Prod" click="model.showItemSearch(this);"/>
				</mx:HBox>
				<mx:TextInput />
			</mx:VBox>
			<mx:VBox height="100%">
				<mx:Label text="Template"/>
				<mx:List width="120" height="90%" dataProvider="{model.templateDP}" allowMultipleSelection="true">
				</mx:List>
			</mx:VBox>
			<mx:VBox height="100%">
				<mx:Label text="Status"/>
				<mx:List width="120" height="90%" dataProvider="{model.statusDP}" allowMultipleSelection="true" >
				</mx:List>
			</mx:VBox>
			<mx:VBox height="100%" verticalAlign="bottom">
				<mx:Button label="Get Programs" click="model.showAction()"/>
			</mx:VBox>
		</mx:HBox>
		<mx:HRule width="100%" strokeColor="black"/>
		<mx:Label text="Mass Contract Prod Update Admin: Specify Rates"/>
		<mx:HBox width="100%" height="50%">
			
			<mx:VBox height="100%">
				
				<mx:Label text="Programs"/>
				<mx:List width="120" height="90%" dataProvider="{model.programsDP}" allowMultipleSelection="true">
				</mx:List>
			</mx:VBox>
			<!-- GLOBAL -->
			<mx:VBox height="100%">
				<mx:HBox backgroundColor="#DAF7F1" width="100%" paddingBottom="5" paddingLeft="5" paddingRight="5" paddingTop="5">
					<mx:VBox>
						<mx:Label text="Global"/>
						<mx:TextInput width="{ model.tiWidth }" />
					</mx:VBox>
					<mx:VBox>
						<mx:Label text=""/>
						<mx:ComboBox dataProvider="{model.uom}"></mx:ComboBox>
					</mx:VBox>
					<mx:VBox>
						<mx:Label text=""/>
						<mx:Button label="Apply To All" click="model.showApplyAllAction()"/>
					</mx:VBox>
				</mx:HBox>
				
				
				<!-- FIXED -->
				<mx:HBox>
					<mx:VBox>
						<mx:Label text="Fixed"/>
						<mx:TextInput width="{ model.tiWidth }" />
					</mx:VBox>
					<mx:VBox>
						<mx:Label text=""/>
						<mx:ComboBox dataProvider="{model.uom}"></mx:ComboBox>
					</mx:VBox>
				
				<!-- REBATE -->
				
					<mx:VBox>
						<mx:Label text="Rebate"/>
						<mx:TextInput width="{ model.tiWidth }" />
					</mx:VBox>
					<mx:VBox>
						<mx:Label text=""/>
						<mx:ComboBox dataProvider="{model.uom}"></mx:ComboBox>
					</mx:VBox>
				</mx:HBox>
				
				<!-- Growth -->
				<mx:HBox>
					<mx:VBox>
						<mx:Label text="Growth"/>
						<mx:TextInput width="{ model.tiWidth }" />
					</mx:VBox>
					<mx:VBox>
						<mx:Label text=""/>
						<mx:ComboBox dataProvider="{model.uom}"></mx:ComboBox>
					</mx:VBox>
				
				<!-- Off Invoice -->
				
					<mx:VBox>
						<mx:Label text="Off Invoice"/>
						<mx:TextInput width="{ model.tiWidth }" />
					</mx:VBox>
					<mx:VBox>
						<mx:Label text=""/>
						<mx:ComboBox dataProvider="{model.uom}"></mx:ComboBox>
					</mx:VBox>
				</mx:HBox>
				
				<!-- Bid -->
				<mx:HBox>
					<mx:VBox>
						<mx:Label text="Bid"/>
						<mx:TextInput width="{ model.tiWidth }" />
					</mx:VBox>
					<mx:VBox>
						<mx:Label text=""/>
						<mx:ComboBox dataProvider="{model.uom}"></mx:ComboBox>
					</mx:VBox>
				
				<!-- xxxxx 
				
					<mx:VBox>
						<mx:Label text="xxxx"/>
						<mx:TextInput width="{ model.tiWidth }" />
					</mx:VBox>
					<mx:VBox>
						<mx:Label text=""/>
						<mx:ComboBox dataProvider="{model.uom}"></mx:ComboBox>
					</mx:VBox>-->
				</mx:HBox>
				
				
			</mx:VBox>
		</mx:HBox>
		<mx:HBox paddingTop="10" paddingLeft="10">
			<mx:Button label="View rates" click=""/>
			<mx:Button label="Save Rates" click=""/>
		</mx:HBox>
	</mx:VBox>
	<!--<mx:TextArea id="txtArea" width="400" height="100" text="{ObjectUtil.toString(model.users)}" />-->
	
</mx:Canvas>
