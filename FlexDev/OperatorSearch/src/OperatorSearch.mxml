<?xml version="1.0" encoding="utf-8"?>
<mx:Application xmlns:mx="http://www.adobe.com/2006/mxml" 
	layout="vertical"
	xmlns:view="com.views.*" 
	xmlns:maps="com.maps.*" 
	xmlns:vos="com.vos.*" 
	paddingBottom="0" paddingLeft="0" paddingRight="0" paddingTop="0"
	width="100%" height="100%"
	preinitialize="applyRuntimeStyleSheet();" 
	preloader="com.components.baProgressBar"> 
	
	<mx:Script>
		<![CDATA[
			import mx.controls.Alert;
			import mx.utils.ObjectUtil;
			import com.events.*;
			import com.models.*;
			import mx.styles.StyleManager;
        	
        	/**
        	 * Application pre-initialize function to apply the stylesheet swf
        	*/
	        public function applyRuntimeStyleSheet():void {
	        	StyleManager.loadStyleDeclarations("/Flex/assets/styles/mainFx.swf") 
	        }
		]]>
	</mx:Script>

	<!--- Event Maps -->
	<maps:MainEventMap/>
	<maps:ModelMap />
	
	<!--- Views -->
	<mx:HBox width="800" height="620">
		<view:SearchPanel />
	</mx:HBox>

</mx:Application>
