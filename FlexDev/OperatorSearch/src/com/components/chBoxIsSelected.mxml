<?xml version="1.0"?>
<!-- components\chBoxIsSelected.mxml -->
<mx:VBox xmlns:mx="http://www.adobe.com/2006/mxml" backgroundAlpha="0" backgroundColor="white" horizontalAlign="center" width="3">
    <mx:Script>
        <![CDATA[
        	import com.events.SearchEvent;
        	import mx.controls.Alert;
        	
        	[Bindable]	public var varCbSelected:Boolean;

            /* Keep Track of selected operators, so when a new query is fired, we dont loose currently selected operators */	
			public function trackSelectedItem(oOperator:Object):void
			{
				data.isSelected = varCbSelected;
				var event:SearchEvent = new SearchEvent(SearchEvent.TRACK_OPERATORS);
				event.selectedOperator = oOperator;
				this.dispatchEvent(event); 
			}     
        ]]>
    </mx:Script>
   
    <mx:CheckBox id="cbIsSelected" 
        height="100%" width="50%" 
        selected="{data.isSelected}" 
        click="varCbSelected=cbIsSelected.selected;trackSelectedItem(data);" />
</mx:VBox>
