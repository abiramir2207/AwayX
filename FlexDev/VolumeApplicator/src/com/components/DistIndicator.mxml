<?xml version="1.0" encoding="utf-8"?>
<!---
This item renderer displays a red cross if the Distributor is not on program 
-->
<mx:HBox xmlns:mx="http://www.adobe.com/2006/mxml" width="100%" 
	height="20" horizontalGap="1" 
	horizontalAlign="center" verticalAlign="middle">
 <mx:Script xmlns:mx="http://www.adobe.com/2006/mxml">
	<![CDATA[
		import mx.controls.Alert;
		import mx.utils.ObjectUtil;
		import flash.external.ExternalInterface
		import com.asfusion.mate.events.Dispatcher;
		import mx.events.CloseEvent;
	]]>
</mx:Script>

	<mx:Image xmlns:mx="http://www.adobe.com/2006/mxml" 
			id="imgDistAppearance"	
			 width="8"
			  height="8"
			source="{getSource(data.distributor_not_on_program)}" 
			toolTip="{parentDocument.sCustomerLabel} not on the program"> 
			<mx:Script>
				<![CDATA[
					[Bindable]
					public var imgHolder:String;
					private function getSource(recType:Boolean):String
					{
						if (data.distributor_not_on_program == 0)   
						{
								imgHolder = ""; // do not display any thing if it is 0
						}
						else if (data.distributor_not_on_program == 1)
						{
							/* ************************************************************** 
							The image no.gif is displayed if the record is edited and coming 
							from the program_product_volume_forecast table and e.ico if the 
							record is coming from program_product_volume table 
							- Anand Rao/29-Jun-09
							************************************************************** */
							imgHolder = "/flex/assets/images/no.gif";
						}
						else
						{
								imgHolder = "";
						}
						return imgHolder;
					}	 
				]]>
			</mx:Script>
	</mx:Image>
 
</mx:HBox>						
 