		 	/**
		 	*  This function saves the datagrid values to the database
	 		*/	
			public function fnSaveChanges(strSaveType:String):void
			{
				var casesTotal:Number 	= 0;
				var poundsTotal:Number  = 0;
				var errorFlag:Number 	= 0;
				var saveType:String;
				
				saveType = strSaveType;
				
				this.bSaveEnabled = false;
				
				for each(var oItem:Object in dgEd.dataProvider.source)
				{
					casesTotal = casesTotal + removeCommas(oItem['cases']); 
					poundsTotal = poundsTotal + removeCommas(oItem['pounds']);
				}
				
				/*  ********************************************************************** 
					Before saving check whether the Setting for the Global value are validated
					if the minGlobalVolume or MaxGlobalVolume is set and if so make sure 
					that the user entered values are not more than or less than the value
					in the settings.
				 ********************************************************************** */
				if (minGlobalVolume.valueOf() == "true" || maxGlobalVolume.valueOf() == "true")
				{
					if (maxGlobalVolume.valueOf() == "true")
					{
						if(volumeUOMType == "Cases")
						{
							if (casesTotal >  Number(maxGlobalVolumeSizeCS))
							{
								Alert.show("The total " + programKeyword.toString() + " volume you have entered (" + casesTotal.toString() + " " + volumeUOMType.toString() + ") exceeds the template maximum " + programKeyword.toString() + " volume of " + maxGlobalVolumeSizeCS.toString() +  "\nPlease adjust the volume accordingly.", "Volume Error Alert!");
								errorFlag = 1;  
							}
						}
						else
						{
							if (poundsTotal >  Number(maxGlobalVolumeSizeLB))
							{
								Alert.show("The total " + programKeyword.toString() + " volume you have entered (" + poundsTotal.toString() + " " + volumeUOMType.toString() + ") exceeds the template maximum " + programKeyword.toString() + " volume of " + maxGlobalVolumeSizeLB.toString() +  "\nPlease adjust the volume accordingly.", "Volume Error Alert!");
								errorFlag = 1;
							}
						}
					}	
					if (minGlobalVolume.valueOf() == "true")
					{
						if(volumeUOMType == "Cases")
						{
							if (casesTotal <  Number(minGlobalVolumeSizeCS))
							{
								Alert.show("The total " + programKeyword.toString() + " volume you have entered (" + casesTotal.toString() + " " + volumeUOMType.toString() + ") is less than the template minimum " + programKeyword.toString() + " volume of " + minGlobalVolumeSizeCS.toString() + "\nPlease adjust the volume accordingly.", "Volume Error Alert!");
								errorFlag = 1;
							}
						}
						else
						{
							if (poundsTotal <  Number(minGlobalVolumeSizeLB))
							{
								Alert.show("The total " + programKeyword.toString() + " volume you have entered (" + poundsTotal.toString() + " " + volumeUOMType.toString() + ") is less than the template minimum " + programKeyword.toString() + " volume of " + minGlobalVolumeSizeLB.toString() + "\nPlease adjust the volume accordingly.", "Volume Error Alert!");
								errorFlag = 1;
							}
						}
					}
				}
				
				if (errorFlag == 0)
				{
					/* ********************************************************************** 
						If errorFlag == 0 which means no error happened with the max or min 
						volume setting then go ahead and save the value in the DataGrid	
					********************************************************************** */
					var eventSaveChanges:VolumeApplicatorEvent = new VolumeApplicatorEvent(VolumeApplicatorEvent.SAVE_CHANGES);
					eventSaveChanges.dgVolumeDataEditSet = this.dgVolumeDataEdit.source;
					eventSaveChanges.appProgramID = this.prgProgramID;
					eventSaveChanges.userId = this.prgUserID;
					eventSaveChanges.nProductGroupLevel = this.nProductGroupLevelEventId;
					eventSaveChanges.excludeAutoVolumeUpdates = this.excludeAutoVolumeUpdates.selected;
					eventSaveChanges.saveType = saveType;
					this.dispatchEvent(eventSaveChanges);
				}
				
				if (errorFlag == 1 && this.bSaveEnabled == false){
					this.bSaveEnabled = true;
				}
			}
			
			
