			protected function applyAction_changeHandler(event:ListEvent):void
			{
				var nApplyActionId:Number = ComboBox(event.target).selectedItem.data;
				if (nApplyActionId == 1){
					fnApplyToSelectedItems('1');
				}
				else if (nApplyActionId == 2){
					fnApplyToSelectedItems('2');
				}
				else if (nApplyActionId == 3){
					fnEvenlyAllocate();
				}
				else if (nApplyActionId == 4){
					fnApplyToSelectedOppItems('4');
				}
				else if (nApplyActionId == 5){
					fnApplyToSelectedOppItems('5');
				}
				else if (nApplyActionId == 6){
					fnEvenlyAllocateOpp();
				}
				
			}
			
			protected function cbUom_changeHandler(event:ListEvent):void
			{
				volumeQtyUOMIDX = ComboBox(event.target).selectedItem.data;
			}
			
			/* Export the grid data to Excel. */
			public function callExportXLS():void
			{	
				var strProdList:String  ='';
					
				/* (String.fromCharCode(9) means tab) */
				var strProdListHeaderTop:String = '[' + programNumber + ']' +  ' - ' + programTitle + String.fromCharCode(13) + String.fromCharCode(10);
				strProdListHeaderTop = strProdListHeaderTop + 'Program Span: '  + prgAreaStartDate + ' - ' +  prgAreaEndDate + ' ('+prgAreaSpanDays+ ' days)' + String.fromCharCode(13) + String.fromCharCode(10) + String.fromCharCode(13) + String.fromCharCode(10);
				
				var strProdListHeader:String = 'Product Number' + String.fromCharCode(9) + 'Product Description' + String.fromCharCode(9);
					
					if(bCasesVolumeShow && bPoundsVolumeShow){	
						strProdListHeader = strProdListHeader + 'Volume (cases)' + String.fromCharCode(9) + 'Volume (pounds)' + String.fromCharCode(9);
					}
					else if(bCasesVolumeShow){
						strProdListHeader = strProdListHeader + 'Volume (cases)' + String.fromCharCode(9);					
					}
					else if(bPoundsVolumeShow){
						strProdListHeader = strProdListHeader + 'Volume (pounds)' + String.fromCharCode(9);		
					}
					
					strProdListHeader = strProdListHeader + String.fromCharCode(10);
					//strProdListHeader = strProdListHeader + 'Net $' + String.fromCharCode(13) + String.fromCharCode(10);
					
						
					for each(var o:Object in dgVolumeDataEdit)
					{
						strProdList = strProdList + '="' + o['item'] + '"' + String.fromCharCode(9) + o['description'] + String.fromCharCode(9)
						
						if(bCasesVolumeShow && bPoundsVolumeShow){	
							strProdList = strProdList + o['cases'] + String.fromCharCode(9) + o['pounds'] + String.fromCharCode(9);
						}
						else if(bCasesVolumeShow){
							strProdList = strProdList + o['cases'] + String.fromCharCode(9);					
						}
						else if(bPoundsVolumeShow){
							strProdList = strProdList + o['pounds'] + String.fromCharCode(9);		
						}
						
						strProdList = strProdList + String.fromCharCode(10);
						//strProdList = strProdList + o['net_dollar'] + String.fromCharCode(13) + String.fromCharCode(10);
						
					}
						strProdList = strProdListHeaderTop +  strProdListHeader + strProdList;
						//downloadFileRef.save(strProdList,"Volume_Prod_List.xls");
						
						var sendRequest:URLRequest = null;
						
						sendRequest=new URLRequest("/flex/csv_Report.cfm?fileName=Volume_Prod_List&ext=xls");
						
						sendRequest.method = URLRequestMethod.POST;
						
						/* Dev Note: (60384) - Remove these special characters while sending the Excel data to CF. 
						The issue was with the "&" character, but removed some other characters too, so that the 
						issue does not come up again for some other character.
						*/
						var excludeChars:RegExp = /[&:#?@%+\/]/g;
						strProdList= strProdList.replace(excludeChars,"");
						
						sendRequest.data = strProdList;
						
						//sendRequest.contentType = 'text/plain';
						flash.net.navigateToURL(sendRequest,'_blank');
			}
			
		]]>	
	
