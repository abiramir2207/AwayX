									oItem['pounds'] 	= iTmpPercentLBVal + ((iTmpPercentLBVal * iVolumeVal) / 100);
									oItem['cases']  	= iTmpPercentCSVal + ((iTmpPercentCSVal * iVolumeVal) / 100);
									
