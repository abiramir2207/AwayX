	 		/** 
	 		* Function to do the filtering of the Datagrid
	 		*/ 
	 		public function  volumeFilterFunc(item:Object):Boolean
	 		{
	 			var chkChecked:Boolean = false;
				var returnVal:Boolean = false;
	 			try 
				{
					var gpB:RadioButtonGroup 	= this.GroupB;
					var rdoSelectedVal:String = this.GroupB.selectedValue.toString();
			  		var chkControl:CheckBox 	= this.chkShowZeroVol;
					var searchBasedOn:String = this.GroupA.selectedValue.toString();
					
					var searchString:String = this.tiSearch.text.toLowerCase();
					
					//operator fields
					var operatorId:String = String(item["operator_id"]).toLowerCase();
					var operatorName:String = String(item["operator_name"]).toLowerCase();
					
					//distributor fields
					var name:String = String(item["name"]).toLowerCase();
					var shrShipTo:String = String(item["shr_ship_to"]).toLowerCase();
					
					//item fields
					var itemNum:String = String(item["item"]).toLowerCase();
					var description:String = String(item["description"]).toLowerCase();
				
					/* **********************************************************************
						At times the checkControl.selected throws an error saying that the 
						object has null reference, so this will be solved and the default
						value of false will be taken as the value of chkChecked 
					********************************************************************** */
					chkChecked = chkControl.selected;
				}	
				catch(err:Error){}
				
	 			if (rdoSelectedVal == null)
				{
			  		/* ********************************************************************** 
			  			If none of the value is selected then (remote possibility, very highly 
			  			unlikely) then set the values to the default value 
			  		********************************************************************** */
			  		this.GroupB.selectedValue = GroupBDefault;
			  		rdoSelectedVal = GroupBDefault;
				}
	 
	 			if (chkChecked)
	 			{
	 				// if checked then display +ve, -ve and 0 volume records
	 				if ((item.invoice_type == rdoSelectedVal) && ((parseInt(item.cases) >= 1) || (parseInt(item.cases) <= 0))) 
	 				{
						
						if(searchString != ""){
							if(searchBasedOn == 'Distributor'){
								if(name.search(searchString) != -1 || shrShipTo.search(searchString) != -1){
									returnVal = true;
								}
							}
							else if(searchBasedOn == 'Product'){
								if(itemNum.search(searchString) != -1 || description.search(searchString) != -1){
									returnVal = true;
								}
							}
							else if(searchBasedOn == 'Operator'){
								if(itemNum.search(searchString) != -1 || description.search(searchString) != -1 || operatorId.search(searchString) != -1 || operatorName.search(searchString) != -1){
									returnVal = true;
								}
							}
						}
						else{
							returnVal = true;
						}
	 					
	 				}
	 			}
	 			else
	 			{
	 				// if not checked then display +ve and -ve only leaving out the 0 volume records
	 				if ((item.invoice_type == rdoSelectedVal)  && (parseInt(item.cases) != 0)) //&& ((parseInt(item.cases) >= 1) || (parseInt(item.cases) < 0)) )
	 				{
						if(searchString != ""){
							if(searchBasedOn == 'Distributor'){
								if(name.search(searchString) != -1 || shrShipTo.search(searchString) != -1){
									returnVal = true;
								}
							}
							else if(searchBasedOn == 'Product'){
								if(itemNum.search(searchString) != -1 || description.search(searchString) != -1){
									returnVal = true;
								}
							}
							else if(searchBasedOn == 'Operator'){
								if(itemNum.search(searchString) != -1 || description.search(searchString) != -1 || operatorId.search(searchString) != -1 || operatorName.search(searchString) != -1){
									returnVal = true;
								}
							}
						}
						else{
							returnVal = true;
						}
	 				}
	 			}
	 			return returnVal;
	 		}
	 
