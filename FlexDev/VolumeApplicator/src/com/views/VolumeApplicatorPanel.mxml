	  		/** 
	  		* This function gets called when the user comes into the edit tab 
	  		*/ 
			public function toggleStateEdit(state:int):void
			{
				if(state == 0) // Click for Right Panel full screen
				{
					this.currentState = "fullRight";
				}	
				else if (state == 1)  // Click for the split screen with the control panel option
				{
					this.currentState = "";
					toggleState('fullAll');
				}
			}
	
			/**
			* This function gets called whenever the user changes the mode in the 
			* view to full screen and toggles back to the split mode screen
			*/   
			public function toggleState(state:String):void
			{
				if(state == "fullRight") // Click for Right Panel full screen
				{
					this.currentState 				= "fullRight";
					iconRight.visible 				= false;
					iconAllR.visible 					= true;
					iconRight.includeInLayout = false;
					iconAllR.includeInLayout 	= true;
				}
				else if(state == "fullAll") // Click for both Panels Shared Screen
				{
					this.currentState 				= "";
					iconAllR.visible 					= false;
					iconRight.visible 				= true;
					iconAllR.includeInLayout 	= false;
					iconRight.includeInLayout = true;
				}
			}
					
