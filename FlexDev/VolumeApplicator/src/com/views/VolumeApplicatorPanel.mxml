						iTotalVolAllocated += iVolumeVal;
					}
					// Pounds should be updated 2 stands for Pounds
					else if (volumeQtyUOMIDX == '2'){
						// pounds cannot be 0 hence allocate the minimum value
						if ((iVolumeVal == 0) && (netWeightVal < 1)){
							iVolumeVal = 1;
						}
						oItem['Opportunity_Volume_LB'] = iVolumeVal;
						oItem['Opportunity_Volume_CS']  =  Math.round((iVolumeVal / netWeightVal));
						if (oItem['Opportunity_Volume_CS'] == 0){
							oItem['Opportunity_Volume_CS'] 	= 1;
							oItem['Opportunity_Volume_LB'] = Math.round(netWeightVal);
						}
						iTotalVolAllocated += oItem['Opportunity_Volume_CS'];
					}
				}
				/* 
				Logic to allocate the extra volume to the item if volume entered 
				by the user is greater than what has been allocated, only then 
				run the loop and start allocating 1 unit to each item till 
				the user entered volume is reached. 
				
				*/ 
				if (iTotalVolAllocated < iTxtAllocateVal){
					for each(var oItem2:Object in dgEd.dataProvider.source){
						if (iTotalVolAllocated >= iTxtAllocateVal){
							break;
						}
						netWeightVal = removeCommas(oItem2['net_weight']);
						// cases should be updated 1 stands for Case
						if (volumeQtyUOMIDX == '1'){
							oItem2['Opportunity_Volume_CS']  = oItem2['Opportunity_Volume_CS'] + 1;
							oItem2['Opportunity_Volume_LB'] =  Math.round(oItem2['Opportunity_Volume_CS'] * netWeightVal);
							iTotalVolAllocated++;
						}
							// Pounds should be updated 2 stands for Pounds
						else if (volumeQtyUOMIDX == '2'){
							oItem2['Opportunity_Volume_LB'] = oItem2['Opportunity_Volume_LB'] + 1 ;
							oItem2['Opportunity_Volume_CS']  =  Math.round((oItem2['Opportunity_Volume_LB'] / netWeightVal));
							iTotalVolAllocated++;
						}
					}
				}
				vScroll = this.dgEd.verticalScrollPosition;
				storeItemForUpdate = this.dgEd.selectedItem;;
				this.dgEd.dataProvider.refresh();
				this.dgEd.verticalScrollPosition = vScroll;
				this.dgEd.selectedItem = storeItemForUpdate;
				fnDoEdTotal();
				this.applyAction.selectedIndex = 0;
			}
			
			public function fnCheckSelected():Boolean{
				
				var bIsRowSelected:Boolean = false;
				
				for each(var iItem:Object in dgEd.dataProvider.source){
					if(iItem['isSelected'] == true){
						bIsRowSelected = true;
						break;
					}
				}
				return bIsRowSelected;
			}
			
			public function fnApplyToSelectedItems(applyChoice:String):void
