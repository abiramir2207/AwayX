				}// ENDS if(applyChoice == '1')
				// User selected the button: Apply To All Items
				else if (applyChoice == '2'){
					for each(var osItem:Object in dgEd.dataProvider.source){
						netWeightVal = removeCommas(osItem['net_weight']);
						// cases should be updated 1 stands for Case
