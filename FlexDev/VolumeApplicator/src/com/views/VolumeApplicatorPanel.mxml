			/**
			* This function gets called whenever the user changes a Group A option
			* in the control panel on the left 		
			*/ 
			public function ShowHideColumns():void 
			{
				var gpA:RadioButtonGroup = GroupA;
		   		var gpB:RadioButtonGroup = GroupB;
		   		var eventVol:VolumeApplicatorEvent = new VolumeApplicatorEvent(VolumeApplicatorEvent.GET_VOLUME_DETAILS);
		   		var eventFilterResults:VolumeApplicatorEvent = new VolumeApplicatorEvent(VolumeApplicatorEvent.FILTER_RESULTS);
				/* ********************************************************************** 
					Reset all the columns ie. set the columns to false so that we can 
					again set what needs to be displayed in this function.
				********************************************************************** */
		    	ResetFilters();
	
				/* **********************************************************************
					 Reset the GroupB radio button and the zero volume check box to 
					 the Default values before we grab the new set of data to be 
					 loaded in the Data Grid.
					 
					 If we need to reset the values back to default, it has to be 
					 done here but commented for now as it is not needed.
				********************************************************************** */ 
		   		/* check what is the selectedValue and set the visible columns accordingly */
		   	
		   		ItemNo.visible 			= true;
				ItemDesc.visible 		= true;
	 			ItemNoTot.visible 	= true;
				ItemDescTot.visible = true;  
				
				/* **********************************************************************
					Check for the selected Group A option and based on that we change the 
					columns that gets displayed to the user.			  
				********************************************************************** */	
		   		try
				{
					if (gpA.selectedValue == "Operator" || gpA.selection.id == "rdoOperator")
					{
						OpNo.visible 				= true;
						OpName.visible 			= true;
						CustNo.visible 			= false;
						CustName.visible 		= false;
		 				OpNoTot.visible 		= true;
						OpNameTot.visible 	= true;
						CustNoTot.visible 	= false;
						CustNameTot.visible = false;  
						eventVol.appGroupA 	= "OPERATOR";
	  	 			}
					else if(gpA.selectedValue == "Customer" || gpA.selection.id == "rdoCus") 
		   			{
						if (bOprShowSetting == 'true')
		   				{
		   					DistNotOnProgram.visible 		= true;
		   					DistNotOnProgramTot.visible = true;
		   				}
						CustNo.visible							= true;
						CustName.visible						=	true;
						OpNo.visible 								= false;
						OpName.visible 							= false;
						CustNoTot.visible 					= true;
		   				CustNameTot.visible					= true;
		   				OpNoTot.visible 						= false;
		   				OpNameTot.visible 					= false;
						ItemNo.visible 							= false;
						ItemDesc.visible 						= false;
						ItemNoTot.visible 					= false;
						ItemDescTot.visible 				= false;
						eventVol.appGroupA 					= "CUSTOMER";
					}
					else if(gpA.selectedValue == "Item" ||  gpA.selection.id == "rdoItem")
					{
						CustNo.visible			= false;
						CustName.visible		=	false;
						OpNo.visible 				= false;
						OpName.visible 			= false;
						CustNoTot.visible		= false;
						CustNameTot.visible	=	false;
						OpNoTot.visible 		= false;
						OpNameTot.visible 	= false;
	 					eventVol.appGroupA 	= "ITEM";
					}
			  		eventVol.appPrgMode 	= "VIEW"
			  		eventVol.appProgramID = this.prgProgramID;
					this.dispatchEvent(eventVol); 
					fnDoTotal();
				}
				catch(err:Error){}
			} 
	 
