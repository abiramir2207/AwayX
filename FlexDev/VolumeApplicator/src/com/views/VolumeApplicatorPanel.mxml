			/** 
	 		* This function removes the commas from the string and return it as a number 
			*/
			public function removeCommas(commaNum:String):Number 
			{
				var newString:String = new String();
				for (var k:int = 0; k<commaNum.length; k++)
				{
					if (commaNum.charAt(k) != ",") 
					{
						newString += commaNum.charAt(k);
					}
				}
				var numValue:Number = new Number(newString);
				return numValue;
			}
	
	 		/**
	 		* This function is called everytime an edit is made to a Pounds or the
			* Cases value and the user presses &lt;Enter&gt; key or clicks outside the
			* edited cell. This function updates Pounds or the Cases value and
			* the Net Dollar and also calls the function to update the Grand total
			* grid as a result of the data change in the Pounds, Cases and
			* Net Dollar cells.
			*/
			public function fnComputeCSLB(evt:AdvancedDataGridEvent):void  
			{
				var colName:String = dgEd.columns[evt.columnIndex].dataField;
				
				// Alert.show(colName);
	             
				// The String sent to the clipboard
	      		var dataString:String 		= "";
	      		var netWeightVal:Number 	= 0;
		   		var casesVal:Number 		= 0;
				var poundsVal:Number 		= 0;
				var oppCasesVal:Number 		= 0;
				var oppPoundsVal:Number 	= 0;
				var basePrice:Number 		= 0;
				var bCalculatedVal:Number	= 0;		
				var data:Object 			= evt.currentTarget.dataProvider[evt.rowIndex];
				
	 			/* 
	 				Dev Notes: D22634/Anand Rao/10-May-10
	 				Bagcraft - Volume applicator deselects items randomly
	 				The datagrid was refreshing while clicking on the checkboxes and hence 
	 				we need to do the below calculation only if the datafield the user
	 				clicked was either 'cases' or 'pounds'
	 			*/
				if (colName == 'cases' || colName=='pounds')
		 		{
		 			try
		 			{
						casesVal		= Math.round(removeCommas(data['cases']));
					  	netWeightVal 	= removeCommas(data['net_weight']);
					  	poundsVal 	 	= Math.round(removeCommas(data['pounds']));
					  	basePrice 	 	= removeCommas(data['base_price_cs']);
				  
						/* ********************************************************************** 	
							if either case of pounds is entered as 0 then set the case value as
							1 and calculate the pounds and net_dollar accordingly
						********************************************************************** */
				  		if (casesVal == 0 || poundsVal == 0)
				  		{
				  			casesVal 	= 1; 
				  			poundsVal 	= Math.round(casesVal * netWeightVal);
				  		} 
				  
				  		// 22416/Anand Rao/17-Feb-10
				  		/* 
				  		If the Pounds value is 0 and the netweight is less than 1 then make pounds to be 1
				  		pounds cannot be 0 as it is causing a divide by 0 error in some places.
				  		*/
				  		  
						if ((poundsVal == 0) && (netWeightVal < 1))
				  		{
				  			poundsVal = 1;
				  			casesVal = poundsVal / netWeightVal;
				  		}	 
				  		  
						if (colName == "cases")
						{
							data['pounds'] =  Math.round(casesVal * netWeightVal); //  casesVal * netWeightVal 
							data['cases'] = casesVal;
							/*
								If the pounds value happens to be zero and the net weight value is less than 1
								then make the pounds value to be 1.
							*/
							if ((data['pounds']== 0) && (netWeightVal < 1))
							{
								data['pounds'] = 1;
								data['cases'] = Math.round(poundsVal / netWeightVal);
							}
							// if netweight is less than 1 then cases will be pounds divided by the net weight
							if (netWeightVal < 1)
							{
								data['cases'] = Math.round(data['pounds'] / netWeightVal);
							}
						} 
						else if (colName == "pounds")
						{
							data['cases'] =  Math.round(poundsVal / netWeightVal); // poundsVal / netWeightVal
							data['pounds'] = poundsVal;
							// if the data['cases'] after calculation turned out to be 0 then change it to 1 
							// this happens when pounds is edited and the cases changes to 0
							if (data['cases']== 0)
							{
								data['cases'] = 1;
								data['pounds'] = Math.round(netWeightVal);
							}
							// if net_weight = 15 user types in 28 in the lbs column case value will become 2 and in the case we want to set pound value = 30 
							if (netWeightVal > 1)
							{
								data['pounds'] = Math.round(data['cases'] * netWeightVal);
							}
						}
				 		casesVal		 = removeCommas(data['cases']);
						data['net_dollar'] = casesVal * basePrice;
						/*
						Dev Notes: D22634/Anand Rao/10-May-10
	 					Bagcraft - Volume applicator deselects items randomly
						When the user tried to select more than a few rows and entered a value
						in the text box for allocating, the datagrid was scrolling to the 
						selected row. This code block is put in place to avoid that. 
						*/
						vScroll = dgEd.verticalScrollPosition;
						storeItemForUpdate = dgEd.selectedItem;;
						dgEd.dataProvider.refresh();
						dgEd.verticalScrollPosition = vScroll;
			 			dgEd.selectedItem = storeItemForUpdate;
			 			fnDoEdTotal();
			 		}
			 		catch(err:Error)
			 		{}   
			 	}
			 	/* handle for Opportunity Volume */
			 	else if (colName == 'Opportunity_Volume_CS' || colName=='Opportunity_Volume_LB')
		 		{
		 			try
		 			{
						oppCasesVal		= Math.round(removeCommas(data['Opportunity_Volume_CS']));
					  	netWeightVal 	= removeCommas(data['net_weight']);
					  	oppPoundsVal 	= Math.round(removeCommas(data['Opportunity_Volume_LB']));
					  	basePrice 	 	= removeCommas(data['base_price_cs']);
				  
						/* ********************************************************************** 	
							if either case of pounds is entered as 0 then set the case value as
							1 and calculate the pounds and net_dollar accordingly
						********************************************************************** */
				  		if (oppCasesVal == 0 && oppPoundsVal == 0)
				  		{
				  			oppCasesVal 	= 1; 
				  			oppPoundsVal 	= Math.round(oppCasesVal * netWeightVal);
				  		}
						
						/* ***********************************************************************
							at this point we know that we have either opportunity case volume or
							opportunity pound volume so if opportunity case volume is 0 then convert
							it or if opportunity pound volume is 0 then convert it
						 *********************************************************************** */
						if (oppCasesVal == 0)
						{
							oppCasesVal = oppPoundsVal / netWeightVal;
						}
						else if (oppPoundsVal == 0)
						{
							oppPoundsVal 	= Math.round(oppCasesVal * netWeightVal);
						}
				  
				  		// 22416/Anand Rao/17-Feb-10
				  		/* 
				  		If the Pounds value is 0 and the netweight is less than 1 then make pounds to be 1
				  		pounds cannot be 0 as it is causing a divide by 0 error in some places.
				  		*/
				  		  
						if ((oppPoundsVal == 0) && (netWeightVal < 1))
				  		{
				  			oppPoundsVal = 1;
				  			oppCasesVal = oppPoundsVal / netWeightVal;
				  		}	 
				  		  
						if (colName == "Opportunity_Volume_CS")
						{
							data['Opportunity_Volume_LB'] =  Math.round(oppCasesVal * netWeightVal); //  casesVal * netWeightVal 
							data['Opportunity_Volume_CS'] = oppCasesVal;
							/*
								If the pounds value happens to be zero and the net weight value is less than 1
								then make the pounds value to be 1.
							*/
							if ((data['Opportunity_Volume_LB']== 0) && (netWeightVal < 1))
							{
								data['Opportunity_Volume_LB'] = 1;
								data['Opportunity_Volume_CS'] = Math.round(oppPoundsVal / netWeightVal);
							}
							// if netweight is less than 1 then cases will be pounds divided by the net weight
							if (netWeightVal < 1)
							{
								data['Opportunity_Volume_CS'] = Math.round(data['Opportunity_Volume_LB'] / netWeightVal);
							}
						} 
						else if (colName == "Opportunity_Volume_LB")
						{
							data['Opportunity_Volume_CS'] =  Math.round(oppPoundsVal / netWeightVal); // poundsVal / netWeightVal
							data['Opportunity_Volume_LB'] = oppPoundsVal;
							// if the data['cases'] after calculation turned out to be 0 then change it to 1 
							// this happens when pounds is edited and the cases changes to 0
							if (data['Opportunity_Volume_CS']== 0)
							{
								data['Opportunity_Volume_CS'] = 1;
								data['Opportunity_Volume_LB'] = Math.round(netWeightVal);
							}
							// if net_weight = 15 user types in 28 in the lbs column case value will become 2 and in the case we want to set pound value = 30 
							if (netWeightVal > 1)
							{
								data['Opportunity_Volume_LB'] = Math.round(data['Opportunity_Volume_CS'] * netWeightVal);
							}
						}
				 		oppCasesVal		 	= removeCommas(data['Opportunity_Volume_CS']);
						data['net_dollar'] 	= oppCasesVal * basePrice;
						/*
						Dev Notes: D22634/Anand Rao/10-May-10
	 					Bagcraft - Volume applicator deselects items randomly
						When the user tried to select more than a few rows and entered a value
						in the text box for allocating, the datagrid was scrolling to the 
						selected row. This code block is put in place to avoid that. 
						*/
						vScroll = dgEd.verticalScrollPosition;
						storeItemForUpdate = dgEd.selectedItem;;
						dgEd.dataProvider.refresh();
						dgEd.verticalScrollPosition = vScroll;
			 			dgEd.selectedItem = storeItemForUpdate;
			 			fnDoEdTotal();
			 		}
			 		catch(err:Error)
			 		{}   
			 	}
			}
			
			/**
			* This function evenly allocates the value entered in the text box for all
			* rows that has been selected and also update the Grand Total grid
			* after the data is assigned to the master Grid. If the value after
			* dividing has decimal in it then they are rounded off.
			*/
			public function fnEvenlyAllocate():void
			{
				var txtAllocateVal:String		= this.txtAllocate.text;
				var iTxtAllocateVal:Number 		= 0; 
				var iSelectedRows:int 			= 0;	
				var iVolumeVal:Number 			= 0;
			 	var dataString:String 			= "";
		    	var netWeightVal:Number 		= 0;
			  	var casesVal:Number 			= 0;
				var poundsVal:Number 			= 0;
				var basePrice:Number 			= 0;
				var iTotalVolAccounted:Number 	= 0;
				var iUnaccountedVol:Number 		= 0;
				var iTotalVolAllocated:Number 	= 0;
				var iTotalVolBalance:Number 	= 0;
				var iTmpPercentCSVal:Number 	= 0;
				var iTmpPercentLBVal:Number 	= 0;
			 
			 	if (StringUtil.trim(txtAllocateVal) == ""){
			 		txtAllocateVal = "0";
			 	}
			 	iTxtAllocateVal = removeCommas(txtAllocateVal);
				for each(var iItem:Object in dgEd.dataProvider.source){
					iSelectedRows = iSelectedRows + 1; 
				}
				// Added this if condition for D21996/Anand Rao/12-Jan-10
				if (iSelectedRows >= removeCommas(txtAllocateVal)){
					iVolumeVal =  Math.round(removeCommas(txtAllocateVal) / iSelectedRows);
				}
				else{
					iVolumeVal = Math.floor(removeCommas(txtAllocateVal) / iSelectedRows);
				}
					
				for each(var oItem:Object in dgEd.dataProvider.source){
					netWeightVal = removeCommas(oItem['net_weight']);
					// cases should be updated 1 stands for Case
					if (volumeQtyUOMIDX == '1'){
						// we do not allow 0 cases so if rounding is lessthan or equal to 0 then it is considered 1 case 
						if (iVolumeVal == 0){
							iVolumeVal = 1;
						} 
						oItem['cases']  = iVolumeVal;
					 	oItem['pounds'] =  Math.round(iVolumeVal * netWeightVal);
						// Make sure if the pounds value is 0 we make it 1 and calculate the cases accordingly
					 	if ((oItem['pounds'] == 0) && (netWeightVal < 1)){
					 		oItem['pounds'] = 1;
					 		oItem['cases'] 	= Math.round(oItem['pounds']/netWeightVal);
					 	}
					 	iTotalVolAllocated += iVolumeVal;
					}
					// Pounds should be updated 2 stands for Pounds
					else if (volumeQtyUOMIDX == '2'){
						// pounds cannot be 0 hence allocate the minimum value
						if ((iVolumeVal == 0) && (netWeightVal < 1)){
							iVolumeVal = 1;
						}
						oItem['pounds'] = iVolumeVal;
						oItem['cases']  =  Math.round((iVolumeVal / netWeightVal));
						if (oItem['cases'] == 0){
							oItem['cases'] 	= 1;
						 	oItem['pounds'] = Math.round(netWeightVal);
						 }
						iTotalVolAllocated += oItem['pounds'];
					}
					basePrice = removeCommas(oItem['base_price_cs']);
					casesVal = oItem['cases'];
					oItem['net_dollar'] = casesVal * basePrice;
				}
				/* 
					Logic to allocate the extra volume to the item if volume entered 
					by the user is greater than what has been allocated, only then 
					run the loop and start allocating 1 unit to each item till 
					the user entered volume is reached. 
					
				*/ 
				if (iTotalVolAllocated < iTxtAllocateVal){
					for each(var oItem2:Object in dgEd.dataProvider.source){
					  	if (iTotalVolAllocated >= iTxtAllocateVal){
							break;
						}
					  	netWeightVal = removeCommas(oItem2['net_weight']);
						// cases should be updated 1 stands for Case
					  	if (volumeQtyUOMIDX == '1'){
							oItem2['cases']  = oItem2['cases'] + 1;
						 	oItem2['pounds'] =  Math.round(oItem2['cases'] * netWeightVal);
						 	iTotalVolAllocated++;
						}
						// Pounds should be updated 2 stands for Pounds
						else if (volumeQtyUOMIDX == '2'){
							oItem2['pounds'] = oItem2['pounds'] + 1 ;
						 	oItem2['cases']  =  Math.round((oItem2['pounds'] / netWeightVal));
						 	iTotalVolAllocated++;
						 }
						basePrice				= removeCommas(oItem2['base_price_cs']);
						casesVal 				= oItem2['cases'];
						oItem2['net_dollar']	= casesVal * basePrice;
					}
				}
				vScroll = this.dgEd.verticalScrollPosition;
				storeItemForUpdate = this.dgEd.selectedItem;;
				this.dgEd.dataProvider.refresh();
				this.dgEd.verticalScrollPosition = vScroll;
				this.dgEd.selectedItem = storeItemForUpdate;
				fnDoEdTotal();
				this.applyAction.selectedIndex = 0;
			}
	
