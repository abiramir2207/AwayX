			/**
	 		* This function is called from fnShowHelp when the user clicks on the Help.
	 		* It creates a popup window and displays it.
	 		* 
	 		* @see #fnShowHelp()
	 		* @see #closePopUp()   	 
	 		*/
			public function fnCreateHelpPopup():void
			{
			 	var vb:VBox 			= new VBox();
			 	var txtHelp:TextArea  	= new TextArea();
			  	var cbHelp:ControlBar 	= new ControlBar();
				var spcHelp:Spacer 		= new Spacer();
				var btnClose:Button 	= new Button();
				spcHelp.percentWidth 	= 100;
				/* **********************************************************************
					If the Help text is not set, display a default message to the User 
				********************************************************************** */
				if (strPanVolumeHelpText == "")
				{
					strPanVolumeHelpText = "<b>Volume Applicator Help:<br><br><font color='#FF3333'><p>Volume Help " + 
																 "text needs to be set in the Settings Panel. Contact your System " + 
																 "Administrator.</p></font></b> ";
				}
				txtHelp.htmlText		 	= strPanVolumeHelpText.toString();
			  	txtHelp.wordWrap 			= true;
				btnClose.label 				= "Close";
				btnClose.addEventListener(MouseEvent.CLICK, closePopUp);
				cbHelp.addChild(spcHelp);
				cbHelp.addChild(btnClose);
				vb.setStyle("paddingBottom", 5);
				vb.setStyle("paddingLeft", 5);
				vb.setStyle("paddingRight", 5);
				vb.setStyle("paddingTop", 5);
				vb.addChild(txtHelp);
				panHelp 			 = new Panel();
				panHelp.title  = "Volume Applicator Help";
				panHelp.width  = 400;
				panHelp.height = 450;
				txtHelp.width	 = panHelp.width - 20;
				txtHelp.height = panHelp.height - 95;
				panHelp.horizontalScrollPolicy = "Off";
				panHelp.verticalScrollPolicy = "Off";
				panHelp.addChild(vb);
				panHelp.addChild(cbHelp);
			}
			
			/** 
			* This function is called when the User clicks on the Help image or text
			* 
			* @see #fnCreateHelpPopup() 
			* @see #closePopUp()  
			*/
			public function fnShowHelp(evt:MouseEvent):void
			{
				fnCreateHelpPopup();
				PopUpManager.addPopUp(panHelp, this, true);
	      		PopUpManager.centerPopUp(panHelp);
			}
	
			/**
			 * This function is called when the User clicks on the Help Close button 
			 * 
			 * @see #fnCreateHelpPopup()  		 
			 * @see #fnShowHelp()
			 
			 */
			
			public function closePopUp(evt:MouseEvent):void 
			{
	    		PopUpManager.removePopUp(panHelp);
			}
			
			protected function cbGroupProductGroupBy_changeHandler(evt:ListEvent):void
			{
			
				var eventProductGroupType:VolumeApplicatorEvent = new VolumeApplicatorEvent(VolumeApplicatorEvent.GET_VOLUME_EDIT);
				this.nProductGroupLevelEventId = ComboBox(evt.target).selectedItem.Product_Group_Level_ID;
				eventProductGroupType.appEditMode = "EDIT"; 
				eventProductGroupType.appProgramID = this.prgProgramID;
