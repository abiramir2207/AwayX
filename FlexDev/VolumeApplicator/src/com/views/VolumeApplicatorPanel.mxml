				if(applyChoice == '1'){
			
					if (!fnCheckSelected()){
						Alert.show("Check one or more rows for applying volume.","BSA Help Alert!");
					}
					else{
						for each(var oItem:Object in dgEd.dataProvider.source){
							if(oItem['isSelected'] == true){
								netWeightVal = removeCommas(oItem['net_weight']);
								// cases should be updated 1 stands for Case
