							// we do not allow 0 cases so if rounding is lessthan or equal to 0 then it is considered 1 case 
							if (iVolumeVal == 0){
								iVolumeVal = 1;
							} 
							osItem['cases']  = iVolumeVal;
						 	osItem['pounds'] =  Math.round(iVolumeVal * netWeightVal);
							// Make sure if the pounds value is 0 we make it 1 and calculate the cases accordingly
						 	if ((osItem['pounds'] == 0) && (netWeightVal < 1)){
						 		osItem['pounds'] = 1;
						 		osItem['cases'] = Math.round(osItem['pounds']/netWeightVal);
						 	}
						 	iTotalVolAllocated += iVolumeVal;
						}
						// Pounds should be updated 2 stands for Pounds
						else if (volumeQtyUOMIDX == '2'){
							// pounds cannot be 0 hence allocate the minimum value
							if ((iVolumeVal == 0) && (netWeightVal < 1)){
								iVolumeVal = 1;
							}
							osItem['pounds'] = iVolumeVal;
						 	osItem['cases']  =  Math.round((iVolumeVal / netWeightVal));
						 	if (osItem['cases'] == 0){
						 		osItem['cases'] = 1;
						 		osItem['pounds'] = Math.round(netWeightVal);
						 	}
						 	iTotalVolAllocated += osItem['pounds'];
						}
						// Apply percent
						else{
							// for percent the value can't be 0 and we have to have a net weight
							if ((iVolumeVal == 0) && (netWeightVal < 1)){
								iVolumeVal = 1;
							}
							iTmpPercentLBVal = osItem['pounds'];
							iTmpPercentCSVal = osItem['cases'];
							osItem['pounds'] = (iTmpPercentLBVal + ((iTmpPercentLBVal * iVolumeVal) / 100));
							osItem['cases']  = (iTmpPercentCSVal + ((iTmpPercentCSVal * iVolumeVal) / 100));
							
							iTotalVolAllocated += (iTotalVolAllocated * iVolumeVal) / 100;
						}
						basePrice 	 			= removeCommas(osItem['base_price_cs']);
						casesVal 				= osItem['cases'];
						osItem['net_dollar']	= casesVal * basePrice;
					} // ENDS for each(var oItem:Object in dgEd.dataProvider.source)

					vScroll = this.dgEd.verticalScrollPosition;
					storeItemForUpdate = this.dgEd.selectedItem;;
					this.dgEd.dataProvider.refresh();
					this.dgEd.verticalScrollPosition = vScroll;
					this.dgEd.selectedItem = storeItemForUpdate;
					fnDoEdTotal(); 
