<?xml version="1.0" encoding="utf-8"?>
<!--- Holds all event handlers registered with Mate : SearchEvent and native : FlexEvent -->
<LocalEventMap 
	xmlns:mx="http://www.adobe.com/2006/mxml"
	xmlns="http://mate.asfusion.com/" xmlns:mate="http://mate.asfusion.com/">
	<mx:Script>
		<![CDATA[
			import com.ContractProds.events.*;
			import com.ContractProds.models.*;
			import com.ContractProds.views.pm.*;
			import com.asfusion.mate.core.*;
			import com.asfusion.mate.events.UnhandledFaultEvent;
			import com.shared.models.SettingsManager;
			import com.shared.vos.Settings;
			import com.shared.vos.Component;
			import com.shared.vos.ProdRate;
			import com.shared.events.MainEvent;
			import mx.events.*;
			import com.shared.views.MainPanel;
			//import com.ContractProds.vos.*;
			[Bindable]
			private var source:String = 'mvc.models.Program.Component.ComponentManager';
		]]>
	</mx:Script>
 	<mate:Debugger level="{Debugger.ERROR}" />
	<!-- load up an instance of the remote objects -->
	<!-- Remote Services  ....................................................... -->
	<!--- Search functionality including initial dataload <p>roSearchService : <strong>mvc.models.Item.ItemSearchService</strong></p> -->
	<mx:RemoteObject id="roSearchService" destination="ColdFusion" source="mvc.models.Item.ItemSearchService_Groups" />
	<mx:RemoteObject id="roContractProd" destination="ColdFusion" source="mvc.models.ContractProd.ContractProd" />
	<mx:RemoteObject id="roComponentDef" destination="ColdFusion" source="mvc.models.Program.Component.ComponentDefManager" />
	<mx:RemoteObject id="roComponent" destination="ColdFusion" source="mvc.models.Program.Component.ComponentManager" />
	<mx:RemoteObject id="roProgram" destination="ColdFusion" source="mvc.models.Program.ProgramManager" />
	<!--- roErrorService : <strong>mvc.models.ErrorService</strong> -->
	<mx:RemoteObject id="roErrorService" destination="ColdFusion" source="mvc.models.ErrorService" />
	<!--- Handles User List (Favorites) Logic <p>roItemListService : <strong>mvc.models.Item.ItemList</strong></p> -->
	<mx:RemoteObject id="roItemListService" destination="ColdFusion" source="mvc.models.Item.ItemList" />

	<!-- FlexEvent.PREINITIALIZE ....................................................... -->
	<!---@see com.ContractProds.models.SettingsManager#loadURLParameters()
			Invoke : com.ContractProds.models.SettingsManager.loadURLParameters()-->
	<EventHandlers type="{FlexEvent.PREINITIALIZE}" id="ePREINITIALIZE" debug="true">
		<ObjectBuilder generator="{SettingsManager}" cache="global" />
		<ObjectBuilder generator="{FilterManager}" id="oFilterManager" constructorArguments="{scope.dispatcher}" />
		<ObjectBuilder generator="{ComponentManager}" id="oComponentManager" constructorArguments="{scope.dispatcher}" />
		<ObjectBuilder generator="{SearchManager}" id="oSearchManager" constructorArguments="{scope.dispatcher}" />
		<ObjectBuilder generator="{GridManager}" id="oGridManager" constructorArguments="{scope.dispatcher}" />
		<ObjectBuilder generator="{ComponentDefManager}" id="oComponentDefManager" constructorArguments="{scope.dispatcher}" />
		<ObjectBuilder generator="{FilterPM}" id="oFilterPM" constructorArguments="{scope.dispatcher}" />
		<ObjectBuilder generator="{ListManager}" id="oListManager" constructorArguments="{scope.dispatcher}" />
		<ObjectBuilder generator="{ComponentPM}" id="oComponentPM" constructorArguments="{scope.dispatcher}" registerTarget="true"  />
		<ObjectBuilder generator="{ProdUploadPM}" id="oProdUploadPM" constructorArguments="{scope.dispatcher}" registerTarget="true" />
		<ObjectBuilder generator="{FavoritePM}" id="oFavoritePM" constructorArguments="{scope.dispatcher}" />
		<ObjectBuilder generator="{GridDataPM}" id="oGridDataPM" constructorArguments="{scope.dispatcher}" />
		<ObjectBuilder generator="{BAError}" id="oBAError" />
		<!--<MethodInvoker generator="{SettingsManager}" method="loadParameters" />	-->
		<!--<MethodInvoker generator="{SettingsManager}" method="loadURLParameters" cache="global" />-->
		<!--call db for other settings-->
		<!--<EventAnnouncer type="{SearchEvent.LOAD_APP_SETTINGS}" generator="{SearchEvent}" >
			<Property source="{SettingsManager}" sourceKey="settings.userId" targetKey="userId"/>
		</EventAnnouncer>-->
		
	</EventHandlers>
	
	<!-- FlexEvent.APPLICATION_COMPLETE ....................................................... -->
	<EventHandlers type="{FlexEvent.CREATION_COMPLETE}">
		<!--load flash Vars ()-->
		<!--for sharedObjects test: <MethodInvoker generator="{SearchManager}" method="loadResults" />-->
		<!--Get 180 day table items -->
		<!--
		<EventAnnouncer type="{SearchEvent.GET_MINI_ITEMS}" generator="{SearchEvent}" >
			<Property sourceCache="inherit" source="{SettingsManager}" sourceKey="settings.programId" targetKey="programId"/>
		</EventAnnouncer>
		-->
		<!--Get Items -->
		<!--<EventAnnouncer type="{SearchEvent.GET}" generator="{SearchEvent}" >
			<Property source="{SettingsManager}" sourceKey="settings.programId" sourceCache="global" targetKey="programId"/>
			<Property source="{SettingsManager}" sourceKey="settings.discountType" sourceCache="global" targetKey="discountType"/>
			<Property source="{SettingsManager}" sourceKey="settings.statusFilterOn" sourceCache="global" targetKey="statusFilterOn"/>
		</EventAnnouncer>-->
		
		<EventAnnouncer type="{SearchEvent.LOAD_SO}" generator="{SearchEvent}" />
		<!--Populate the Saved Lists -->
		<!--<EventAnnouncer type="{SearchEvent.GET_USERLIST}" generator="{SearchEvent}" >
			<Property source="{SettingsManager}" sourceKey="settings.userId" sourceCache="global" targetKey="userId"/>
		</EventAnnouncer>-->
		<!--Get discount types on a program template -->
		<EventAnnouncer type="{SearchEvent.GET_DISC_TYPES_ON_PRG_TEMPLATE}" generator="{SearchEvent}" >
			<Property source="{SettingsManager}" sourceKey="settings.programId" sourceCache="global" targetKey="programId"/>
		</EventAnnouncer>
		<!--Get Component Defs -->
		<!--<EventAnnouncer type="{ComponentEvent.GET_COMPONENT_DEFS}" generator="{ComponentEvent}" >
			<Property source="{SettingsManager}" sourceKey="settings.programId" sourceCache="global" targetKey="programId"/>
			<Property source="{SettingsManager}" sourceKey="settings.bMarketPrice" sourceCache="global" targetKey="bMarketPrice"/>
		</EventAnnouncer>-->
	</EventHandlers>
	
	 <!--SAVE SETTINGS .......................................................-->
	 <!---@see com.ContractProds.models.SettingsManager#SaveSettings()
			Invoke : com.ContractProds.models.SettingsManager.SaveSettings()-->
	<EventHandlers type="{SearchEvent.SAVE_SETTINGS}" id="eSAVE_SETTINGS">
        <!--Store passed in values (flashvars)-->
		<MethodInvoker 	generator="{SettingsManager}" method="SaveSettings" 
						arguments="{event.settings}" />
    </EventHandlers>
    
	<!--GET ITEMS .......................................................-->
    <!---			@see #roSearchService
	    ** RemoteInvoke : roSearchService.getItems()
	    		@see com.ContractProds.models.SearchManager#itemResults() 
	    ** Handler : com.ContractProds.models.SearchManager.itemResults()   
		**		ProgramId , DiscountType_Id, StatusFilter, bAll (1 NO FILTER: GET ALL prods then cache them in so), bMP (Market Price?), TemplateFilterId -->
	<EventHandlers type="{SearchEvent.GET}" id="eGET">
		<RemoteObjectInvoker instance="{roSearchService}" showBusyCursor="true" method="getCompItems" arguments="{[event.programId,event.discountType,event.statusFilterOn,1,event.bMarketPrice,event.templateFilterId,event.customPrint]}">
			<!-- result sequence gets executed when service returns with a result -->
			<resultHandlers>
				<MethodInvoker generator="{SearchManager}" method="itemResults" arguments="{resultObject}" />
				<!--Get Components....don't go until we have items 
				<EventAnnouncer type="{ComponentEvent.LOAD_PROGRAM}" generator="{ComponentEvent}" >
					<Property source="{SettingsManager}" sourceKey="settings.programId" sourceCache="global" targetKey="programId"/>
				</EventAnnouncer>-->
			</resultHandlers>
			<!-- server fault -->
			<faultHandlers>
				<!--announce error event -->
				<EventAnnouncer type="{SearchEvent.BSA_ERROR}" generator="{SearchEvent}" >
					<Properties sBaError="ITEM SEARCH SERVICE (get items)" />
					<Properties oBaError="{fault}" />
				</EventAnnouncer>
			</faultHandlers>
		</RemoteObjectInvoker>
	</EventHandlers>
	
	<!--GET ITEMS ....................................................... ProgramId , DiscountType_Id, StatusFilter, bAll (0 means use templateFilter), bMP (Market Price?), TemplateFilterId-->
	<EventHandlers type="{SearchEvent.GET_PROGRAM_PRODUCTS}" id="eGET_PROGRAM_PRODUCTS" debug="true">
		<RemoteObjectInvoker instance="{roSearchService}" showBusyCursor="true" method="getCompItems" arguments="{[event.programId,event.discountType,event.statusFilterOn,0,event.bMarketPrice,event.templateFilterId,event.customPrint,event.aItems]}">
			<!-- result sequence gets executed when service returns with a result -->
			<resultHandlers>
				<MethodInvoker generator="{SearchManager}" method="validateProgramProducts" arguments="{resultObject}" />
				<!--Get Components....don't go until we have items -->
				<!--<EventAnnouncer type="{ComponentEvent.LOAD_PROGRAM}" generator="{ComponentEvent}" >
					<Property source="{SettingsManager}" sourceKey="settings.programId" sourceCache="global" targetKey="programId"/>
				</EventAnnouncer>-->
			</resultHandlers>
			<!-- server fault -->
			<faultHandlers>
				<!--announce error event -->
				<EventAnnouncer type="{SearchEvent.BSA_ERROR}" generator="{SearchEvent}" >
					<Properties sBaError="ITEM SEARCH SERVICE (get items)" />
					<Properties oBaError="{fault}" />
				</EventAnnouncer>
			</faultHandlers>
		</RemoteObjectInvoker>
	</EventHandlers>
	
	<!--GET GET_COMPONENT_DEFS .......................................................-->
    <!---			@see #roComponentDef
	    ** RemoteInvoke : roComponentDef.getComponentDef()
	    		@see com.ContractProds.models.SearchManager#saveComponentDefs() 
	    ** Handler : com.ContractProds.models.SearchManager.saveComponentDefs()   -->
	<EventHandlers type="{ComponentEvent.GET_COMPONENT_DEFS}" id="eGET_COMPONENT_DEFS" debug="true">
		<RemoteObjectInvoker instance="{roComponentDef}" showBusyCursor="true" method="getComponentDef" arguments="{[event.programId,event.bMarketPrice]}">
			<!-- result sequence gets executed when service returns with a result -->
			<resultHandlers>
				<MethodInvoker generator="{ComponentDefManager}" method="saveComponentDefs" arguments="{resultObject}" />
			</resultHandlers>
			<!-- server fault -->
			<faultHandlers>
				<!--announce error event -->
				<EventAnnouncer type="{SearchEvent.BSA_ERROR}" generator="{SearchEvent}" >
					<Properties sBaError="COMPONENT SERVICE (get component def)" />
					<Properties oBaError="{fault}" />
				</EventAnnouncer>
			</faultHandlers>
		</RemoteObjectInvoker>
	</EventHandlers>
	
	<!--GET LOAD_COMPONENT .......................................................-->
    <!---			@see #roComponent
	    ** RemoteInvoke : roComponent.getComponent()
	    		@see com.ContractProds.models.SearchManager#saveComponents() 
	    ** Handler : com.ContractProds.models.SearchManager.saveComponents()   -->
	<EventHandlers type="{ComponentEvent.LOAD_COMPONENT}" id="eLOAD_COMPONENT" debug="true">
		<RemoteObjectInvoker instance="{roComponent}" showBusyCursor="true" method="getComponent" arguments="{event.programId}">
			<!-- result sequence gets executed when service returns with a result -->
			<resultHandlers>
				<MethodInvoker generator="{ComponentManager}" method="saveComponents" arguments="{resultObject}" />
			</resultHandlers>
			<!-- server fault -->
			<faultHandlers>
				<!--announce error event -->
				<EventAnnouncer type="{SearchEvent.BSA_ERROR}" generator="{SearchEvent}" >
					<Properties sBaError="COMPONENT SERVICE (get component)" />
					<Properties oBaError="{fault}" />
				</EventAnnouncer>
			</faultHandlers>
		</RemoteObjectInvoker>
	</EventHandlers>
	
	<EventHandlers type="{ComponentEvent.LOAD_PROGRAM}" id="eLOAD_PROGRAM" debug="true">
		<RemoteObjectInvoker instance="{roProgram}" showBusyCursor="true" method="getProgram" arguments="{[event.programId,event.bMarketPrice]}" debug="true">
			<!-- result sequence gets executed when service returns with a result -->
			<resultHandlers>
				<MethodInvoker generator="{ComponentManager}" method="saveComponents" arguments="{resultObject}" />
				<!--Get Component Defs -->
				<EventAnnouncer type="{ComponentEvent.GET_COMPONENT_DEFS}" generator="{ComponentEvent}" >
				<Property source="{SettingsManager}" sourceKey="settings.programId" sourceCache="global" targetKey="programId"/>
				<Property source="{SettingsManager}" sourceKey="settings.bMarketPrice" sourceCache="global" targetKey="bMarketPrice"/>
				</EventAnnouncer>
			</resultHandlers>
			<!-- server fault -->
			<faultHandlers>
				<!--announce error event -->
				<EventAnnouncer type="{SearchEvent.BSA_ERROR}" generator="{SearchEvent}" >
					<Properties sBaError="COMPONENT SERVICE (load program)" />
					<Properties oBaError="{fault}" />
				</EventAnnouncer>
			</faultHandlers>
		</RemoteObjectInvoker>
	</EventHandlers>
	
	<!--SAVE SAVE_DATA .......................................................-->
    <!---			@see #roComponentDef
	    ** RemoteInvoke : roComponentDef.getComponentDef()
	    		@see com.ContractProds.models.SearchManager#saveComponentDefs() 
	    ** Handler : com.ContractProds.models.SearchManager.saveComponentDefs()   -->
	<EventHandlers type="{ComponentEvent.SAVE_DATA}" id="eSAVE_DATA" debug="true">
		<RemoteObjectInvoker instance="{roComponent}" showBusyCursor="true" method="saveComponentData" arguments="{[event.programId, event.acComponents,event.bMarketPrice]}">
			<!-- result sequence gets executed when service returns with a result -->
			<resultHandlers>
				<MethodInvoker generator="{ComponentManager}" method="callWrapper" />
			</resultHandlers>
			<!-- server fault -->
			<faultHandlers>
				<!--announce error event -->
				<EventAnnouncer type="{SearchEvent.BSA_ERROR}" generator="{SearchEvent}" >
					<Properties sBaError="SEARCH SERVICE (save data)" />
					<Properties oBaError="{fault}" />
				</EventAnnouncer>
			</faultHandlers>
		</RemoteObjectInvoker>
	</EventHandlers>
	
	<!--LOAD_SO  .......................................................-->
	<EventHandlers type="{SearchEvent.LOAD_SO}" id="eLOAD_SO">
		<MethodInvoker 	generator="{SearchManager}" method="loadSOitems" />
	</EventHandlers>
	
	<!--UPDATE COMBOBOX FILTERS .......................................................-->
	<!--- 	   @see com.ContractProds.models.SearchManager#updFilters()
	    ** Invoke : com.ContractProds.models.SearchManager.updFilters()  -->
	<EventHandlers type="{SearchEvent.UPD_CB_FILTERS}" id="eUPD_CB_FILTERS">
        <MethodInvoker generator="{SearchManager}" method="updFilters" />
    </EventHandlers>
    
    <!--FILTER  .......................................................-->
    <!--- 	   @see com.ContractProds.models.SearchManager#itemFilter()
	    ** Invoke : com.ContractProds.models.SearchManager.itemFilter()  -->
	<EventHandlers type="{SearchEvent.FILTER}" debug="true" id="eFILTER">
        <MethodInvoker 	generator="{SearchManager}" method="itemFilter" 
        				arguments="{event}" />
    </EventHandlers>
    <!--event.searchFieldText,event.brand,event.qBrand,event.typeCode,event.typeGroup,event.bfilterMiniItem,event.programDiscountTypes,event.lblStatus-->
     <!--RESET FILTER  .......................................................-->
     <!--- 	   @see com.ContractProds.models.SearchManager#filterReset()
	    ** Invoke : com.ContractProds.models.SearchManager.filterReset()  -->
	<EventHandlers type="{SearchEvent.RESET_FILTER}" id="eRESET_FILTER">
        <MethodInvoker 	generator="{SearchManager}" method="filterReset" />
    </EventHandlers>
    
    <!--FILTER SELECTED  .......................................................-->
    <!--- 	   @see com.ContractProds.models.SearchManager#filterSelected()
	    ** Invoke : com.ContractProds.models.SearchManager.filterSelected()  -->
	<EventHandlers type="{SearchEvent.FILTER_SELECTED}" id="eFILTER_SELECTED">
        <MethodInvoker 	generator="{SearchManager}" method="filterSelected" />
    </EventHandlers>
	<!--FILTER SELECTED  .......................................................
	This method then Dispatches the FILTER_SELECTED Event-->
	<EventHandlers type="{ComponentEvent.SELECT_FILTER_ITEMS}" id="eSELECT_FILTER_ITEMS" debug="true">
		<MethodInvoker 	generator="{SearchManager}" method="selectItemsFilter" arguments="{event}" />
	</EventHandlers>
    
    <!--FILTER RATES  .......................................................-->
    <!--- 	   @see com.ContractProds.models.SearchManager#filterRates()
	    ** Invoke : com.ContractProds.models.SearchManager.filterRates()  -->
	<EventHandlers type="{SearchEvent.FILTER_RATES}" id="eFILTER_RATES">
        <MethodInvoker 	generator="{SearchManager}" method="itemFilter"
        	 arguments="{event}" /> <!--filterRates only filters on rates and ignores other filter selections-->
    </EventHandlers>
    
      <!--FILTER MINI ITEMS (180 table)  .......................................................-->
      <!---    @see com.ContractProds.models.SearchManager#filterMiniItems()
	    ** Invoke : com.ContractProds.models.SearchManager.filterMiniItems()  -->

	<EventHandlers type="{SearchEvent.FILTER_MINI_ITEMS}" id="eFILTER_MINI_ITEMS">
        <MethodInvoker generator="{SearchManager}" method="filterMiniItems" />
    </EventHandlers>
  
  	  <!--SAVE_FILTER_PARMS (180 table)  .......................................................-->
      <!---   -->

	<EventHandlers type="{SearchEvent.SAVE_FILTER_PARMS}" id="eSAVE_FILTER_PARMS">
        <MethodInvoker generator="{FilterManager}" method="setFilterParms" arguments="{event.oFilterParms}" />
    </EventHandlers>
    
    <!--CREATE USER ITEM LIST  .......................................................-->
    <!--- 	   @see com.ContractProds.models.SearchManager#createList()
	    ** Invoke : com.ContractProds.models.SearchManager.createList()  -->
	<EventHandlers type="{SearchEvent.CREATE_LIST}" id="eCREATE_LIST">
        <MethodInvoker 	generator="{SearchManager}" method="createList"
        				arguments="{[event.iList]}" />
    </EventHandlers>
    <!--DISPLAY USER ITEM LIST  .......................................................-->
    <!--- 	   @see com.ContractProds.models.SearchManager#displayList()
	    ** Invoke : com.ContractProds.models.SearchManager.displayList()  -->
	<EventHandlers type="{SearchEvent.GET_USERLIST_ITEMS}" id="eGET_USERLIST_ITEMS">
        <MethodInvoker 	generator="{SearchManager}" method="displayList"
        				arguments="{[event.arrUserListItems]}" />
    </EventHandlers>
    
	<!--GET SAVED USER ITEM LIST  .......................................................-->
  <!--- 			@see #roItemListService
	    ** RemoteInvoke : roItemListService.getUserItemList()
	    		@see com.ContractProds.models.ListManager#userItemListResults() 
	    ** Handler : com.ContractProds.models.ListManager.userItemListResults()   -->
	<EventHandlers type="{SearchEvent.GET_USERLIST}" id="eGET_USERLIST" debug="true">
        <RemoteObjectInvoker instance="{roItemListService}" showBusyCursor="true" method="getUserItemList" 
        						arguments="{event.userId}">		 
			<!-- result sequence gets executed when service returns with a result -->
			<resultHandlers>
				<MethodInvoker generator="{ListManager}" method="userItemListResults" arguments="{resultObject}" />
			</resultHandlers>
			<!-- server fault -->
			<faultHandlers>
				<!--announce error event -->
				<EventAnnouncer type="{SearchEvent.BSA_ERROR}" generator="{SearchEvent}" >
					<Properties sBaError="USER LIST SERVICE (get)" />
					<Properties oBaError="{fault}" />
				</EventAnnouncer>
			</faultHandlers>
		</RemoteObjectInvoker>
    </EventHandlers>
    
    <!--SAVE NEW USER ITEM LIST  .......................................................-->
    <!--- 			@see #roItemListService
	    ** RemoteInvoke : roItemListService.saveUserItemList()
	    		@see com.ContractProds.models.ListManager#saveItemListResults() 
	    ** Handler : com.ContractProds.models.ListManager.saveItemListResults()   -->
	<EventHandlers type="{SearchEvent.SAVE_USERLIST}" id="eSAVE_USERLIST">
        <RemoteObjectInvoker instance="{roItemListService}" showBusyCursor="true" method="saveUserItemList" 
        						arguments="{[event.userId,event.userListItemsName,event.arrUserListItems]}" debug="true">		 
			<!-- result sequence gets executed when service returns with a result -->
			<resultHandlers>
				<!--<MethodInvoker generator="{ListManager}" method="saveItemListResults" arguments="{resultObject}" />-->
				<!--reload user list ** in handler so we know the save is done -->
				<EventAnnouncer type="{SearchEvent.GET_USERLIST}" generator="{SearchEvent}" >
					<Property sourceCache="global" source="{SettingsManager}" sourceKey="settings.userId" targetKey="userId"/>
				</EventAnnouncer>
			</resultHandlers>
			
			<!-- server fault -->
			<faultHandlers>
				<!--announce error event -->
				<EventAnnouncer type="{SearchEvent.BSA_ERROR}" generator="{SearchEvent}" >
					<Properties sBaError="USER LIST SERVICE (save)" />
					<Properties oBaError="{fault}" />
				</EventAnnouncer>
			</faultHandlers>
		</RemoteObjectInvoker>
		
    </EventHandlers>
    
	<!--DELETE USER ITEM LIST  .......................................................-->
	<!--- 			@see #roItemListService
	    ** RemoteInvoke : roItemListService.deleteUserItemList()
	    		@see #eGET_USERLIST
	    ** Handler : AnnounceEvent :  GET_USERLIST  -->
	<EventHandlers type="{SearchEvent.DELETE_USERLIST}" id="eDELETE_USERLIST">
        <RemoteObjectInvoker instance="{roItemListService}" showBusyCursor="true" method="deleteUserItemList" 
        						arguments="{event.userListId}">	 
			<!-- result sequence gets executed when service returns with a result -->
			<resultHandlers>
				<!--reload user list after the delete-->
				<EventAnnouncer type="{SearchEvent.GET_USERLIST}" generator="{SearchEvent}" >
					<Property source="{SettingsManager}" sourceKey="settings.userId" sourceCache="global" targetKey="userId"/>
				</EventAnnouncer>
				<!--<MethodInvoker generator="{ListManager}" method="deleteItemListResults" arguments="{data.tmpUserId}" />-->
			</resultHandlers>
			<!-- server fault -->
			<faultHandlers>
				<!--announce error event-->
				<EventAnnouncer type="{SearchEvent.BSA_ERROR}" generator="{SearchEvent}" >
					<Properties sBaError="USER LIST SERVICE (delete)" />
					<Properties oBaError="{fault}" />
				</EventAnnouncer>
			</faultHandlers>
		</RemoteObjectInvoker>
    </EventHandlers>
    
    <!--GET DISTRIBUTOR ITEMS (180 DAY TABLE).......................................................-->
    <!--- 			@see #roSearchService
	    ** RemoteInvoke : roSearchService.getMiniItemMasterItems()
	    		@see com.ContractProds.models.SearchManager#miniItemResults() 
	    ** Handler : com.ContractProds.models.SearchManager.miniItemResults()   -->
	<EventHandlers type="{SearchEvent.GET_MINI_ITEMS}" id="eGET_MINI_ITEMS" debug="true">
		<RemoteObjectInvoker instance="{roSearchService}" showBusyCursor="true" method="getMiniItemMasterItems" arguments="{event.programId}">
			<!-- result sequence gets executed when service returns with a result -->
			<resultHandlers>
				<MethodInvoker generator="{SearchManager}" method="miniItemResults" arguments="{resultObject}" />
			</resultHandlers>
			<!-- server fault -->
			<faultHandlers>
				<!--announce error event-->
				<EventAnnouncer type="{SearchEvent.BSA_ERROR}" generator="{SearchEvent}" >
					<Properties sBaError="SEARCH SERVICE (item invoice query)" />
					<Properties oBaError="{fault}" />
				</EventAnnouncer>
			</faultHandlers>
		</RemoteObjectInvoker>
	</EventHandlers>
	
	  <!--..............................................................................................................-->
	   <!--- 	RETURN WHAT DISCOUNT TYPES EXIST ON A PROGRAM TEMPLATE	
	   				@see #roSearchService
	    ** RemoteInvoke : roSearchService.getRebateTypes()
	    		@see com.ContractProds.models.SearchManager#programDiscountTypesResult() 
	    ** Handler : com.ContractProds.models.SearchManager.programDiscountTypesResult()   -->
	<EventHandlers type="{SearchEvent.GET_DISC_TYPES_ON_PRG_TEMPLATE}" id="eGET_DISC_TYPES_ON_PRG_TEMPLATE">
		<RemoteObjectInvoker instance="{roSearchService}" showBusyCursor="true" method="getRebateTypes" arguments="{event.programId}">
			<!-- result sequence gets executed when service returns with a result -->
			<resultHandlers>
				<MethodInvoker generator="{SearchManager}" method="programDiscountTypesResult" arguments="{resultObject}" />
			</resultHandlers>
			<!-- server fault -->
			<faultHandlers>
				<!--announce error event-->
				<EventAnnouncer type="{SearchEvent.BSA_ERROR}" generator="{SearchEvent}" >
					<Properties sBaError="SEARCH SERVICE (discount types on a program template query)" />
