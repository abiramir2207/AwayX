				</EventAnnouncer>
			</faultHandlers>
		</RemoteObjectInvoker>
	</EventHandlers>
    
    <!--LOAD APP SETTINGS ** ONLY NEEDED IF WE CUSTOM SETTINGS FOR vos .......................................................-->
    <!--- 			@see #roSearchService
	    ** RemoteInvoke : roSearchService.getSettingsObject()
	    		@see com.ContractProds.models.SettingsManager#setAppSettings() 
	    ** Handler : com.ContractProds.models.SettingsManager.setAppSettings()   
	    		@see com.ContractProds.models.SearchManager#settings
	    ** Handler : com.ContractProds.models.SearchManager.settings()-->
	<EventHandlers type="{SearchEvent.LOAD_APP_SETTINGS}" id="eLOAD_APP_SETTINGS" debug="true">
		<RemoteObjectInvoker instance="{roSearchService}" showBusyCursor="true" method="getSettingsObject" arguments="{event.userId}" >
			<!-- result sequence gets executed when service returns with a result -->
			<resultHandlers>
				<MethodInvoker generator="{ConProdSettings}" method="setAppSettings" arguments="{resultObject}" />
				<!--<MethodInvoker cache="global" generator="{SearchManager}" method="settings" >
					<Property sourceCache="inherit" source="{SettingsManager}" sourceKey="settings" targetKey="settings"/>
				</MethodInvoker>-->
			</resultHandlers>
			<!-- server fault -->
			<faultHandlers>
				<!--announce error event -->
				<EventAnnouncer type="{SearchEvent.BSA_ERROR}" generator="{SearchEvent}" >
					<Properties sBaError="SEARCH SETTINGS SERVICE (load app settings event = LOAD_APP_SETTINGS)" />
					<Properties oBaError="{fault}" />
				</EventAnnouncer>
			</faultHandlers>
		</RemoteObjectInvoker>
