		/* Handle the Import Items Button Click ****************************** */
		private function callImportItems():void{
			/* Dispatch Event */
			var bShowAlert:Boolean = false;
			var bShowAlertEz:Boolean = false;
			var bShowAlertCustomPrint:Boolean = false;
			var bShowAlertCustomPrintRate:Boolean = false;
			var sMessage:String = '';
			var sTitle:String = '';
			var gValComp:Component;
			var gValIx:int;
			var bGVal:Boolean;
			var i:int = 0;
			var gValItemsError:Array = new Array();
			var ezRateItemsError:Array = new Array();
			var ezComp:Component;
			var cr:String = String.fromCharCode(13, 10);
			for each(var comp:Component in this.acComponents){
				if(comp.payee && comp.payee.payeeTypeId > 0 && comp.payee.payeeId == "")
				{
					bShowAlert = true;
					sMessage = sMessage + comp.name + ' has the Pay Single payee option without a selected payee.' + cr;
					sTitle = sTitle + 'Payee Validation Error'  + cr;
				}
				//Custom Print (for Fixed)
				if(comp.customPrint.bCustomPrint && !this.oSettings.bMarketPrice){
					for each(var p:ProdRate in comp.prodRate){
						if(p.rateMPCustom > 0 && p.rateMP != 0){
							p.rateMP =  p.rateMPCustom;
							p.rateMPCS = p.rateMPCustom;
							p.rateMPLB = p.rateMPCustom;
						}
						if(p.customPrint.iColors == 0 && p.rate > 0 && p.customPrint.bCustomPrint){
							bShowAlertCustomPrint = true;
						}
						/* NOT NEEDED -> MIN PRICE IS USED IN APPROVAL
						if(p.customPrint.bCustomPrint && p.rateMP != 0 && p.rateMP > p.rate){
							bShowAlertCustomPrintRate = true;
						}*/
					}
					if(bShowAlertCustomPrint){
						sMessage = comp.name + ' contains custom print items that do not have print options (colors, graphics or digital art) applied.' + cr;
						sTitle = sTitle + 'Custom Print Options'  + cr;
					}
					/* NOT NEEDED -> MIN PRICE IS USED IN APPROVAL
					if(bShowAlertCustomPrintRate){
						sMessage = comp.name + ' contains custom print items that have rates lower than the Minimum Price.' + cr;
						sTitle = sTitle + 'Custom Print Min Price'  + cr;
					}*/
				}
				
				if(comp.componentDef.bGreatestValue){
					//gValComp = new Component(comp);
					gValIx = i;//the index in acComponents of the gVal component
					bGVal = true;//bool should we gVal?
				}
				i++;
			}
			// GREATEST PROGRAM VALUE LOGIC
			if(bGVal){
				gValComp = this.acComponents[gValIx];//Greatest Val Component "gVal"
				for each(var pr:ProdRate in gValComp.prodRate){//Prodrates To check
					for each(var comp2:Component in this.acComponents){//loop over Components
						if(comp2.componentId != gValComp.componentId && comp2.type == ComponentManager.FIXED_TYPE_ID){//if it is Fixed component and it is NOT the gVal Component
							for each(var pr3:ProdRate in comp2.prodRate){//loop over non gVal Component rates -> "FOB" rates in pratcice
								if(pr3.itemGuid == pr.itemGuid){ //compare like items
									//check gval component rate against non gVal rate
									if(pr.rate <= pr3.rate && pr.rate != 0){
										gValItemsError.push(pr.itemGuid);
										continue;
									}
									//if customer level rates
									if(gValComp.fixedType == ComponentManager.FIXED_CUST_RATE_TYPE_ID){
										for each(var c:Customer in this.program.distributors){//loop over customers and validate their rates
											if(pr['rateCust_'+ c.shipTo] <= pr3.rate  && pr['rateCust_'+ c.shipTo] != 0){
												gValItemsError.push(pr.itemGuid);
												break;
											}
										}//loop custs
									}//if gValComp.fixedType gValItemsError
								}//if 
							}//for each pr3	
						}//if comp2 != gValComp
					}//for each comp2
				}//for each pr	
			}//if gValComp
			
			//CHECK EZ RATES
			if(this.program.template.bEZButtonOn && this.program.template.bDiscountRebateMaxRateOn){
				for each(var comp3:Component in this.acComponents){//loop over Components
					if(comp3.type == 2){//REBATE ONLY HAS EZ
						for each(var pr4:ProdRate in comp3.prodRate){
							if(pr4.rate > pr4.rateEz){
								ezRateItemsError.push(pr4.itemGuid);
								ezComp = comp3;
							}
						}
					}
				}
			}
			
			if(gValItemsError.length){
				bShowAlert = true;
				sMessage = sMessage + gValComp.name + ' has ' +  gValItemsError.length + ' rates that are not Greatest Program Value.' + cr;
				sTitle = sTitle + 'Greatest Program Value Error';
				/*  TODO:  DISPATCH EVENT TO SELECT ITEMS */
				var e:ComponentEvent = new ComponentEvent(ComponentEvent.SELECT_FILTER_ITEMS);
				e.arr1 = gValItemsError;
				this.dispatchEvent(e); 
			}
			
			if(ezRateItemsError.length){
				bShowAlertEz = true;
				sMessage = sMessage + ezComp.name + ' has ' +  ezRateItemsError.length + ' rates that are greater than the ez rate.' + cr;
				sTitle = sTitle + 'EZ rates Betond Max Rate Error';
				/*  TODO:  DISPATCH EVENT TO SELECT ITEMS */
				var ez:ComponentEvent = new ComponentEvent(ComponentEvent.SELECT_FILTER_ITEMS);
				ez.arr1 = ezRateItemsError;
				this.dispatchEvent(ez); 
			}

			if(bShowAlert || bShowAlertCustomPrintRate || bShowAlertCustomPrint){
				Alert.show(sMessage,sTitle)
			}
			else if(bShowAlertEz){
				//if we can enter beyond max, give achoice
				if(this.program.template.bEzButtonEnterBeyondMaxRates){
					sMessage = sMessage + 'Would you like to continue with your save?' + cr;
					Alert.show(sMessage,sTitle,Alert.YES|Alert.NO, this, alertClickHandler)
				}
				else{//STOP
					Alert.show(sMessage,sTitle)
				}
			}
			else{
				var event:ComponentEvent = new ComponentEvent(ComponentEvent.SAVE_DATA);
				event.programId = this.oSettings.programId;
				event.acComponents = this.acComponents;
				event.bMarketPrice = this.oSettings.bMarketPrice;
				this.dispatchEvent(event);
			}

		}
			
		private function alertClickHandler(evt:CloseEvent):void {
				if (evt.detail == Alert.YES) {
					var event:ComponentEvent = new ComponentEvent(ComponentEvent.SAVE_DATA);
					event.programId = this.oSettings.programId;
					event.acComponents = this.acComponents;
					event.bMarketPrice = this.oSettings.bMarketPrice;
					this.dispatchEvent(event)
				} 
				else {
					//DO NOTHING
				}
			}
			/* When a user clicks cancel close the caller page */
			public function clickCancelHandler():void {
				var s:String;
				if (ExternalInterface.available) {
					var wrapperFunction:String = "closeCompProdRateEdit";
					s = ExternalInterface.call(wrapperFunction);
				} else {
					s = "Wrapper not available";
				}
			}
		private function vbLayoutClick(ui:*,img:Image,lbl:Label):void{
   			/* toggle the ui container */
   			ui.visible = !ui.visible; 
   			ui.includeInLayout = !ui.includeInLayout;
   			/* toggle the clickable label */
   			lbl.visible = !lbl.visible; 
   			lbl.includeInLayout = !lbl.includeInLayout;
   			/* toggle the image icon */
   			if(img){
   				img.source = getimgPlusMinus(ui.visible);
   				img.toolTip = ui.visible == false ? 'Expand' : 'Collapse';
   			}
   			
   		}
   		/* Toggle the Plus Minus Gif	............................................. */
		public function getimgPlusMinus(i:int):Class
			{
				if (i==0){
					return _imgPlus;
				}
				else{
					return _imgMinus;
				}
				
			}

		]]>
	</mx:Script>
