			private function reset():void{
			
				//select Rates
				this.chFilterRates.selected = false;
				pModel.setBfilterRates(false);
				
				//reset selected filter
				this.chFilterSelected.selected = false;
				pModel.setBfilterSelected(false);
				
				this.chFilterVarianceMP.selected = false;
				pModel.setBfilterVarianceMP(false);
				
				this.chFilterMP.selected = false;
				pModel.setBfilterMP(false);
				
				this.cboProductStatus.selectedIndex = 0;
				var o:Object = new Object();
				o = pModel.arrProductStatus[0];
				pModel.updateFilterProductStatus(o);
			/* 	var x:* = this.gFilterGroupItem.getAutomationChildren();
				for each(var chk:spark.components.CheckBox in this.gFilterGroupItem.getAutomationChildren() ){
					chk.selected = false;
				} */
				for (var x : int = 0; x < this.gFilterGroupItem.numChildren ; x++){
					var chk:spark.components.CheckBox = this.gFilterGroupItem.getChildAt(x) as spark.components.CheckBox;
					chk.selected = false;
				}
				pModel.setBfilterGroups(false);
				pModel.setBfilterItems(false);
				pModel.setBfilterNone(false);
				//var _funcFilterInsert:Function = function(inObject:Object):Boolean{return true;};
				dgItems.resetFilters();
				//send to pModel for dispatch
				//pModel.reset();
			}

