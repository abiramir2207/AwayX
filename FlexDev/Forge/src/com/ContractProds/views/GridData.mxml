							var chkAttr:spark.components.CheckBox = new spark.components.CheckBox();
							chkAttr.id="chShow" + pa.productGroupAttributeNameField;
							chkAttr.selected = !this.pModel.oSettings.appSettings.Template_Multiple_Product_Attr_Groups;
							/* TODO: Hide some attrs by default -> user setting?
							if(pa.groupLevelDesc.toLowerCase() =='level 1'){
								chkAttr.selected = true;
							} */
							chkAttr.label= pa.groupLevelDesc; 
							chkAttr.addEventListener(Event.CHANGE,showHide,false,0,true); 
							chkAttr.toolTip="show or hide " + pa.groupLevelDesc + " column" ;
							this.hbShowHideCol.addChild(chkAttr);
						}
						
					}
			//KRAFT	
				}
			
				if(bGroup && this.pModel.program.template.bGroupDeal && this.pModel.oSettings.appSettings.Template_Multiple_Product_Attr_Groups){
				//	pModel.setBfilterGroups(true);
				//	pModel.setBfilterItems(false);
				//public	var chkGrp:spark.components.CheckBox = new spark.components.CheckBox();
						chkGrp.id="chFilterGroup";
						//chkGrp.selected = true;
						chkGrp.label= "groups"; 
						chkGrp.addEventListener(Event.CHANGE,pModel.updateBfilterGroups,false,0,true); 
						chkGrp.toolTip="show group records in the datagrid";
						this.gFilterGroupItem.addElement(chkGrp);
						BindingUtils.bindProperty(chkGrp, "selected", pModel, ["oFilterParms","bfilterB"]);
				//public	var chkItem:spark.components.CheckBox = new spark.components.CheckBox();
						chkItem.id="chFilterItem";
						chkItem.selected = this.pModel.oFilterParms.bfilterA;// false;
						chkItem.label= "items"; 
						chkItem.addEventListener(Event.CHANGE,pModel.updateBfilterItems,false,0,true); 
						chkItem.toolTip="show item records in the datagrid";
						this.gFilterGroupItem.addElement(chkItem);
						
						
						//hgFilterMP chkNone
						if(this.pModel.program.template.bCustomPrint &&
							//this.component.fixedType != com.ContractProds.models.ComponentManager.FIXED_CUST_RATE_TYPE_ID &&
							this.pModel.oSettings.appSettings.Template_Multiple_Product_Attr_Groups  && 
