           public function showHide(event:Event):void
			{
		   		var sCol:String;
				//show hide dynamic prod attr cols
				for each(var col:AdvancedDataGridColumn in this.dgItems.columns){
					
					if("chShow" + col.dataField == event.currentTarget.id){
						col.visible = !col.visible;
						break;
					}
				}
				//show hide static cad (canadien conversion
				if(event.currentTarget.id == 'chShowCAD' || event.currentTarget.id == 'chShowrateConverted'){
					for each(var colGroup:* in this.dgItems.groupedColumns){
						if(colGroup is AdvancedDataGridColumnGroup){
							for each(var colGroupChild:* in colGroup.children){
								for each (var colGroupChildren:* in colGroupChild.children){
									if(colGroupChildren is AdvancedDataGridColumn && colGroupChildren.headerText == 'cad'){
										colGroupChildren.visible = chkCC.selected;
										if(colGroupChildren is AdvancedDataGridFilterColumn && chkCC.selected){ //cust rate and cad IS Visible
											colGroupChildren.visible = false;//set false and turn on if it is in arr
											for each(var cust:Customer in this.pModelComp.arrSelectedCustomer){
												if(colGroupChildren.dataFieldComplex == cust.shipTo){
													colGroupChildren.visible = true;
												}
											} //for each cust
										}
										//break;
									}	
								}
							}
						}
					}
				}
				
			}
			
			public function showHideCustRates(event:ComponentEvent):void
			{
				var sCol:String;
				for each(var colGroup:* in this.dgItems.groupedColumns){
					if(colGroup is AdvancedDataGridColumnGroup){
						for each ( var outerChild:BaAdvancedDataGridColumnGroup in colGroup.children){
							if(outerChild is BaAdvancedDataGridColumnGroup && outerChild.component.fixedType == ComponentManager.FIXED_CUST_RATE_TYPE_ID){
								for each (var colGroupChild:* in outerChild.children){
									if(colGroupChild is AdvancedDataGridFilterColumn && (colGroupChild.dataFieldComplex == colGroupChild.headerText || colGroupChild.headerText == 'cad')  ){ //&& colGroupChild.dataFieldComplex == 'cad'
										//setvisible = false then loopover selected custs (arr1 = selected customers) and set vis=true if selected
										colGroupChild.visible = false;
										for each(var cust:Customer in event.arr1){
											if(colGroupChild.dataFieldComplex == cust.shipTo){
												colGroupChild.visible = true;
												if(colGroupChild.headerText == 'cad'){
													colGroupChild.visible = chkCC.selected;
												}
											}
										} //for each cust
									}	
								} //for each colGroupChild
							}
						} //for each outerChild	
					}
				}
			}
			
