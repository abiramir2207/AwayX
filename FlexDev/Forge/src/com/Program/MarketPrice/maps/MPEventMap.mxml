<?xml version="1.0" encoding="utf-8"?>
<LocalEventMap 
	xmlns:mx="http://www.adobe.com/2006/mxml"
	xmlns="http://mate.asfusion.com/" 
	xmlns:mate="http://mate.asfusion.com/">
	<mx:Script>
		<![CDATA[
			import com.asfusion.mate.core.*;
			import com.asfusion.mate.events.UnhandledFaultEvent;
			import mx.events.*;
			import com.Program.MarketPrice.events.*;
			import com.Program.MarketPrice.models.*;
			import com.Program.MarketPrice.views.pm.*;
			import com.Program.MarketPrice.views.*;
			import com.shared.models.*;
			//import com.ContractProds.vos.*;
		]]>
	</mx:Script>
	<mate:Debugger level="{Debugger.ALL}" />
	<!-- load up an instance of the remote objects -->
	<!-- Remote Services  ***************************************************************************************** -->
	<mx:RemoteObject id="MainService" destination="ColdFusion" source="mvc.models.Program.ContractMainManager" />
	<mx:RemoteObject id="ComponentService" destination="ColdFusion" source="mvc.models.Program.Component.ComponentManager" />
	<mx:RemoteObject id="ProgramService" destination="ColdFusion" source="mvc.models.Program.ProgramManager" />
	<mx:RemoteObject id="MarketPriceService" destination="ColdFusion" source="mvc.models.Template.MarketPriceManager" />
	<!--- Search functionality including initial dataload <p>roSearchService : <strong>mvc.models.Distributor.DistributorSearchService</strong></p> -->
	<!--- roErrorService : <strong>mvc.models.ErrorService</strong> -->
	<mx:RemoteObject id="ErrorService" destination="ColdFusion" source="mvc.models.ErrorService" />

	<!-- FlexEvent.PREINITIALIZE   ******************************************************************************** -->
	<!---@see com.ContractProds.models.SettingsManager#loadURLParameters()
			Invoke : com.ContractProds.models.SettingsManager.loadURLParameters()-->
	<EventHandlers type="{FlexEvent.PREINITIALIZE}" id="ePREINITIALIZE">
		<ObjectBuilder generator="{MPManager}" id="oMPManager"  constructorArguments="{scope.dispatcher}" />
		<ObjectBuilder generator="{MPGridManager}" id="oMPGridManager"  constructorArguments="{scope.dispatcher}" />
		<ObjectBuilder generator="{SettingsManager}" id="oSettingsManager" />
		<ObjectBuilder generator="{GridDataPModel}" id="oGridDataPModel" constructorArguments="{scope.dispatcher}"/>
		<!--<ObjectBuilder generator="{GridDataPModel}" id="oGridDataPModel" cache="global" />-->
		<ObjectBuilder generator="{BAError}" id="oBAError" cache="global" />
		<MethodInvoker generator="{SettingsManager}" method="loadURLParameters" />
	</EventHandlers>
	
	<!-- FlexEvent.APPLICATION_COMPLETE     ************************************************************************* -->
	<EventHandlers type="{FlexEvent.CREATION_COMPLETE}" id="eCREATION_COMPLETE" debug="true">
		<!--call db for other settings-->
		<EventAnnouncer type="{MPEvent.LOAD_APP_SETTINGS}" generator="{MPEvent}">
			<Property source="{SettingsManager}" sourceKey="settings.userId" targetKey="userId"/>
		</EventAnnouncer>
		<!--Get Data ********  modify the property tag to send to the get GET ************-->
		<EventAnnouncer type="{MPEvent.GET}" generator="{MPEvent}" >
			<Property source="{SettingsManager}" sourceKey="settings.programId" targetKey="programId"/>
		</EventAnnouncer>
	</EventHandlers>
	
	<!--GET DATA ******** modify this event to get data from CF ************ -->
	    <!---	The main GET Event Should call a wrapper function in CF that will get ALL Data needed (complex Object possibly) for the initial load of the app.
	    		We should not see 10 remote calls to load up the app.		
	    			@see #roMainService
	    ** RemoteInvoke : roMainService.getDistributors()
	    		@see com.ContractProds.models.SearchManager#getMyData() 
	    ** Handler : com.ContractProds.models.SearchManager.getMyData()   -->
	<EventHandlers type="{MPEvent.GET}" id="eGET">
		<RemoteObjectInvoker instance="{ProgramService}" showBusyCursor="true" method="getProgram" arguments="{[event.programId,0,1,0,'',0,1]}">
			<resultHandlers>
				<MethodInvoker generator="{MPManager}" method="acItemResults" arguments="{resultObject}" />
			</resultHandlers>	
			<faultHandlers>	
				<EventAnnouncer type="{MPEvent.BSA_ERROR}" generator="{MPEvent}" >
					<Properties sBaError="MP SERVICE (get data)" />
					<Properties oBaError="{fault}" />
				</EventAnnouncer>
			</faultHandlers>
		</RemoteObjectInvoker>
	</EventHandlers>
 
 
    <!-- ************************************************
    	 ADD NEW EventHandlers Here   *******************
         ************************************************-->
	<!--FILTER  .......................................................-->
	<EventHandlers type="{MPEvent.FILTER}" debug="true" id="eFILTER">
		<MethodInvoker 	generator="{MPManager}" method="filter" 
						arguments="{event}" />
	</EventHandlers>
	
	<!--APPROVE  .......................................................-->
	<EventHandlers type="{MPEvent.APPROVE}" debug="true" id="eAPPROVE">
		<RemoteObjectInvoker instance="{MarketPriceService}" showBusyCursor="true" method="approveMarketPriceProgram" 
							 arguments="{event.programId}">
			<resultHandlers>
				<MethodInvoker 	generator="{GridDataPModel}" method="approveHandler" 
								arguments="{resultObject}" />
			</resultHandlers>	
			<faultHandlers>	
				<EventAnnouncer type="{MPEvent.BSA_ERROR}" generator="{MPEvent}" >
					<Properties sBaError="Market Price SERVICE (approveMarketPriceProgram)" />
					<Properties oBaError="{fault}" />
				</EventAnnouncer>
			</faultHandlers>
		</RemoteObjectInvoker>
		
	</EventHandlers>
	
	<!--CANCEL  .......................................................-->
	<EventHandlers type="{MPEvent.CANCEL}" debug="true" id="eCANCEL">
		<MethodInvoker 	generator="{MPManager}" method="cancel" 
						arguments="{event}" />
	</EventHandlers>

    <!--LOAD APP SETTINGS *************************************************************************** -->
     <!--- 			@see #roMainService
	    ** RemoteInvoke : roMainService.getSettingsObject()
	    		@see com.ContractProds.models.SettingsManager#setAppSettings() 
	    ** Handler : com.ContractProds.models.SettingsManager.setAppSettings()   -->
	<EventHandlers type="{MPEvent.LOAD_APP_SETTINGS}">
		<RemoteObjectInvoker instance="{MainService}" showBusyCursor="true" method="getSettingsObject" arguments="{event.userId}" >
			<!-- result sequence gets executed when service returns with a result -->
			<resultHandlers>
				<MethodInvoker generator="{SettingsManager}" method="setAppSettings" arguments="{resultObject}" />
			</resultHandlers>
			<!-- server fault -->
			<faultHandlers>
				<!--announce error event -->
				<EventAnnouncer type="{MPEvent.BSA_ERROR}" generator="{MPEvent}" >
					<Properties sBaError="SEARCH SETTINGS SERVICE (load app settings event = LOAD_APP_SETTINGS)" />
					<Properties oBaError="{fault}" />
				</EventAnnouncer>
			</faultHandlers>
		</RemoteObjectInvoker>
	</EventHandlers>
	
	<!--SET STATE FOR SEARCH ITEMS *************************************************************************** -->


	
	<!--	*****************************************************************************************
			***		BSA CUSTOM ERROR HANDLER 		*************************************************
			***************************************************************************************** -->

<!---  	<p>First display the error to the user</p>
		<p>Then Try to log the error on the cf server</p> 
		<p>there is a fault Logging the error on the server show the "ERROR SERVICE" Message</p>
		<p>*********************************************************************************</p>
		*      @see com.ContractProds.models.BAError#showBAError()
		** Invoke : com.ContractProds.models.BAError.showBAError()		
		*			@see #roErrorService
	    ** RemoteInvoke : roErrorService.logError()
	    *		@see com.ContractProds.models.BAError#logError() 
	    ** faultHandler : com.ContractProds.models.BAError.showBAError()   -->
	<EventHandlers type="{MPEvent.BSA_ERROR}">
     	<MethodInvoker generator="{BAError}" method="showBAError" arguments="{event.oBaError}" cache="none" >
			<Properties BAErrorString="{event.sBaError}" />
		</MethodInvoker>
		<!--log error on server-->	
		<!--<RemoteObjectInvoker instance="{ErrorService}" method="logError" arguments="{[event.oBaError.faultDetail, event.oBaError.faultString]}">
			<faultHandlers>
				<MethodInvoker generator="{BAError}" method="showBAError" arguments="{fault}" cache="none" >
					<Properties BAErrorString="ERROR SERVICE: The server is not responding.  Please contact support." />
				</MethodInvoker>
			</faultHandlers>
		</RemoteObjectInvoker>-->
     </EventHandlers>

	<!--GLOBAL ERROR HANDLER  *********************************************************************** -->
	<EventHandlers type="{UnhandledFaultEvent.FAULT}">
     	<MethodInvoker generator="{BAError}" method="showBAError" arguments="{event.fault}" cache="none" >
			<Properties BAErrorString="UNHANDLED" />
		</MethodInvoker>
		<!--log error on server-->	
		<RemoteObjectInvoker instance="{ErrorService}" method="logError" arguments="{[event.fault.faultDetail, event.fault.faultString]}"/>
     </EventHandlers>
	
	<!--..................................... INJECTORS ......................................-->
	
	<!-- GridDataPModel ....................................................... -->
	<Injectors target="{GridDataPModel}" debug="true">
		<PropertyInjector targetKey="acItems" source="{MPManager}" sourceKey="acItems" />
		<PropertyInjector targetKey="maxVariancePercent" source="{MPManager}" sourceKey="maxVariancePercent" />
		<PropertyInjector targetKey="program" source="{MPManager}" sourceKey="program" />
		<PropertyInjector targetKey="arrDgItemsCols" source="{MPGridManager}" sourceKey="arrDgItemsCols" />
		<PropertyInjector targetKey="oSettings" source="{SettingsManager}" sourceKey="settings"  softBinding="true" />
	</Injectors>
	
	<!-- MPManager ....................................................... -->
	<Injectors target="{MPManager}" debug="true">
		<PropertyInjector targetKey="oSettings" source="{SettingsManager}" sourceKey="settings"  softBinding="true" />
	</Injectors>
	
	<!-- GridDataMP ....................................................... -->
	<Injectors target="{GridDataMP}" debug="true">
		<PropertyInjector targetKey="pModel" source="{GridDataPModel}" />
	</Injectors>
	
	<!-- Header ....................................................... -->
	<Injectors target="{Header}" debug="true">
		<PropertyInjector targetKey="pModel" source="{GridDataPModel}" />
	</Injectors>
	
	<!-- MPPanel ....................................................... -->
	<Injectors target="{MPPanel}" debug="true">
		<PropertyInjector targetKey="pModel" source="{GridDataPModel}" />
	</Injectors>
	
</LocalEventMap>
