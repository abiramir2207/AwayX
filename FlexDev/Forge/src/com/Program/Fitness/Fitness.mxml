<?xml version="1.0" encoding="utf-8"?>
<s:Application xmlns:fx="http://ns.adobe.com/mxml/2009"
		  xmlns:s="library://ns.adobe.com/flex/spark" 
		  xmlns:mx="library://ns.adobe.com/flex/mx"
		  xmlns:view="com.Program.Fitness.views.*" 
		  xmlns:maps="com.Program.Fitness.maps.*" 
		  xmlns:vos="com.Program.Fitness.vos.*" 
		  creationComplete="applyRuntimeStyleSheet();" 
		  implements="com.shared.models.IModuleBa" width="100%" height="100%" 
		  resize="this.reSizeCall()">
	
	<s:layout>
		<s:VerticalLayout/>
	</s:layout>
	<fx:Declarations>
		<!-- Event Maps __________________________________________________ -->
		<maps:FitnessEventMap dispatcher="{this}" cache="local" />
	</fx:Declarations>
	<fx:Script><![CDATA[
		import com.Program.Fitness.events.FitnessEvent;
		import com.shared.models.IModuleBa;
		import com.shared.vos.Settings;
		import com.shared.events.MainEvent;
		[Bindable]
		private var sBBId:String;

		private function reSizeCall():void {
			//this.setActualSize(this.width,this.height);
			callLater(this.reSize);
		}
		private function reSize():void {
		//this.setActualSize(this.width,this.height);
		this.vGroup.width = this.width;
		this.vDetail.width = this.width;
		this.vGroup.height = this.height;
		this.vDetail.height = this.height - this.vHeader.height - 15;
			trace(this.height.toString() + ' :: ' + this.vHeader.height.toString() + ' :: ' + this.vDetail.height.toString());
		}
		
		private function applyRuntimeStyleSheet():void {
			styleManager.loadStyleDeclarations("/flex/mainFx411.swf") 
			//this.reSizeCall();
		}
		
		public function setSettings(settings:Settings):void{
			var event:MainEvent = new MainEvent ( MainEvent.SET_LOCAL_APP_SETTINGS );
			event.settings = settings;
			this.dispatchEvent( event );
		}
		
	]]>
	</fx:Script>
	
	<!-- Views _______________________________________________________ -->
	<s:VGroup id="vGroup" width="100%" height="100%">
		<view:FitnessHeaderForm width="100%" id="vHeader" resize="this.reSizeCall()" />
		<view:FitnessItemsGrid width="100%" id="vDetail" height="100%" />
	</s:VGroup>
</s:Application>
