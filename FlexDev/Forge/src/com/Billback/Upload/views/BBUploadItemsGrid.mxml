<?xml version="1.0" encoding="utf-8"?>
<s:Group xmlns:fx="http://ns.adobe.com/mxml/2009" 
		 xmlns:s="library://ns.adobe.com/flex/spark" 
		 xmlns:mx="library://ns.adobe.com/flex/mx"
		 xmlns:filters="com.shared.components.filters.*" width="100%" height="100%">
	<s:layout>
		<s:VerticalLayout paddingLeft="5" paddingRight="5" 
						  paddingTop="5" paddingBottom="5" />
	</s:layout>
	<fx:Declarations>
		<!-- Place non-visual elements (e.g., services, value objects) here -->
		<s:RadioButtonGroup id="rdoErrorDisplay" selectedValue="current"  itemClick="loadCurrentData(event);" />
	</fx:Declarations>
	
	<fx:Script>
		<![CDATA[
			import com.Billback.Upload.views.pm.BBUploadPModel;
			import com.Billback.Edit.models.vos.BBToolsLock;
