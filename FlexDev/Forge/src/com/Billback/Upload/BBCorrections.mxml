				<s:ButtonBar skinClass="com.shared.views.skins.ButtonBarBa" dataProvider="{tbNavList}" requireSelection="true"/> 
				<!--<mx:Text text="Connected to Server : {cfMessageFromServer.subscribed}" />-->
