	<s:layout>
		<s:VerticalLayout paddingBottom="0" paddingLeft="0" paddingRight="0" paddingTop="0"/>
	</s:layout>
	<fx:Declarations>
		<!-- Event Maps __________________________________________________ -->
		<maps:BBCorrectionsEventMap dispatcher="{this}" cache="local" />
		
		<s:Consumer id="cfMessageFromServer" destination="ColdFusionGateway" message="gotMessage( event )"  />
	</fx:Declarations>
	<fx:Style>
		@namespace s "library://ns.adobe.com/flex/spark";
		@namespace mx "library://ns.adobe.com/flex/mx";
		
		s|Label#labelDisplay {
			textAlign: left;
		}
		
		s|FormItem {
			textAlign: left;
			skinClass: ClassReference("com.Billback.Upload.views.skins.FormValidatorItemSkin");
		}
		
	</fx:Style>
	<fx:Script><![CDATA[
		import com.Billback.Main.models.IBBEdit;
		import com.Billback.Main.models.vos.BBHeader;
		import com.Billback.Upload.events.BBUploadEvent;
		import com.Billback.Upload.models.vos.BBRawEDIDetail;
		import com.Billback.Upload.models.vos.BBRawEDIHeader;
		import com.Billback.Upload.models.vos.BBUploadDetail;
		import com.Billback.Upload.models.vos.BBUploadDetailError;
		import com.Billback.Upload.models.vos.BBUploadHeader;
		import com.Billback.Upload.views.pm.BBCorrectionsPModel;
		import com.Billback.Upload.views.pm.BBRawEDIPModel;
		import com.shared.events.MainEvent;
		import com.shared.models.SettingsManager;
		import com.shared.vos.Settings;
		
		import mx.collections.ArrayCollection;
		import mx.controls.Alert;
		import mx.core.mx_internal;
		
		/* Presentation Model */
		[Bindable]
		public var pModel:BBCorrectionsPModel;
		[Bindable]
		private var bbRawEDIHeader:BBRawEDIHeader;
		private var bbRawEDIDetail:BBRawEDIDetail = new BBRawEDIDetail();
		
		/* Presentation Model */
		[Bindable]
		public var pModelRawEDI:BBRawEDIPModel;
		
		[Bindable]
		private var bbUploadHeader:BBUploadHeader;
		private var bbUploaddetail:BBUploadDetail = new BBUploadDetail();;
		private var bbUploaddetailError:BBUploadDetailError;
		public static const millisecondsPerDay:int = 1000 * 60 * 60 * 24;
		// sets the start date to today - 1.5 year
		[Bindable]
		public var startDate:Date = new Date(new Date().getTime() - (534 * millisecondsPerDay)); 
		[Bindable]
		public var endDate:Date = new Date();
		
		import mx.messaging.events.MessageEvent;
		[Bindable] protected var messageList:ArrayCollection = new ArrayCollection();
		[Bindable] protected var acParseResult:ArrayCollection = new ArrayCollection();
		[Bindable] protected var sCurrentUploadMessage:String = '';
		
		protected function gotMessage(e:MessageEvent):void
		{
			var i:int = e.message.body.arrCorrections.length;
			var obj:Object = new Object();
			obj.message = '[' + e.message.body.user + ' @' + e.message.body.serial + '] ' + e.message.body.message;
			obj.sFileName = e.message.body.sFileName;
			obj.acParseResult = acParseResult = new ArrayCollection(e.message.body.arrParseResult);
			messageList.addItemAt(obj,0);
			// this.lMessage.selectedIndex = 0;
			sCurrentUploadMessage = e.message.body.message;
			//display Parse messages
			/* if(e.message.body.arrParseResult.length){
				acParseResult = new ArrayCollection(e.message.body.arrParseResult);
			}
			else{
				acParseResult = new ArrayCollection();
				sCurrentUploadMessage = '';
			} */
			//append new corrections records to grid
			// Commented as we do not want to add the record to the grid when the file is uploaded			
		/*	if(i){
				//add to corrections list
				var evt:BBUploadEvent = new BBUploadEvent ( BBUploadEvent.ADD_BB_CORRECTIONS );
				evt.arrBBcorrrections = e.message.body.arrCorrections;
				this.dispatchEvent( evt );
			} */
			//toNumber.text = e.message.body.fromNumber;
		}
		
		public function clearLog():void{
			this.messageList = new ArrayCollection();
		}
		
		private function applyRuntimeStyleSheet():void {
			SettingsManager.applyRuntimeStyleSheet(mx_internal::VERSION,this);
			cfMessageFromServer.subscribe();
		}
		
		public function setSettings(settings:Settings):void{
			
			var event:MainEvent = new MainEvent ( MainEvent.SET_LOCAL_APP_SETTINGS );
			event.settings = settings;
			this.dispatchEvent( event );
		}
		
		public function setBB(bbh:BBUploadHeader):void{
			if(bbh.bbHeaderID != 0){
				var e:BBUploadEvent = new BBUploadEvent ( BBUploadEvent.REMOVE_BB_UPLOAD );
				e.bbUploadHeader = bbh;
				this.dispatchEvent( e );
			}
		}
		public function getBB():BBUploadHeader{
			return this.bbUploadHeader;
		}
		public function setBBRawEDI(bbREH:BBRawEDIHeader):void{
			if(bbREH){
				var event:BBUploadEvent = new BBUploadEvent ( BBUploadEvent.LOAD_BB_RAW_EDI_DETAIL );
				event.bbRawEDIHeader = bbREH;
				this.bbRawEDIHeader = bbREH
				this.dispatchEvent( event );
			}
			
		}
		public function getBBRawEDI():BBRawEDIHeader{
			return this.bbRawEDIHeader;
		}
		private function showHideTabs():void{
			/* If this module is called from the settings panel's
			"EDI Viewer" link, then remove the first 2 tabs. Just show
			the "Raw EDI" link. 
			Note: The reason why index 0 (zero) is used twice below is because
			once the first tab is removed, the second tab becomes the first tab.
			*/
			if(pModel.oSettings.source == 'settings'){
				tbNavList.removeChildAt(0);
				tbNavList.removeChildAt(0);
			}
		}		
	]]>
	</fx:Script>
	
