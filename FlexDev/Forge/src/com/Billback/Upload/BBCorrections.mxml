				</s:HGroup>-->
				
				<mx:ViewStack id="tbNavList" width="100%" height="100%" 
							  selectedIndex="0" paddingBottom="0" paddingLeft="0" paddingRight="0" paddingTop="0">
					<s:NavigatorContent label="upload &amp; history" width="100%" height="100%">
						<view:BBUploadHistoryForm height="100%" />
					</s:NavigatorContent>
					<s:NavigatorContent label="corrections" width="100%" height="100%">
						<view:BBCorrectionsGrid height="100%" width="100%" />
					</s:NavigatorContent>
					<s:NavigatorContent label="Raw EDI" width="100%" height="100%">
						<view:BBRawEDIGrid height="100%" width="100%" />
					</s:NavigatorContent>
				</mx:ViewStack>
		</s:VGroup>
	<!--</s:Scroller>-->
</s:Module>

