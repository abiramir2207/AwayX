								   visible="{this.lMessage.selectedItem.sFileName != null}"/>
				</s:HGroup>-->
				<!--<s:Label text="Upload Activity" toolTip="Upload activity since log-in.  Connected to Server : {cfMessageFromServer.subscribed}" />
			includeInLayout="{this.lMessage.selectedItem.sFileName!= null}" -->
