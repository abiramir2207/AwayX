			<PropertyInjector targetKey="arrBBRawEDIItemsDgCols" source="{BBRawEDIDetailGridManager}" sourceKey="arrBBRawEDIItemsDgCols"  softBinding="false" />
		</Injectors>
 
		<Injectors target="{BBRawEDI}" debug="false">
