			<PropertyInjector targetKey="sFileData" source="{BBUploadManager}" sourceKey="sFileData"  softBinding="false" />
			<PropertyInjector targetKey="bbCorrectionsDate" source="{BBUploadManager}" sourceKey="bbCorrectionsLastSavedDate"  softBinding="false" />
