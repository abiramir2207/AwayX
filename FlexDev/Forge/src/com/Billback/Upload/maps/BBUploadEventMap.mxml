<?xml version="1.0" encoding="utf-8"?>
<LocalEventMap 
	xmlns:fx="http://ns.adobe.com/mxml/2009" 
	xmlns:mx="library://ns.adobe.com/flex/mx"
	xmlns="http://mate.asfusion.com/" xmlns:mate="http://mate.asfusion.com/">
	<fx:Script>
		<![CDATA[
			import com.asfusion.mate.core.*;
			import com.asfusion.mate.events.UnhandledFaultEvent;
			import mx.events.*;
			import com.Billback.Upload.events.*;
			import com.Billback.Upload.models.*;
			import com.Billback.Upload.views.pm.*;
			import com.Billback.Upload.views.*;
			import com.shared.models.*;
			import com.shared.events.MainEvent;
			import com.Billback.Upload.BBUpload;
			//import com.ContractProds.vos.*;
		]]>
	</fx:Script>
	<fx:Declarations>
		<mate:Debugger level="{Debugger.ALL}" />
		<!-- load up an instance of the remote objects -->
		<!-- Remote Services  ***************************************************************************************** -->
		<mx:RemoteObject id="MainService" destination="ColdFusion" source="mvc.Models.Billback.BillbackUploadManager" />
		<!--- Search functionality including initial dataload <p>roSearchService : <strong>mvc.models.Distributor.DistributorSearchService</strong></p> -->
		<!--- roErrorService : <strong>mvc.models.ErrorService</strong> -->
		<mx:RemoteObject id="ErrorService" destination="ColdFusion" source="mvc.models.ErrorService" />
		<mx:RemoteObject id="EditSearchService" 	destination="ColdFusion"	source="mvc.Models.Billback.BillbackEditSearchManager" />
		<!-- FlexEvent.PREINITIALIZE   ******************************************************************************** -->
		<!---@see com.ContractProds.models.SettingsManager#loadURLParameters()
		Invoke : com.ContractProds.models.SettingsManager.loadURLParameters()-->
		<EventHandlers type="{FlexEvent.PREINITIALIZE}" id="ePREINITIALIZE" useWeakReference="true">
			<ObjectBuilder generator="{BBUploadManager}" id="oBBUploadManager" constructorArguments="{scope.dispatcher}"  />
			<ObjectBuilder generator="{BBUploadItemsGridManager}" id="oBBUploadItemsGridManager" constructorArguments="{scope.dispatcher}"  />
			<ObjectBuilder generator="{SettingsManager}" id="oSettingsManager" />
			<ObjectBuilder generator="{UploadManager}" id="oUploadManager" constructorArguments="{scope.dispatcher}"  />
			<ObjectBuilder generator="{BBUploadPModel}" id="oBBUploadPModel" constructorArguments="{scope.dispatcher}" />
			<ObjectBuilder generator="{BBUploadItemsPModel}" id="oBBUploadItemsPModel" constructorArguments="{scope.dispatcher}" />
			<ObjectBuilder generator="{BBUploadFilterPModel}" id="oBBUploadFilterPModel" constructorArguments="{scope.dispatcher}" />
			<ObjectBuilder generator="{BAError}" id="oBAError"  />
		</EventHandlers>
		
		<!-- FlexEvent.APPLICATION_COMPLETE     ************************************************************************* -->
		<EventHandlers type="{FlexEvent.CREATION_COMPLETE}" id="eCREATION_COMPLETE" useWeakReference="true" debug="false">
			<!--call db for other settings  sourceCache="global"-->
			<!--<EventAnnouncer type="{BBUploadEvent.BB_LOAD_APP_SETTINGS}" generator="{BBUploadEvent}" >
			<Property source="{SettingsManager}" sourceKey="settings.userId" targetKey="userId" />
			</EventAnnouncer>-->
			<!--Get Data ********  modify the property tag to send to the get GET ************-->
			<!--<EventAnnouncer type="{BBUploadEvent.GET}" generator="{BBUploadEvent}" >
			<Property sourceCache="inherit" source="{SettingsManager}" sourceKey="settings.programId" targetKey="programId"/>
			</EventAnnouncer>-->
		</EventHandlers>
		
		<!--GET DATA ******** modify this event to get data from CF ************ -->
		
		<EventHandlers type="{BBUploadEvent.LOAD_BB_EDIT}" id="eLOAD_BB_EDIT">
			<RemoteObjectInvoker instance="{MainService}" showBusyCursor="true" method="getBillbackUploadDetail" arguments="{[event.bbUploadHeader,event.bDisplayAll]}">
				<resultHandlers>
					<MethodInvoker generator="{BBUploadManager}" method="getBillbackResults" arguments="{resultObject}" />
				</resultHandlers>	
				<faultHandlers>	
					<EventAnnouncer type="{BBUploadEvent.BSA_ERROR}" generator="{BBUploadEvent}" >
						<Properties sBaError="BB Upload (LOAD_BB_EDIT)" />
						<Properties oBaError="{fault}" />
					</EventAnnouncer>
				</faultHandlers>
			</RemoteObjectInvoker>
		</EventHandlers>
		
		<EventHandlers type="{BBUploadEvent.VALIDATE}" id="eVALIDATE">
			<RemoteObjectInvoker instance="{MainService}" showBusyCursor="true" method="saveUploadHeaderAndDetails" arguments="{[event.bbUploadHeader,event.sAction]}">
				<resultHandlers>
					<MethodInvoker generator="{BBUploadManager}" method="getBillbackResultsFromValidate" arguments="{[resultObject,event.sAction]}" />
				</resultHandlers>	
				<faultHandlers>	
					<EventAnnouncer type="{BBUploadEvent.BSA_ERROR}" generator="{BBUploadEvent}" >
						<Properties sBaError="BB Upload (VALIDATE)" />
						<Properties oBaError="{fault}" />
					</EventAnnouncer>
				</faultHandlers>
			</RemoteObjectInvoker>
		</EventHandlers>
		
		
		<EventHandlers type="{BBUploadEvent.DELETE_BB_UPLOAD}" id="eDELETE_BB_UPLOAD">
			<RemoteObjectInvoker instance="{MainService}" showBusyCursor="true" method="deleteUploadHeaderAndDetails" arguments="{event.bbUploadHeader}">
				<resultHandlers>
					<MethodInvoker generator="{BBUploadManager}" method="getBillbackResultsFromDelete" arguments="{resultObject}" />
				</resultHandlers>	
				<faultHandlers>	
					<EventAnnouncer type="{BBUploadEvent.BSA_ERROR}" generator="{BBUploadEvent}" >
						<Properties sBaError="BB Upload (VALIDATE)" />
						<Properties oBaError="{fault}" />
					</EventAnnouncer>
				</faultHandlers>
			</RemoteObjectInvoker>
		</EventHandlers>
		
		<EventHandlers type="{BBUploadEvent.DELETE_CORRECTION_ROW}"  id="eDELETE_CORRECTION_ROW" useWeakReference="true">
			<RemoteObjectInvoker instance="{MainService}" showBusyCursor="true" method="deleteCorrectionRecords" arguments="{event.uploadIDList}">
				 <resultHandlers>
					<MethodInvoker generator="{BBUploadManager}" method="getBillbackResultsFromDelete" arguments="{resultObject}" />
				</resultHandlers> 
				<faultHandlers>	
					<EventAnnouncer type="{BBUploadEvent.BSA_ERROR}" generator="{BBUploadEvent}" >
						<Properties sBaError="BB Upload (Delete Correction Row)" />
						<Properties oBaError="{fault}" />
					</EventAnnouncer>
				</faultHandlers>
			</RemoteObjectInvoker>	
		</EventHandlers>	
		
		<EventHandlers type="{MainEvent.DELETE_ROW}"  id="eDELETE_ROW" useWeakReference="true">
			<RemoteObjectInvoker instance="{MainService}" showBusyCursor="true" method="deleteBBUploadDetail" arguments="{event.objRowData}">
				<resultHandlers>
					<MethodInvoker generator="{BBUploadManager}" method="deleteBBUploadDetailResult" arguments="{resultObject}" />
				</resultHandlers> 
				<faultHandlers>	
					<EventAnnouncer type="{BBUploadEvent.BSA_ERROR}" generator="{BBUploadEvent}" >
						<Properties sBaError="BB Upload (Delete Correction Row)" />
						<Properties oBaError="{fault}" />
					</EventAnnouncer>
				</faultHandlers>
			</RemoteObjectInvoker>	
		</EventHandlers>
		
		<EventHandlers type="{MainEvent.UPDATE_ROW}"  id="eUPDATE_ROW" useWeakReference="true">
				<MethodInvoker generator="{BBUploadManager}" method="updateRow" arguments="{event}" />	
		</EventHandlers>
		
		
		<!--GET BILLBACK LOCK ******** modify this event to get lock data from cf for a billback ************ -->
		<EventHandlers type="{BBUploadEvent.GET_LOCK_BB_EDIT}" id="eGET_LOCK_BB_EDIT" useWeakReference="true">
			<RemoteObjectInvoker instance="{MainService}" showBusyCursor="true" method="getLockUnlockBB" arguments="{event.bbHeaderID}">
				<resultHandlers>
					<MethodInvoker generator="{BBUploadManager}" method="getLockBB" arguments="{resultObject}" />
				</resultHandlers>	
				<faultHandlers>	
					<EventAnnouncer type="{BBUploadEvent.BSA_ERROR}" generator="{BBUploadEvent}" >
						<Properties sBaError="UPLOADED BB LOCK SERVICE (GET_LOCK_BB_EDIT)" />
						<Properties oBaError="{fault}" />
					</EventAnnouncer>
				</faultHandlers>
			</RemoteObjectInvoker>
		</EventHandlers>
		
		<!--GET BILLBACK LOCK ******** modify this event to get lock data from cf for a billback ************ -->
		<EventHandlers type="{BBUploadEvent.LOCK_BB_EDIT}" id="eLOCK_BB_EDIT" debug="true" useWeakReference="true">		
			<RemoteObjectInvoker instance="{MainService}" showBusyCursor="true" method="lockUnlockBB" arguments="{[event.bbHeaderID, event.userId, event.lockIt,event.bbtoggle,event.bbUnlockExistingLockedByUser,event.bbClose]}">
				<resultHandlers>
					<MethodInvoker generator="{BBUploadManager}" method="getLockBB" arguments="{[resultObject,event.bbClose]}" />
				</resultHandlers>	
				<faultHandlers>	
					<EventAnnouncer type="{BBUploadEvent.BSA_ERROR}" generator="{BBUploadEvent}" >
						<Properties sBaError=" BB CORRECTIONS LOCK SERVICE (LOCK_BB_EDIT)" />
						<Properties oBaError="{fault}" />
					</EventAnnouncer>
				</faultHandlers>
			</RemoteObjectInvoker>
		</EventHandlers>
		
		<!--SET GRID LOCK ******** modify this event to get PRODUCT SEARCH ************ -->
		<EventHandlers type="{BBUploadEvent.SET_GRID_LOCK_UNLOCK}" id="eSET_GRID_LOCK_UNLOCK" debug="true" useWeakReference="true">
			<MethodInvoker generator="{BBUploadItemsGridManager}" method="setGridLockUnlock" arguments="{[event.lockIt]}" />
		</EventHandlers>
		
		<!--UNLOCK_OTHER_LOCKED_USER ******** modify this event to unlock all existing billbacks locked by a user (except the one requested lock on) ************ -->
		<EventHandlers type="{BBUploadEvent.UNLOCK_OTHER_LOCKED_USER}" id="eUNLOCK_OTHER_LOCKED_USER" debug="true" useWeakReference="true">
			<MethodInvoker generator="{BBUploadManager}" method="unlockOtherLockedUser" arguments="{event.bbUploadHeader}" />
		</EventHandlers>
		
		<!--HIDE/SHOW TOP MENU AND SET LOCK/UNLOCK PROPERTY-->
		<EventHandlers type="{BBUploadEvent.SET_BB_TOOLS_LOCK}" id="eSET_BB_TOOLS_LOCK" debug="true" useWeakReference="true">
			<MethodInvoker generator="{BBUploadManager}" method="callobjBBToolsLock" arguments="{event.bbToolsLock}" />
		</EventHandlers>
		
		<!--............... UPLOAD_FILE ............................................-->
		<!--<EventHandlers type="{MainEvent.UPLOAD_FILE}" debug="true" id="eUPLOAD_FILE" useWeakReference="true">
		<MethodInvoker generator="{UploadManager}" method="browseAndUpload" arguments="{event}" />
		</EventHandlers>-->
		
		<!--............... SET_APP_SETTINGS ............................................-->
		<EventHandlers type="{MainEvent.SET_LOCAL_APP_SETTINGS}" debug="true" id="eSET_LOCAL_APP_SETTINGS" useWeakReference="true">
			<MethodInvoker generator="{SettingsManager}" method="setLocalAppSettings" arguments="{event}" />
		</EventHandlers>
		
		<!--GET VENDOR SEARCH ******** modify this event to get vendor search ************ -->
		<EventHandlers type="{BBUploadEvent.LOAD_VENDOR_SEARCH}" id="eLOAD_VENDOR_SEARCH" debug="true" useWeakReference="true">
			<MethodInvoker generator="{BBUploadManager}" method="showVendorSearch" />
		</EventHandlers>
		
		<!--GET DISTRIBUTOR SEARCH ******** modify this event to get vendor search ************ -->
		<EventHandlers type="{BBUploadEvent.LOAD_DISTRIBUTOR_SEARCH}" id="eLOAD_DISTRIBUTOR_SEARCH" debug="true" useWeakReference="true">
			<MethodInvoker generator="{BBUploadManager}" method="showDistributorSearch" />
		</EventHandlers>	
		
		<EventHandlers type="{BBUploadEvent.LOAD_DISTRIBUTOR}" id="eLOAD_DISTRIBUTOR" debug="true" useWeakReference="true">
			<RemoteObjectInvoker instance="{EditSearchService}" showBusyCursor="true" method="getDistributorData" arguments="{event.distributorId}">
				<resultHandlers>
					<MethodInvoker generator="{BBUploadManager}" method="setDistributorInfo" arguments="{resultObject}" />
				</resultHandlers>	
				<faultHandlers>	
					<EventAnnouncer type="{BBUploadEvent.BSA_ERROR}" generator="{BBUploadEvent}" >
						<Properties sBaError="DISTRIBUTOR SERVICE (setDistributorInfo)" />
						<Properties oBaError="{fault}" />
					</EventAnnouncer>
				</faultHandlers>
			</RemoteObjectInvoker>
		</EventHandlers>
		
		<!-- Operator Section -->		
		<!--GET Operator DATA ******** modify this event to get data from CF for a Operator ************ -->
		<EventHandlers type="{BBUploadEvent.LOAD_OPERATOR}" id="eLOAD_OPERATOR" debug="true" useWeakReference="true">
			<RemoteObjectInvoker instance="{EditSearchService}" showBusyCursor="true" method="getOperatorData" arguments="{event.operatorId}">
				<resultHandlers>
					<MethodInvoker generator="{BBUploadManager}" method="setOperatorInfo" arguments="{resultObject}" />
				</resultHandlers>	
				<faultHandlers>	
					<EventAnnouncer type="{BBUploadEvent.BSA_ERROR}" generator="{BBUploadEvent}" >
						<Properties sBaError="OPERATOR SERVICE (setOperatorInfo)" />
						<Properties oBaError="{fault}" />
					</EventAnnouncer>
				</faultHandlers>
			</RemoteObjectInvoker>
		</EventHandlers>
		
		<!--GET Operator SEARCH ******** modify this event to get payee SEARCH ************ -->
		<EventHandlers type="{BBUploadEvent.LOAD_OPERATOR_SEARCH}" id="eLOAD_OPERATOR_SEARCH" debug="true" useWeakReference="true">
			<MethodInvoker generator="{BBUploadManager}" method="showOperatorSearch" />
		</EventHandlers>
		
		
		<!-- ************************************************
		ADD NEW EventHandlers Here   *******************
		************************************************-->
		
		<!--LOAD APP SETTINGS *************************************************************************** -->
		
		<!--<EventHandlers type="{BBUploadEvent.BB_LOAD_APP_SETTINGS}" useWeakReference="true" debug="false" >
		<RemoteObjectInvoker instance="{MainService}" showBusyCursor="true" method="getSettingsObject" arguments="{event.userId}" debug="false" >
		
		<resultHandlers>
		<MethodInvoker generator="{SettingsManager}" method="setAppSettings" arguments="{resultObject}"  />
		</resultHandlers>
		
		<faultHandlers>
		
		<EventAnnouncer type="{BBUploadEvent.BSA_ERROR}" generator="{BBUploadEvent}">
		<Properties sBaError="SEARCH SETTINGS SERVICE (load app settings event = LOAD_APP_SETTINGS)" />
		<Properties oBaError="{fault}" />
		</EventAnnouncer>
		</faultHandlers>
		</RemoteObjectInvoker>
		</EventHandlers>-->
		
		<!--SET STATE FOR SEARCH ITEMS *************************************************************************** -->
		
		
		
		<!--	*****************************************************************************************
		***		BSA CUSTOM ERROR HANDLER 		*************************************************
		***************************************************************************************** -->
		
		<!---  	<p>First display the error to the user</p>
		<p>Then Try to log the error on the cf server</p> 
		<p>there is a fault Logging the error on the server show the "ERROR SERVICE" Message</p>
		<p>*********************************************************************************</p>
		*      @see com.ContractProds.models.BAError#showBAError()
		** Invoke : com.ContractProds.models.BAError.showBAError()		
		*			@see #roErrorService
		** RemoteInvoke : roErrorService.logError()
		*		@see com.ContractProds.models.BAError#logError() 
		** faultHandler : com.ContractProds.models.BAError.showBAError()   -->
		<EventHandlers type="{BBUploadEvent.BSA_ERROR}" useWeakReference="true">
			<MethodInvoker generator="{BAError}" method="showBAError" arguments="{event.oBaError}" cache="none" >
				<Properties BAErrorString="{event.sBaError}" />
			</MethodInvoker>
			<!--log error on server-->	
			<!--<RemoteObjectInvoker instance="{ErrorService}" method="logError" arguments="{[event.oBaError.faultDetail, event.oBaError.faultString]}">
			<faultHandlers>
			<MethodInvoker generator="{BAError}" method="showBAError" arguments="{fault}" cache="none" >
			<Properties BAErrorString="ERROR SERVICE: The server is not responding.  Please contact support." />
			</MethodInvoker>
			</faultHandlers>
			</RemoteObjectInvoker>-->
		</EventHandlers>
		
		<!--GLOBAL ERROR HANDLER  *********************************************************************** -->
		<EventHandlers type="{UnhandledFaultEvent.FAULT}" useWeakReference="true">
			<MethodInvoker generator="{BAError}" method="showBAError" arguments="{event.fault}" cache="none" >
				<Properties BAErrorString="UNHANDLED" />
			</MethodInvoker>
			
			<RemoteObjectInvoker instance="{ErrorService}" method="logError" arguments="{[event.fault.faultDetail, event.fault.faultString]}"/>
		</EventHandlers>
		
		<!--..................................................................................................................................................................-->
		<!--..................................................................................................................................................................-->
		<!--........................................................................... INJECTORS ............................................................................-->
		<!--..................................................................................................................................................................-->
		<!--..................................................................................................................................................................-->
		
		<!-- BBUploadPModel ....................................................... -->
		<Injectors target="{BBUploadPModel}" debug="false">
			<PropertyInjector targetKey="oSettings" source="{SettingsManager}" sourceKey="settings"  softBinding="false" />
			<PropertyInjector targetKey="bbUploadHeader" source="{BBUploadManager}" sourceKey="bbUploadHeader"  softBinding="false" />
			<PropertyInjector targetKey="acMenuData" source="{BBUploadManager}" sourceKey="acMenuData"  softBinding="false" />
			<PropertyInjector targetKey="BBLock" source="{BBUploadManager}" sourceKey="BBLock"  softBinding="false"  />
			<PropertyInjector targetKey="objBBToolsLock" source="{BBUploadManager}" sourceKey="objBBToolsLock"  softBinding="false" />
		</Injectors>
		
		<!-- BBSearchGridPModel ....................................................... -->
		<Injectors target="{BBUploadItemsPModel}" debug="false">
			<PropertyInjector targetKey="oSettings" source="{SettingsManager}" sourceKey="settings"  softBinding="false" />
			<PropertyInjector targetKey="bbUploadHeader" source="{BBUploadManager}" sourceKey="bbUploadHeader"  softBinding="false" />
			<PropertyInjector targetKey="arrBBUploadItemsDgCols" source="{BBUploadItemsGridManager}" sourceKey="arrBBUploadItemsDgCols"  softBinding="false" />
		</Injectors>
		
		<!-- BBUploadFilterPModel ....................................................... -->
		<Injectors target="{BBUploadFilterPModel}" debug="false">
			<PropertyInjector targetKey="oSettings" source="{SettingsManager}" sourceKey="settings"  softBinding="false" />
			<PropertyInjector targetKey="bbUploadHeader" source="{BBUploadManager}" sourceKey="bbUploadHeader"  softBinding="false" />
		</Injectors>
		
		<!-- BBUploadManager ....................................................... -->
		<Injectors target="{BBUploadManager}" debug="false">
			<PropertyInjector targetKey="oSettings" source="{SettingsManager}" sourceKey="settings"  softBinding="false" />
		</Injectors>
		
		<!-- BBUpload ....................................................... -->
		<Injectors target="{BBUpload}" debug="false">
			<PropertyInjector targetKey="pModel" source="{BBUploadPModel}" softBinding="false"/>
		</Injectors>
		
		<!-- BBHeaderForm ....................................................... -->
		<Injectors target="{BBHeaderForm}" debug="false">
			<PropertyInjector targetKey="pModel" source="{BBUploadPModel}" softBinding="false"/>
			<PropertyInjector targetKey="pModelBBUploadItems" source="{BBUploadItemsPModel}" softBinding="false"/>
		</Injectors>
		
		<!-- BBUploadItemsGrid ....................................................... -->
		<Injectors target="{BBUploadItemsGrid}" debug="false">
			<PropertyInjector targetKey="pModel" source="{BBUploadItemsPModel}" softBinding="false"/>
			<PropertyInjector targetKey="pUploadModel" source="{BBUploadPModel}" softBinding="false"/>
		</Injectors>
		
		<!-- BBUploadItemsGridManager ....................................................... -->
		<Injectors target="{BBUploadItemsGridManager}" debug="false">
			<PropertyInjector targetKey="objBBToolsLock" source="{BBUploadManager}" sourceKey="objBBToolsLock"  softBinding="false" />
		</Injectors>
	</fx:Declarations>
</LocalEventMap>
