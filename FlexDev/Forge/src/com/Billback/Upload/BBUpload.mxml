<?xml version="1.0" encoding="utf-8"?>
<s:Module xmlns:fx="http://ns.adobe.com/mxml/2009"
		  xmlns:s="library://ns.adobe.com/flex/spark" 
		  xmlns:mx="library://ns.adobe.com/flex/mx"
		  xmlns:view="com.Billback.Upload.views.*" 
		  xmlns:maps="com.Billback.Upload.maps.*" 
		  xmlns:vos="com.Billback.Upload.vos.*" 
		  creationComplete="applyRuntimeStyleSheet();" 
		  implements="com.Billback.Main.models.IBBUpload"  
		  width="100%"
		  height="100%">
	
	<s:layout>
		<s:VerticalLayout/>
	</s:layout>
	<fx:Declarations>
		<!-- Event Maps __________________________________________________ -->
		<maps:BBUploadEventMap dispatcher="{this}" cache="local" />
		
	</fx:Declarations>
	
	
	<fx:Style>
		@namespace s "library://ns.adobe.com/flex/spark";
		@namespace mx "library://ns.adobe.com/flex/mx";
		
		s|Label#labelDisplay {
			textAlign: left;
		}
		
		/* 	s|FormItem {
		textAlign: left;
		skinClass: ClassReference("com.Billback.Upload.views.skins.FormValidatorItemSkin");
		} */
		
	</fx:Style>
	<fx:Script><![CDATA[
		import com.Billback.Main.models.IBBEdit;
		import com.Billback.Main.models.vos.BBHeader;
		import com.Billback.Upload.events.BBUploadEvent;
		import com.Billback.Upload.models.vos.BBUploadDetail;
		import com.Billback.Upload.models.vos.BBUploadDetailError;
		import com.Billback.Upload.models.vos.BBUploadHeader;
		import com.Billback.Upload.views.pm.BBUploadPModel;
		import com.shared.events.MainEvent;
		import com.shared.models.SettingsManager;
		import com.shared.vos.Settings;
		
		import mx.collections.ArrayCollection;
		import mx.core.mx_internal;
		[Bindable]
		private var bbUploadHeader:BBUploadHeader;
		private var bbUploaddetail:BBUploadDetail = new BBUploadDetail();;
		private var bbUploaddetailError:BBUploadDetailError;
		/* Presentation Model */
		[Bindable]
		public var pModel:BBUploadPModel;
		
		
		private function applyRuntimeStyleSheet():void {
			//styleManager.loadStyleDeclarations("/flex/mainFx410.swf")
			SettingsManager.applyRuntimeStyleSheet(mx_internal::VERSION,this);
		}
		
		
		public function setSettings(settings:Settings):void{
			var event:MainEvent = new MainEvent ( MainEvent.SET_LOCAL_APP_SETTINGS );
			event.settings = settings;
			this.dispatchEvent( event );
		}
		
		public function setBB(bbh:BBUploadHeader):void{
			if(bbh){
				//setting new date will cause detail rows to get loaded
				bbh.updatedDate = new Date();
				var event:BBUploadEvent = new BBUploadEvent ( BBUploadEvent.LOAD_BB_EDIT );
				event.bbUploadHeader = bbh;
				this.bbUploadHeader = bbh
				this.dispatchEvent( event );
			}
			
		}
		public function getBB():BBUploadHeader{
			return this.bbUploadHeader;
		}
		
		/* Unlock billbacks locked by the user, other than the one requested lock on */
		public function setLockedUnlocked():void{
			/*  This function is being called from "BillbackMain.mxml". The call could be for multiple modules at a time.
			Every module has it's own pModel and so we can find out the bb upload details from the pModel.
			*/		
			var event:BBUploadEvent = new BBUploadEvent ( BBUploadEvent.UNLOCK_OTHER_LOCKED_USER );
			event.bbUploadHeader = pModel.bbUploadHeader;
			this.dispatchEvent( event );
		}
	]]>
	</fx:Script>
	
	<!-- Views _______________________________________________________ -->
	<s:VGroup width="100%" height="100%" >
		<view:BBHeaderForm id="BBHeaderForm" width="100%" />
		<view:BBUploadItemsGrid id="BBUploadItemsGrid" height="100%" />
	</s:VGroup>
</s:Module>
