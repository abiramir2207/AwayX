<?xml version="1.0" encoding="utf-8"?>
<!--- Popup that shows valid and invalid billback ID's, while adding favorites. -->
<s:TitleWindow 
			xmlns:fx="http://ns.adobe.com/mxml/2009" 
			xmlns:s="library://ns.adobe.com/flex/spark" 
			xmlns:mx="library://ns.adobe.com/flex/mx" 
			backgroundColor="0xffffff"
			close="PopUpManager.removePopUp(this)"
			color="0x333333"
			name="validAndInvalidItemIDs"
			title="Item IDs">
	<fx:Script>
		<![CDATA[
			import flash.events.Event;
			import mx.events.*;
			import mx.managers.PopUpManager;
			import mx.collections.ArrayList;
			
			[Bindable]
			public var aInvalidItems:Array;
			[Bindable]
			public var aValidItems:Array;
			
		]]>
	</fx:Script>
	
	<mx:VBox horizontalAlign="center">
		<mx:Label text="Invalid Billback IDs" fontWeight="bold"/>		
		<s:List id="lsInvalidItemIDs" alternatingItemColors="[#bbffbb,#ffffff]" dataProvider="{new ArrayList(aInvalidItems)}" name="lsInvalidItemIDs" width="100%" toolTip="These are Invalid Billback IDs" enabled="true" allowMultipleSelection="true"/>
		<mx:Label text="Valid Billback IDs" fontWeight="bold"/>
		<s:List id="lsValidItemIDs" alternatingItemColors="[#bbffbb,#ffffff]" dataProvider="{new ArrayList(aValidItems)}" name="lsValidItemIDs" width="100%" toolTip="These are Valid Billback IDs" enabled="true" allowMultipleSelection="true"/>		
	</mx:VBox>		
</s:TitleWindow>