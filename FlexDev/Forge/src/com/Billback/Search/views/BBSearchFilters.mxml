									keyDown="enterSearchBox(event)"
									/>
								
								<s:DropDownList
									id="drpDateRangeStartCriteria"
									labelField="description"
									toolTip="filter:Start Date Condition"
									width="54"
									dataProvider="{new ArrayList(this.pModel.objLookupData.criteriaList)}"
									selectedIndex="{this.pModel.DefaultOption}"
									keyDown="enterSearchBox(event)"
									/>
							</s:HGroup> 
							<mx:DateField id="dtSearchDateRangeStart" toolTip="Date Search on selected Start Date Type and Date Condition" editable="true" keyDown="enterSearchBox(event)"/>
						</s:HGroup>
						<s:HGroup verticalAlign="top">
							<s:HGroup width="320"> 
								<s:Label paddingTop="5" text="Amount" width="55" />
								
								<s:DropDownList
									id="drpAmountType"
