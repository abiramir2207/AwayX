										<s:VerticalLayout requestedMaxRowCount="8" horizontalAlign="justify"/>
									</local:layout>
								</local:MultiSelectionDropDown>	
							</s:HGroup>
						</s:HGroup> 
						
						<s:HGroup>
							<s:HGroup verticalAlign="middle" width="320">
								<s:Label text="Program" width="55" />
								<s:TextInput 
									tabEnabled="true"			  	
									id="tiProgram" 
									toolTip="Keyword search on any of the fields:&#13; Program #,Title"			
									height="{this.pModel.oSettings.cfApp_textInputHeight}"
									width="160"
									keyDown="enterSearchBox(event)"
									/>
							</s:HGroup> 
							<s:HGroup verticalAlign="middle" width="405">
								<s:Label text="{this.pModel.oSettings.appFlex.bbLabels.Analyst}" width="50" />
								<local:MultiSelectionDropDown
									id="drpAnalyst"
									labelField="fullName"
									toolTip="filter:{this.pModel.oSettings.appFlex.bbLabels.Analyst}"
									width="189"
									requireSelection="false" 							
									currentSelection="{this.pModel.objBBFilterParams.analystListSelect}"
									itemRenderer="com.shared.components.MultiSelectItemRenderer"
									skinClass="com.shared.components.MultiSelectionDropDownListSkin"
									dataProvider="{new ArrayList(this.pModel.objLookupData.analystList)}"
									keyDown="enterSearchBox(event)"
									>	
									<!--selectionChange="FilterBillbacks('search')"
									selectedIndex="{this.pModel.DefaultOption}" close="this.pModel.updateAnalyst(drpAnalyst.arrSelectedItems)"
									change="this.pModel.updateAnalyst(drpAnalyst.arrSelectedItems)"-->
									<local:layout>
										<s:VerticalLayout requestedMaxRowCount="8" horizontalAlign="justify"/>
									</local:layout>
								</local:MultiSelectionDropDown>	
							</s:HGroup>
							<s:HGroup verticalAlign="middle" width="350">
								<s:Label text="{this.pModel.oSettings.appFlex.bbLabels.Closing_Method}" width="90"/>
								<local:MultiSelectionDropDown
									id="drpClosingMethod"
									labelField="description"
									toolTip="filter:{this.pModel.oSettings.appFlex.bbLabels.Closing_Method}"
									width="189"
									requireSelection="false"
									currentSelection="{this.pModel.objBBFilterParams.closingMethodSelect}"
									itemRenderer="com.shared.components.MultiSelectItemRenderer"
									skinClass="com.shared.components.MultiSelectionDropDownListSkin"
									dataProvider="{new ArrayList(this.pModel.objLookupData.closingMethodList)}"	
									keyDown="enterSearchBox(event)"
									>	
									<!--selectionChange="FilterBillbacks('search')"
									selectedIndex="{this.pModel.DefaultOption}"-->
									<local:layout>
										<s:VerticalLayout requestedMaxRowCount="8" horizontalAlign="justify"/>
									</local:layout>
								</local:MultiSelectionDropDown>	
							</s:HGroup>
						</s:HGroup>
						
						<s:HGroup>
							<s:HGroup verticalAlign="middle" width="320">
								<s:Label text="{this.pModel.oSettings.appFlex.bbLabels.Type}" width="55" />
								<local:MultiSelectionDropDown
									id="drpBBType"
									labelField="description"
									toolTip="filter:{this.pModel.oSettings.appFlex.bbLabels.Type}"
									width="189"
									requireSelection="false"
									currentSelection="{this.pModel.objBBFilterParams.typeListSelect}"
									itemRenderer="com.shared.components.MultiSelectItemRenderer"
									skinClass="com.shared.components.MultiSelectionDropDownListSkin"
									dataProvider="{new ArrayList(this.pModel.objLookupData.typeList)}"
									keyDown="enterSearchBox(event)"
									>	
									<!--selectionChange="FilterBillbacks('search')"
									selectedIndex="{this.pModel.DefaultOption}"-->
									<local:layout>
										<s:VerticalLayout requestedMaxRowCount="8" horizontalAlign="justify"/>
									</local:layout>
								</local:MultiSelectionDropDown>	
							</s:HGroup> 
							<s:HGroup verticalAlign="middle" width="405">
								<s:Label text="{this.pModel.oSettings.appFlex.bbLabels.Payee}" width="50"/>
								<s:TextInput
									tabEnabled="true"			  	
									id="tiPayee" 
									toolTip="Keyword search on any of the fields:&#13; {this.pModel.oSettings.appFlex.bbLabels.Payee} ID,{this.pModel.oSettings.appFlex.bbLabels.Payee} Name"			
									height="{this.pModel.oSettings.cfApp_textInputHeight}"
									width="160"
									keyDown="enterSearchBox(event)"
									/>
							</s:HGroup>
							<s:HGroup > 
								<s:Label paddingTop="5" text="Start Date" width="90" />
								<s:DropDownList
									id="drpDateRangeStartType"
									labelField="description"
									toolTip="filter:Start Date Type"
									width="100"
									dataProvider="{new ArrayList(this.pModel.objLookupData.dateTypeList)}"
