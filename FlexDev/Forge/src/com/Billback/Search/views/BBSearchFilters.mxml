<?xml version="1.0" encoding="utf-8"?>
<!-- When a user clicks on the panel and the grid's expands and occupies the space taken by the bb filter screen - This can happen
only when we have no height for the filter screen (s:Group below). Below I have minHeight as 0 and maxHeight as 215. This takes care
of the issue. It seems since we have no height, the grid can take the place occupied by the filter screen.
-->
<s:Group color="0x333333"
		 minHeight="0"
		 maxHeight="{this.pModel.nHeightContainer}"
		 width="{this.pModel.nWidthContainer}"
		 xmlns:fx="http://ns.adobe.com/mxml/2009" 
		 xmlns:s="library://ns.adobe.com/flex/spark" 
		 xmlns:mx="library://ns.adobe.com/flex/mx" 
		 xmlns:local="com.shared.views.renderer.*"
		 xmlns:ba="com.shared.components.*"
		 xmlns:mate="http://mate.asfusion.com/"
		 creationComplete="fnInitialize();"
		 >
	<s:layout>
		<s:VerticalLayout/>
	</s:layout>
	
	<fx:Declarations>
		<!-- Place non-visual elements (e.g., services, value objects) here -->
		<s:RadioButtonGroup id="DataLoadType" selectedValue="{this.pModel.dataViewOption}" itemClick="loadCurrentData(event);" />
	</fx:Declarations>
	<fx:Script>	
		<![CDATA[
			import com.Billback.Main.models.vos.*;
			import com.Billback.Main.models.vos.BBHeader;
			import com.Billback.Search.events.*;
			import com.Billback.Search.events.BBSearchEvent;
			import com.Billback.Search.views.pm.BBSearchFiltersPModel;
			import com.Billback.Search.views.pm.BBSearchGridPModel;
			import com.asfusion.mate.events.Dispatcher;
			import com.shared.components.HTMLToolTip;
			
			import flash.sampler.NewObjectSample;
			
			import mx.collections.ArrayList;
			import mx.collections.IList;
			import mx.controls.Alert;
			import mx.controls.ToolTip;
			import mx.events.ItemClickEvent;
			import mx.events.ListEvent;
			import mx.events.ToolTipEvent;
			import mx.managers.ToolTipManager;
			import mx.utils.ObjectUtil;
			
			/* Presentation Model */
			[Bindable]
			public var pModel:BBSearchFiltersPModel;
			[Bindable]
			public var pModelSearchGrid:BBSearchGridPModel;			
			[Bindable]
			private var sToolTip:String;
			/*
			This function get called when the filters are initialized and it is mainly called
			to set the tooltip properties.
			*/
			public function fnInitialize():void  
			{
				//set tool tip maxwidth so that the rate decimal tool tip takes up more horizontally space than vertical
				ToolTipManager.toolTipClass = HTMLToolTip;
				ToolTip.maxWidth = 550;
				setToolTip();
			}
			
			private function setToolTip():void
			{
				/* 
				The below variable is used to set the tooltip on the Data view **Check the <textformat> tag within the help "leading"  actually
				equals the padding property.
				*/
				this.sToolTip = "<textformat leading='8'>Current = Billbacks created within the last " + this.pModel.oSettings.appSettings.BB_Created_Recently_Days + " days that are <u>not</u> in Paid or Approved-Void status" + "\n"
					+ "Current including paid/void = All billbacks, includes those in Paid and Approved-Void status" + "\n </textformat>";
			}
			
			public function fnPositionToolTip(event:ToolTipEvent):void
			{
				var pt:Point = event.currentTarget.contentToGlobal(new Point(0,0));
				ToolTipManager.currentToolTip.y = pt.y - 85; // 68
				ToolTipManager.currentToolTip.x = pt.x - 20;
				ToolTipManager.currentToolTip.height = 50;
				
			}
			
			/* for handling any action related to file */
			private var objFileRef:FileReference = new FileReference();
			
			/* Hide/Show controls based on user selection. */
			private function loadCurrentData(event:ItemClickEvent):void
			{
				if(event.currentTarget.selectedValue == 'current'){
					/* Load the data from the shared object */
					this.pModel.loadCurrent();		
				}		
				
				this.pModel.dataViewOption = event.currentTarget.selectedValue;				
			}
			
			public function TextBoxfilterReset(resetType:String):void
			{
				this.pModel.resetType = resetType;
				
				/* Reset the textbox values */
				tiPayableNumber.text = '';
				tiBillbackNumber.text = '';
				tiProgram.text = '';
				tiPayee.text = '';
				tiEntitySearch.text = '';
				tiAmountValue.text = '';
				dtSearchDateRangeStart.text = '';
				dtSearchDateRangeEnd.text = '';
				tiCheckNumber.text = '';
				chkDuplicate.selected = false;
				
				/* Reset the checkboxes in the dropdowns */
				//this.pModel.objLookupData.analystList = this.pModel.objLookupData.analystList;
				
				if(this.pModel.resetType == 'FullReset')
				{
					
					/* Set the "Data View" radio button option to "current" */
					DataLoadType.selectedValue = 'current';	
					
					/* Fire the click event on the selected radio button ("current" option) above */
					DataLoadType.dispatchEvent(new ItemClickEvent(ItemClickEvent.ITEM_CLICK));
				}
				
				/* Reset controls, other than textbox values */
				var eventReset:BBSearchEvent = new BBSearchEvent(BBSearchEvent.RESET_FILTERS);
				
				/* When the user attaches documents to billbacks, the result set gets filtered to those billbacks. Then when the user clicks 
				on "options", then all the filters need to be reset. For that purpose, I need to send eRefreshData = true.
				On clicking of "reset", we do not need it, as the Data View needs to be set to current" view, which already takes care of it,
				*/
				if(this.pModel.resetType == 'BBFilterForDocs')
				{
					eventReset.eRefreshData = true;
				}
				else
				{
					eventReset.eRefreshData = false;
				}
				
				this.dispatchEvent(eventReset);
				
				/* If there are any previously checked items, uncheck them */
				var eventUncheckSelected:BBSearchEvent = new BBSearchEvent(BBSearchEvent.UNCHECK_SELECTED);
				this.dispatchEvent(eventUncheckSelected);
				
				/* Set the height of the top search filters section to it's original height. The code will only be useful when a user
				chooses the "reassign" option from the "action" dropdown for which the height of the screen needs to be increased so that
				the "Reassign To" dropdown can be added on an additional row. Once the user clicks reset, this code will set the screen to 
				it's original height.
				*/
				var eventSearchScreenHeight:BBSearchEvent = new BBSearchEvent ( BBSearchEvent.BB_SEARCH_FILTERS_SCREEN_HEIGHT);							
				eventSearchScreenHeight.eSearchFiltersScreenHeightIncrease = false;
				
				this.dispatchEvent( eventSearchScreenHeight );
			}
			
			private function FilterBillbacks(type:String):void
			{
				
				/* Set bGetFavorites = true, so that "saveBBFilterParams" function is  not fired before it should, when user either 
				saves the "Favorites" list OR loads "Archive" data.
				*/
				if(type == 'userList')
				{
					this.pModel.bGetFavorites =  true;				
				}
					/* When user searches for "current including paid/void" data */
				else if(this.pModel.dataViewOption == 'current_including_paid')
				{
					this.pModel.bSearchData = true;
				}
				
				/* All the selected values from the different textboxes and dropdowns or any other control are now a part of "BBFilterParams" object */
				this.pModel.updatePayableNumber(tiPayableNumber.text);
				this.pModel.updateBBNumber(tiBillbackNumber.text);
				this.pModel.updateProgram(tiProgram.text);
				this.pModel.updatePayee(tiPayee.text);
				this.pModel.updateAmountValue(drpAmountType.selectedItem,drpAmountCriteria.selectedItem,tiAmountValue.text);
				this.pModel.updateEntity(drpEntity.selectedItem,tiEntitySearch.text);
				this.pModel.updateCheckNumber(tiCheckNumber.text);
				
				this.pModel.updateStatus(drpStatus.arrSelectedItems);
				this.pModel.updateAnalyst(drpAnalyst.arrSelectedItems);
				this.pModel.updateClosingMethod(drpClosingMethod.arrSelectedItems);
				this.pModel.updateBBType(drpBBType.arrSelectedItems);
				this.pModel.updateDateRangeStartValue(drpDateRangeStartType.selectedItem,drpDateRangeStartCriteria.selectedItem,dtSearchDateRangeStart.text);
				this.pModel.updateDateRangeEndValue(drpDateRangeEndType.selectedItem,drpDateRangeEndCriteria.selectedItem,dtSearchDateRangeEnd.text);
				this.pModel.updateAmountValue(drpAmountType.selectedItem,drpAmountCriteria.selectedItem,tiAmountValue.text);
				this.pModel.updateEntity(drpEntity.selectedItem,tiEntitySearch.text);
				this.pModel.updateActions(drpActions.selectedItem);
				this.pModel.updateUser(drpHistory.selectedItem,drpUser.arrSelectedItems);
				this.pModel.updateConditionsValue(drpConditions.selectedItem);
				if (this.chkDuplicate.selected)
				{
					this.pModel.updateDuplicateCheck(true);	
				}
				else
				{
					this.pModel.updateDuplicateCheck(false);
				}
				
				/* This is called for searching, whether it is "current" or "current including paid/void" */
				if(type == 'search'){
					
					this.pModel.updateSearchData();
					//this.pModel.saveBBFilterParams();	
				} 
					/* User saving "favorites" data */
				else{			  
					if(tListName.text.length == 0){
						Alert.show("Please enter a name for your favorites");
					}
					else{
						this.pModel.saveUserList(tListName.text);
						tListName.text = '';
					}			  	
				}			   
			}
			
			/* Call this when the user hits the "Enter" key */
			private function enterSearchBox(event:KeyboardEvent):void 
			{        
				if (event.keyCode == Keyboard.ENTER)
				{
					/* call main filter method */       
					
					FilterBillbacks('search');
				}
			}
			
			private function validateUserListItems():void
			{
				if(this.lsUserList.selectedItems.length == 0)
				{
					Alert.show("Please select a list to display");
				}
				else
				{
					/* If the favorite returns any billback in paid/approved-void status besides non-paid (if any) */				
					if(this.lsUserList.selectedItem.currentIncludingPaid == true){					
						/* Set the "Data View" radio button option to "current including paid/void" */
						DataLoadType.selectedValue = 'current_including_paid';							
					}
					else{	
						/* When the user searches for a billback in non-paid status right after searching
						for in paid/void status,reset the datasource to the original data. This will make sure 
						when the filtering happens correctly, especially for full-text search.
						*/
						if(DataLoadType.selectedValue == 'current_including_paid'){
							
							TextBoxfilterReset('FullReset');
						}
						
						/* Set the "Data View" radio button option to "Current" */
						DataLoadType.selectedValue = 'current';	
					}
					/* Without this, when the user retrieves favorites having paid data (not paid status) and then filters that data
					by paid status, the code does not allow to search by paid data */
					this.pModel.dataViewOption = DataLoadType.selectedValue.toString();
					/* Get data */
					this.pModel.getUserListItems(this.lsUserList.selectedItem);
				}
			}
			
			/* handler for when a user presses enter on a Saved user List row (lsUserList)*/
			private function enterUserListRow(event:KeyboardEvent):void 
			{                
				if (event.keyCode == Keyboard.ENTER) 
				{
					/* ITEM_DOUBLE_CLICK calls validateUserListItems()   */                   
					lsUserList.dispatchEvent(new ListEvent(ListEvent.ITEM_DOUBLE_CLICK));
				}
			}
			
			private function validateDeleteUserList():void
			{
				if(this.lsUserList.selectedItems.length == 0)
				{
					Alert.show("Please select a list to delete");				
				}
				else
				{
					this.pModel.deleteUserList(this.lsUserList.selectedItem.userBillbackListId);
				}
			}
			
			private function callupdateActions():void
			{   
				this.pModel.updateActions(drpActions.selectedItem);
			}
			
			/* Reset the filter for uploaded docs and then reset the entire grid. Do not reset the "Data View" though, i.e.
			if the user was in "current" OR "current including paid/void" or "Year" Data View, let the screen be in that view.
			*/
			private function updateBBFilterForDocs():void
			{   
				if(this.pModel.objBBFilterParams.BBIDIntList.length > 0)
				{
					this.pModel.bFilterBBForUploadedDocs =  false;
					this.pModel.objBBFilterParams.BBIDIntList = new Array();
					TextBoxfilterReset('BBFilterForDocs');
				}
			}
		]]>
	</fx:Script>	
	<ba:MinMaxPanel id="header" width="{this.pModel.nWidthContainer}" height="{this.pModel.nHeightContainer}" borderStyle="none" panelTitle="Billback Search Results: {this.pModelSearchGrid.acData.length} records" showMaximize="false" showMinimize="true">
		<!-- tbNavList.selectedIndex is 1 when the user is on the "tools" tab. So, when the user clicks on "options" tab, 
		since the tbNavList.selectedIndex is 1, "updateBBFilterForDocs" is fired to reset the filter for uploaded docs.
		Now tbNavList.selectedIndex is set to 0 and so this code is not fired when the user clicks on "tools" tab.
		-->
		<s:ButtonBar skinClass="com.shared.views.skins.ButtonBarBa" dataProvider="{tbNavList}" requireSelection="true" click="if(tbNavList.selectedIndex == 1){updateBBFilterForDocs()}"  /> 		
		<s:VGroup id="vgHeader" height="100%" paddingTop="20">
			<mx:ViewStack id="tbNavList" width="100%" height="100%"  
						  selectedIndex="{this.pModel.intNavListSelectedIndex}">	
				<s:NavigatorContent label="options" width="100%" height="100%">
					<s:VGroup top="5">
						<s:HGroup>
							<s:HGroup verticalAlign="middle" width="320">
								<s:Label text="{this.pModel.oSettings.appFlex.bbLabels.Payable}" width="55" />
								<s:TextInput
									tabEnabled="true"			  	
									id="tiPayableNumber" 
									toolTip="Keyword search on any of the fields:&#13; {this.pModel.oSettings.appFlex.bbLabels.Payable} #,{this.pModel.oSettings.appFlex.bbLabels.Title}"			
									height="{this.pModel.oSettings.cfApp_textInputHeight}"
									width="160"
									keyDown="enterSearchBox(event)"
									/>
							</s:HGroup>
							
							<s:HGroup verticalAlign="middle" width="405">
								<s:Label text="{this.pModel.oSettings.appFlex.bbLabels.Billback} #" width="50"/>
								<s:TextInput
									tabEnabled="true"			  	
									id="tiBillbackNumber" 
									toolTip="Keyword search on any of the fields:&#13; {this.pModel.oSettings.appFlex.bbLabels.Billback} #,{this.pModel.oSettings.appFlex.bbLabels.Reference_Number} #"			
									height="{this.pModel.oSettings.cfApp_textInputHeight}"
									width="160"
									keyDown="enterSearchBox(event)"
									/>
							</s:HGroup>
							
							<s:HGroup verticalAlign="middle">
								<s:Label text="Status" width="90" />
								<local:MultiSelectionDropDown
									id="drpStatus"
									labelField="description"
									toolTip="filter:Status"
