<mx:Canvas xmlns:mx="http://www.adobe.com/2006/mxml"
    implements="mx.controls.listClasses.IDropInListItemRenderer">
    
    <mx:Script>
        <![CDATA[
        	import com.asfusion.mate.events.Dispatcher;
        	import com.Billback.Main.models.vos.BBHeader;
        	import spark.components.PopUpAnchor;
        	import spark.events.PopUpEvent;
        	import com.Billback.Search.views.popup;
        	import mx.controls.Alert;
			import mx.utils.ObjectUtil;
			import mx.managers.PopUpManager;
			import flash.display.DisplayObject;
			import mx.core.Application;
			import mx.core.IFlexDisplayObject;
			import mx.core.FlexGlobals;
			import flash.events.Event;
			import com.Billback.Search.events.BBSearchEvent;
        
           // import mx.events.CollectionEvent;
            import mx.controls.advancedDataGridClasses.AdvancedDataGridListData;
            //import mx.collections.ArrayCollection;
             import mx.controls.AdvancedDataGrid
            //import mx.controls.advancedDataGridClasses.AdvancedDataGridColumn;
            import mx.controls.listClasses.BaseListData;
            
            private var _listData:BaseListData;
            //private var _dataGrid:AdvancedDataGrid;
            //private var _dataField:String;
            //[Bindable] private var _CBselected:Boolean = false;
            //[Bindable] private var _headerLabel:String;
            

            [Bindable("dataChange")]
            public function get listData():BaseListData
            {
                return _listData;
            }
        
            public function set listData(value:BaseListData):void
            {
                _listData = value;
               // _dataGrid = value.owner as AdvancedDataGrid;
               // _dataField = (value as AdvancedDataGridListData).dataField;
               // 
               //
            }
            
            public var pop_up:popup;
            //public var d:Dispatcher = new Dispatcher();
			/* This is used to open the pop up for program details */
			private function openBillbackDetails():void{	
				
			//pop_up = popup(PopUpManager.createPopUp(this as DisplayObject,popup,true));
			pop_up = PopUpManager.createPopUp(DisplayObject(systemManager),popup, true, null, moduleFactory) as popup;
			
				pop_up.ObjBBHeader = this.data as BBHeader;

				pop_up.height=600;
				pop_up.width=800;
	
				PopUpManager.centerPopUp(pop_up);
				
				/* Pass the event dispatcher to the pop up page. Events cannot be easily fired from the popup as the popup page behaves like the parent application and so
				   the dispatcher needs to be passed from here so that the events can be fired from the pop up page.
				   (BillbackMain.mxml)
				 */
				pop_up.dDispatcher = this as IEventDispatcher;
				
				/* Due to timing issue, calling the getBillbackDetails from here, instead of the pop up page */
				pop_up.getBillbackDetails();	
			}
	            
            /* Billback Preview */
			private function openBillbackSummary() : void{  
	 	        	var jsURL:String ="/BillbackID_Wrapper.cfm?Billback_ID_Int="+this.data.billbackIDInt+"&Page_Relocate=/billbacks/capture/bb_preview.cfm";
	 
				var jscommand:String = "window.open('"+jsURL+"','winPreview','height=640,width=815,toolbar=no,scrollbars=yes,resizable=yes');"   
				var url:URLRequest = new URLRequest("javascript:" + jscommand + " void(0);");   
				navigateToURL(url, "_self"); 
			}
			
			/* This is used to decide whether to show the deviation link or not */			
			[Bindable]
			private function getDeviationInfo(bdeviationAllowed:Boolean):String
			{				
				var deviationText:String = '';
				
					  if(bdeviationAllowed == true)
					  {
					  	deviationText = '[val]'
					  } 					  
				return deviationText;
			}
			
		/* This is used to open the pop up for the deviation screen */
 		private function openDeviationScreen():void
		{
			var jsURL:String = "/BillbackID_Wrapper.cfm?Billback_ID_Int="+this.data.billbackIDInt+"&userID="+parentDocument.userId+"&Page_Relocate=/flex/Billback/BillbackDevAppFX.cfm";
			var jscommand:String = "window.open('"+ jsURL + "','winDeviationScreen','height=640,width=1300,left=0,toolbar=no,scrollbars=yes,resizable=yes');";			
			var url:URLRequest = new URLRequest("javascript:" + jscommand + " void(0);"); 
			navigateToURL(url, "_self"); 
		}	
        ]]>
    </mx:Script>

<mx:HBox verticalAlign="top" horizontalGap="0">
<mx:Text fontSize="9" text="[preview]" click="openBillbackSummary()" useHandCursor="true" mouseChildren="false" buttonMode="true" toolTip="Click here for billback preview"/>
<mx:Text fontSize="9" text="[details]" click="openBillbackDetails()" useHandCursor="true" mouseChildren="false" buttonMode="true" toolTip="Click here for billback details"/>	
<!-- mx:Text fontSize="10"  color="green" text="{getDeviationInfo(this.data.deviationAllowed)}" click="openDeviationScreen()" useHandCursor="true" buttonMode="true" mouseChildren="false" toolTip="BB Deviation tool for {this.data.BBCode}" /-->
	<mx:Text fontSize="10"  color="green" text="{getDeviationInfo(this.data.deviationAllowed)}" click="{parentDocument.pModel.selectBB(parentDocument.dgBBSearch.selectedItem as BBHeader,'Deviation')}" useHandCursor="true" buttonMode="true" mouseChildren="false" toolTip="BB Deviation tool for {this.data.BBCode}" />	
</mx:HBox>	

