<?xml version="1.0" encoding="utf-8"?>
<LocalEventMap 
	xmlns:fx="http://ns.adobe.com/mxml/2009" 
	xmlns:mx="library://ns.adobe.com/flex/mx"
	xmlns="http://mate.asfusion.com/" xmlns:mate="http://mate.asfusion.com/"
	xmlns:maps="com.Billback.Edit.maps.*">
	<fx:Script>
		<![CDATA[
			import com.Billback.Edit.BBEdit;
			import com.Billback.Edit.events.*;
			import com.Billback.Main.events.*;
			import com.Billback.Edit.models.*;
			import com.Billback.Edit.views.*;
			import com.Billback.Edit.views.pm.*;
			import com.asfusion.mate.core.*;
			import com.asfusion.mate.events.UnhandledFaultEvent;
			import com.shared.events.MainEvent;
			import com.shared.models.*;
			
			import mx.events.*;
			//import com.ContractProds.vos.*;
			[Bindable]
			private var bDebug:Boolean = false;
			[Bindable]
			private var bSoftBinding:Boolean = false;
		]]>
	</fx:Script>
	<fx:Declarations>
		<!--<mate:Debugger level="{Debugger.ALL}" />-->
		<!-- load up an instance of the remote objects -->
		<!-- Remote Services  ***************************************************************************************** -->
		<mx:RemoteObject id="MainService" 			destination="ColdFusion"	source="mvc.Models.Billback.BillbackManager"  />
		<mx:RemoteObject id="MainEditService" 		destination="ColdFusion"	source="mvc.Models.Billback.BillbackEditManager" />
		<mx:RemoteObject id="EditSearchService" 	destination="ColdFusion"	source="mvc.Models.Billback.BillbackEditSearchManager" />
		<mx:RemoteObject id="ProgramService" 		destination="ColdFusion"	source="mvc.Models.Program.ProgramManager" />
		<mx:RemoteObject id="LoadService" 			destination="ColdFusion"	source="mvc.Models.Billback.BillbackLoadManager" />
		<mx:RemoteObject id="SettlementService" 	destination="ColdFusion"	source="mvc.Models.Billback.BillbackSettlementManager" />
		<mx:RemoteObject id="ErrorService"			destination="ColdFusion"	source="mvc.models.ErrorService" />
		<mx:RemoteObject id="DeductionService" 		destination="ColdFusion" source="mvc.Models.Deduction.DeductionManager" />
		<!--- Search functionality including initial dataload <p>roSearchService : <strong>mvc.models.Distributor.DistributorSearchService</strong></p> -->
		<!--- roErrorService : <strong>mvc.models.ErrorService</strong> -->
		
		<!-- FlexEvent.PREINITIALIZE   ******************************************************************************** -->
		<!---@see com.ContractProds.models.SettingsManager#loadURLParameters()
		Invoke : com.ContractProds.models.SettingsManager.loadURLParameters()-->
		<EventHandlers type="{FlexEvent.PREINITIALIZE}" id="ePREINITIALIZE" useWeakReference="true">
			<ObjectBuilder generator="{BBEditManager}" id="oBBEditManager" constructorArguments="{scope.dispatcher}"  />
			<ObjectBuilder generator="{BBEditItemsGridManager}" id="oBBEditItemsGridManager" constructorArguments="{scope.dispatcher}"  />
			<ObjectBuilder generator="{BBClosingDetailGridManager}" id="oBBClosingDetailGridManager" constructorArguments="{scope.dispatcher}"  />
			<ObjectBuilder generator="{SettingsManager}" id="oSettingsManager"  />
			<ObjectBuilder generator="{BBEditPModel}" id="oBBEditPModel" constructorArguments="{scope.dispatcher}" />
			<ObjectBuilder generator="{BBEditItemsPModel}" id="oBBEditItemsPModel" constructorArguments="{scope.dispatcher}" />
			<ObjectBuilder generator="{BBSettlementPModel}" id="oBBSettlementPModel" constructorArguments="{scope.dispatcher}" />
			<ObjectBuilder generator="{BAError}" id="oBAError"  />
			<!--<MethodInvoker generator="{SettingsManager}" method="loadURLParameters"  />-->
		</EventHandlers>
		
		<!-- FlexEvent.APPLICATION_COMPLETE     ************************************************************************* -->
		<EventHandlers type="{FlexEvent.CREATION_COMPLETE}" id="eCREATION_COMPLETE" useWeakReference="true" debug="{bDebug}">
			<!--call db for other settings  sourceCache="global"-->
			<!--  CALLED ON LOAD WHEN USER_ID IS PASSED IN
			<EventAnnouncer type="{BBEditEvent.BB_LOAD_APP_SETTINGS}" generator="{BBEditEvent}" >
			<Property source="{SettingsManager}" sourceKey="settings.userId" targetKey="userId" />
			</EventAnnouncer>-->
			<!--Get Data ********  modify the property tag to send to the get GET ************-->
			<!--<EventAnnouncer type="{BBEditEvent.GET}" generator="{BBEditEvent}" >
			<Property sourceCache="inherit" source="{SettingsManager}" sourceKey="settings.programId" targetKey="programId"/>
			</EventAnnouncer>-->
			<!--<EventAnnouncer type="{BBEditEvent.LOAD_ITEM_LIST}" generator="{BBEditEvent}" />-->
			<EventAnnouncer type="{BBEditEvent.LOAD_ITEM_LIST_SO}" generator="{BBEditEvent}" />
			<EventAnnouncer type="{BBEditEvent.LOAD_UOM_DP}" generator="{BBEditEvent}"  />
		</EventHandlers>
		
		<!--LOAD BILLBACK DATA	******** MODULE CALL FROM BB SEARCH TO LOAD BB DATA FROM CF  ************ -->
		<EventHandlers type="{BBEditEvent.LOAD_BB_EDIT}" id="eLOAD_BB_EDIT" debug="{bDebug}" useWeakReference="true">
			<RemoteObjectInvoker instance="{MainService}" showBusyCursor="true" method="getBillback" arguments="{[event.bbHeader.billbackIDInt,event.bbHeader.copyAction]}">
				<resultHandlers>
					<MethodInvoker generator="{BBEditManager}" method="getBillbackResults" arguments="{resultObject}" />						
				</resultHandlers>	
				<faultHandlers>	
					<EventAnnouncer type="{BBEditEvent.BSA_ERROR}" generator="{BBEditEvent}" >
						<Properties sBaError="BB EDIT SERVICE (getBillbackResults)" />
						<Properties oBaError="{fault}" />
					</EventAnnouncer>
				</faultHandlers>
			</RemoteObjectInvoker>
		</EventHandlers>
		
		<!--CREATE NEW BILLBACK **************************************************** -->
		<EventHandlers type="{BBEditEvent.CREATE_NEW_BB}" id="eCREATE_NEW_BB" debug="{bDebug}" useWeakReference="true">
			<ObjectBuilder generator="{BBEditManager}" constructorArguments="{scope.dispatcher}"  />
			<EventAnnouncer type="{BBEditEvent.LOAD_UOM_DP}" generator="{BBEditEvent}" />
			<MethodInvoker generator="{BBEditManager}" method="createNewBillback" arguments="{event.billback}" />
		</EventHandlers>
		
		<!--LOAD UOM DP DATA	******** LOAD UOM's INTO A NEW BILLBACK ************ -->
		<EventHandlers type="{BBEditEvent.LOAD_UOM_DP}" id="eLOAD_UOM_DP" debug="{bDebug}" useWeakReference="true">
			<ObjectBuilder generator="{BBEditManager}" constructorArguments="{scope.dispatcher}"  />
			<RemoteObjectInvoker instance="{MainService}" showBusyCursor="true" method="getUomDp">
				<resultHandlers>
					<MethodInvoker generator="{BBEditManager}" method="getUomDp" arguments="{resultObject}" />
				</resultHandlers>	
				<faultHandlers>	
					<EventAnnouncer type="{BBEditEvent.BSA_ERROR}" generator="{BBEditEvent}" >
						<Properties sBaError="UOM DP SERVICE (getUomDp)" />
						<Properties oBaError="{fault}" />
					</EventAnnouncer>
				</faultHandlers>
			</RemoteObjectInvoker>
		</EventHandlers>
		
		<!--BILLBACK VALIDATE COMPONENETS ******** before save validate compnents ************ -->
		<!-- <EventHandlers type="{BBEditEvent.VALIDATE_BB_EDIT_COMP}" id="eVALIDATE_BB_EDIT_COMP" debug="{bDebug}" useWeakReference="true">
		<MethodInvoker generator="{BBEditManager}" method="validateComponents" />
		</EventHandlers> -->
		
		<!--SAVE BILLBACK VALIDATE HEADER ******** before save validate, then call save ************ -->
		<EventHandlers type="{BBEditEvent.VALIDATE_BB_EDIT_HDR}" id="eVALIDATE_BB_EDIT_HDR" debug="{bDebug}" useWeakReference="true">
			<MethodInvoker generator="{BBEditManager}" method="validateBBDates"/>
		</EventHandlers>
		
		<!--SAVE BILLBACK VALIDATE DETAIL ******** before save validate, then call save ************ -->
		<EventHandlers type="{BBEditEvent.VALIDATE_BB_EDIT_DTL}" id="eVALIDATE_BB_EDIT_DTL" debug="{bDebug}" useWeakReference="true">
			<MethodInvoker generator="{BBEditManager}" method="validateBBDetail"/>
		</EventHandlers>
		
		
		<!--SAVE BILLBACK ******** modify this event to save billback data ************ -->
		<EventHandlers type="{BBEditEvent.SAVE_BB_EDIT}" id="eSAVE_BB_EDIT" debug="{bDebug}" useWeakReference="true">
			<RemoteObjectInvoker instance="{MainEditService}" showBusyCursor="true" method="saveBillback" arguments="{event.billback}" debug="{bDebug}">
				<resultHandlers>
					<MethodInvoker generator="{BBEditManager}" method="setSaveCompleted" arguments="{resultObject}" />
					<!--<MethodInvoker generator="{BBEditManager}" method="getBillbackResults" arguments="{resultObject}" />-->
					<!-- Whenver the edit page gets billback data, update the search bbheader -->
					<EventAnnouncer type="{BBMainEvent.UPDATE_SEARCH_BBHEADER}" generator="{BBMainEvent}" dispatcherType="global">
						<Properties bbHeader="{resultObject}" />
					</EventAnnouncer>					
				</resultHandlers>	
				<faultHandlers>
					<MethodInvoker generator="{BBEditManager}" method="clearSaveMessage" arguments="{fault}" />
					<EventAnnouncer type="{BBEditEvent.BSA_ERROR}" generator="{BBEditEvent}" >
						<Properties sBaError="BB SAVE SERVICE (saveBillbackData)" />
						<Properties oBaError="{fault}" />
					</EventAnnouncer>					
				</faultHandlers>
			</RemoteObjectInvoker>
		</EventHandlers>
		
		<EventHandlers type="{BBEditEvent.SAVE_BB_EDIT_SETTLE}" id="eSAVE_BB_EDIT_SETTLE" debug="{bDebug}" useWeakReference="true">
			<RemoteObjectInvoker instance="{MainEditService}" showBusyCursor="true" method="saveBillback" arguments="{event.billback}">
				<resultHandlers>
					<!--  This method SAVES THE RETURNED bb AND dispatches the RUN_DEVIATIONS event (if BB is wip) [handled below] ******************** -->
					<MethodInvoker generator="{BBEditManager}" method="runDeviations" arguments="{resultObject}" />
					<!-- Whenver the edit page gets billback data, update the search bbheader -->
					<EventAnnouncer type="{BBMainEvent.UPDATE_SEARCH_BBHEADER}" generator="{BBMainEvent}" dispatcherType="global">
						<Properties bbHeader="{resultObject}" />
					</EventAnnouncer>
				</resultHandlers>	
				<faultHandlers>	
					<EventAnnouncer type="{BBEditEvent.BSA_ERROR}" generator="{BBEditEvent}" >
						<Properties sBaError="BB SAVE SERVICE (saveBillbackData)" />
						<Properties oBaError="{fault}" />
					</EventAnnouncer>
				</faultHandlers>
			</RemoteObjectInvoker>
		</EventHandlers>
		
		
		<!-- RUN DEVIATIONS ******************** -->
		<EventHandlers type="{BBEditEvent.RUN_DEVIATIONS}" id="eRUN_DEVIATIONS" debug="{bDebug}" useWeakReference="true">
			<RemoteObjectInvoker instance="{MainEditService}" showBusyCursor="true" method="runBillbackDeviation" arguments="{[event.bbIdInt, event.userId]}">
				<resultHandlers>
					<!-- THIS METHOD CHECKS PERMISSIONS AND THEN DISPATCHES BBMainEvent.LOAD_DEVIATIONS [HANDLED IN BBMainEvent] ******************** -->
					<MethodInvoker generator="{BBEditManager}" method="loadDeviations" arguments="{resultObject}" />
				</resultHandlers>	
				<faultHandlers>	
					<EventAnnouncer type="{BBEditEvent.BSA_ERROR}" generator="{BBEditEvent}" >
						<Properties sBaError="BB SAVE SERVICE (saveBillbackData)" />
						<Properties oBaError="{fault}" />
					</EventAnnouncer>
				</faultHandlers>
			</RemoteObjectInvoker>
		</EventHandlers>
		
		<!--INSERT NEW ROW **************************************************** -->
		<EventHandlers type="{MainEvent.INSERT_ROW}" id="eINSERT_ROW" debug="{bDebug}" useWeakReference="true">
			<MethodInvoker generator="{BBEditManager}" method="dgBBEditItemInsertRow" arguments="{event.currentRow}" />
		</EventHandlers>
		
		<!--SELECT ROW **************************************************** -->
		<EventHandlers type="{MainEvent.SELECT_ROW}" id="eSELECT_ROW" debug="{bDebug}" useWeakReference="true">
			<MethodInvoker generator="{BBEditManager}" method="dgBBEditItemSelectRow" arguments="{event.objRowData}" />
		</EventHandlers>	
		
		<!--UPDATE COMPONENT **************************************************** -->
		<EventHandlers type="{MainEvent.COMPONENT_UPDATE}" id="eCOMPONENT_UPDATE" debug="{bDebug}" useWeakReference="true">
			<MethodInvoker generator="{BBEditManager}" method="bbComponentUpdate" arguments="{event.component}" />
		</EventHandlers>		
		
		<!-- Program Section -->
		<!--GET PROGRAM DATA ******** modify this event to get data from CF for a program ************ -->
		<EventHandlers type="{BBEditEvent.LOAD_PROGRAM}" id="eLOAD_PROGRAM" debug="{bDebug}" useWeakReference="true" >
			<RemoteObjectInvoker instance="{ProgramService}" showBusyCursor="true" method="getProgram" arguments="{[event.programId, 0, 0, 1, event.payeeTypeId, 1]}">
				<resultHandlers>
					<MethodInvoker generator="{BBEditManager}" method="setProgramInfo" arguments="{resultObject}" />
				</resultHandlers>	
				<faultHandlers>	
					<EventAnnouncer type="{BBEditEvent.BSA_ERROR}" generator="{BBEditEvent}" >
						<Properties sBaError="PROGRAM SERVICE (getProgram)" />
						<Properties oBaError="{fault}" />
					</EventAnnouncer>
				</faultHandlers>
			</RemoteObjectInvoker>
		</EventHandlers>
		
		<!--GET PROGRAM LIST ******** modify this event to get data from CF for a program ************ -->
		<EventHandlers type="{BBEditEvent.LOAD_PROGRAM_LIST}" id="eLOAD_PROGRAM_LIST" debug="{bDebug}" useWeakReference="true">
			<!--<RemoteObjectInvoker instance="{EditSearchService}" showBusyCursor="true" method="testProgramList" >-->
			<RemoteObjectInvoker instance="{EditSearchService}" showBusyCursor="true" method="getProgramList" 
								 arguments="{[event.userId, event.billback.bbHeader.startDate, event.billback.bbHeader.endDate, event.payee, event.programNumber]}">
				<resultHandlers>
					<MethodInvoker generator="{BBEditManager}" method="setProgramList" arguments="{resultObject}" />
				</resultHandlers>	
				<faultHandlers>	
					<EventAnnouncer type="{BBEditEvent.BSA_ERROR}" generator="{BBEditEvent}" >
						<Properties sBaError="PROGRAM LIST SERVICE (getProgramList)" />
						<Properties oBaError="{fault}" />
					</EventAnnouncer>
				</faultHandlers>
			</RemoteObjectInvoker>
		</EventHandlers>
		
		<!--GET PROGRAM SEARCH ******** modify this event to get PROGRAM SEARCH ************ -->
		<EventHandlers type="{BBEditEvent.LOAD_PROGRAM_SEARCH}" id="eLOAD_PROGRAM_SEARCH" debug="{bDebug}" useWeakReference="true">
			<MethodInvoker generator="{BBEditManager}" method="showProgramSearch" />
		</EventHandlers>
		
		
		<!-- Vendor Section -->
		<!--GET VENDOR DATA ******** modify this event to get data from CF for a vendor ************ -->
		<EventHandlers type="{BBEditEvent.LOAD_VENDOR}" id="eLOAD_VENDOR" debug="{bDebug}" useWeakReference="true">
			<RemoteObjectInvoker instance="{EditSearchService}" showBusyCursor="true" method="getVendorData" arguments="{event.vendorId}">
				<resultHandlers>
					<MethodInvoker generator="{BBEditManager}" method="setVendorInfo" arguments="{resultObject}" />
				</resultHandlers>	
				<faultHandlers>	
					<EventAnnouncer type="{BBEditEvent.BSA_ERROR}" generator="{BBEditEvent}" >
						<Properties sBaError="VENDOR  SERVICE (setVendorInfo)" />
						<Properties oBaError="{fault}" />
					</EventAnnouncer>
				</faultHandlers>
			</RemoteObjectInvoker>
		</EventHandlers>
		
		<!--VENDOR INPUT CHANGE ******************** -->
		<EventHandlers type="{BBEditEvent.SET_VENDOR_INPUT_CHANGE}" id="eSET_VENDOR_INPUT_CHANGE" debug="{bDebug}" useWeakReference="true">
			<MethodInvoker generator="{BBEditManager}" method="setVendorInputChange" arguments="{event.vendorId}" />
		</EventHandlers>
		
		<!--CLEAR VENDOR SELECTED ******************** -->
		<EventHandlers type="{BBEditEvent.CLEAR_SELECTED_VENDOR}" id="eCLEAR_SELECTED_VENDOR" debug="{bDebug}" useWeakReference="true">
			<MethodInvoker generator="{BBEditManager}" method="setVendorInfo" arguments="{event.vendor}" />
		</EventHandlers>
		
		<!--CLEAR PROGRAM, COMPONENT ITEMS SELECTED [Called after a User changes Vendor]  This Will Then Call BBEditEvent.LOAD_VENDOR ******************** -->
		<EventHandlers type="{BBEditEvent.CLEAR_PROG_COMP_ITEMS}" id="eCLEAR_PROG_COMP_ITEMS" debug="{bDebug}" useWeakReference="true">
			<MethodInvoker generator="{BBEditManager}" method="clearBBProgCompItems" arguments="{event.vendorId}" />
		</EventHandlers>
		
		<!--GET VENDOR SEARCH ******** modify this event to get vendor search ************ -->
		<EventHandlers type="{BBEditEvent.LOAD_VENDOR_SEARCH}" id="eLOAD_VENDOR_SEARCH" debug="{bDebug}" useWeakReference="true">
			<MethodInvoker generator="{BBEditManager}" method="showVendorSearch" arguments="{event.vendorSearchType}" />
		</EventHandlers>
		
		<!-- Payee Section -->
		<!--GET PAYEE DATA ******************** -->
		<EventHandlers type="{BBEditEvent.LOAD_PAYEE}" id="eLOAD_PAYEE" debug="{bDebug}" useWeakReference="true">
			<MethodInvoker generator="{BBEditManager}" method="setPayeeInfo" arguments="{event.payee}" />
		</EventHandlers>
		
		<!--GET PAYEE LIST ******** modify this event to get data from CF for a payee list ************ -->
		<EventHandlers type="{BBEditEvent.LOAD_PAYEE_LIST}" id="eLOAD_PAYEE_LIST" debug="{bDebug}" useWeakReference="true">
			<RemoteObjectInvoker instance="{EditSearchService}" showBusyCursor="true" method="getPayeeList" arguments="{event.vendorId}">
				<resultHandlers>
					<MethodInvoker generator="{BBEditManager}" method="setPayeeList" arguments="{resultObject}" />
				</resultHandlers>	
				<faultHandlers>	
					<EventAnnouncer type="{BBEditEvent.BSA_ERROR}" generator="{BBEditEvent}" >
						<Properties sBaError="PAYEE SERVICE (setPayeeInfo)" />
						<Properties oBaError="{fault}" />
					</EventAnnouncer>
				</faultHandlers>
			</RemoteObjectInvoker>
		</EventHandlers>
		
		<!--SET PAYEE LIST ******** modify this event to set payee list ************ -->
		<EventHandlers type="{BBEditEvent.SET_PAYEE_LIST}" id="eSET_PAYEE_LIST" debug="{bDebug}" useWeakReference="true">
			<ObjectBuilder generator="{BBEditManager}" constructorArguments="{scope.dispatcher}"  />
			<MethodInvoker generator="{BBEditManager}" method="setPayeeList" arguments="{event.payeeList}" />
		</EventHandlers>
		
		<!--GET PAYEE DISTRIBUTOR DATA ******** modify this event to get data from CF for a Distributor AS Payee ************ -->
		<EventHandlers type="{BBEditEvent.LOAD_PAYEE_DISTRIBUTOR}" id="eLOAD_PAYEE_DISTRIBUTOR" debug="{bDebug}" useWeakReference="true">
			<RemoteObjectInvoker instance="{EditSearchService}" showBusyCursor="true" method="getDistributorData" arguments="{event.distributorId}">
				<resultHandlers>
					<MethodInvoker generator="{BBEditManager}" method="setPayeeDistributorInfo" arguments="{resultObject}" />
				</resultHandlers>	
				<faultHandlers>	
					<EventAnnouncer type="{BBEditEvent.BSA_ERROR}" generator="{BBEditEvent}" >
						<Properties sBaError="PAYEE DISTRIBUTOR SERVICE (setPayeeDistributorInfo)" />
						<Properties oBaError="{fault}" />
					</EventAnnouncer>
				</faultHandlers>
			</RemoteObjectInvoker>
		</EventHandlers>		
		
		<!--GET Payee SEARCH ******** modify this event to get payee search ************ -->
		<EventHandlers type="{BBEditEvent.LOAD_PAYEE_SEARCH}" id="eLOAD_PAYEE_SEARCH" debug="{bDebug}" useWeakReference="true">
			<MethodInvoker generator="{BBEditManager}" method="showPayeeSearch" />
		</EventHandlers>	
		
		
		<!-- Distributor Section -->
		<!--GET DISTRIBUTOR DATA ******** modify this event to get data from CF for a Distributor ************ -->
		<EventHandlers type="{BBEditEvent.LOAD_DISTRIBUTOR}" id="eLOAD_DISTRIBUTOR" debug="{bDebug}" useWeakReference="true">
			<RemoteObjectInvoker instance="{EditSearchService}" showBusyCursor="true" method="getDistributorData" arguments="{event.distributorId}">
				<resultHandlers>
					<MethodInvoker generator="{BBEditManager}" method="setDistributorInfo" arguments="{resultObject}" />
				</resultHandlers>	
				<faultHandlers>	
					<EventAnnouncer type="{BBEditEvent.BSA_ERROR}" generator="{BBEditEvent}" >
						<Properties sBaError="DISTRIBUTOR SERVICE (setDistributorInfo)" />
						<Properties oBaError="{fault}" />
					</EventAnnouncer>
				</faultHandlers>
			</RemoteObjectInvoker>
		</EventHandlers>
		
		<!--GET DISTRIBUTOR SEARCH ******** modify this event to get payee SEARCH ************ -->
		<EventHandlers type="{BBEditEvent.LOAD_DISTRIBUTOR_SEARCH}" id="eLOAD_DISTRIBUTOR_SEARCH" debug="{bDebug}" useWeakReference="true">
			<MethodInvoker generator="{BBEditManager}" method="showDistributorSearch" />
		</EventHandlers>
		
		<!--GET DISTRIBUTOR SELECTED ******** modify this event to get payee SEARCH ************ -->
		<EventHandlers type="{BBEditEvent.LOAD_DISTRIBUTOR_SELECTED}" id="eLOAD_DISTRIBUTOR_SELECTED" debug="{bDebug}" useWeakReference="true">
			<MethodInvoker generator="{BBEditManager}" method="setSelectedDistributorInfo" arguments="{event.distributorId}" />
		</EventHandlers>
		
		
		<!-- Operator Section -->		
		<!--GET Operator DATA ******** modify this event to get data from CF for a Operator ************ -->
		<EventHandlers type="{BBEditEvent.LOAD_OPERATOR}" id="eLOAD_OPERATOR" debug="{bDebug}" useWeakReference="true">
			<RemoteObjectInvoker instance="{EditSearchService}" showBusyCursor="true" method="getOperatorData" arguments="{event.operatorId}">
				<resultHandlers>
					<MethodInvoker generator="{BBEditManager}" method="setOperatorInfo" arguments="{resultObject}" />
				</resultHandlers>	
				<faultHandlers>	
					<EventAnnouncer type="{BBEditEvent.BSA_ERROR}" generator="{BBEditEvent}" >
						<Properties sBaError="OPERATOR SERVICE (setOperatorInfo)" />
						<Properties oBaError="{fault}" />
					</EventAnnouncer>
				</faultHandlers>
			</RemoteObjectInvoker>
		</EventHandlers>
		
		<!--GET Operator SEARCH ******** modify this event to get payee SEARCH ************ -->
		<EventHandlers type="{BBEditEvent.LOAD_OPERATOR_SEARCH}" id="eLOAD_OPERATOR_SEARCH" debug="{bDebug}" useWeakReference="true">
			<MethodInvoker generator="{BBEditManager}" method="showOperatorSearch" />
		</EventHandlers>
		
		<!--EMAIL BILLBACK******************** -->
		<EventHandlers type="{BBEditEvent.OPEN_EMAIL_PAGE}" id="eOPEN_EMAIL_PAGE" debug="{bDebug}" useWeakReference="true">
			<MethodInvoker generator="{BBEditManager}" method="openEmailPage" />
		</EventHandlers>
		
		<!--PRINT BILLBACK******************** -->
		<EventHandlers type="{BBEditEvent.OPEN_PRINT_PAGE}" id="eOPEN_PRINT_PAGE" debug="{bDebug}" useWeakReference="true">
			<MethodInvoker generator="{BBEditManager}" method="openPrintPage" />
		</EventHandlers>
		
		<!--BILLBACK WORKFLOW******************** -->
		<EventHandlers type="{BBEditEvent.BILLBACK_WORKFLOW}" id="eBILLBACK_WORKFLOW" debug="{bDebug}" useWeakReference="true">
			<RemoteObjectInvoker instance="{MainService}" showBusyCursor="true" method="getBillbackDetails" arguments="{[event.bbIdInt,event.userId]}">
				<resultHandlers>
					<MethodInvoker generator="{BBEditManager}" method="openBBWorkflow" arguments="{resultObject}" />
				</resultHandlers>
				<faultHandlers>	
					<EventAnnouncer type="{BBEditEvent.BSA_ERROR}" generator="{BBEditEvent}" >
						<Properties sBaError="BILLBACK DETAILS (getBillbackDetails)" />
						<Properties oBaError="{fault}" />
					</EventAnnouncer>
				</faultHandlers>
			</RemoteObjectInvoker>			
		</EventHandlers>
		
		<!--BILLBACK STATEMENT******************** -->
		<EventHandlers type="{BBEditEvent.OPEN_BB_STATEMENT}" id="eOPEN_BB_STATEMENT" debug="{bDebug}" useWeakReference="true">
			<MethodInvoker generator="{BBEditManager}" method="openBBStatement" />
		</EventHandlers>
		
		<!--BILLBACK DISCREPANCY******************** -->
		<EventHandlers type="{BBEditEvent.SHOW_BB_DEVIATION_REPORT}" id="eSHOW_BB_DEVIATION_REPORT" debug="{bDebug}" useWeakReference="true">
			<MethodInvoker generator="{BBEditManager}" method="openBBDiscrepancyReport" />
		</EventHandlers>
		
		<!--SHOW BIZ CONSIDERATIONS******************** -->
		<EventHandlers type="{BBEditEvent.SHOW_BIZ_CONSIDERATIONS}" id="eSHOW_BIZ_CONSIDERATIONS" debug="{bDebug}" useWeakReference="true">
			<MethodInvoker generator="{BBEditManager}" method="showBizCon" arguments="{event.bizConMode}" />
		</EventHandlers>
		
		<!--SHOW HISTORY******************** -->
		<EventHandlers type="{BBEditEvent.SHOW_HISTORY}" id="eSHOW_HISTORY" debug="{bDebug}">
			<MethodInvoker generator="{BBEditManager}" method="showHistory" />
		</EventHandlers>
		
		<!--SHOW ADJUST BIZ CONSIDERATIONS******************** -->
		<EventHandlers type="{BBEditEvent.SHOW_ADJUST_BIZ_CONSIDERATIONS}" id="eSHOW_ADJUST_BIZ_CONSIDERATIONS" debug="{bDebug}" useWeakReference="true">
			<MethodInvoker generator="{BBEditManager}" method="showAdjustBizCon" />
		</EventHandlers>
		
		<!--SHOW PROGRAM SUMMARY******************** -->
		<EventHandlers type="{BBEditEvent.SHOW_PROGRAM_SUMMARY}" id="eSHOW_PROGRAM_SUMMARY" debug="{bDebug}" useWeakReference="true">
			<MethodInvoker generator="{BBEditManager}" method="showProgramSummary" arguments="{event.programId}"  />
		</EventHandlers>
		
		<!--GET PRODUCT LIST ******** get all the products from item master ************ -->
		<EventHandlers type="{BBEditEvent.LOAD_ITEM_LIST}" id="eLOAD_ITEM_LIST" debug="{bDebug}" useWeakReference="true">
			<RemoteObjectInvoker instance="{EditSearchService}" showBusyCursor="true" method="getProductList" >
				<resultHandlers>
					<MethodInvoker generator="{BBEditManager}" method="getProductList" arguments="{resultObject}" />
