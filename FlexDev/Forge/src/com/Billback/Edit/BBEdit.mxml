	<fx:Declarations>
		<!-- Event Maps __________________________________________________ -->
		<maps:BBEditEventMap dispatcher="{this}" cache="local" id="BBEditEventMap" />
	</fx:Declarations>
	<fx:Script><![CDATA[
		import com.Billback.Edit.events.BBEditEvent;
		import com.Billback.Edit.views.pm.BBEditItemsPModel;
		import com.Billback.Edit.views.pm.BBSettlementPModel;
		import com.Billback.Main.events.BBMainEvent;
		import com.Billback.Main.models.IBBEdit;
		import com.Billback.Main.models.vos.BBHeader;
		import com.Billback.Main.models.vos.Billback;
		import com.Billback.Main.models.vos.ClosingMethod;
		import com.Billback.Main.models.vos.Payee;
		import com.shared.events.MainEvent;
		import com.shared.models.Destroy;
		import com.shared.models.ObjectUtilFunctions;
		import com.shared.models.SettingsManager;
		import com.shared.models.entity.vos.User;
		import com.shared.vos.Settings;
		
		import mx.binding.utils.BindingUtils;
		import mx.controls.Alert;
		import mx.core.mx_internal;
		import mx.utils.ObjectUtil;
		
		[Bindable]
		private var _bbHeader:BBHeader = new BBHeader();
		[Bindable]
		private var _iTabNavIdx:int = 0;
		[Bindable]
		private var reDirector:String= 'EDIT';
		
		/* Presentation Model */
		[Bindable]
		public var pModel:BBSettlementPModel;
		[Bindable]
		public var pModelItems:BBEditItemsPModel;
		
		private function applyRuntimeStyleSheet():void {
			SettingsManager.applyRuntimeStyleSheet(mx_internal::VERSION,this);
			this.addEventListener(KeyboardEvent.KEY_UP,editBBKeyHandler,false,0,true);	
			/*	if(this.reDirector == 'Deviation')
			{
			//var timer:Timer = new Timer(3000);
			//timer.start()
			pModelItems.loadDeviations();
			}*/
			
		}
		
		private function editBBKeyHandler(event:KeyboardEvent):void 
		{
			var bShiftPressed:Boolean = event.shiftKey;
			var bCTRLPressed:Boolean = event.ctrlKey;
			
			if (bCTRLPressed) {
				var curKeyCode:int = event.keyCode;
				
				// Save = CTRL+S(83)   
				if (curKeyCode == 83) {
					event.preventDefault();
					if (event.currentTarget.hasOwnProperty("BBHeaderForm")){
						this.BBHeaderForm.pModel.billback.bbHeader.BBNumber = event.currentTarget.BBHeaderForm.tiBBNumber.text;
						this.BBHeaderForm.pModel.billback.bbHeader.referenceNumber = event.currentTarget.BBHeaderForm.tiBBReferenceID.text;
						this.BBHeaderForm.pModel.billback.bbHeader.title = event.currentTarget.BBHeaderForm.tiTitle.text;
						this.BBHeaderForm.pModel.billback.bbNotes = event.currentTarget.BBHeaderForm.taNotes.text;
						this.BBHeaderForm.pModel.billback.claimedAmount = event.currentTarget.BBHeaderForm.tiClaimAmount.text;
						this.BBHeaderForm.pModel.billback.claimedCS = event.currentTarget.BBHeaderForm.tiClaimCases.text;
						this.BBHeaderForm.pModel.billback.claimedLB = event.currentTarget.BBHeaderForm.tiClaimPounds.text;
					}
					
					this.pModelItems.validateBillback();
				}				
			}
		}
		
		
		public function setSettings(settings:Settings):void{
			var event:MainEvent = new MainEvent ( MainEvent.SET_LOCAL_APP_SETTINGS );
			event.settings = ObjectUtilFunctions.clone(settings) as Settings;
			this.dispatchEvent( event );
		}
		
		public function setBB(bbHeader:BBHeader):void{
			var bbh:BBHeader = new BBHeader(bbHeader);
			if(bbHeader){
				this._bbHeader = bbh;
				if(bbHeader.billbackIDInt != 0){
					var event:BBEditEvent = new BBEditEvent ( BBEditEvent.LOAD_BB_EDIT );
					event.bbHeader = bbh;
					this.dispatchEvent( event );
				}
				else{
					// pass in a blank billback
					var evt:BBEditEvent = new BBEditEvent ( BBEditEvent.CREATE_NEW_BB );
					evt.billback = new Billback();
					this.dispatchEvent( evt );
				}				
			}
			this.callLater(selectTab);
		}
		
		public function getBB():BBHeader{
			return this._bbHeader;
		}
		
		public function setSelectedTabEvent(e:BBEditEvent):void{
			/* set the navigator index only if the tab exists. */
			if(this.navigator){
				if(this.navigator.getChildren().length > idx){
					var idx:int = e.iIndex;
					this._iTabNavIdx = idx;
					this.navigator.selectedIndex = _iTabNavIdx;
					this.navigator.getTabAt(_iTabNavIdx).invalidateDisplayList();
				}
			}			
		}
				
		public function setSelectedTab(idx:int):void{			
			/* set the navigator index only if the tab exists. */
			if(this.navigator){
				if(this.navigator.getChildren().length > idx){
					this._iTabNavIdx = idx;
				}
			}		
		}
		
		public function setClosingMethods(closingMethodList:Array):void{
			if(closingMethodList.length){
				var arr1:Array = new Array();
				for each(var cm:ClosingMethod in closingMethodList ){
					arr1.push(new ClosingMethod(cm));
				}
				var eventCM:BBEditEvent = new BBEditEvent(BBEditEvent.LOAD_BBEDIT_CLOSINGMETHODS);
				eventCM.closingMethodList = arr1;
				this.dispatchEvent(eventCM);
			}
		}	
		public function setBBAnalysts(bbAnalysts:Array):void{
			if(bbAnalysts.length){
				var arr2:Array = new Array();
				for each(var analyst:User in bbAnalysts ){
					arr2.push(new User(analyst));
				}
				var eventBA:BBEditEvent = new BBEditEvent(BBEditEvent.LOAD_BBEDIT_ANALYSTS);
				eventBA.bbAnalysts = arr2;
				this.dispatchEvent(eventBA);
			}
		}	
		
		public function setReDirector(reDirector:String):void{
			this.reDirector = reDirector;
		}
		
		public function setPayeeList(payeeList:Array):void{
			if(payeeList.length){
				var arr:Array = new Array();
				for each(var payee:Payee in payeeList ){
					arr.push(new Payee(payee));
				}
				var event:BBEditEvent = new BBEditEvent(BBEditEvent.SET_PAYEE_LIST);
				event.payeeList = arr;
				this.dispatchEvent(event);
			}
		}	
		
		private function selectTab():void{
			this.navigator.invalidateDisplayList();
			this.navigator.getTabAt(0).invalidateDisplayList();
			this.navigator.selectedIndex = _iTabNavIdx;
			this.navigator.invalidateDisplayList(); 
		}
		import flash.utils.ByteArray;
		
		private function clone(source:Object):*
		{
			var myBA:ByteArray = new ByteArray();
			myBA.writeObject(source);
			myBA.position = 0;
			var ret:* = myBA.readObject();
			//return(ret);
			return source;
		}
		private function close():void
		{
			var e:BBMainEvent = new BBMainEvent(BBMainEvent.CLOSE_BB);
			if(this.pModel.billback){
				e.bbHeader  = this.pModel.billback.bbHeader;
			}
			this.dispatchEvent(e);
		}
		/* Unlock billbacks locked by the user, other than the one requested lock on */
		public function setLockedUnlocked():void{
			/*  This function is being called from "BillbackMain.mxml". The call could be for multiple modules at a time.
			Every module has it's own pModel and so we can find out the billback details from the pModel.
			*/
			var bbh:BBHeader = new BBHeader(pModel.billback.bbHeader);
			
			var event:BBEditEvent = new BBEditEvent ( BBEditEvent.UNLOCK_OTHER_LOCKED_USER );
			event.bbHeader = bbh;
			this.dispatchEvent( event );
		}
		private function cleanUp():void{
			
			callLater(Destroy.cleanUp,[this.BBHeaderForm,mx_internal]);
			callLater(Destroy.cleanUp,[this.BBEditItemsGrid,mx_internal]);
			callLater(Destroy.cleanUp,[this.BBSettlementView,mx_internal]);
			callLater(Destroy.cleanUp,[this.BBHeaderForm.rndrComponentTileRenderer,mx_internal]);
			callLater(Destroy.disposeAllCurlyBraceBindings,[this.BBEditEventMap,mx_internal]);
			callLater(Destroy.cleanUp,[this,mx_internal]);
		}
	]]>
	</fx:Script>
	<!--<s:Button label="close" click="this.close()" />-->
	
	<!-- Views _______________________________________________________ -->
	<mx:TabNavigator id="navigator" width="100%" height="100%" 
					 selectedIndex="{_iTabNavIdx}" 
					 creationPolicy="all"
					 tabStyleName="tab" 
					 selectedTabTextStyleName="tab" tabHeight="30">
		<s:NavigatorContent label="edit" 
							width="100%" height="100%" 
							creationPolicy="all">
			<s:layout>
				<s:HorizontalLayout/>
			</s:layout>
			<s:VGroup id="vgBB" width="100%" height="100%">
				<view:BBHeaderForm id="BBHeaderForm" /> <!-- Do not use height="100%" here, else expand/collapse of the grid from the panel will not work -->
				<view:BBEditItemsGrid id="BBEditItemsGrid" height="100%" />
			</s:VGroup>
			<s:VScrollBar viewport="{vgBB}" height="100%" />
		</s:NavigatorContent>
		<s:NavigatorContent label="settlement" 
							width="100%" height="100%" 
							creationPolicy="all"
							>
			<s:VGroup width="100%" height="100%"
					  visible="{this.pModel.billback.bbHeader.bDisplaySettlement}">
				<view:BBSettlementView width="100%" height="100%" id="BBSettlementView" />
			</s:VGroup>
		</s:NavigatorContent>
	</mx:TabNavigator>
	
</s:Module>
