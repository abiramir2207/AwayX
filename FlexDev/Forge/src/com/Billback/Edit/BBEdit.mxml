<?xml version="1.0" encoding="utf-8"?>
<s:Module xmlns:fx="http://ns.adobe.com/mxml/2009" width="100%" height="100%"
		  xmlns:s="library://ns.adobe.com/flex/spark" 
		  xmlns:mx="library://ns.adobe.com/flex/mx"
		  xmlns:view="com.Billback.Edit.views.*" 
		  xmlns:maps="com.Billback.Edit.maps.*" 
		  xmlns:vos="com.Billback.Edit.vos.*" 
		  creationComplete="applyRuntimeStyleSheet();" 
		  implements="com.Billback.Main.models.IBBEdit" remove="cleanUp()">
	
	<s:layout>
		<s:VerticalLayout/>
	</s:layout>
	<!--<fx:Style>
	@namespace s "library://ns.adobe.com/flex/spark";
	s|Form
	{
	skinClass: ClassReference("com.shared.views.renderer.FormSkinBa");
	}
	s|FormItem
	{
	skinClass: ClassReference("com.shared.views.renderer.FormItemSkinBa");
	}
