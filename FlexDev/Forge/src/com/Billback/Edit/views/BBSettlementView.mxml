									enabled="{this.pModel.bDeductionEditable}" />
					</s:FormItem>
				</s:Form>
				
				<!--<s:HGroup>
				<s:Label text="Total" height="{this.pModel.iFrmHeight}" />
				<s:CheckBox id="chkItemAmount" 
				selected="{pModel.bbDeductionFilterParm.bAmount}" 
				click="{pModel.chkItemAmountHandler(this.chkItemAmount.selected)}" />
				<s:Label text="Payee" height="{this.pModel.iFrmHeight}" />
				<s:CheckBox id="chkDistributor" 
