									   verticalSeparatorSkin="com.shared.views.skins.DataGridHeaderSeparatorSkinBa"	
									   />
				</s:HGroup>
				<s:Label text="{this.pModel.acBBDeductions.length} records" />
			</s:Group>
		</s:BorderContainer>
		
		<!-- CLOSING METHODS -->
		<s:BorderContainer width="450" borderVisible="true" >
