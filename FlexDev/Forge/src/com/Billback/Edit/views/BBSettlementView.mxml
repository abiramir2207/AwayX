				<s:Label text="Balance" height="{this.pModel.iFrmHeight}" />
				<s:CheckBox id="chkBalance" 
				selected="{pModel.bbDeductionFilterParm.bBalance}" 
				click="{pModel.chkBalanceHandler(this.chkBalance.selected)}" />
				</s:HGroup>-->
				<s:HGroup paddingTop="0">
					<ba:FilterDatagrid id="dgBBDeduction" 
									   editable="false"
									   bAllowDelete="true"
									   rowCount="9" 
									   allowMultipleSelection="{this.pModel.oSettings.appSettings.Allow_Multiple_Deduction_Settlement}"
									   columns="{pModel.arrBBDeductionDgCols}"
									   dataProvider="{this.pModel.acBBDeductions}"
