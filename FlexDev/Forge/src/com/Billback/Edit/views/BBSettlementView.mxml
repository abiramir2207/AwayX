			import mx.utils.StringUtil;
			import spark.effects.WipeDirection;
			/* this.pModel.oSettings.appSettings.Allow_Multiple_Deduction_Settlement */
			
			/* Presentation Model */
			[Bindable]
			public var pModel:BBSettlementPModel;
			
			[Bindable]
			public var sTitle:String;
			
		 	public function initTitle(argTitle:String):String{
				if ((argTitle).length > 85)
				{
					sTitle = (argTitle).substr(0,84);
					sTitle = sTitle + "...";
				}	
				else
				{
					sTitle = argTitle;
				}
				return sTitle;	
			}
			 
			/* private var _pModel:BBSettlementPModel;
			[Bindable (event="BBSettlementPModelChange")]
			public function get pModel():BBSettlementPModel
			{
				return _pModel;
			}
			public function set pModel(pm:BBSettlementPModel):void
			{
				this._pModel = pm;
				this.currentState = pm.sEditClosingDetailResult.length > 0 ? 'error' : '';
				dispatchEvent(new Event('BBSettlementPModelChange'));
			} */
			
			/* 			
			private function test(e:Event):void{
			var x:Event = e;
			var dg:DataGrid = e.currentTarget as DataGrid;
			
			} 
			*/
			
			public function roundDecimal(numb:Number, decimal:Number):Number
			{
				var precision:Number = Math.pow(10,decimal);
				return Math.round(numb*precision )/precision;
			}
		]]>
	</fx:Script>
	<!--header info display-->
	
	<s:states>
		<s:State name="default"/>
		<s:State name="error"/>
	</s:states>
	
	<s:transitions>
		<s:Transition id="toError" fromState="*" toState="error">
			<s:Sequence id="t1" targets="{[this.fiResult,this.tiResult]}">
				<s:SetAction property="includeInLayout"/>
				<s:SetAction property="visible"/>
				<s:Resize heightFrom="0" heightTo="{this.pModel.iFrmHeight*2}" duration="500"/>
				<s:SetAction property="height"/>
				<!--<s:Wipe direction="down" duration="3000"/>-->
			</s:Sequence>
		</s:Transition>
	
		<s:Transition id="toAnyFromAny" fromState="*" toState="*">
			<s:Sequence id="t2" targets="{[this.fiResult,this.tiResult]}">
				<s:Resize heightFrom="{this.pModel.iFrmHeight*2}" heightTo="0" duration="500"/>
				<s:SetAction property="height"/>
				<s:SetAction property="visible"/>
				<s:SetAction property="includeInLayout"/>
				<!--<s:Wipe direction="up" duration="3000"/>-->
			</s:Sequence>
		</s:Transition>
	</s:transitions>
	
	
	
