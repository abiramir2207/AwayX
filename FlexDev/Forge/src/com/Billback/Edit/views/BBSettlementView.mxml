						<s:HorizontalLayout paddingLeft="0" paddingRight="0" 
											paddingTop="0" paddingBottom="0"
											gap="0" />
					</s:layout> 
					<s:FormItem label="Error" id="fiResult" width="100%"
								height="0"
								height.error="{this.pModel.iFrmHeight*2}"
								includeInLayout="false"
								includeInLayout.error="true"
								visible="false"
								visible.error="true">
						<s:Label text="{pModel.sEditClosingDetailResult}" 
								 id="tiResult"
								 width="300" color="red"
								 height="0"
								 height.error="{this.pModel.iFrmHeight*2}"
								 includeInLayout="false"
								 includeInLayout.error="true"
								 visible="false"
								 visible.error="true"
								 />
					</s:FormItem>
				</s:Form>
				<!--...................   DATAGRID   ..........................-->
				<s:HGroup paddingTop="2" paddingBottom="0" width="100%">
					<!-- Removing the skins from here may result in no background color for the datagrid header -->
					<mx:DataGrid id="dgBBClosingDetail" 
								 editable="{this.pModel.bEditable}"
								 selectedItem="{pModel.bbClosingdetail}"
								 rowCount="{this.pModel.acBBClosingDetail.length}" 
								 allowMultipleSelection="true"
								 columns="{pModel.arrBBClosingDetailDgCols}"
								 dataProvider="{this.pModel.acBBClosingDetail}"
								 itemEditEnd="this.pModel.itemEditEndDgClosing(event)"
								 itemEditBegin="this.pModel.itemEditBeginDgClosing(event)"
								 change="this.pModel.selectBBClosingDetail(event)" dataTipFunction="{this.pModel.cmToolTip}"
								 headerBackgroundSkin="com.shared.views.skins.DataGridHeaderBackgroundSkinBa"
								 headerSeparatorSkin="com.shared.views.skins.DataGridHeaderSeparatorSkinBa"
								 verticalSeparatorSkin="com.shared.views.skins.DataGridHeaderSeparatorSkinBa"
								 />
				</s:HGroup><!--   -->
				
				<s:Form height="100%">
					<s:layout>
						<s:HorizontalLayout paddingLeft="0" paddingRight="0" 
											paddingTop="0" paddingBottom="0"
											gap="0" />
					</s:layout>
					<s:FormItem label="Special Handling">
						<s:CheckBox id="chkSpecialHandling"
									selected="{pModel.billback.bbHeader.bbSettlement.bSpecialHandling}" 
									click="{pModel.chkSpecialHandlingHandler(this.chkSpecialHandling.selected)}"
									enabled="{pModel.objBBToolsLock.bSettlementScreenEnabled}" />
					</s:FormItem>
					<s:FormItem label="Remittance" height="{(this.pModel.iFrmHeight*2) + 10}" >
						<s:TextArea id="tiPaymentNotes" 
									height="{this.pModel.iFrmHeight*2}" width="190"
									text="{this.pModel.billback.bbHeader.bbSettlement.paymentNotes}"
									change="this.pModel.tiPaymentNotesHandler(this.tiPaymentNotes.text)"
									enabled="{pModel.objBBToolsLock.bSettlementScreenEnabled}"/>
					</s:FormItem>
				</s:Form>
				
				<s:HGroup paddingTop="2" height="100%">
					<s:VGroup width="182">
						<s:HGroup paddingTop="5">
							<!-- Dev Note: 30796 - Remove the "save" feature, for now -->
							<!--<s:Button label="save" 
									  enabled="{this.pModel.bApprovable}" 
									  click="this.pModel.save()" />
							-->
							<s:Button label="deviation" 
									  click="this.pModel.loadDeviations()"
									  enabled="{pModel.objBBToolsLock.bDeviationEnabled}"/>
							<s:Button label="close"
									  click="this.pModel.close()" />
						</s:HGroup>
						
						<s:Button label="discrepancy report"
								  click="this.pModel.showDiscrepancyReport()" width="148" />	
					</s:VGroup>
					<s:Group toolTip="{this.pModel.sSubmitButtonTip}">
						<s:HGroup paddingTop="5">
							<s:Button label="disagree"
									  enabled="{this.pModel.bApprovable &amp;&amp; this.pModel.billback.bbHeader.finalSelectedAmount != 0}"
									  click="this.pModel.fnDisagreeClicked()" />					
							<s:Button label="{this.pModel.sSubmitButtonText}" 
									  enabled="{this.pModel.bApprovable &amp;&amp; this.pModel.billback.bbHeader.finalSelectedAmount != 0}" 
									  click="this.pModel.approve()" />
						</s:HGroup>						
					</s:Group>
				</s:HGroup>
				
			</s:Group>
		</s:BorderContainer>
	</s:Group>
</s:Group>
