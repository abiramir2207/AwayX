	</s:Group>
	<!-- Deductions and Closing Method DATA GRIDS -->
	<s:Group minWidth = "850" >
		<s:layout>
			<s:HorizontalLayout paddingLeft="5" paddingRight="5" 
								paddingTop="0" paddingBottom="5" gap="7"/>
		</s:layout>
		<!-- 30907: Changes to the BB Settlement screen/ Anand Rao/13-Mar-2012
			 Settlement Information is now moved to the same location as the 
			 Deduction search, ie., either Deductions search will show up 
			 or settlement information will show up in this place.
			 But there is a difference in the includeInLayout and visible properties
		     as we want to keep the Closing method box in the same place on the screen.
			 If we make both visible condition to be equal to includeInLayout then the 
			 Closing method box will be moved to the left which should not happen
			 (it was requested).
		 -->
		<s:BorderContainer width="375"
			visible="{!(this.pModel.billback.bbHeader.status.id != 5 &amp;&amp; this.pModel.billback.bbHeader.status.id != 8)}" 
			includeInLayout="{!(this.pModel.billback.bbHeader.status.id != 3 &amp;&amp; this.pModel.billback.bbHeader.status.id != 4 &amp;&amp; this.pModel.billback.bbHeader.status.id != 5 &amp;&amp; this.pModel.billback.bbHeader.status.id != 8)}"	 >
			<s:layout>
				<s:HorizontalLayout paddingLeft="5" paddingRight="5" 
									paddingTop="0" paddingBottom="5" gap="7"/>
			</s:layout>			
			<s:Form width="200">
				<s:RichText id="settlementHeader">
					<s:content>
						<s:p fontSize="10" textDecoration="underline" fontWeight="bold" paddingBottom="5">Settlement Information:</s:p>
					</s:content>
				</s:RichText>
				
				
				<s:FormItem label="Amount *">
					<s:Label text="{StringUtils.getDollarDec3(this.pModel.billback.bbHeader.checkAmount)}"/>
				</s:FormItem>
				
				<s:FormItem label="Settlement ID **">
					<s:Label text="{this.pModel.billback.bbHeader.checkNumber}"/>
				</s:FormItem>
				
				<s:FormItem label="{this.pModel.oSettings.appFlex.bbLabels.Variable_1}">
					<s:Label text="{this.pModel.billback.bbHeader.documentNumber1}"/>
				</s:FormItem>
				
				<s:FormItem label="{this.pModel.oSettings.appFlex.bbLabels.Variable_2}">
					<s:Label text="{this.pModel.billback.bbHeader.documentNumber2}"/>
				</s:FormItem>
				
				<s:RichText id="disclaimer">
					<s:content>
						<s:p fontSize="9" fontWeight="bold" paddingBottom="0" paddingLeft="5">* - The Amount value and Approve value from the Closing Details</s:p>  
						<s:p fontSize="9" fontWeight="bold" paddingBottom="0" paddingLeft="22">section will not equal when the billback has either reinstate</s:p>
						<s:p fontSize="9" fontWeight="bold" paddingBottom="0" paddingLeft="22">and/or write off. The Approve value from the Closing Details</s:p>
						<s:p fontSize="9" fontWeight="bold" paddingBottom="5" paddingLeft="22">section does not consider the reinstate or write off amounts.</s:p>
						<s:p fontSize="9" fontWeight="bold" paddingBottom="0" paddingLeft="5">** - The Settlement ID represents either the check number or</s:p>  
						<s:p fontSize="9" fontWeight="bold" paddingBottom="5" paddingLeft="22">credit memo number, depending upon the closing method</s:p>
					</s:content>
				</s:RichText>	
				
			</s:Form>
			<s:Form width="175" >
				<s:FormHeading height="0"/>
				
				<!--<s:FormItem label="End" height="{this.pModel.iFrmHeight}">
					<s:Label text="{StringUtils.getFormatDt(this.pModel.billback.bbHeader.endDate)}"/>
				</s:FormItem>
				
				<s:FormItem label="Deviation" height="{this.pModel.iFrmHeight}">
					<s:Label text="{StringUtils.getDollarDec3( (this.pModel.billback.bbHeader.amount - this.pModel.billback.bbHeader.expectedAmt).toString() )}"/>
				</s:FormItem>-->
				
				<s:FormItem>
					<s:Spacer height="{this.settlementHeader.height}" width="{this.settlementHeader.width}" />
				</s:FormItem>
				
				<s:FormItem label="Date">
					<s:Label text="{StringUtils.getFormatDt(this.pModel.billback.bbHeader.checkDate)}"/>
				</s:FormItem>
				
				<s:FormItem>
					<s:Spacer width="3" />
				</s:FormItem>
				
			</s:Form>
		</s:BorderContainer>
		
	 
		
		
		<!--  DEDUCTIONS -->
		<s:BorderContainer width="350" borderVisible="true" 
						   visible="{this.pModel.billback.bbHeader.status.id != 3 &amp;&amp; this.pModel.billback.bbHeader.status.id != 4 &amp;&amp; this.pModel.billback.bbHeader.status.id != 5 &amp;&amp; this.pModel.billback.bbHeader.status.id != 8}" 
