			public function fnFormatVol(item:String):String 
			{
				// return numberFormatterVol.format(item);
				if (sBBFractionalVolume == '0')
				{
					var newVal:String = numberFormatterVolCS.format(item).toString();
					if (newVal == '') 
					{
						return '0';
					}
					else
					{
						return newVal;
					}
				}
				else
				{
					return numberFormatterVol.format(item);
				}
			}
			
			
