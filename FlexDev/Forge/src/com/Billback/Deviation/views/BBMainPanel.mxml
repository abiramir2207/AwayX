			public function handleItemFocusIn(event:AdvancedDataGridEvent):void
			{
				var ui:UIComponent = event.itemRenderer as UIComponent;
				if(ui.getChildAt(0))
				{
					var editor:UIComponent = ui.getChildAt(0) as UIComponent;
					if(editor)
					{
						editor.setFocus();
						editor.drawFocus(true); 
					} 
					else 
					{
						ui.setFocus();
						ui.drawFocus(true);
					}
				}
			}
			
			
