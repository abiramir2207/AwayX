															 ))}"
						    		 		
						    		 	/>  
											 <!-- enter="outerDocument.fnSetRateManual(this)"   change="fnChkDecPlaces(txtRateMan.text);sValRate=txtRateMan.text" 
											 toolTip="Hit &lt;Enter&gt; after entering value" -->
										</mx:HBox>
