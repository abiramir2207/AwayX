			/**
			 * This function is a styleFunction that is called by the AdvancedDataGrid styleFunction property.
			 * This sets the style of each row based on the Dummy_Program, UnKnown_Item and iDone values.
			 */
			public function fnBBFixed(data:Object,col:AdvancedDataGridColumn):Object{
				var sPropertyList:String;
				var bColorRed:Number = 0;
				var bBgRed:Number = 0;
				if(bEnableFnCalled == 0){
					fnEnableButtons();
					bEnableFnCalled = 1;
				}
				// Expected_Amount was Final_Payment earlier.  This was changed after the discussion with
				// Paul on  22-Oct-09
				//if ((data.iDone=='0') || ((data.iDone=='1') && (data["Expected_Amount"] <= data["Claimed_Amount"])))
				if ((sBBLSClaimedRebateExpected == "1" && data["Expected_Amount"] != data["Claimed_Amount"]))
					//if (data.iDone=='0')
				{ 
					bColorRed = 1;
				}
				//	if (data.Dummy_Program == "1" || data.UnKnown_Item =="1")
				// if Third_Party_BB_Upload is 3 and (dummy_program is 1 OR Unknown_ITem is 1) then Disable the radio buttons
				//	if ((data.Third_Party_BB_Upload == '3') && (data.Dummy_Program == '1' || data.UnKnown_Item =='1'))
				if(data.Dummy_Program == '1' || data.UnKnown_Item =='1'){
					bBgRed = 1;
				}
				if(bColorRed == 1 && bBgRed == 1){
					return {color:0xFF0000, backgroundColor:"0xFFC184"}
				}
				else if(bColorRed == 1 && bBgRed == 0){
					return {color:0xFF0000}
				}
				else if(bColorRed == 0 && bBgRed == 1){
					return {color:0x00000000, backgroundColor:"0xFFC184"}
				}
				else{
					return {color:0x00000000}
				}
			}
			
