			/**
			 * This function fnPositionRatePrecisionToolTip gets called from within the styleFunction
			 * it will re-position the tool tip a little higher 
			 * so that the long tool tip text will not hide the contents of the data grid.
			 */
			public function fnPositionRatePrecisionToolTip(event:ToolTipEvent):void
			{
				var pt:Point = event.currentTarget.contentToGlobal(new Point(0,0));
				ToolTipManager.currentToolTip.y = pt.y - 20;
			}
			
			
			/**
			 * This function fnEnableButtons gets called from within the styleFunction
			 * and there is a variable that is set once this function is called to make sure
			 * that this does not get called multiple times. This will enable all the 
			 * buttons on the screen after the data is loaded on the screen, so that 
			 * the user will not be able to click on the buttons when the grid is loading
			 * and therefore will not be able to approve empty records.
			 */
			
			public function fnEnableButtons():void
			{
				
				if (this.sBBEditable == "1" && sBBApproveExpRateLessTol=="1")
				{
					this.btnExpectedAmtLT.enabled = true;
				}
				if (this.sBBEditable == "1")
				{
					this.btnApprove.enabled 		 = true;
					// this.btnVolOverride.enabled  = true;
					this.btnRateOverride.enabled = true;
					this.btnSave.enabled 				 = true;
					this.btnRecalc.enabled 			 = true;
					this.btnClaimedAmt.enabled 	 = true;
					this.btnExpectedAmt.enabled  = true;
					this.btnDisagree.enabled 		 = true;
				}
				this.btnVolOverride.enabled  = true;
			}
			
			public function enableButtons(e:Event):void{
				/* There was an error without "callLater" */
				callLater(setEnableButtons);
			}
			
			public function setEnableButtons():void{
				this.btnRecalc.enabled = true;
			}
			
			/**
			 * This function gets called on the creationComplete of the btnApprove
			 * which is the last button element
			 * It calls fnInitListeners and sets tool tip max width
			 */
			public function fnInit():void  
			{
				this.fnInitListeners();
				
				/* 	Dev Note: 30728 - When the user clicks on "val" from the BB search grid and gets redirected to the deviation grid, the 
				"sBBDeviationSource" gets set to 'Deviation'. This needs to be cleared as without it, the user keeps on getting redirected 
				to the deviation page on clicking on any button which takes the user from the deviation grid to the settlement page.
				*/
				if(sharedSettings.sBBDeviationSource == 'Deviation')
				{
					sharedSettings.sBBDeviationSource = "";
				}
				
				//set tool tip maxwidth so that the rate decimal tool tip takes up more horizontally space than vertical
				ToolTip.maxWidth = 525;
				
			}
			
			/**
			 * This function gets called on the creationComplete of the btnApprove
			 * which is the last button element and it adds the eventListeners for 
			 * all the buttons.  It adds the eventListeners of type MouseEvent.Click 
			 * and KeyboardEvent.KEY_DOWN 
			 */
			public function fnInitListeners():void  
			{ 
				// Event Listener for the "Volume Override" Button
				this.btnVolOverride.addEventListener(MouseEvent.CLICK,fnVolOverride,false,0,true)
				this.btnVolOverride.addEventListener(KeyboardEvent.KEY_DOWN,fnEnterButton,false,0,true);
				
				
				// Event Listener for the "Rate Override" Button
				this.btnRateOverride.addEventListener(MouseEvent.CLICK,fnRateOverride,false,0,true)
				this.btnRateOverride.addEventListener(KeyboardEvent.KEY_DOWN,fnEnterButton,false,0,true);
				
				// Event Listener for the "Save" Button 
				this.btnSave.addEventListener(MouseEvent.CLICK,fnDoActions,false,0,true)
				this.btnSave.addEventListener(KeyboardEvent.KEY_DOWN,fnEnterButton,false,0,true);
				
				// Event Listener for the "Approve" Button
				this.btnApprove.addEventListener(MouseEvent.CLICK,fnDoActions,false,0,true)
				this.btnApprove.addEventListener(KeyboardEvent.KEY_DOWN,fnEnterButton,false,0,true);
				
				// Event Listener for the "Recalc" Button
				this.btnRecalc.addEventListener(MouseEvent.CLICK,fnDoActions,false,0,true)
				this.btnRecalc.addEventListener(KeyboardEvent.KEY_DOWN,fnEnterButton,false,0,true);
				
				// Event Listener for the "Approve Claimed Amount" Button
				this.btnClaimedAmt.addEventListener(MouseEvent.CLICK,fnClaimedAmountClicked,false,0,true)
				this.btnClaimedAmt.addEventListener(KeyboardEvent.KEY_DOWN,fnEnterButton,false,0,true);
				
				// Event Listener for the "Approve Expected Amount" Button	
				this.btnExpectedAmt.addEventListener(MouseEvent.CLICK,fnExpectedAmountClicked,false,0,true)
				this.btnExpectedAmt.addEventListener(KeyboardEvent.KEY_DOWN,fnEnterButton,false,0,true);  
				
				// Start: CAG Changes for 21923 
				// Event Listener for the "Approve Expected Less Tolerance" Button	
				this.btnExpectedAmtLT.addEventListener(MouseEvent.CLICK,fnExpectedAmountLTClicked,false,0,true)
				this.btnExpectedAmtLT.addEventListener(KeyboardEvent.KEY_DOWN,fnEnterButton,false,0,true);  
				// End: CAG Changes for 21923 
				
				// Start: 22925 BBK Approval- Disagree Option  
				// Event Listener for the "Approve Expected Less Tolerance" Button	
				this.btnDisagree.addEventListener(MouseEvent.CLICK,fnDisagreeClicked,false,0,true)
				this.btnDisagree.addEventListener(KeyboardEvent.KEY_DOWN,fnEnterButton,false,0,true);  
				// End: 22925 BBK Approval- Disagree Option  
			
				this.cbShowDeviated.addEventListener(MouseEvent.CLICK,fnShowDeviated,false,0,true);

			}
			
