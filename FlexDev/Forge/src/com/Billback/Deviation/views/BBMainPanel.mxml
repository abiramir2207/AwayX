			public function AllFilterFunc(item:Object):Boolean
			{
				// check if the item starts with the string in the text field
				var retVal:Boolean = true;
				
				if (this.sProgramFilter != "")
				{
					if (item['Program'].toUpperCase().indexOf(this.sProgramFilter.toUpperCase()) != -1 )
					{	
						retVal = true;
					}
					else
					{
						retVal = false;	
					}
				}
				if (this.sDistributorFilter != "")
				{
					if (item['Distributor'].toUpperCase().indexOf(this.sDistributorFilter.toUpperCase()) != -1 && retVal)	
					{	
						retVal = true;
					}
					else
					{
						retVal = false;	
					}
				}
				if (this.sItemFilter != "")
				{
					if (item['Item'].toUpperCase().indexOf(this.sItemFilter.toUpperCase()) != -1 && retVal)	
					{	
						retVal = true;
					}
					else
					{
						retVal = false;	
					}
				}
				if (this.sTypeFilter != "")
				{
					if (item['Discount_Type_Desc'].toUpperCase().indexOf(this.sTypeFilter.toUpperCase()) != -1 && retVal)	
					{	
						retVal = true;
					}
					else
					{
						retVal = false;	
					}
				} 
				if (this.sDeviatedFilter == true)
				{
					if (item['Variation_Claim_Expected'] != 0 && retVal)	
					{	
						retVal = true;
					}
					else
					{
						retVal = false;	
					}
				} 
				return retVal;
			}			
