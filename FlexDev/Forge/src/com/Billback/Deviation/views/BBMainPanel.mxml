							<mx:AdvancedDataGridColumn headerText="Manual" editable="true"  
													   width="90" id="adgColManualVol" dataField="Manual_Vol" rendererIsEditor="true" 
													   editorDataField="sValVol" sortCompareFunction="sortCompareFunc"><!-- labelFunction="fnFormatDollars2" -->
								<mx:itemRenderer>          
									<mx:Component>            
										<mx:HBox horizontalScrollPolicy="off" verticalScrollPolicy="off" verticalAlign="middle"
												 implements ="mx.managers.IFocusManagerComponent"  paddingLeft="3">   
											 <mx:NumberFormatter id="numberFormatterVol" precision="3" useThousandsSeparator="true"     />
											 <mx:NumberFormatter id="numberFormatterVolCS" precision="0" useThousandsSeparator="true"     />
						    				<mx:Script>
						    					<![CDATA[
											//import mx.managers.FocusManager;
													[Bindable]
													public var sValVol:String; 
													
											private var sOriginalText:String;
						            		
											override public function drawFocus(draw:Boolean):void 
											{
												//trace(' DRAW :: ' + draw);
												if(draw){
													focusManager.setFocus( IFocusManagerComponent( txtVolMan ) );
													txtVolMan.setSelection(0,txtVolMan.text.length);
												}
						             		}		
											override public function setFocus():void 
											{	
												//trace(' SETFOCUS :: ' + focusManager.getFocus());
												
												focusManager.setFocus( IFocusManagerComponent( txtVolMan ) );
												txtVolMan.setSelection(0,txtVolMan.text.length);
												sOriginalText = txtVolMan.text;
											}
											private function fnFormatVol(item:String):String 
											{
												// return numberFormatterVol.format(item);
												if (outerDocument.sBBFractionalVolume == '0')
												{
													var newVal:String = numberFormatterVolCS.format(item).toString();
													if (newVal == '') 
													{
														return '0';
													}
													else
													{
														return newVal;
													}
												}
												else
												{
													return numberFormatterVol.format(item);
												}			
											}
											
											private function fnVolChange(txtNumber:String):Boolean
											{
												//trace(' FOCUSOUT :: ' + focusManager.getFocus());
												var bSuccess:Boolean = false;
											if(txtNumber != '' && Object(focusManager.getFocus()).name.toString().indexOf('OK') == -1){
													bSuccess = fnChkDecPlaces(txtNumber);
													if(bSuccess){
														bSuccess = fnChkManVol(txtNumber);
														if(bSuccess){
															sValVol=txtNumber;
															//this fn is fired on focus out.  Could have been a tab with no data change
															//only file if data was changed
															/*  if(this.data.Manual_Vol != txtNumber){
																this.data.Manual_Vol = txtNumber;
																outerDocument.fnSetVolManual(this);
															} */ 
														} 
													}
												}
												return bSuccess;
											}		
											private function setVolMan(s:String):void{
												trace(' SETVOL :: ' + this.data.Manual_Vol + ' :: ' + sOriginalText);
												if(this.data.Manual_Vol != sOriginalText){
													if(fnVolChange(s)){
														outerDocument.fnSetVolManual(this);
													}
												} 
											}
											private function fnChkDecPlaces(txtNumber:String):Boolean
													{
														var iPointPos:Number = txtNumber.indexOf(".");
						             			var chrToCheck:String = txtNumber.substr(iPointPos+4,1);
														var strWholePart:String = txtNumber.substr(0,iPointPos);
						             			var strTwoDecimals:String = txtNumber.substr(iPointPos+1,3);
												var bSuccess:Boolean = true;
														if (outerDocument.sBBFractionalVolume == '0')
														{
															if (iPointPos != -1)
															{
																mx.controls.Alert.show("Decimals not allowed!!");
																txtVolMan.text = strWholePart;
														sValVol = strWholePart;
														//txtVolMan.setFocus();
														bSuccess = false;
															}
														}
														else
														{
															if (iPointPos != -1)
															{
																if (chrToCheck != "")
																{
															mx.controls.Alert.show("Only three decimal places allowed!!")
																	txtVolMan.text = strWholePart + "." + strTwoDecimals;
															sValVol = strWholePart + "." + strTwoDecimals;
															//txtVolMan.setFocus();
															bSuccess = false;
																}
															}
														}	
												return bSuccess;
													}
													
											private function fnChkManVol(txtNumber:String):Boolean
						             		{
						             				//mx.controls.Alert.show(data.Claimed_Volume);
						             			//	mx.controls.Alert.show(txtVolMan.text);
						             			var txtNumberLen:Number = txtNumber.length;
												var bSuccess:Boolean = true;
						             		 if (Number(txtNumber) > Number(data.Claimed_Volume))
						             			{
						             				mx.controls.Alert.show("Enter a value Less than or equal to the Claimed Volume!!","Volume Limit Error!")
						             				// txtVolMan.text= txtNumber.substr(0, txtNumber.length -1);
													sValVol = fnFormatVol(parseFloat(data.Claimed_Volume).toString());
													txtVolMan.text = fnFormatVol(parseFloat(data.Claimed_Volume).toString());//"0";
						             				//txtVolMan.setFocus();
													bSuccess = false;
						             			} 
											 return bSuccess;
						             		}
												]]>
											</mx:Script> 	
											<mx:Binding destination="sValVol" source="data.Manual_Vol"/>  
											<mx:TextInput    restrict="0-9.,-" maxChars="9" id="txtVolMan" 
						    				textAlign="right" width="70" paddingLeft="2" height="18"
						    		 	  	text="{fnFormatVol(parseFloat(data.Manual_Vol).toString())}"   
															 tabIndex="8" 
											focusOut="setVolMan(txtVolMan.text);"
											change="fnVolChange(txtVolMan.text);" 
											enabled="{((outerDocument.sBBEditable=='1')  &amp;&amp; (outerDocument.sProfileBBSelected =='1')
												&amp;&amp; (((data.Third_Party_BB_Upload == '3') &amp;&amp; (data.Dummy_Program == '0' &amp;&amp; data.UnKnown_Item =='0') &amp;&amp; (data.Selected_Vol_Type == '3'))|| (data.Third_Party_BB_Upload != '3') &amp;&amp; (data.Selected_Vol_Type == '3')
												))}" 
											editable="{((outerDocument.sBBEditable=='1')  &amp;&amp; (outerDocument.sProfileBBSelected =='1')
													 &amp;&amp; (((data.Third_Party_BB_Upload == '3') &amp;&amp; (data.Dummy_Program == '0' &amp;&amp; data.UnKnown_Item =='0') &amp;&amp; (data.Selected_Vol_Type == '3'))|| (data.Third_Party_BB_Upload != '3') &amp;&amp; (data.Selected_Vol_Type == '3')
														))}"
															 />  
										</mx:HBox>
									<!--  change="fnVolChange(txtVolMan.text);"   click="tiClick();"
									enter="outerDocument.fnSetVolManual(this)"    toolTip="Hit &lt;Enter&gt; after entering value" -->
						    	</mx:Component>
								</mx:itemRenderer>
