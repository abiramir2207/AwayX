			private function fnDisagreeClicked(evtObj:Object):void
			{
				var currentAppName:String = FlexGlobals.topLevelApplication.toString();
				if (ExternalInterface.available)
					ExternalInterface.addCallback("bbDisagreed", bbDisagreed);
				var winjscommand:String = "/Billbacks/common/BB_DisagreeFlx.cfm?BBID=" + this.sBBID + "&userID=" + this.sUserID + "&source=" + this.sCallerSource + "&FlexAppName="+currentAppName;
				var jscommand:String = "window.open('"+winjscommand+"', 'bbDisagreeWindow', 'height=600,width=900,toolbar=no,scrollbars=yes,resizable=yes');"
				var url:URLRequest = new URLRequest("javascript:" + jscommand + " void(0);");
				navigateToURL(url,'_self');
				
			} 
			
			
			/**
			 * This function is called when the user hits enter key on a form element 
			 * and it inturn dispatch a MouseEvent.CLICK for the same element.
			 */ 
			private function fnEnterButton(event:KeyboardEvent):void 
			{                
				if (event.keyCode == Keyboard.ENTER)
				{
					// Create new event object.
					var evtMouseClick:MouseEvent = new MouseEvent(MouseEvent.CLICK);
					
					/* Even when one clicks on "claimed $" or "expected $" or "expected $ LT ",
					the "selected" button is clicked in the code and so the "ApprovalButton" gets
					overwritten and we always have the 'selectedButton' name, i.e. "btnApprove".
					So, we need to check whether "ApprovalButton" is already populated , i.e. a button
					besides the "selected $" was clicked.
					*/
					if(this.ApprovalButton == ''){
						/* get the button's ID. */
						this.ApprovalButton = event.currentTarget.id;
					}										
					
					// Dispatch click event to the target of original keydown event.
					event.currentTarget.dispatchEvent(evtMouseClick);                 
				}
			}
			
