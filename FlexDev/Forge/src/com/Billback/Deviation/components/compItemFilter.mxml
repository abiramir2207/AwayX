<?xml version="1.0" encoding="utf-8"?>
<!---
	 	This is a ItemRenderer for displaying Datagrid Header labels vertically
-->
<mx:VBox xmlns:mx="http://www.adobe.com/2006/mxml" paddingLeft="0" paddingTop="0" paddingRight="0" paddingBottom="0" width="100%" height="100%" verticalAlign="middle" horizontalAlign="center">
	<mx:Script>
		<![CDATA[
			protected function filterItemTxt_keyDownHandler(event:KeyboardEvent):void
			{
				// TODO Auto-generated method stub
				if (event.keyCode == Keyboard.ENTER)
				{
					parentDocument.parentDocument.filterItem(this.filterItemTxt.text);
				}
			}
			
 
			
			/* 
			click="lblItem_clickHandler(event)"
			protected function lblItem_clickHandler(event:MouseEvent):void
			{
				// TODO Auto-generated method stub
				parentDocument.adgColItem.sortable = true;
				// parentDocument.adgColItem.dispatchEvent(new MouseEvent(MouseEvent.CLICK, true, false));   
				// 
				parentDocument.itemSort();
				parentDocument.adgColItem.sortable = false;
			} */
			
			protected function filterItemTxt_focusInHandler(event:FocusEvent):void
			{
				// TODO Auto-generated method stub
				parentDocument.parentDocument.adgColItem.sortable = false;
			}
			
			protected function filterItemTxt_focusOutHandler(event:FocusEvent):void
			{
				// TODO Auto-generated method stub
				parentDocument.parentDocument.adgColItem.sortable = true;
			}
			
		]]>
	</mx:Script>
	
	<mx:HBox xmlns:mx="http://www.adobe.com/2006/mxml" paddingLeft="0" paddingTop="0" paddingRight="0" paddingBottom="0" width="100%" height="100%" verticalAlign="middle" horizontalAlign="center">
		<mx:Script>
			<![CDATA[
			public var myVerdana:Class;
		  	import mx.controls.advancedDataGridClasses.AdvancedDataGridColumn;
			import mx.managers.SystemManager;
			import flash.events.Event;
			import flash.events.EventDispatcher;
			import flash.events.IEventDispatcher;
			import mx.controls.TextInput;
			import mx.controls.Button;
				
			import flash.events.KeyboardEvent;
			import flash.events.MouseEvent;
			import flash.ui.Keyboard;
			]]>
		</mx:Script>
		<mx:Label  id="lblItem"  text="Item" />
	</mx:HBox>
	<mx:HBox xmlns:mx="http://www.adobe.com/2006/mxml" paddingLeft="0" paddingTop="0" paddingRight="0" paddingBottom="0" width="100%" height="100%" verticalAlign="middle" horizontalAlign="center">
		<mx:Image xmlns:mx="http://www.adobe.com/2006/mxml" 
					id="imgDUP"	
					width="13"
					height="13"
					source="/flex/assets/Images/filter-icon_15_trans.gif" 
					useHandCursor="false" 
					buttonMode="true" 
					mouseChildren="false"
					/>
		<mx:TextInput id="filterItemTxt" 
					  focusIn="filterItemTxt_focusInHandler(event)"
					  focusOut="filterItemTxt_focusOutHandler(event)" 
					  keyDown="filterItemTxt_keyDownHandler(event)" 
					  width="50" height="22" paddingLeft="0" paddingTop="0" fontSize="10" toolTip="Type search text and press &lt;enter&gt; to filter" />
	</mx:HBox>
</mx:VBox>	