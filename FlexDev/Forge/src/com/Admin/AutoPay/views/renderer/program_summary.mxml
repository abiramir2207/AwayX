<?xml version="1.0" encoding="utf-8"?>
<!--- This is the popup for program summary. -->
<mx:VBox xmlns:mx="http://www.adobe.com/2006/mxml" horizontalScrollPolicy="off">
<mx:HBox horizontalGap="1">
<mx:Text text="[{data.contractNumber}]"  id="program_num" click="openProgram(data.contractId,'0')" useHandCursor="true" mouseChildren="false" buttonMode="true" toolTip="{data.contractNumber}{'\n'}[Click to preview Program]" />
	<!-- color="{getColor(data.is_catalog)}"   dataTipFunction="fnDgToolTipProgram" --> 
	<mx:Script>
	<![CDATA[
		/* import com.Billback.Deviation.events.*;
		import com.Billback.Deviation.maps.*;
		import com.Billback.Deviation.models.*;
		import com.Billback.Deviation.views.*; */
		
		import mx.controls.Alert;
		import mx.core.Application;
		import mx.utils.ObjectUtil;
				
		private function getColor(Catalog:String):int
		{
			var colorCode:int = 0;
			
			if(Catalog == '1')
			{
				/* Color:Lavender Blush4 */
				colorCode = 0x817679;
			}
			return colorCode;
		}
		
		/* Program Summary */		
		private function openProgram(Program_ID:int,Catalog:String) : void
		{
			var programId:int;
			
			if (data.hasOwnProperty("Latest_Program_ID") && data.contractId != data.Latest_Program_ID){
				programId = data.Latest_Program_ID;
			
			}
			else{
				programId = Program_ID;
			}
			 if(Catalog == '0')
			 {
		     	var winjscommand:String ="/CID_Wrapper.cfm?Program_ID="+programId+"&Page_Relocate=/scorecard/program_display.cfm";
				var jscommand:String = "window.open('"+winjscommand+"','winSummary','height=710,width=1015,toolbar=no,scrollbars=yes,left=0,top=0,screenX=0,screenY=0,resizable=yes');"   
				var url:URLRequest = new URLRequest("javascript:" + jscommand + " void(0);");   
				navigateToURL(url, "_self");
			 }
	   }
   ]]>    
	</mx:Script>

	</mx:HBox>
</mx:VBox>