			[Bindable]
			public var AsEvent:AliasEvent;
			[Bindable]
			public var pModelUpload:AliasUpload;

			public function fnInitialize():void  
			{
				//set tool tip maxwidth so that the rate decimal tool tip takes up more horizontally space than vertical
				ToolTipManager.toolTipClass = HTMLToolTip;
				ToolTip.maxWidth = 550;
				if (this.pModel.aliasSourceType == 1)
				{
					var eOpr:AliasEvent = new AliasEvent(AliasEvent.SHOW_HIDE_ADDRESS_COLS);
					eOpr.bShowAddressCols = false;
					eOpr.iSelectedTab	 = this.pModel.dataProviderType;
					eOpr.sSourceType 	 = this.pModel.aliasSourceType.toString();
					this.dispatchEvent(eOpr);
				}
			}
			
			public var bEntityDetail:Boolean = true;
			
			/* This function will remove any filter on the Datagrid whenever a new tab is called  */
			public function resetInitialFilter(event:AliasEvent):void
			{
				// this.cbShowUnassigned.dispatchEvent(new ItemClickEvent(ItemClickEvent.ITEM_CLICK));
				// var rdoShowIgnoreSel:Object = this.rdoShowIgnore.
				
				var idxRdoSelected:int = 3; 
				filter();
				
				this.pModel.setShowUnassigned(this.cbShowUnassigned.selected);
				
				//this.pModel.setShowIgnore(this.cbShowIgnore.selected);
				// Alert.show(this.rdoShowIgnore.selectedIndex.toString());
				
				if (this.rdoShowIgnore3.selected)
				{
					idxRdoSelected = 3;
				}
				else if (this.rdoShowIgnore2.selected)
				{
					idxRdoSelected = 2;
				}
				else if (this.rdoShowIgnore1.selected)
				{
					idxRdoSelected = 1;
				}
				this.pModel.setShowIgnore(idxRdoSelected);
				
				if(this.pModel.aliasSelectedDef.aliasID != ""){
					this.dgAlias.selectedItem = this.pModel.aliasSelectedDef;
				}
				else{
					this.dgAlias.selectedIndex = -1;
				}
				//this.pModel.aliasCurrentSelectedDef.refresh();
			}
			
			
			/* Call this when the user hits the "Enter" key */
			private function saveAliasesEnterKey(event:KeyboardEvent):void 
			{
				/* If the "Enter" key was clicked and the focus through tab is on the button titled "search alias" */
				if (event.keyCode == Keyboard.ENTER && Object(focusManager.getFocus()).id == 'btnSave')
				{	 		
					triggerSaveAliases();
					
				}
			}
			
			private function triggerSaveAliases():void
			{
				/* save Aliases */         
				this.pModel.saveSelectedAlias(this.pModel.dataProviderType);
				/* this call will get the entity description */
				/* this.pModel.getDesc(this.pModel.dataProviderType.toString()); */
			}
			
			/* Call this when the user hits the "Enter" key */
			private function resetAliasesEnterKey(event:KeyboardEvent):void
			{
				/* If the "Enter" key was clicked and the focus through tab is on the button titled "reset" */
				if (event.keyCode == Keyboard.ENTER && Object(focusManager.getFocus()).id == 'btnResetAlias')
				{	 		
					triggerResetAlias();
				}		 				 		
			}
			
			private function triggerResetAlias():void
			{	 
				this.pModel.resetSelectedAlias();
				//this.stage.focus = null;
				//dgAlias.setFocus();
				//grid.selectedIndex = -1;
				//dgAlias.dispatchEvent(new Keyboard(Keyboard.ESCAPE));
				//dgAlias.dispatchEvent(new KeyboardEvent (KeyboardEvent.KEY_DOWN,true,false,0,27));
				
				/* In flex, whenever a user selects a cell on the grid and then takes the focus away from the grid and then when the user tabs into the grid
				again, the focus is automatically taken to the cell which the user last visited. Though this feature is useful, it is not required when
				the user clicks on "reset". After clicking on "reset", the tabbing action into the grid should always take the user to the first cell.
				The solution is to set the editedItemPosition to the first cell and then remove focus from that cell and then put focus on the field (aliasID)
				where focus is required. Now the last visited call becomes the first cell and on tabbing the user is taken to that cell. 
				*/
				/* 	The grid has "focusIn" event which calls "entityIDChange" function. When a user clicks on "reset", we do not want the entityID
				and EntityDesc to be populated. So, set "bEntityDetail" to false.
				*/
				bEntityDetail =  false;
				dgAlias.editedItemPosition = {rowIndex: 0, columnIndex: 1};
				dgAlias.selectedIndex = -1;
				callLater(gridFocusOut);
				callLater(textInputFocusIn);			
			}
			
			private function gridFocusOut():void
			{
				dgAlias.dispatchEvent(new FocusEvent(FocusEvent.FOCUS_OUT));
			}
			
			private function textInputFocusIn():void
			{	
				/* focus on the "Alias ID" textbox */
				focusManager.setFocus(tiAliasID);
				/* Call "this.pModel.resetSelectedAlias();" again to reset  as "dgAlias.editedItemPosition" above calls the "focusIn" event on the grid */
				this.pModel.resetSelectedAlias();
				//tiAliasID.text = '';
				//tiAliasID.dispatchEvent(new FocusEvent(FocusEvent.FOCUS_IN));
			}
			
			private function entityIDChange():void{
				/* 	We do not want the entityID and EntityDesc to be populated when a user clicks on reset. AliasID and AliasDesc is already not populated
				as we use "this.pModel.resetSelectedAlias()", but since "dgAlias.editedItemPosition" calls the "focusIn" event, EntityID and EntityDesc
				would get populated even though we use "this.pModel.resetSelectedAlias();" after "dgAlias.editedItemPosition" due to timing issue.
				*/
				if(bEntityDetail == true){			
					this.pModel.getDesc(tiEntityID.text);
					this.pModel.updateID(tiEntityID.text);
				}
				
				/* Reset back to "true", which is the default. */
				bEntityDetail = true;
			}
			
			/* This is the filter logic for unassigned aliases - blank entityID or entityDesc  */	
			[Bindable] 
			public var filterInsertAll:Function =
				function(inObject:Object):Boolean{
					// return inObject.entityID == '' || inObject.entityDesc == '';
					return (inObject.isAssigned == false); //&& (inObject.Unknown == true || inObject.Unknown == false)
				};
			
			/*private function showUnassigned():void{
				if(cbShowUnassigned.selected){
					dgAlias.filterInsert = this.filterInsert;
				}
				else{
					/// return true by default 
					dgAlias.filterInsert =  function(inObject:Object):Boolean{return true;};
				}
				dgAlias.dispatchEvent(new Event("filterEvent"));
			}*/
			
			[Bindable] 
			public var filterInsertIgnore:Function =
				function(inObject:Object):Boolean{
					// return inObject.entityID == '' || inObject.entityDesc == '';
					return (inObject.Unknown == true && (inObject.isAssigned == false || inObject.isAssigned == true)); 
				};
			[Bindable] 
			public var filterInsertUnIgnore:Function =
				function(inObject:Object):Boolean{
					// return inObject.entityID == '' || inObject.entityDesc == '';
					return (inObject.Unknown == false && (inObject.isAssigned == false || inObject.isAssigned == true));  
				};
			[Bindable] 
			public var filterInsertIgnoreUna:Function =
				function(inObject:Object):Boolean{
					// return inObject.entityID == '' || inObject.entityDesc == '';
					return inObject.Unknown == true && inObject.isAssigned == false;
				};
			
			[Bindable] 
			public var filterInsertUnaNi:Function =
				function(inObject:Object):Boolean{
					// return inObject.entityID == '' || inObject.entityDesc == '';
					return inObject.Unknown == false && inObject.isAssigned == false;
				};
			
			/*
			rdoShowIgnore1 - show ignored
			rdoShowIgnore2 - show unignored
			rdoShowIgnore3 - show all
			*/
			private function filter():void{
				if(this.cbShowUnassigned.selected && this.rdoShowIgnore1.selected){ 			// show unassigned and Show ignored 
					dgAlias.filterInsert = this.filterInsertIgnoreUna;
				}
				else if(this.cbShowUnassigned.selected && this.rdoShowIgnore2.selected){		// show unassigned and show unignored
					dgAlias.filterInsert = this.filterInsertUnaNi;
				}
				else if(this.cbShowUnassigned.selected && this.rdoShowIgnore3.selected){		// show unassigned and both ignore and not ignored
					dgAlias.filterInsert = this.filterInsertAll;
				}
				else if(this.rdoShowIgnore1.selected){								// show Only ignore
					dgAlias.filterInsert = this.filterInsertIgnore;	
				}
				else if(this.rdoShowIgnore2.selected){								// show Only ignore
					dgAlias.filterInsert = this.filterInsertUnIgnore;	
				}
				else
				{
					/* return true by default */
					//dgAlias.filterInsert =  function(inObject:Object):Boolean{return (this.selectedItem && inObject.aliasID == this.selectedItem.aliasID);};
					dgAlias.filterInsert =  function(inObject:Object):Boolean{return (inObject.Unknown == true || inObject.Unknown == false);};
				}
				dgAlias.dispatchEvent(new Event("filterEvent"));
			}
			
			private function showToolTip(item:Object):String
			{
				var desc:String = "";
				if(item != null)
				{
					desc = item.entityAddress.toString();
				}
				return desc;
			}

			
			/* Presentation Model */
			[Bindable]
			public var pModel:AliasItemsPModel;
			
			[Bindable]
			private var sToolTip:String = "<textformat leading='8'>The Payee ID field is only applicable for EDI records.  When the Source Type of EDI is selected, the Payee ID field can be updated. </textformat>";
			
			public function fnPositionToolTip(event:ToolTipEvent):void
			{
				var pt:Point = event.currentTarget.contentToGlobal(new Point(0,0));
				ToolTipManager.currentToolTip.y = pt.y - 50; // 68
				ToolTipManager.currentToolTip.x = pt.x - 20;
				ToolTipManager.currentToolTip.height = 50;
				
			}
			
		]]>
	</fx:Script>
