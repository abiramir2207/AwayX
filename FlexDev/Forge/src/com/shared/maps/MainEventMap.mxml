<?xml version="1.0" encoding="utf-8"?>
<EventMap 
	xmlns:fx="http://ns.adobe.com/mxml/2009" 
	xmlns:mx="library://ns.adobe.com/flex/mx"
	xmlns="http://mate.asfusion.com/" xmlns:mate="http://mate.asfusion.com/">
	<fx:Script>
		<![CDATA[
			import com.asfusion.mate.core.*;
			import com.asfusion.mate.events.UnhandledFaultEvent;
			import mx.events.*;
			import com.shared.events.*;
			import com.shared.views.MainPanel;
			import com.shared.models.*;
			import com.shared.views.MainUIPM;
			import com.ContractProds.events.ComponentEvent;
			//import com.ContractProds.vos.*;
		]]>
	</fx:Script>
	<fx:Declarations>

<!--	<mate:Debugger level="{Debugger.ALL}" />-->
	<!-- load up an instance of the remote objects -->
	<!-- Remote Services  ***************************************************************************************** -->
	<mx:RemoteObject id="MainService" destination="ColdFusion" source="mvc.Models.SettingsService" />
	<!--- Search functionality including initial dataload <p>roSearchService : <strong>mvc.models.Distributor.DistributorSearchService</strong></p> -->
	<!--- roErrorService : <strong>mvc.models.ErrorService</strong> -->
	<mx:RemoteObject id="ErrorService" destination="ColdFusion" source="mvc.Models.ErrorService" />

	<!-- FlexEvent.PREINITIALIZE   ******************************************************************************** -->
	<!---@see com.ContractProds.models.SettingsManager#loadURLParameters()
			Invoke : com.ContractProds.models.SettingsManager.loadURLParameters()-->
	<EventHandlers type="{FlexEvent.PREINITIALIZE}" id="ePREINITIALIZE">
		<ObjectBuilder generator="{MainManager}" id="oManager" cache="global" />
		<ObjectBuilder generator="{SettingsManager}" id="oSettingsManager" cache="global" constructorArguments="{scope.dispatcher}" />
		<ObjectBuilder generator="{ContractModuleManager}" id="oContractModuleManager" cache="global" />
		<ObjectBuilder generator="{BAError}" id="oBAError" cache="global" />
		<!--<MethodInvoker generator="{SettingsManager}" method="loadURLParameters" cache="global" />-->
	</EventHandlers>
	
	<!-- FlexEvent.APPLICATION_COMPLETE     ************************************************************************* -->
	<EventHandlers type="{FlexEvent.CREATION_COMPLETE}" id="eCREATION_COMPLETE">
		<!--call db for other settings-->
		<EventAnnouncer type="{MainEvent.LOAD_APP_SETTINGS}" generator="{MainEvent}">
			<Property sourceCache="global" source="{SettingsManager}" sourceKey="settings.userId" targetKey="userId"/>
		</EventAnnouncer>

	</EventHandlers>
 
 
    <!-- ************************************************
    	 ADD NEW EventHandlers Here   *******************
         ************************************************-->
     <EventHandlers type="{MainEvent.SEARCH_PAYEE}" debug="true" id="eSEARCH_PAYEE" useWeakReference="true">
        <MethodInvoker 	generator="{ContractModuleManager}" method="showPayeeSearch"
        				arguments="{event}" />
    </EventHandlers>
    
    <EventHandlers type="{MainEvent.CLOSE_PAYEE}" debug="true" id="eCLOSE_PAYEE" useWeakReference="true">
        <MethodInvoker 	generator="{ContractModuleManager}" method="closePayeeSearch"/>
    </EventHandlers>

 	<!---............... SET_PAYEE ................Empty Listener to prevent type coecion error when talking between modules.
 	...............................................This event is really handled in  compponentManger -->
	<!--<EventHandlers type="{ComponentEvent.SET_PAYEE}" debug="true" id="eSET_PAYEE" dispatcherType="global" useWeakReference="true">
        <MethodInvoker 	generator="{ComponentManager}" method="setPayee" arguments="{event}" />
   </EventHandlers>-->

    <!--LOAD APP SETTINGS *************************************************************************** -->
     <!--- 			@see #roMainService
	    ** RemoteInvoke : roMainService.getSettingsObject()
	    		@see com.ContractProds.models.SettingsManager#setAppSettings() 
	    ** Handler : com.ContractProds.models.SettingsManager.setAppSettings()   -->
	<EventHandlers type="{MainEvent.LOAD_APP_SETTINGS}" debug="true">
		<RemoteObjectInvoker instance="{MainService}" showBusyCursor="true" method="getSettingsObject" debug="true">
			<!-- result sequence gets executed when service returns with a result -->
			<resultHandlers>
				<MethodInvoker cache="global" generator="{SettingsManager}" method="setAppSettings" arguments="{resultObject}" />
				<!-- after settings are applied (user has been validated) load Modules
					** THIS WAS MOVED TO SETTINGSMANAGER setAppSettings()-->
				<!--<EventAnnouncer type="{MainEvent.LOAD_MODS_MAIN}" generator="{MainEvent}" />-->
			</resultHandlers>
			<!-- server fault -->
			<faultHandlers>
				<!--announce error event -->
				<EventAnnouncer type="{MainEvent.BSA_ERROR}" generator="{MainEvent}" >
					<Properties sBaError="MainEvent SETTINGS SERVICE (load app settings event = LOAD_APP_SETTINGS)" />
					<Properties oBaError="{fault}" />
				</EventAnnouncer>
			</faultHandlers>
		</RemoteObjectInvoker>
	</EventHandlers>
	
	<!--SET STATE FOR SEARCH ITEMS *************************************************************************** -->
	<EventHandlers type="{ MainEvent.SEARCH_ITEMS }">
		<MethodInvoker generator="{ MainUIPM }" method="updState" arguments="{event.sState}" />
	</EventHandlers>

	
	<!--	*****************************************************************************************
			***		BSA CUSTOM ERROR HANDLER 		*************************************************
			***************************************************************************************** -->

<!---  	<p>First display the error to the user</p>
		<p>Then Try to log the error on the cf server</p> 
		<p>there is a fault Logging the error on the server show the "ERROR SERVICE" Message</p>
		<p>*********************************************************************************</p>
		*      @see com.ContractProds.models.BAError#showBAError()
		** Invoke : com.ContractProds.models.BAError.showBAError()		
		*			@see #roErrorService
	    ** RemoteInvoke : roErrorService.logError()
	    *		@see com.ContractProds.models.BAError#logError() 
	    ** faultHandler : com.ContractProds.models.BAError.showBAError()   -->
	<EventHandlers type="{MainEvent.BSA_ERROR}">
     	<MethodInvoker generator="{BAError}" method="showBAError" arguments="{event.oBaError}" cache="none" >
			<Properties BAErrorString="{event.sBaError}" />
		</MethodInvoker>
		<!--log error on server-->	
		<RemoteObjectInvoker instance="{ErrorService}" method="logError" arguments="{[event.oBaError.faultDetail, event.oBaError.faultString]}">
			<faultHandlers>
			<!--If the server notification (log error on cf server) fails throw a simple pop-up error-->
				<!--call method -->
				<MethodInvoker generator="{BAError}" method="showBAError" arguments="{fault}" cache="none" >
					<Properties BAErrorString="ERROR SERVICE: The server is not responding.  Please contact support." />
				</MethodInvoker>
			</faultHandlers>
		</RemoteObjectInvoker>
     </EventHandlers>

	<!--GLOBAL ERROR HANDLER  *********************************************************************** -->
	<EventHandlers type="{UnhandledFaultEvent.FAULT}">
     	<MethodInvoker generator="{BAError}" method="showBAError" arguments="{event.fault}" cache="none" >
			<Properties BAErrorString="UNHANDLED" />
		</MethodInvoker>
		<!--log error on server-->	
		<RemoteObjectInvoker instance="{ErrorService}" method="logError" arguments="{[event.fault.faultDetail, event.fault.faultString]}"/>
     </EventHandlers>
	
	<Injectors target="{AliasMain}">
		<ListenerInjector eventType="{MainEvent.LOAD_MODS_MAIN}" method="loadAlias" useWeakReference="true" />
		<PropertyInjector targetKey="settings" source="{SettingsManager}" sourceKey="settings"  softBinding="false" />
	</Injectors>
		
	<Injectors target="{EDIViewerMain}">
		<ListenerInjector eventType="{MainEvent.LOAD_MODS_MAIN}" method="loadEDIViewer" useWeakReference="true" />
		<PropertyInjector targetKey="settings" source="{SettingsManager}" sourceKey="settings"  softBinding="false" />
	</Injectors>
		
	<Injectors target="{MainPanel}" debug="true">
		<PropertyInjector sourceCache="global" targetKey="oSettings" source="{SettingsManager}" sourceKey="settings"  softBinding="true" />
	</Injectors>
		

		
	</fx:Declarations>
</EventMap>
