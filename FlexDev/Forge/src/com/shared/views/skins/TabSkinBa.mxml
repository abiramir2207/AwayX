<!--- The Spark skin class for the tabs of the MX TabNavigator container. 

		@see mx.containers.TabNavigator
	
		@langversion 3.0
		@playerversion Flash 10
		@playerversion AIR 1.5
		@productversion Flex 4
-->
<s:SparkSkin xmlns:fx="http://ns.adobe.com/mxml/2009" xmlns:s="library://ns.adobe.com/flex/spark" 
			 minWidth="21" minHeight="21"
			 alpha.disabledStates="0.5">
	
	<fx:Script>
		/**
		 * @private
		 */
		override protected function initializationComplete():void
		{
			useChromeColor = true;
			super.initializationComplete();
		}
	</fx:Script>
	
	<!-- states -->
	<s:states>
		<s:State name="up" />
		<s:State name="over" />
		<s:State name="down" />
		<s:State name="disabled" stateGroups="disabledStates"/>
		<s:State name="selectedUp" stateGroups="selectedStates" />
		<s:State name="selectedOver" stateGroups="selectedStates" />
		<s:State name="selectedDown" stateGroups="selectedStates" />
		<s:State name="selectedDisabled" stateGroups="disabledStates, selectedStates" />
	</s:states>
	
	<!-- layer 1: fill -->
	<!-- topLeftRadiusX and topRightRadiusX is for "cornerRadius" -->
	<s:Rect left="1" right="1" top="1" bottom="0" topLeftRadiusX="5" topRightRadiusX="5">
		<s:fill>
			<!-- Modified the colors here to get the background color -->
			<s:LinearGradient rotation="90">
				<s:GradientEntry color="0xFFCE84" color.over="0xCACACA"
								 color.selectedStates="0xFFFFFF"
								 alpha="1" />
				<s:GradientEntry color="0xFFFFFF" color.over="0x878787"
								 color.selectedStates="0xE4E4E4" 
								 alpha="1" />
			</s:LinearGradient>
		</s:fill>
	</s:Rect>
	
	<!-- layer 2: highlight stroke -->
	<!-- topLeftRadiusX and topRightRadiusX is for "cornerRadius" -->
	<s:Rect left="1" right="1" top="1" bottom="1" alpha=".22" topLeftRadiusX="5" topRightRadiusX="5">
		<s:stroke>
			<s:LinearGradientStroke rotation="90">
				<s:GradientEntry color="0xFFFFFF" alpha="1" />
				<s:GradientEntry color="0xD8D8D8" alpha="1" />
			</s:LinearGradientStroke>
		</s:stroke>
	</s:Rect>
	
	<!-- layer 3: fill highlight -->
	<!-- topLeftRadiusX and topRightRadiusX is for "cornerRadius" -->
	<s:Rect left="1" right="1" top="1" bottom="1" topLeftRadiusX="5" topRightRadiusX="5">
		<s:fill>
			<s:LinearGradient rotation="90">
				<s:GradientEntry color="0xFFFFFF"
								 ratio="0.0"
								 alpha="0.12"
								 alpha.down="0.12"/>
				<s:GradientEntry color="0xFFFFFF"
								 ratio="0.48"
								 alpha="0.12" />
				<s:GradientEntry color="0xFFFFFF"
								 ratio="0.48001"
								 alpha="0" />
			</s:LinearGradient>
		</s:fill>
	</s:Rect>
	
	<!-- layer 4: border - unselected only -->
	<!-- topLeftRadiusX and topRightRadiusX is for "cornerRadius" -->
	<s:Rect left="0" right="0" top="0" bottom="0" excludeFrom="selectedStates" topLeftRadiusX="5" topRightRadiusX="5">
		<s:stroke>
			<!-- Modified color and alpha to get the light grey color -->
			<s:SolidColorStroke color="0x000000" alpha=".15" />
		</s:stroke>
	</s:Rect>
	
	<!-- layer 5: border - selected only -->
	<!-- topLeftRadiusX and topRightRadiusX is for "cornerRadius" -->
	<!-- Modified color and alpha below to get the light grey color -->
	<s:Rect left="0" width="1" top="0" bottom="0" includeIn="selectedStates" topLeftRadiusX="5" topRightRadiusX="5">
		<s:fill>
			<s:SolidColor color="0x000000" alpha=".15" />
		</s:fill>
	</s:Rect>
	<s:Rect left="1" right="1" top="0" height="1" includeIn="selectedStates" topLeftRadiusX="5" topRightRadiusX="5">
		<s:fill>
			<s:SolidColor color="0x000000" alpha=".15" />
		</s:fill>
	</s:Rect>
	<s:Rect width="1" right="0" top="0" bottom="0" includeIn="selectedStates" topLeftRadiusX="5" topRightRadiusX="5">
		<s:fill>
			<s:SolidColor color="0x000000" alpha=".15" />
		</s:fill>
	</s:Rect>
	
</s:SparkSkin>