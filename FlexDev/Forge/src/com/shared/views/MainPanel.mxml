			//	mod.child.addEventListener(ErrorEvent.ERROR,errorHandler);
			if (this.mod.child != null) {                    
				/* Call data getters in the module  */
				ichild.setSettings(this.oSettings);
			} else {                
				trace("AutoPay Module could not load ()");                 
			}
			//clean up
			mod.removeEventListener(ModuleEvent.READY,ModReady);
		}
        
        public function removeModule(m:ModuleLoader):void {
