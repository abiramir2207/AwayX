            public function createModule(e:MainEvent):void {  //m:ModuleLoader, s:String
				//we need relative path to debug and dev however release version needs absolute path
				var s:String = '/flex/com/ContractProds/ContractProds.swf';
				
				if(e.settings.bDebug){ //DEBUG URL
					s =  'com/ContractProds/ContractProds.swf';
				}
			this.mod.addEventListener(ModuleEvent.READY, ModReady,false,0,true);
            if (!this.mod.url) {
				this.mod.url = s;
              //  return;
            }
			//m.applicationDomain = ApplicationDomain.currentDomain;
			this.mod.loadModule();
