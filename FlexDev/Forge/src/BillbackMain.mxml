		public function searchModReady(e:Event):void {
			var mod:ModuleLoader = new ModuleLoader();
			mod = e.currentTarget as ModuleLoader;
			var ichild:* = mod.child as IBBSearch;
			if (mod.child != null) {                    
				/* Call data getters in the module  */
				ichild.getLoadLookupData(pModel.oSettings.userId);
				//ichild.getAllColumnsSize(pModel.oSettings.userId);
				ichild.setSettings(this.pModel.oSettings);
				ichild.setSearch(pModel.oSettings.userId,pModel.oSettings.status);
			} else {                
				trace("BB Search Module could not load ()");                 
			}
			//clean up
			mod.removeEventListener(ModuleEvent.READY,searchModReady);
			//tnavHome.selectedChild = mod;
		}
		
		
		public function editModReadySelectTab(e:Event):void {
			var mod:ModuleLoader;
			mod = e.currentTarget as ModuleLoader;
			var ichild:IBBEdit = mod.child as IBBEdit;
			if (mod.child != null) {                    
				/* Call setters in the module  */
				var sId:String = mod.id;
				dictEdit[sId].child.setSelectedTab(1);
				dictEdit[sId].child.setSettings(this.pModel.oSettings);
				/* need to get BBHeader obj from Search screen event */
				dictEdit[sId].child.setPayeeList(this.payeeList);
				dictEdit[sId].child.setClosingMethods(this.closingMethodList);
				dictEdit[sId].child.setBBAnalysts(this.bbAnalysts);
				dictEdit[sId].child.setBB(dictEditBBh[sId]);
				
			} else {                
				trace("BB Edit Module could not load ()");                 
			}
			//clean up
			mod.removeEventListener(ModuleEvent.READY,editModReadySelectTab);
		}
