		public function loadDeviations(e:BBMainEvent):void {
			if (navigator.selectedChild) {
				this.bbHCurrent = e.bbHeader;
				/* NEED TO CHECK IF SELECTED TAB IS SAME BB AS e.BHeader PASSED IN */
				var mod:ModuleLoader = navigator.selectedChild as ModuleLoader;
				var modDevApp:ModuleLoader = new ModuleLoader();
				var ichild:IBBEdit = mod.child as IBBEdit;
				var idx:int = navigator.getChildIndex(mod);
				//e.bbHeader.BBCode
				// if(mod.url == "com/Billback/Edit/BBEdit.swf" && (ichild.getBBId() == e.bbHeader.billbackIDInt.toString()) || e.bbHeader.billbackIDInt ==0){
				if(mod.url == "com/Billback/Edit/BBEdit.swf" && (ichild.getBB().billbackIDInt = e.bbHeader.billbackIDInt) || e.bbHeader.billbackIDInt == 0){;
					navigator.removeChild(mod);
					//mod.unloadModule();
					//delete dictEdit[mod.id];
					//mod.removeElement(ichild as IVisualElement);
					//ichild = null;
					dictEditBBh[mod.id] = e.bbHeader;
					modDevApp.label = "Deviations: " + ' (' + e.bbHeader.BBCode + ')';
					modDevApp.addEventListener(ModuleEvent.READY, deviationModReady,false,0,true);
					modDevApp.loadModule('com/Billback/Deviation/BillbackDevApp.swf');
					modDevApp.id = mod.id;
					navigator.addChildAt(modDevApp,idx);
					navigator.selectedChild = modDevApp;
				}
				else{
					//textField.text = "NO UnLoad of Search "+System.totalMemory.toString()+"\n"+textField.text;
				}
				
			}
		}
		private function showAlert():void{
			Alert.show('Unable to open Billback.  Max number of open items has been reached [ ' + MAX_CHILDREN + ' ].','Maximum Tabs Alert');
		}
		
