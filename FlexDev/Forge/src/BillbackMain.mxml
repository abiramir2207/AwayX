		public function initApp():void
		{
			// add keyboard event handler
			this.addEventListener(KeyboardEvent.KEY_UP,bbKeyHandler);	
			applyRuntimeStyleSheet();
		}
		
		private function bbKeyHandler(event:KeyboardEvent):void 
		{
			var bShiftPressed:Boolean = event.shiftKey;
			var bCTRLPressed:Boolean = event.ctrlKey;
			var selectedTab:int = navigator.selectedIndex;
			
			if (bCTRLPressed) {
				var curKeyCode:int = event.keyCode;
				
				// New BB = CTRL+SHIFT+N(78)
				if (bShiftPressed && curKeyCode == 78) {
					var e:BBMainEvent = new BBMainEvent(BBMainEvent.EDIT_BB);
					var bbH:BBHeader = new BBHeader();
					e.bbHeader = bbH;
					e.payeeList = new Array(bbH.payee);
					e.closingMethodList = this.closingMethodList; // Send in the closingMethod List too for the edit screen dropdown instead of loading from CF.
					e.bbAnalysts = this.bbAnalysts; // Send in the analysts List too for the edit screen dropdown instead of loading from CF.
					this.dispatchEvent(e);
				}
				
				// Undo = CTRL+Z(90)
				if (curKeyCode == 90) {
					if(event.target.hasOwnProperty('textFlow')){
						this.undoAction(event.target.textFlow);					
					}
				}
				
				// Redo = CTRL+Y(89)
				if (curKeyCode == 89) {
					if(event.target.hasOwnProperty('textFlow')){
						this.redoAction(event.target.textFlow);
					}
				}
				// Redo = CTRL+Y(89)
				if (curKeyCode == 89) {
					if(event.target.hasOwnProperty('textFlow')){
						this.redoAction(event.target.textFlow);
					}
				}
				
				// Toggle = CTRL+`(192) / Toggle back = CTRL+SHIFT+`(192)
				
				if (curKeyCode == 192) {
					if(bShiftPressed){selectedTab--;}							// if shift pressed then move left(-)
					else{selectedTab++;}										// if no shift pressed then move right(+)
					
					if(selectedTab < 0){selectedTab = (navigator.length-1);} 	// if @ first then set to last
					if(selectedTab > (navigator.length-1)){selectedTab = 0}		// if @ last then set to first
					navigator.selectedIndex = selectedTab;
				}
				
				
				// Toggle = CTRL+ Rt Arrow (39)
				if (curKeyCode == 39) {
					selectedTab++;												// move right(+)
					if(selectedTab > (navigator.length-1)){selectedTab = 0}		// if @ last then set to first
					navigator.selectedIndex = selectedTab;
				}
				
				// Toggle = CTRL+ Lt. Arrow (37)
				if (curKeyCode == 37) {
					selectedTab--;												// move left(-)
					if(selectedTab < 0){selectedTab = (navigator.length-1);} 	// if @ first then set to last
					navigator.selectedIndex = selectedTab;
				}
				
			}
		}
		
		public function undoAction( textFlow:TextFlow ):void
		{
			if( textFlow.interactionManager is IEditManager ) 
			{
				IEditManager( textFlow.interactionManager ).undo();
			}
		}
		
		public function redoAction( textFlow:TextFlow ):void
		{
			if( textFlow.interactionManager is IEditManager )
			{
				IEditManager( textFlow.interactionManager ).redo();
			}
		}
		
