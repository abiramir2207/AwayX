		public function loadBBEdit(e:BBMainEvent):void {
			if (navigator.numChildren <= MAX_CHILDREN) {
				// this.sBBId = e.bbId;
				var dtNow:Date = new Date();
				//this.bbHCurrent= e.bbHeader;
				//this.closingMethodList= e.closingMethodList;
				//this.bbAnalysts = e.bbAnalysts;
				this.payeeList = e.payeeList;
				//this.reDirector = e.reDirector;
				var BBEditMod:ModuleLoader = new ModuleLoader();
				//sId becomes the ID of the module
				var sId:String = 'v' + e.bbHeader.billbackIDInt.toString() + '_' + dtNow.getTime().toString();
				
				var bLoaded:Boolean = false;
				var idx:uint;
				var len:uint = navigator.numChildren;
				var ichild2:IBBEdit;
				//look for loaded mod -> xtra logic needed for Create bb with bbid = 0
				for (idx=0; idx<len; idx++) {
					var mod2:ModuleLoader = navigator.getChildAt(idx) as ModuleLoader;
					if(mod2){
						var arr:Array = com.shared.components.StringUtils.listToArray(mod2.id,'_');
						if(arr[0] == 'v' + e.bbHeader.billbackIDInt.toString() &&  arr[0] != 'v0'){
							bLoaded = true;
							sId = mod2.id;
							break;
						}
					}
				}
				if(bLoaded){
					//BBEditMod = dictEdit[sId];
					//	var ichild:IBBEdit = dictEdit[sId].child;
					/* Call setters in the module  */
					dictEdit[sId].child.setSettings(this.pModel.oSettings);
					navigator.selectedChild = dictEdit[sId];
					/* DONT RELOAD IN CASE USER MADE UPDATES */
					//ichild.setBB(e.bbHeader);
					//ichild.setClosingMethods(e.closingMethodList);
				}
				else if(navigator.numChildren <= MAX_CHILDREN){
					
					/* info = ModuleManager.getModule("com/Billback/Edit/BBEdit.swf");
					var x:DisplayObject = info.factory.create() as DisplayObject;
					var z:ModuleManager; */				
					
					var s:String = 'com/Billback/Edit/BBEdit.swf';
					dictEdit[sId] = BBEditMod; //this['BBEditMod' + i.toString()];
					i++;
					dictEditBBh[sId] = e.bbHeader;
					dictEdit[sId].id = sId;
					if(e.bbHeader.billbackIDInt){
						dictEdit[sId].label = e.bbHeader.BBtype.description + ": " + ' (' + e.bbHeader.BBCode + ')'; // + i.toString()
					}
					else{
						dictEdit[sId].label = 'new';
					}
					var childDomain:ApplicationDomain = new ApplicationDomain(ApplicationDomain.currentDomain);
					//set dictionary firsyt since Load() -> editModReady() needs the data
					dictEdit[sId].addEventListener(ModuleEvent.READY, editModReady,false,0,true);
					dictEdit[sId].applicationDomain = childDomain;
					dictEdit[sId].loadModule(s);
					//add to ui and select
					navigator.addChild(dictEdit[sId]);
					navigator.selectedChild = dictEdit[sId];
				}
				
			}
			else{
				showAlert();
			}
			//System.gc();
		}
		
		private function loadSearch():void {
			if (navigator.numChildren <= MAX_CHILDREN) {
				var BBSearchMod:ModuleLoader;
				BBSearchMod = new ModuleLoader();
				var s:String = 'com/Billback/Search/BBSearch.swf';
				BBSearchMod.label = "Search";
				BBSearchMod.addEventListener(ModuleEvent.READY, searchModReady,false,0,true);
				//BBSearchMod.creationPolicy = "all";
				BBSearchMod.loadModule(s);
				tnavHome.addChildAt(BBSearchMod,0);
				tnavHome.selectedIndex = 0;
				//textField.text = "  Load - "+System.totalMemory.toString()+"\n"+textField.text;	
			}
		}
		
		public function loadBBUpload(e:BBMainEvent):void {
			if (navigator.numChildren <= MAX_CHILDREN) {
				this.bbUploadHeader = e.bbUploadHeader;
				
				var BBUploadMod:ModuleLoader;
				BBUploadMod = new ModuleLoader();
				var sId:String = 'v' + e.bbUploadHeader.bbHeaderID.toString() + e.bbUploadHeader.uploadID.toString();
				
				//if already loaded, select it
				if(dictUpload[sId]){
					BBUploadMod = dictUpload[sId];
					var ichild:IBBUpload = BBUploadMod.child as IBBUpload;
					/* Call setters in the module  */
					ichild.setSettings(this.pModel.oSettings);
					/*DONT RELOAD IN CASE USER MADE UPDATES */
					//ichild.setBB(e.bbUploadHeader);
				}
				else{ //else load it up
					var s:String = 'com/Billback/Upload/BBUpload.swf';
					BBUploadMod.label = 'ID: ' + e.bbUploadHeader.uploadID + ' / ' + e.bbUploadHeader.uploadType + ': ' + ' (' + e.bbUploadHeader.BBReference + ')';
					BBUploadMod.addEventListener(ModuleEvent.READY, uploadModReady,false,0,true);
					BBUploadMod.loadModule(s);
					BBUploadMod.id = sId;
					dictUpload[sId] = BBUploadMod;
					
					navigator.addChild(BBUploadMod);
					
				}
				navigator.selectedChild = BBUploadMod;
			}
			else{
				showAlert();
			}
		}
		
		public function loadRawEDIUpload(e:BBMainEvent):void {
			if (navigator.numChildren <= MAX_CHILDREN) {
				this.bbRawEDIHeader = e.bbRawEDIHeader;
				
				var BBRawEDIMod:ModuleLoader;
				BBRawEDIMod = new ModuleLoader();
				var sId:String = 'v' + e.bbRawEDIHeader.BBUploadIIIPHID.toString() + e.bbRawEDIHeader.UploadID.toString();
				
				//if already loaded, select it
				if(dictUpload[sId]){
					BBRawEDIMod = dictUpload[sId];
					var ichild:IBBRawEDI = BBRawEDIMod.child as IBBRawEDI;
					/* Call setters in the module  */
					ichild.setSettings(this.pModel.oSettings);
					/*DONT RELOAD IN CASE USER MADE UPDATES */
					ichild.setBBRawEDI(e.bbRawEDIHeader);
				}
				else{ //else load it up
					var s:String = 'com/Billback/Upload/BBRawEDI.swf';
					BBRawEDIMod.label = 'EDI Upload ID: ' + e.bbRawEDIHeader.UploadID + ' / '   + ' (' + e.bbRawEDIHeader.BBNumber + ')';
					BBRawEDIMod.addEventListener(ModuleEvent.READY, rawEDIModReady,false,0,true);
					BBRawEDIMod.loadModule(s);
					BBRawEDIMod.id = sId;
					dictUpload[sId] = BBRawEDIMod;
					navigator.addChild(BBRawEDIMod);
				}
				navigator.selectedChild = BBRawEDIMod;
			}
			else{
				showAlert();
			}
		}//close
			
		
		
