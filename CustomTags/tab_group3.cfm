<!---
	Description: 
		This parent tag surrounds the content generated by one of its child 
		tags with tables containing background images made to look like a 
		file folder. 
	Usage:
		<CF_TAB_GROUP Width="600">
			<CF_TAB_ITEM Title="Step 1 of 2" ToolTip="1) Don't eat yellow snow...">
				...don't eat yellow snow...
			</CF_TAB_ITEM>
			<CF_TAB_ITEM Title="Step 2 of 2" ToolTip="2) Don't eat green snow...">
				...don't eat green snow...
			</CF_TAB_ITEM>
		</CF_TAB_GROUP>
	--->

<!--- Protect against no sub-tags --->
<CFPARAM NAME="ThisTag.AssocAttribs" DEFAULT="#ArrayNew(1)#">

<!--- Added a default height to the control panel --->
<CFPARAM NAME="Attributes.Height" DEFAULT="300">


<CFSWITCH EXPRESSION="#ThisTag.ExecutionMode#">
	<CFCASE VALUE="start">
		<CFSET THISTAG.TABCOUNTER=1>
	</CFCASE>
	<CFCASE VALUE="end">
		<CFPARAM NAME="URL.Tab" DEFAULT="1">
		<CFSET Variables.COLSPAN="#Evaluate('IncrementValue(DecrementValue(ThisTag.TabCounter)*3)')#">
		<CFOUTPUT>
		
			<BR><BR>
			
			
			
			<CFPARAM NAME="Attributes.Width" DEFAULT="800">
			<!--- Tabs at the top --->
			<TABLE WIDTH="#Attributes.Width#" BORDER="0" CELLSPACING="0" CELLPADDING="0" ALIGN="center" STYLE="padding-bottom: 0px; margin-bottom: 0px;">
				<TR>
					<TD><IMG SRC="http://#CGI.HTTP_HOST#/images/tabs/tabs_01.gif" WIDTH=12 HEIGHT=26></TD>
					<!--- Loop over the attribute sets of all sub tags --->
					<CFLOOP INDEX="MyCounter" FROM="1" TO="#DecrementValue(ThisTag.TabCounter)#">
						<!--- Get the Attributes structure --->
						<CFIF MYCOUNTER GTE URL.TAB>
							<CFSET TAGAttributes="#ThisTag.AssocAttribs[IncrementValue(MyCounter)]#">
							<CFELSE>
							<CFSET TAGAttributes="#ThisTag.AssocAttribs[MyCounter]#">
						</CFIF>
						<CFPARAM NAME="TagAttributes.URLVariableName"	DEFAULT="ID">
						<CFPARAM NAME="TagAttributes.URLVariableValue"	DEFAULT="#RandRange(111111111, 999999999)#">
						<CFPARAM NAME="TagAttributes.Title"				DEFAULT="Tab #MyCounter#">
						<CFPARAM NAME="TagAttributes.ToolTip"			DEFAULT="Click here to see the contents of tab #MyCounter#">
						<CFPARAM NAME="TagAttributes.ContentAlign"		DEFAULT="left">
						<CFIF URL.TAB EQ MYCOUNTER>
							<TD><IMG BORDER="0" SRC="http://#CGI.HTTP_HOST#/images/tabs/tabs_03.gif"></TD>
							<TD 
								BACKGROUND="http://#CGI.HTTP_HOST#/images/tabs/tabs_04.gif" 
								NOWRAP 
								STYLE="font-weight: bold; color: red; font-size: 11pt;"
							>#TagAttributes.Title#</TD>
							<TD><IMG SRC="http://#CGI.HTTP_HOST#/images/tabs/tabs_05.gif"></TD>
						<CFELSE>
							<TD><IMG BORDER="0" SRC="http://#CGI.HTTP_HOST#/images/tabs/tabs_06.gif"></TD>
							<TD 
								BACKGROUND="http://#CGI.HTTP_HOST#/images/tabs/tabs_07.gif" 
								NOWRAP 
								STYLE="font-weight: bold;" 
								TITLE="#TagAttributes.ToolTip#"
							>
								<CFSET FormAction="http://#CGI.HTTP_HOST##CGI.SCRIPT_NAME#">
								<CFSET FormName="tab#MyCounter#Form">
								<FORM 
									ACTION="#FormAction#?Tab=#MyCounter#&#TagAttributes.URLVariableName#=#TagAttributes.URLVariableValue#" 
									METHOD="post" 
									NAME="#FormName#" 
									STYLE="margin-bottom: 0px; margin-top: 0px;"
								>
									<CFIF IsDefined('TagAttributes.AddParams')>
										<CFLOOP INDEX="i" LIST="#TagAttributes.AddParams#">
											<CFIF IsDefined('Caller.' & i)>
												<INPUT NAME="#i#" TYPE="Hidden" VALUE="#Evaluate('Caller.' & i)#">
											</CFIF>
										</CFLOOP>
									</CFIF>
									<A 
										HREF="javascript:this.document.forms['#FormName#'].submit()" 
										CLASS="nameLinkSmall" 
										ONMOUSEOUT="window.status=' ';return(true);" 
										ONMOUSEOVER="window.status='#FormAction#';return(true);"
									>#TagAttributes.Title#</A>
								</FORM>
							</TD>
							<TD><IMG SRC="http://#CGI.HTTP_HOST#/images/tabs/tabs_08.gif" WIDTH="17"></TD>
						</CFIF>
					</CFLOOP>
					<TD WIDTH="1" BACKGROUND="http://#CGI.HTTP_HOST#/images/tabs/tabs_02.gif"><IMG SRC="http://#CGI.HTTP_HOST#/images/tabs/tabs_02.gif" WIDTH="13" HEIGHT="26" BORDER="0" ALT=""></TD>
					<TD><IMG SRC="http://#CGI.HTTP_HOST#/images/tabs/tabs_09.gif"></TD>
				</TR>
				<!--- Middle rows with the colspan in it --->
				<TR>
					<TD><IMG SRC="http://#CGI.HTTP_HOST#/images/tabs/tabs_10.gif" WIDTH=12 HEIGHT=8></TD>
					<TD 
						COLSPAN="#Variables.ColSpan#" 
						WIDTH="100%"
					><IMG BORDER="0" HEIGHT="8" SRC="http://#CGI.HTTP_HOST#/images/tabs/fill.gif" WIDTH="100%"></TD>
					<TD><IMG SRC="http://#CGI.HTTP_HOST#/images/tabs/tabs_12.gif" WIDTH=12 HEIGHT=8></TD>
				</TR>
				<TR>
					<TD 
						HEIGHT="#Attributes.Height#" 
						BACKGROUND="http://#CGI.HTTP_HOST#/images/tabs/tabs_13.gif"
					><!--- <IMG SRC="http://#CGI.HTTP_HOST#/images/tabs/fill.gif" BORDER="0" HEIGHT="1" WIDTH="12"> ---></TD>
					<CFPARAM NAME="TagAttributes.ContentAlign" DEFAULT="left">
					<TD 
						HEIGHT="#Attributes.Height#" 
						COLSPAN="#Variables.ColSpan#" 
						ALIGN="#TagAttributes.ContentAlign#"
						BGCOLOR="WHITE"
					>#ThisTag.GeneratedContent#</TD>
					<TD 
						HEIGHT="#Attributes.Height#" 
						BACKGROUND="http://#CGI.HTTP_HOST#/images/tabs/tabs_15.gif" 
						HEIGHT="108" 
						WIDTH="12"
					></TD>
				</TR>
			
				<!--- Bottom row to close the card --->
				<TR>
					<TD><IMG
						HEIGHT="12"
						SRC="http://#CGI.HTTP_HOST#/images/tabs/tabs_16.gif"
						WIDTH="12"
					></TD>
					<TD
						BACKGROUND="http://#CGI.HTTP_HOST#/images/tabs/tabs_17.gif"
						COLSPAN="#Variables.ColSpan#"
					></TD>
					<TD><IMG
						HEIGHT="12"
						SRC="http://#CGI.HTTP_HOST#/images/tabs/tabs_18.gif"
						WIDTH="12"
					></TD>
				</TR>
			</TABLE>
		</CFOUTPUT>
		<CFSET THISTAG.GENERATEDCONTENT="">
	</CFCASE>
</CFSWITCH>




