<!---
    Custom Tag Name: CF_SafeLightWhite
    Description    : Removes excess white space from CFML templates
    Author         : Peter B. Harrison
    Date           : 8 Oct 1999
    Usage          : <cf_safeLightWhite>
                         CFML and HTML code in here
                     </cf_safeLightWhite>
    Notes          : <pre></pre> and <script></script> <cfmail></cfmail> tags are not reformatted
--->
<cfif thisTag.ExecutionMode is "end"><cfif findnocase("<pre>", thisTag.GeneratedContent) is 0 and findnocase("<script>", thisTag.GeneratedContent) is 0 and findnocase("</pre>", thisTag.GeneratedContent) is 0 and findnocase("</script>", thisTag.GeneratedContent) is 0 and findnocase("<cfmail>", thisTag.GeneratedContent) is 0 and findnocase("</cfmail>", thisTag.GeneratedContent) is 0><!--- quick method ---><cfset thisTag.GeneratedContent = replace(replace(replace(thisTag.GeneratedContent, chr(13), " ", "all"), chr(10), " ", "all"), chr(9), " ", "all")><cfloop condition="find('  ', thisTag.GeneratedContent) is not 0"><cfset thisTag.GeneratedContent = replace(thisTag.GeneratedContent, "  ", " ", "all")></cfloop><cfelse><!--- long method for safely doing pre and script tags ---><cfset newContent = ""><cfset tmpContent = replace(replace(replace(replace(replace(replace(thisTag.GeneratedContent, "<pre>", "<safeLightWhite><pre>", "all"), "<script", "<safeLightWhite><script", "all"), "</script>", "</script></safeLightWhite>", "all"), "</pre>", "</pre></safeLightWhite>", "all"), "<cfmail>", "<cfmail><safeLightWhite>", "all"), "</cfmail>", "</cfmail></safeLightWhite>", "all")><cfloop condition="len(tmpContent) is not 0"><cfset startTag = findnocase("<safeLightWhite>", tmpContent)><cfset endTag = findnocase("</safeLightWhite>", tmpContent)><cfif endTag is not 0><cfset endTag = endTag + 16></cfif><cfif endTag is 0 and startTag gt 0><cfset endTag = len(tmpContent)></cfif><cfif startTag is 0><cfset startTag = 1></cfif><cfif endTag is 0><cfset endTag = 1></cfif><cfif startTag is 1 and endTag is 1><cfset newContent = newContent & tmpContent><cfset tmpContent = ""><cfelse><cfif startTag gt 1><!--- clean up ---><cfset addThis = replace(replace(replace(left(tmpContent, startTag - 1), chr(13), " ", "all"), chr(10), " ", "all"), chr(9), " ", "all")><cfloop condition="find('  ', addThis) is not 0"><cfset addThis = replace(addThis, "  ", " ", "all")></cfloop><cfset newContent = newContent & addThis></cfif><!--- ignore text region ---><cfset newContent = newContent & mid(tmpContent, startTag, endTag - startTag + 1)><cfif endTag is len(tmpContent)><cfset tmpContent = ""><cfelse><cfset tmpContent = mid(tmpContent, endTag + 1, len(tmpContent) - endTag)></cfif></cfif></cfloop><cfset thisTag.GeneratedContent = replace(replace(newContent, "<safeLightWhite>", "", "all"), "</safeLightWhite>", "", "all")></cfif></cfif>