			,<cfqueryparam cfsqltype="cf_sql_bit" value="#Form.Manual_Selection_Of_Approvers#"> <!---  D47065 : Change Order - Program Approvals --->
			,<cfqueryparam cfsqltype="cf_sql_bit" value="#Form.Manual_Committed_Equal_Actual#"> <!--- D50326 :: Tru-up to Actuals Button in Program --->
