			,<cfqueryparam cfsqltype="cf_sql_bit" value="#Form.Billback_Sales_Tax#">
			,<cfqueryparam cfsqltype="cf_sql_bit" value="#Form.Document_Attachment_Required#"><!--- D42591 --->
