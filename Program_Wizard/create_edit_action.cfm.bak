						,Maximum_Dollar_Amount_Checked = <cfqueryparam cfsqltype="cf_sql_bit" value="#Form.Maximum_Dollar_Amount_Checked#">
						,Maximum_Dollar_Amount =<cfif len(trim(Form.Maximum_Dollar_Amount)) eq 0> NULL <cfelse> #Form.Maximum_Dollar_Amount#</cfif>
						,Billback_Status_For_Max_Dollar_Amt =<cfqueryparam cfsqltype="cf_sql_int" value="#Form.Billback_Status_For_Max_Dollar_Amt#" />
						,Auto_Deviation_Inc_Manual_BB = <cfqueryparam cfsqltype="cf_sql_bit" value="#Form.Auto_Deviation_Inc_Manual_BB#">
						,Currency_Conversion_Factor = <cfqueryparam cfsqltype="cf_sql_bit" value="#Form.Currency_Conversion_Factor#">
						<!--- ,growth_auto_pay = 		<cfqueryparam cfsqltype="cf_sql_bit" value="#Form.growth_auto_pay#">		D35731 - Growth Auto Pay --->
						,Default_rate_equal_to_zero = <cfqueryparam cfsqltype="cf_sql_bit" value="#Form.Default_rate_equal_to_zero#">	<!---	36607--->
						,Alternate_Payment_Recipient = <cfqueryparam cfsqltype="cf_sql_bit" value="#Form.Alternate_Payment_Recipient#">	<!---	D37492 --->
						<!---,Custom_Fixed_Price_Options = <cfqueryparam cfsqltype="cf_sql_bit" value="#Form.Custom_Fixed_Price_Options#">--->
						,Claim_Rates_ConFig_Id = <cfqueryparam cfsqltype="cf_sql_int" value="#Form.Claim_Rates_ConFig_Id#">
						,ItemMarked_Lost_Program_Volume_Automation = <cfqueryparam cfsqltype="cf_sql_bit" value="#Form.ItemMarked_Lost_Program_Volume_Automation#">
						,ItemMarked_Lost_Budget_Committed_Dollars = <cfqueryparam cfsqltype="cf_sql_bit" value="#Form.ItemMarked_Lost_Budget_Committed_Dollars#">
						,Payment_Notification = <cfqueryparam cfsqltype="cf_sql_bit" value="#Form.Payment_Notification#">
						,Payment_Notification_Span = <cfif len(trim(form.Payment_Notification_Span)) eq 0>NULL<cfelse>'#form.Payment_Notification_Span#'</cfif>
						,Billback_Sales_Tax = <cfqueryparam cfsqltype="cf_sql_bit" value="#Form.Billback_Sales_Tax#">
						,Document_Attachment_Required = <cfqueryparam cfsqltype="cf_sql_bit" value="#Form.Document_Attachment_Required#"><!--- D42591:: Template setting - document attachment required --->
						,Most_Favored_Nation =  <cfqueryparam cfsqltype="cf_sql_bit" value="#Form.Most_Favored_Nation#">
						,Approval_Considerations_ID = <cfqueryparam cfsqltype="cf_sql_int" value="#Form.Approval_Considerations_ID#"> <!--- D43651 --->
						,Price_List_Download = <cfqueryparam cfsqltype="cf_sql_bit" value="#Form.Price_List_Download#"><!---  D47306 : Price List Download --->
						,Manual_Selection_Of_Approvers = <cfqueryparam cfsqltype="cf_sql_bit" value="#Form.Manual_Selection_Of_Approvers#"> <!---  D47065 : Change Order - Program Approvals --->
						,BB_Dont_Count_Volume_Select = <cfqueryparam cfsqltype="cf_sql_bit" value="#Form.BB_Dont_Count_Volume_Select#">  <!--- D48049: Count / Dont Count Volume based on Program Component --->
						,Include_In_Sales_Tracker_Dashboard = <cfqueryparam cfsqltype="cf_sql_bit" value="#Form.Include_In_Sales_Tracker_Dashboard#">
						,Manual_Committed_Equal_Actual = <cfqueryparam cfsqltype="cf_sql_bit" value="#Form.Manual_Committed_Equal_Actual#"> <!--- D50326 :: Tru-up to Actuals Button in Program --->
						,Hide_On_Create_Program = <cfqueryparam cfsqltype="cf_sql_bit" value="#Form.Hide_On_Create_Program#">
						,Percentage_Of_List_Price = <cfqueryparam cfsqltype="cf_sql_bit" value="#Form.Percentage_Of_List_Price#">
						,Price_List_ID = <cfqueryparam cfsqltype="cf_sql_varchar" value="#Form.Price_List_ID#">
						,Set_Billbacks_To_Paid_No_Interface = <cfqueryparam cfsqltype="cf_sql_bit" value="#Form.Set_Billbacks_To_Paid_No_Interface#"> <!--- 55348 --->
						,Retail_Planner = <cfqueryparam cfsqltype="cf_sql_bit" value="#Form.Retail_Planner#"> <!--- 57305 --->
						,Optional_Dates_Program = <cfqueryparam cfsqltype="cf_sql_bit" value="#Form.Optional_Dates_Program#"> <!--- 60410 --->
						,Show_Contract_Dates = <cfqueryparam cfsqltype="cf_sql_bit" value="#Form.Show_Contract_Dates#"> <!--- 64090 --->
						,allow_Best_Plan_Programs = <cfqueryparam cfsqltype="cf_sql_bit" value="#Form.allowBestPlanPrograms#"><!---60308 --->
						,Pullback_Operator_Fixed_Price_Only = <cfqueryparam cfsqltype="cf_sql_bit" value="#Form.Pullback_Operator_Fixed_Price_Only#">
						,isBrokerage = <cfqueryparam cfsqltype="cf_sql_bit" value="#Form.isBrokerage#"><!---74641--->
						,Template_In_Program_LH_Recapture_Link = <cfqueryparam cfsqltype="cf_sql_bit" value="#Form.Template_In_Program_LH_Recapture_Link#">
						,Template_In_Program_LH_Recapture_Link_Default = <cfqueryparam cfsqltype="cf_sql_bit" value="#Form.Template_In_Program_LH_Recapture_Link_Default#">
						,allow_Reference_2 = <cfqueryparam cfsqltype="cf_sql_bit" value="#Form.allowReference2#"><!---77539--->
						,Allow_Vendor_Only = <cfqueryparam cfsqltype="cf_sql_bit" value="#Form.Allow_Vendor_Only#">
						,Ignore_Rebate_Volume = <cfqueryparam cfsqltype="cf_sql_bit" value="#Form.Ignore_Rebate_Volume#"><!--- 79614 --->
						,Display_Blanket_Bid = <cfqueryparam cfsqltype="cf_sql_bit" value="#Form.Display_Blanket_Bid#">
				WHERE 	ProgramControl_Panel_Options_ID = #ID#
		</cfquery>

		<!---30418 update Billback_Closing_Methods_Template :: start--->
	<cfif Action neq "Copy">
		<CFQUERY NAME="qDeleteClosingMethod" DATASOURCE="#Application.Datasource#">
			delete from Billback_Closing_Methods_Template
			where  	First_Parent_ID = '#getFisrParentID.First_Parent_ID#'
		</CFQUERY>
		<cfset FirstParentID = getFisrParentID.First_Parent_ID>
	<cfelseif Action eq "Copy">
		<cfset FirstParentID = ID>
	</cfif>


		<cfif len(trim(Form.Billback_Closing_Method_ID_List)) GT 0 AND Form.BB_D_Template_Overrides_Deviation_Tolerances eq 1>
			<cfloop list="#form.Billback_Closing_Method_ID_List#" index="indxList">
				<cfparam name="form.#indxList#_Auto_Dev_BB_Status_Below" default="0">
				<cfparam name="form.#indxList#_Auto_Dev_BB_Status_Exceed" default="0">
				<CFQUERY NAME="qUpdateClosingMethod" DATASOURCE="#Application.Datasource#">
					INSERT INTO Billback_Closing_Methods_Template (First_Parent_ID,iBillback_Closing_Method_ID,Auto_Dev_BB_Status_Below,Auto_Dev_BB_Status_Exceed)
					VALUES(#FirstParentID#,#indxList#,#evaluate("form.#indxList#_Auto_Dev_BB_Status_Below")#,#evaluate("form.#indxList#_Auto_Dev_BB_Status_Exceed")#)
				</CFQUERY>
			</cfloop>
		</cfif>

		<!---update Template Business Segment if it's enabled--->
		<!---init BusinessSegmentManager to check if it's enabled--->
		<cfset variables.businessSegmentManager = CreateObject("component", "components.programs.business_segment.BusinessSegmentManager") />
		<cfif variables.businessSegmentManager.isEnabled() and appSettings.getFilterBusinessSegments()>
			<cfset variables.businessSegmentManager.updateBusinessSegmentTemplateSettings(ID, form.Template_Business_Segment_ID) />
		</cfif>

		<!---30418 update Billback_Closing_Methods_Template :: end--->
<!--- 		<cfif form.EZButton_on EQ 1>
	<!------ Insert a dummy program ----->
			<cfinclude template="/common_files/contracts/contract_number_generator.cfm">
			<cfquery name="CreateEZButtonProgram" datasource="#application.datasource#">
				SET NOCOUNT ON
				INSERT INTO Contract_Main
							(   Contract_Number,
								ProgramType,
								ProgramType_ID,
								contract_EZButton_On	)
				values ('TMP_#generator_contract_number#','#form.Created_Type#',#ID#,1)

			update Program_Control_Panel_Options
			set EZ_Contract_Id = (SELECT MAX(Contract_Main_ID) AS Contract_Main_ID FROM Contract_Main)
			where ProgramControl_Panel_Options_ID = #ID#
			SET NOCOUNT OFF
			</cfquery>
		</cfif> --->

		<!------ *********************** Auto_Committed_Equal_Actualactiveley update old versions of the template *********************** ----->
		<!------
		Date: 03/22/2005 by Deepa Kunnath
		Here is the logic to retroactively make the changes to all versions of this template.
		Right now we are only adding few fields from the main table to this list, may be in future we need more....
		If the fields you need to add are in the main table (Program_Control_Panel_Options), just add it to the array and will be taken care of
		But if you need to do the same of a mapping table, you need to write the code for it,
			anyway please try to code in a common way so that it can be reused if we want to add more items into that list,
			but if it gets too complicated it can be done custom.
		 ----->
		<cfif Active IS 1><!------ Only if the template is active it will have multiple versions ----->

			<!------ **** Update Master Table **** ----->
			<cfscript>
				MainTableFieldsToUpdate = arrayNew(2);

				aTmp = ["Allow_Retro_Create", "#Allow_Retro_Create#"];           			                   arrayAppend(MainTableFieldsToUpdate, aTmp);
				aTmp = ["Allow_Retro_Create_Max", "#Allow_Retro_Create_Max#"]; 				                   arrayAppend(MainTableFieldsToUpdate, aTmp);
				aTmp = ["Allow_Retro_Revision", "#Allow_Retro_Revision#"];     				                   arrayAppend(MainTableFieldsToUpdate, aTmp);
				aTmp = ["Allow_Retro_Revision_Span", "#Allow_Retro_Revision_Span#"];		                 arrayAppend(MainTableFieldsToUpdate, aTmp);
				aTmp = ["Include_Template_In_Deals_IF", "#Include_Template_In_Deals_IF#"];		           arrayAppend(MainTableFieldsToUpdate, aTmp);
				aTmp = ["Include_Treatment_Basis_Code", "#Include_Treatment_Basis_Code#"];		           arrayAppend(MainTableFieldsToUpdate, aTmp);
					aTmp = ["Exclude_Same_Spending_Cat_From_TPA", "#Exclude_Same_Spending_Cat_From_TPA#"];   arrayAppend(MainTableFieldsToUpdate, aTmp);
				aTmp = ["Include_In_Catalog", "#Include_In_Catalog#"]; 				                           arrayAppend(MainTableFieldsToUpdate, aTmp);
				aTmp = ["Catalog_Type", "#Catalog_Type#"];				                                       arrayAppend(MainTableFieldsToUpdate, aTmp);
				aTmp = ["Restrict_Product_Group_Level", "#Restrict_Product_Group_Level#"];		           arrayAppend(MainTableFieldsToUpdate, aTmp);
				aTmp = ["Allow_Lower_Pricing_Level", "#Allow_Lower_Pricing_Level#"];				             arrayAppend(MainTableFieldsToUpdate, aTmp);
				aTmp = ["Restrict_On_Approval_Group", "#Restrict_On_Approval_Group#"];				           arrayAppend(MainTableFieldsToUpdate, aTmp);
				aTmp = ["Use_Fixed_Price_As_Base_Sales", "#Use_Fixed_Price_As_Base_Sales#"];	           arrayAppend(MainTableFieldsToUpdate, aTmp);
				aTmp = ["Template_UPC_Display", "#Template_UPC_Display#"];				                       arrayAppend(MainTableFieldsToUpdate, aTmp);
				aTmp = ["BB_D_Template_Overrides_Deviation_Tolerances",								"#BB_D_Template_Overrides_Deviation_Tolerances#"];	                             arrayAppend(MainTableFieldsToUpdate, aTmp);
				aTmp = ["BB_D_Purchase_Period_OverRide", "#BB_D_Purchase_Period_OverRide#"];	           arrayAppend(MainTableFieldsToUpdate, aTmp);
				aTmp = ["BB_D_Purchase_Period_OverRide_Rate", "#BB_D_Purchase_Period_OverRide_Rate#"];	 arrayAppend(MainTableFieldsToUpdate, aTmp);
				aTmp = ["BB_D_Aggregation_Period_OverRide", "#BB_D_Aggregation_Period_OverRide#"];			 arrayAppend(MainTableFieldsToUpdate, aTmp);
				aTmp = ["Freight_accrual_considers_cash_discount",
								"#Freight_accrual_considers_cash_discount#"];	                                   arrayAppend(MainTableFieldsToUpdate, aTmp);
				if ( trim(Margin_Price_List_Header_ID) NEQ "0" ) {
					aTmp = ["Margin_Price_List_Header_ID", "#Margin_Price_List_Header_ID#"];		           arrayAppend(MainTableFieldsToUpdate, aTmp);
				}
				aTmp = ["Item_Fixed_Rebate_Paid_To_Dup_Message",
								"#Item_Fixed_Rebate_Paid_To_Dup_Message#"];                                      arrayAppend(MainTableFieldsToUpdate, aTmp);
				aTmp = ["Currency_Conversion_Factor", "#Currency_Conversion_Factor#"];				           arrayAppend(MainTableFieldsToUpdate, aTmp);
				aTmp = ["Claim_Rates_ConFig_Id", "#Claim_Rates_ConFig_Id#"];				                     arrayAppend(MainTableFieldsToUpdate, aTmp);   // 38460
				//D38942 :: Program Blackout Period on Frontend
				if (Form.blackout_periods EQ 1) {
				aTmp = ["Start_zero", "#Start_zero#"];			   arrayAppend(MainTableFieldsToUpdate, aTmp);
				aTmp = ["Future_Zero", "#Future_Zero#"];			   arrayAppend(MainTableFieldsToUpdate, aTmp);
				}
				aTmp = ["blackout_periods", "#blackout_periods#"];	   arrayAppend(MainTableFieldsToUpdate, aTmp);
				aTmp = ["Auto_Volume", "#Auto_Volume#"];		   arrayAppend(MainTableFieldsToUpdate, aTmp);
				aTmp = ["Auto_Actual", "#Auto_Actual#"];			   arrayAppend(MainTableFieldsToUpdate, aTmp);
				aTmp = ["Auto_Future", "#Auto_Future#"];			   arrayAppend(MainTableFieldsToUpdate, aTmp);
				aTmp = ["Auto_Committed_Equal_Actual", "#Auto_Committed_Equal_Actual#"];			   arrayAppend(MainTableFieldsToUpdate, aTmp);
				aTmp = ["Auto_Committed_Equal_Actual_ON", "#Auto_Committed_Equal_Actual_ON#"];			   arrayAppend(MainTableFieldsToUpdate, aTmp);
				aTmp = ["Auto_Volume_Program_Equal_Actual_Weeks", "#Auto_Volume_Program_Equal_Actual_Weeks#"];			   arrayAppend(MainTableFieldsToUpdate, aTmp);
				//D38942 :: Program Blackout Period on Frontend

				aTmp = ["Billback_Sales_Tax", "#Billback_Sales_Tax#"];			   arrayAppend(MainTableFieldsToUpdate, aTmp);
				// D42591: Template setting - document attachment required
				aTmp = ["Document_Attachment_Required", "#Document_Attachment_Required#"];			   arrayAppend(MainTableFieldsToUpdate, aTmp);
				aTmp = ["Sequential_Net_Sales_Operating_Margin", "#Sequential_Net_Sales_Operating_Margin#"];			   arrayAppend(MainTableFieldsToUpdate, aTmp);

				aTmp = ["Approval_Considerations_ID", "#Approval_Considerations_ID#"];			   arrayAppend(MainTableFieldsToUpdate, aTmp);
				aTmp = ["Manual_Committed_Equal_Actual", "#Manual_Committed_Equal_Actual#"];			   arrayAppend(MainTableFieldsToUpdate, aTmp);//D50236
				if (Form.BB_D_Template_Overrides_Deviation_Tolerances EQ 1) {
						aTmp = ["Maximum_Dollar_Amount_Checked", "#Maximum_Dollar_Amount_Checked#"];			   arrayAppend(MainTableFieldsToUpdate, aTmp);
						aTmp = ["Auto_Deviation_Inc_Manual_BB", "#Auto_Deviation_Inc_Manual_BB#"];				   arrayAppend(MainTableFieldsToUpdate, aTmp);
						if (len(trim(BB_Tolerance_DVT)) GT 0) { aTmp = ["BB_Tolerance_DVT", "#BB_Tolerance_DVT#"];	              arrayAppend(MainTableFieldsToUpdate, aTmp); }
						if (len(trim(BB_Tolerance_ERT)) GT 0) {	aTmp = ["BB_Tolerance_ERT", "#BB_Tolerance_ERT#"];	              arrayAppend(MainTableFieldsToUpdate, aTmp); }
						if (len(trim(Cannot_Exceed_Percent)) GT 0) { aTmp = ["Cannot_Exceed_Percent", "#Cannot_Exceed_Percent#"];	arrayAppend(MainTableFieldsToUpdate, aTmp); }
						if (len(trim(Cannot_Exceed_Dollar)) GT 0)  { aTmp = ["Cannot_Exceed_Dollar", "#Cannot_Exceed_Dollar#"];		arrayAppend(MainTableFieldsToUpdate, aTmp); }
						if (len(trim(Maximum_Dollar_Amount)) GT 0) { aTmp = ["Maximum_Dollar_Amount", "#Maximum_Dollar_Amount#"];	arrayAppend(MainTableFieldsToUpdate, aTmp); }
				} // end of "if (Form.BB_D_Template_Overrides_Deviation_Tolerances EQ 1)"
				aTmp = ["Percentage_Of_List_Price", "#Percentage_Of_List_Price#"];	arrayAppend(MainTableFieldsToUpdate, aTmp);
				aTmp = ["Price_List_ID", "#Price_List_ID#"];						arrayAppend(MainTableFieldsToUpdate, aTmp);
				aTmp = ["Show_Contract_Dates", "#Show_Contract_Dates#"];			arrayAppend(MainTableFieldsToUpdate, aTmp);
				aTmp = ["Pullback_Operator_Fixed_Price_Only", "#Pullback_Operator_Fixed_Price_Only#"];			arrayAppend(MainTableFieldsToUpdate, aTmp);
				aTmp = ["Template_In_Program_LH_Recapture_Link", "#Template_In_Program_LH_Recapture_Link#"];			arrayAppend(MainTableFieldsToUpdate, aTmp);
				aTmp = ["Template_In_Program_LH_Recapture_Link_Default", "#Template_In_Program_LH_Recapture_Link_Default#"];			arrayAppend(MainTableFieldsToUpdate, aTmp);
			</cfscript>

			<cfinclude template ="rectroactive_update.cfm">
			<!------ **** Update Master Table **** ----->
		</cfif>
		<!------ *********************** retroactiveley update old versions of the template *********************** ----->

<cfelse>

	<cfif appSettings.getMarginDisplaydefault() EQ 1>
		<cfset default_margin_uom  = 1>
	<cfelse>
		<cfset default_margin_uom  = 2>
	</cfif>

	<cfquery name="CreateNewTemplate" datasource="#application.datasource#">
		SET NOCOUNT ON
		INSERT INTO Program_Control_Panel_Options
		(
			Company_Main_ID,
			Generic_Type,
			Created_Type,
			Program_Description,
			<cfif FORM.Use_Discount_ID IS 1 and len(trim(Form.Discount_Identifier_ID)) GT 0>
