			,<cfqueryparam cfsqltype="cf_sql_bit" value="#Form.Display_Blanket_Bid#">
		)
		SELECT ProgramControl_Panel_Options_ID = @@IDENTITY
		SET NOCOUNT OFF
	</cfquery>

	<cfset ID = CreateNewTemplate.ProgramControl_Panel_Options_ID>
		<!---30418 update Billback_Closing_Methods_Template :: start--->
		<cfif len(trim(Form.Billback_Closing_Method_ID_List)) GT 0>
			<cfloop list="#form.Billback_Closing_Method_ID_List#" index="indxList">
				<cfparam name="form.#indxList#_Auto_Dev_BB_Status_Below" default="0">
				<cfparam name="form.#indxList#_Auto_Dev_BB_Status_Exceed" default="0">
				<CFQUERY NAME="qUpdateClosingMethod" DATASOURCE="#Application.Datasource#">
					INSERT INTO Billback_Closing_Methods_Template (First_Parent_ID,iBillback_Closing_Method_ID,Auto_Dev_BB_Status_Below,Auto_Dev_BB_Status_Exceed)
					VALUES(#ID#,#indxList#,#evaluate("form.#indxList#_Auto_Dev_BB_Status_Below")#,#evaluate("form.#indxList#_Auto_Dev_BB_Status_Exceed")#)
				</CFQUERY>
			</cfloop>
		</cfif>
		<!---30418 update Billback_Closing_Methods_Template :: end--->

	<!--- Create new currency mapping to default to USD for new templates only --->
	<cfquery name="InsertPaymentRecord" datasource="#application.datasource#">
		INSERT INTO Currency_Mapping
		(
			Template_ID,
			Currency_ID
		)
		VALUES
		(
			<cfqueryparam value="#ID#" cfsqltype="cf_sql_integer">,
			<cfqueryparam value="#FORM.CurrencyDefaultOption#" cfsqltype="cf_sql_integer">
		)
	</cfquery>

<!---
<cfif form.EZButton_on EQ 1>
		<!------ Insert a dummy program ----->
			<cfinclude template="/common_files/contracts/contract_number_generator.cfm">
			<cfquery name="CreateEZButtonProgram" datasource="#application.datasource#">
				SET NOCOUNT ON
				INSERT INTO Contract_Main
							(   Contract_Number,
								ProgramType,
								ProgramType_ID,
								<!--- Dev Note: Drachala; D27580 : EZ button programs with null start/end dates START--->
								Contract_Start_Date,
								Contract_End_Date,
								<!--- Dev Note: Drachala; D27580 : EZ button programs with null start/end dates END--->
								contract_EZButton_On,
								deleted	)
				values (<cfqueryparam value="TMP_#generator_contract_number#" cfsqltype="cf_sql_varchar">,
						<cfqueryparam value="#form.Created_Type#" cfsqltype="cf_sql_varchar">,
						<cfqueryparam value="#ID#" cfsqltype="cf_sql_integer">,
						<!--- Dev Note: Drachala; D27580 : EZ button programs with null start/end dates START--->
						CAST(CONVERT(CHAR(10), GETDATE(), 101) as datetime),
						CAST(CONVERT(CHAR(10), GETDATE(), 101) as datetime),
						<!--- Dev Note: Drachala; D27580 : EZ button programs with null start/end dates END--->
						1,1)

			update Program_Control_Panel_Options
			set EZ_Contract_Id = (SELECT MAX(Contract_Main_ID) AS Contract_Main_ID FROM Contract_Main)
			where ProgramControl_Panel_Options_ID = <cfqueryparam value="#ID#" cfsqltype="cf_sql_integer">
			SET NOCOUNT OFF
			</cfquery>
	</cfif>
	--->

	<!------ Update First_Parent_ID ----->
	<cfquery name="qUpdateFirstParentID" datasource="#application.datasource#">
		UPDATE	Program_Control_Panel_Options
		SET		First_Parent_ID = <cfqueryparam value="#ID#" cfsqltype="CF_SQL_INTEGER">
		WHERE	ProgramControl_Panel_Options_ID = <cfqueryparam value="#ID#" cfsqltype="CF_SQL_INTEGER">
	</cfquery>

	<!------ Populate all the components as selected ----->
	<cfif bTemplateLevelComponentFilter>
		<cfset templateManager.addAllTemplateDiscountComponents(ID) />
	</cfif>

	<!---  Dev Note: KAL - D7952 : Lock/Unlock Template --->
	<cfset temp = templateManager.LockTemplate(ID,request.AccessStructure.User_ID)>
	<!---  Dev Note: KAL - D7952 : Lock/Unlock Template --->

	<!---- save the default duplicate definition setting if allow_dup_programs is checked --->
	<cfinclude template="importDupDefinition.cfm">
<!---What action is/is not--->

	<!--- 27341 - ChrisN 6/9/2011 --->
	<!---Save Template Business Segment if it's enabled--->
	<!---init BusinessSegmentManager to check if it's enabled--->
	<cfset variables.businessSegmentManager = CreateObject("component", "components.programs.business_segment.BusinessSegmentManager")/>
	<cfif variables.businessSegmentManager.isEnabled() and appSettings.getFilterBusinessSegments()>
		<cfset variables.businessSegmentManager.addBusinessSegmentTemplateSettings(0, ID, form.Template_Business_Segment_ID)/>
	</cfif>

</cfif>


<!---60410 : Fiscal Year Selection and Auto Renew START--->

	<cfquery name="getFisrParentID" datasource="#application.datasource#">
		SELECT	First_Parent_ID, Auto_Renew_Option
		FROM	Program_Control_Panel_Options
		WHERE ProgramControl_Panel_Options_ID = <cfqueryparam value="#ID#" cfsqltype="CF_SQL_INTEGER">
	</cfquery>
<cfif getFisrParentID.Auto_Renew_Option>
	<cfquery name="getCurrentSelection" datasource="#application.datasource#">
		SELECT	Auto_Renew_Option_ID
		FROM	Template_Auto_Renew_Options
		WHERE Template_First_Parent_ID = #getFisrParentID.First_Parent_ID#
		AND Deleted = 0
	</cfquery>
	<cfset currentSelection = valuelist(getCurrentSelection.Auto_Renew_Option_ID)>
	<cfloop from="1" to="4" index="Options">
		<cfif listfind(currentSelection, Options) EQ 0>
			<cfquery name="InsertNewSelection" datasource="#application.datasource#">
				INSERT INTO Template_Auto_Renew_Options(Template_First_Parent_ID, Auto_Renew_Option_ID)
				VALUES (#getFisrParentID.First_Parent_ID#, #Options#)
			</cfquery>
		</cfif>
		<cfif listfind(form.Auto_Renew_Selected_Options, Options) EQ 0>
			<cfquery name="UpdateSelection" datasource="#application.datasource#">
				UPDATE Template_Auto_Renew_Options
				SET Deleted = 1, Updated_date = getdate()
				WHERE Template_First_Parent_ID = #getFisrParentID.First_Parent_ID#
				AND Auto_Renew_Option_ID = #Options#
				AND Deleted = 0
			</cfquery>
		</cfif>
	</cfloop>
<cfelse>
	<cfquery name="updateTemplateAutoRenewOptions" datasource="#application.datasource#">
		UPDATE Template_Auto_Renew_Options
		SET Deleted = 1, Updated_date = getdate()
		WHERE Template_First_Parent_ID = #getFisrParentID.First_Parent_ID#
		AND Deleted = 0
	</cfquery>
</cfif>
<!--- NEW --->
<!--- Checks if template setting "Optional Dates for Program"  is ON we excute below code --->
<cfif form.Optional_Dates_Program>
	<!--- CHECK if this template has any optional date --->
	<cfquery name="currentOptinalDate" datasource="#application.datasource#">
		SELECT CONVERT(VARCHAR(24), start_date,101) AS Start_Date, CONVERT(VARCHAR(24), end_date,101) AS End_date
		FROM Template_Optional_dates
		WHERE first_parent_id = #getFisrParentID.First_Parent_ID#
		AND Deleted = 0
	</cfquery>

	<!--- Make a comma delimited list (start and end date as one value) of existing records in the db --->
	<cfset listExistingOptionalDates = "">
	<cfloop query="currentOptinalDate">
		<cfset listExistingOptionalDates = ListAppend(listExistingOptionalDates,Start_Date & "-" & End_Date)>
	</cfloop>

	<cfset listNewOptionalDates = "">
	<cfset indexCounter = 0>
	<cfset listNewOptionalDatesAndDescription = "">
	<cfloop list="#form.OptionalStartDate#" index="i">
	<cfset indexCounter = indexCounter + 1>
		<!--- Make a comma delimited list (start and end date as one value) of records passed in the form --->
		<cfset listNewOptionalDates = ListAppend(listNewOptionalDates, ListGetAt(form.OptionalStartDate,indexCounter) & "-" & ListGetAt(form.OptionalEndDate,indexCounter)) >
		<!--- Make a comma delimited list (start and end date and description as one value) of records passed in the form --->
		<cfset listNewOptionalDatesAndDescription = ListAppend(listNewOptionalDatesAndDescription, ListGetAt(form.OptionalStartDate,indexCounter) & "-" & ListGetAt(form.OptionalEndDate,indexCounter) & "-" & ListGetAt(form.OptionalDescription,indexCounter)) >
	</cfloop>

	<!--- Get a list of records which was in the db, but now has been deleted --->
	<cfset DatesNotIN= baseSettings.listCompare(listExistingOptionalDates,listNewOptionalDates)>

		<cfset currentStartDate = valuelist(currentOptinalDate.Start_Date)>
		<cfset currentEndDate = valuelist(currentOptinalDate.End_Date)>
		<!--- Check if form dates are in database if not we flag them deleted --->
		<cfloop list="#DatesNotIN#" index="i">
			<cfquery name="DeleteRecords" datasource="#application.datasource#">
				UPDATE Template_Optional_dates
				SET Deleted = 1, Updated_Date = getdate()
				WHERE Start_Date = (<cfqueryparam value="#ListFirst(i,'-')#" cfsqltype="CF_SQL_DATE" />)
				AND End_Date = (<cfqueryparam value="#ListLast(i,'-')#" cfsqltype="CF_SQL_DATE" />)
				AND first_Parent_id = #getFisrParentID.First_Parent_ID#
			</cfquery>
		</cfloop>

		<!--- Loop through the values passed in the form.
		Note: On "create_edit.cfm", there is JS logic to make sure that "start" and 'end" date combination is always unique.
		JS code will not allow duplicate "start" and 'end" date combinations.
		--->
		<cfloop list="#listNewOptionalDatesAndDescription#" index="i">
			<cfquery name="checkRecord" datasource="#application.datasource#">
				SELECT 1
				FROM Template_Optional_dates
				WHERE Start_Date = (<cfqueryparam value="#listgetat(i,1,'-')#" cfsqltype="CF_SQL_DATE" />)
				AND End_Date = (<cfqueryparam value="#listgetat(i,2,'-')#" cfsqltype="CF_SQL_DATE" />)
				AND first_Parent_id = #getFisrParentID.First_Parent_ID#
				AND Deleted = 0
			</cfquery>

			<cfif checkRecord.recordCount eq 0>
				<cfquery name="InsertOptionalDate" datasource="#application.datasource#">
					INSERT INTO Template_Optional_dates(first_parent_id, Start_Date, End_Date, Description)
					Values
					(
					#getFisrParentID.First_Parent_ID#, <cfqueryparam value="#listgetat(i,1,'-')#" cfsqltype="CF_SQL_DATE" />,
					<cfqueryparam value="#listgetat(i,2,'-')#" cfsqltype="CF_SQL_DATE" />,
					<!--- 3 pipes should be converted back to comma. On "create_edit.cfm", commas were converted into 3 pipes as
					commas were causing an issue with the comma-delimited list.
					--->
					<cfqueryparam value="#Replace(listgetat(i,3,'-'),'|||',',','All')#" cfsqltype="CF_SQL_VARCHAR" />
					)
				</cfquery>
			<cfelse>
				<cfquery name="UpdateOptionalDate" datasource="#application.datasource#">
					UPDATE Template_Optional_dates
					<!--- 3 pipes should be converted back to comma. On "create_edit.cfm", commas were converted into 3 pipes as
					commas were causing an issue with the comma-delimited list.
					--->
					SET Description = <cfqueryparam value="#Replace(listgetat(i,3,'-'),'|||',',','All')#" cfsqltype="CF_SQL_VARCHAR" />
					WHERE Start_Date = <cfqueryparam value="#listgetat(i,1,'-')#" cfsqltype="CF_SQL_DATE" />
					AND End_Date = <cfqueryparam value="#listgetat(i,2,'-')#" cfsqltype="CF_SQL_DATE" />
					AND first_Parent_id = #getFisrParentID.First_Parent_ID#
					AND Deleted = 0
				</cfquery>
			</cfif>
		</cfloop>
<!--- if template setting "Optional Dates for Program"  is OFF we excute below code --->
<cfelse>
	<cfquery name="updateOptinalDate" datasource="#application.datasource#">
		UPDATE Template_Optional_dates
		SET Deleted = 1, updated_date = getdate()
		WHERE First_Parent_ID = #getFisrParentID.First_Parent_ID#
		AND Deleted = 0
	</cfquery>
</cfif>
<!---60410 : Fiscal Year Selection and Auto Renew END--->

<!--- Label 36588: Auto Renew Schedule - If Apply_Lead_Time_To_All equals 1 then run script to apply the auto renew lead time to all programs --->
<cfif form.Apply_Lead_Time_To_All eq 1>
	<CFQUERY NAME="qApplyLeadTimeToAll" DATASOURCE="#Application.Datasource#">
		UPDATE	A
		SET		Renewal_Lead_Time = t.Days_Before_Auto_Renew,
				AR_Notification_Date = DateAdd(d, -1 * t.Days_Before_Auto_Renew, A.AR_Start_Date)
		FROM	Program_Control_Panel_Options t -- find all template versions
				INNER JOIN Program_Control_Panel_Options tversions on tversions.First_Parent_ID = t.First_Parent_ID
				INNER JOIN Contract_Main CM ON CM.ProgramType_ID = tversions.ProgramControl_Panel_Options_ID AND CM.Deleted = 0
				INNER JOIN Program_Auto_Renew A ON A.Program_ID = CM.Contract_Main_ID AND A.Deleted = 0
				AND A.Renewed = 0 -- Do not update if program already auto renewed
		WHERE	t.IsDominant = 1
		AND     t.Auto_Renew_Option = 1
		AND     t.ProgramControl_Panel_Options_ID = <cfqueryparam value="#ID#" cfsqltype="cf_sql_integer">
		AND     t.Days_Before_Auto_Renew != A.Renewal_Lead_Time
	</CFQUERY>
</cfif>

		<!--- vvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvv --->
		<!--- AR Insert --->
		<!--- vvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvv --->
		<CFIF application.returned_customer_setting.Show_Fund_Settings EQ 1 AND application.returned_customer_setting.Upload_GL_Code EQ 1>
			<CFQUERY NAME="DeletePreviousInsert" DATASOURCE="#Application.Datasource#">
				DELETE FROM GL_Code_AR_For_ProgTemp WHERE Template_ID = <cfqueryparam value="#ID#" cfsqltype="cf_sql_integer">
			</CFQUERY>
			<CFQUERY NAME="ActiveFiscalYear" DATASOURCE="#Application.Datasource#">
				SELECT * FROM GL_Code_Fund_Setting WHERE AR_Status = 1 AND Deleted = 0 ORDER BY CAST(AR_From_Fiscal_Year AS numeric)
			</CFQUERY>
			<CFLOOP QUERY="ActiveFiscalYear">
				<CFIF IsDefined("FORM.SelectedAR_#AR_From_Fiscal_Year#")>
					<CFSET AROfThisFiscalYear = "">
					<!--- <CFSET DeletedAR = ""> --->
					<CFSET AROfThisFiscalYear = EVALUATE("FORM.SelectedAR_#AR_From_Fiscal_Year#")>
					<!--- <CFSET DeletedAR = EVALUATE("FORM.DeletedAR_#AR_From_Fiscal_Year#")> --->
					<CFIF AROfThisFiscalYear NEQ "">
						<CFLOOP LIST="#AROfThisFiscalYear#" INDEX="ThisAR">
							<CFSET AllocationForThisAR = EVALUATE("FORM.Allocation_Method_#AR_From_Fiscal_Year#_#ThisAR#")>
							<CFQUERY NAME="InsData" DATASOURCE="#Application.Datasource#">
								INSERT INTO
								GL_Code_AR_For_ProgTemp (	Template_ID,
															Fiscal_Year,
															A_R,
															Allocation_Method			)

								VALUES					(	<cfqueryparam value="#ID#" cfsqltype="cf_sql_integer">,
															<cfqueryparam value="#AR_From_Fiscal_Year#" cfsqltype="cf_sql_varchar">,
															<cfqueryparam value="#ThisAR#" cfsqltype="cf_sql_varchar">,
															<cfqueryparam value="#AllocationForThisAR#" cfsqltype="cf_sql_integer">
														)
							</CFQUERY>
							<!--- </CFIF> --->
						</CFLOOP>
					</CFIF>
				</CFIF>
			</CFLOOP>
		</CFIF>

		<!---- approval groups allowed in this template --->
		<cfquery name="DeleteAnyPriorApprovalGroupRecords" datasource="#application.datasource#">
			DELETE FROM Template_Allow_Approval_Group WHERE Program_Type_ID = <cfqueryparam value="#ID#" cfsqltype="cf_sql_integer">
		</cfquery>
		<cfloop list="#Form.Allow_Approval_group#" index="thisApprovalGroup">
			<cfquery name="qInsertApprovalGroup" datasource="#application.datasource#">
				INSERT INTO Template_Allow_Approval_Group
				(
					Group_ID,
					Program_Type_ID
				)
				VALUES
				(
					<cfqueryparam value="#thisApprovalGroup#" cfsqltype="cf_sql_idstamp">,
					<cfqueryparam value="#ID#" cfsqltype="cf_sql_integer">
				)
			</cfquery>
		</cfloop>

		<!------ Save group levels allowed in this template Allow_Product_Group_Level  ----->
		<cfset templateManager.saveTemplateAllowProductGroupLevelFromList(templateId = ID, groupLevelList = Form.Allow_Product_Group_Level) />


		<!---- post-approval status included in this template --->
		<cfif appSettings.getPgmPostApprovalStatus() EQ 1>
		<cfset searchInputToken = "TemplateProgramPostApprovalStatus_">
		<cfset LenInputToken = len(searchInputToken)>
		<!------ Delete first ----->
		<cfquery name="ForbiddenList" datasource="#application.datasource#">
			UPDATE	Template_Post_Approval_Status
			SET		Deleted = 1
			WHERE	Deleted = 0
			AND		Template_ID = <cfqueryparam value="#ID#" cfsqltype="cf_sql_integer">
		</cfquery>
		<cfloop collection = #Form# item = "FieldNames">
			<cfset FieldName = FieldNames>
			<cfif left(FieldName, LenInputToken) IS searchInputToken>
				<cfset LenFieldName = len(FieldName)>
				<cfset FieldValue = ListLast(FieldName, "_")>
				<!------ Insert in loop ----->
				<cfquery name="qInsertTemplatePostApprovalStatus" datasource="#application.datasource#">
					INSERT INTO Template_Post_Approval_Status
					(
						Program_Post_Approval_Status_ID,
						Template_ID
					)
					VALUES
					(
						<cfqueryparam cfsqltype="CF_SQL_INTEGER" value="#FieldValue#" />,
						<cfqueryparam cfsqltype="CF_SQL_INTEGER" value="#ID#" />
					)
				</cfquery>
			</cfif>
		</cfloop>
		</cfif>

		<!---Accounting Program Types--->
		<cfif appSettings.getUse_Accounting_Program_Type() EQ 1>
		<cfquery name="AccountingProgramType" datasource="#application.datasource#">
			DELETE FROM APT_Template_Mapping
			WHERE	Template_ID = <cfqueryparam value="#ID#" cfsqltype="cf_sql_integer">
		</cfquery>

		<cfset searchInputToken = "Accounting_Program_Type_">
		<cfset LenInputToken = len(searchInputToken)>
		<cfloop collection = #Form# item = "FieldNames">
			<cfset FieldName = FieldNames>
			<cfif left(FieldName, LenInputToken) IS searchInputToken>
				<cfset LenFieldName = len(FieldName)>
				<cfset FieldValue = ListLast(FieldName, "_")>
				<cfquery name="AccountingProgramType" datasource="#application.datasource#">
					INSERT INTO APT_Template_Mapping
					(
						Accounting_Program_Type_ID,
						Template_ID,
						Created_By
					)
					VALUES
					(
						<cfqueryparam value="#FieldValue#" cfsqltype="cf_sql_integer">,
						<cfqueryparam value="#ID#" cfsqltype="cf_sql_integer">,
						<cfqueryparam value="#request.AccessStructure.User_ID#" cfsqltype="cf_sql_varchar">
					)
				</cfquery>
			</cfif>
		</cfloop>
		</cfif>

	<!--- Dev Note: Milan 6321 --->
		<!--- Program Categories--->
		<cfif appSettings.getProgramCategory() EQ 1>
			<cfquery name="ProgramCategory" datasource="#application.datasource#">
					UPDATE Category_Template_Mapping
					SET Deleted = 1
					WHERE Template_ID = <cfqueryparam value="#ID#" cfsqltype="cf_sql_integer">
				</cfquery>

		<cfset searchInputToken = "Program_Category_">
		<cfset LenInputToken = len(searchInputToken)>
		<cfloop collection = #Form# item = "FieldNames">
			<cfset FieldName = FieldNames>
			<cfif left(FieldName, LenInputToken) IS searchInputToken>
				<cfset LenFieldName = len(FieldName)>
				<cfset FieldValue = ListLast(FieldName, "_")>
				<cfquery name="ProgramCategory" datasource="#application.datasource#">
					INSERT INTO Category_Template_Mapping
					(
						Program_Category_ID,
						Template_ID,
						Created_By
					)
					VALUES
					(
						<cfqueryparam value="#FieldValue#" cfsqltype="cf_sql_integer">,
						<cfqueryparam value="#ID#" cfsqltype="cf_sql_integer">,
						<cfqueryparam value="#request.AccessStructure.User_ID#" cfsqltype="cf_sql_varchar">
					)
				</cfquery>
			</cfif>
		</cfloop>
		</cfif>
		<!--- End Note: Milan 6321 --->

		<!------ Operating Group ----->
		<cfif appSettings.getOperatingGroupOn() EQ 1>
			<cfset operatingGroupManager 			= CreateObject("component", "components.Operating_Group.OperatingGroupManager").init() />
			<cfset templateMapLevel 				= operatingGroupManager.getTemplateMapLevel() />

			<cfset operatingGroupManager.deleteOperatingGroupTemplateSettings(ID) />

			<cfset qOperatingGroupTemplateSettings = operatingGroupManager.getOperatingGroupTemplateSettings(templateMapLevel, ID) />

			<cfloop query="qOperatingGroupTemplateSettings">
				<cfset thisFieldName = "Operating_Group_#Operating_Group_ID#" />
				<cfparam name="Form.#thisFieldName#" 	default="0">
				<cfif Evaluate("form.#thisFieldName#") EQ 1>
					<cfset operatingGroupManager.addOperatingGroupTemplateSettings(Operating_Group_ID, ID) />
				</cfif>
			</cfloop>
		</cfif>

		<!--- 	stored procedure to change old template settings to new template settings for profiles approve and agree --->

		<cfstoredproc procedure="SP_ADJUST_PROGRAM_TEMPLATE_PROFILE_SETTINGS" datasource="#application.datasource#">
			<cfprocparam type = "In" CFSQLType ="CF_SQL_INTEGER" dbVarName = "@@CONTROL_PANEL_OPTIONS_ID" value="#ID#" null="no">
		</cfstoredproc>



		<!------ Search Sequence ----->
		<cfif appSettings.getSearchSequenceOn() EQ 1>
			<cfset SearchSequenceManager 			= CreateObject("component", "components.Search_Sequence.SearchSequenceManager").init() />

			<cfset SearchSequenceManager.deleteSearchSequenceTemplateSettings(ID) />

			<cfset qSearchSequenceTemplateSettings = SearchSequenceManager.getSearchSequenceTemplateSettings(ID) />

			<cfloop query="qSearchSequenceTemplateSettings">
				<cfset thisFieldName = "Search_Sequence_#Search_Sequence_ID#" />
				<cfparam name="Form.#thisFieldName#" 	default="0">
				<cfif Evaluate("form.#thisFieldName#") EQ 1>
					<cfset SearchSequenceManager.addSearchSequenceTemplateSettings(Search_Sequence_ID, ID) />
				</cfif>
			</cfloop>
		</cfif>

<!---29808 Enable rebate on EZButton template--->
<cfif form.EZButton_on eq 1>
	<cfif not isDefined("tmp_oldInfo.EZButton_On") <!---new template--->
				or tmp_oldInfo.EZButton_On eq 0>         <!---existing template that was NOT defined as EZ button before--->
		<cfquery name="tmp.updateDefaults" datasource="#application.datasource#">
			UPDATE Program_Control_Panel_Options
				 SET Discount_Rebates = 1
			WHERE ProgramControl_Panel_Options_ID = <cfqueryparam value="#ID#" cfsqltype="cf_sql_integer">
		</cfquery>
	</cfif>
</cfif>

<cfif Form.Action IS "Edit" OR Form.Action IS "Copy">
<!---
		<cfquery name="checkifEZButton_On" datasource="#application.datasource#">
			select EZButton_On,created_type,EZ_Contract_Id
			 from Program_Control_Panel_Options
			WHERE 	ProgramControl_Panel_Options_ID = <cfqueryparam value="#ID#" cfsqltype="cf_sql_integer">
			</cfquery>

	<cfif checkifEZButton_On.EZButton_on EQ 1>

		<cfif checkifEZButton_On.EZ_Contract_Id NEQ "" and checkifEZButton_On.EZ_Contract_Id NEQ 0>
			<!------ Copy program if ez program exists ----->
			<CFSET Program_ID_To_Replicate = checkifEZButton_On.EZ_Contract_Id>
			<!---D45270 : Template Wait Time for Updates -> don't copy because Group capture is too heavy.
							Same EZ rates are valid across all version of a template
							Renewed_Program_ID = Program_ID_To_Replicate		--->
			<CFSET Renewed_Program_ID = checkifEZButton_On.EZ_Contract_Id>
			<cfset IsRevisionOfExistingContract =  1>

				<!--- Dev Note: Milan (24239). When copying the template, set "IsRevisionOfExistingContract" to 0 --->
				<cfif Form.Action eq "Copy">
						<cfset IsRevisionOfExistingContract =  0>
				</cfif>

			<!---
			D22578: CAG - mass copy a program
			We will be using the new routine USP_Copy_Program to copy program
			instead of replicate_program.cfm
			--->
			<!---	D45270 : Template Wait Time for Updates -> don't copy because Group capture is too heavy.
							Same EZ rates are valid across all version of a template

				<CFSTOREDPROC PROCEDURE="USP_Copy_Program" datasource="#application.datasource#">
				<CFPROCPARAM TYPE="In" 	CFSQLTYPE="CF_SQL_INTEGER"	DBVARNAME="@Program_ID_To_Replicate"		VALUE="#Program_ID_To_Replicate#">
				<CFPROCPARAM TYPE="In" 	CFSQLTYPE="CF_SQL_VARCHAR"	DBVARNAME="@New_Contract_Number"			VALUE="">
				<CFPROCPARAM TYPE="In" 	CFSQLTYPE="CF_SQL_BIT"		DBVARNAME="@IsRevisionOfExistingContract"	VALUE="#IsRevisionOfExistingContract#">
				<CFPROCPARAM TYPE="In" 	CFSQLTYPE="CF_SQL_BIT"		DBVARNAME="@ISROLLOVER"						VALUE="0">
				<CFPROCPARAM TYPE="In" 	CFSQLTYPE="CF_SQL_BIT"		DBVARNAME="@ForceFreightOnAutoCopy"			VALUE="0">
				<CFPROCPARAM TYPE="In" 	CFSQLTYPE="CF_SQL_INTEGER"	DBVARNAME="@User_Position_ID"				VALUE="0" 	null="true">
				<CFPROCPARAM TYPE="In" 	CFSQLTYPE="CF_SQL_VARCHAR"	DBVARNAME="@Responsible_User_ID"			VALUE=""	null="true">
				<CFPROCPARAM TYPE="In" 	CFSQLTYPE="CF_SQL_VARCHAR"	DBVARNAME="@Current_User_ID"				VALUE="#request.AccessStructure.User_ID#">
				<CFPROCPARAM TYPE="Out"	CFSQLTYPE="CF_SQL_INTEGER"	DBVARNAME="@Contract_Main_ID"				VARIABLE="Renewed_Program_ID">
				<CFPROCPARAM TYPE="In" 	CFSQLTYPE="CF_SQL_BIT"		DBVARNAME="@Is_Mass_Copy"					VALUE="0">
				<CFPROCPARAM TYPE="Out"	CFSQLTYPE="CF_SQL_INTEGER"	DBVARNAME="@Is_Group_Deal"					VARIABLE="Is_Group_Deal">
				<CFPROCPARAM TYPE="In" 	CFSQLTYPE="CF_SQL_BIT"		DBVARNAME="@From_EZ_Template"				VALUE="1">
			</CFSTOREDPROC>--->

			<cfquery name="qUpdateEZProgram" datasource="#application.datasource#">
				update 	Contract_Main
				set 	contract_EZButton_On = 1,
							programtype_id = #ID#,     <!---27333--->
						deleted = 1
				where 	Contract_Main_ID = <cfqueryparam value="#Renewed_Program_ID#" cfsqltype="cf_sql_integer">
			</cfquery>

			<cfquery name="qUpdateTemplateEZProgramID" datasource="#application.datasource#">
				update 	Program_Control_Panel_Options
				set 	EZ_Contract_Id = <cfqueryparam value="#Renewed_Program_ID#" cfsqltype="cf_sql_integer">
				where 	ProgramControl_Panel_Options_ID = <cfqueryparam value="#ID#" cfsqltype="cf_sql_integer">
			</cfquery>
		<cfelse>
			<!------ Insert a new dummy program ----->
			<cfinclude template="/common_files/contracts/contract_number_generator.cfm">

			<cfquery name="CreateEZButtonProgram" datasource="#application.datasource#">
				SET NOCOUNT ON
				INSERT INTO Contract_Main
							(   Contract_Number,
								ProgramType,
								ProgramType_ID,
								contract_EZButton_On,
								deleted	)
					values (<cfqueryparam value="TMP_#generator_contract_number#" cfsqltype="cf_sql_varchar">,
							<cfqueryparam value="#checkifEZButton_On.Created_Type#" cfsqltype="cf_sql_varchar">,
							<cfqueryparam value="#ID#" cfsqltype="cf_sql_integer">,
							1,
							1
						)

				update Program_Control_Panel_Options
				set EZ_Contract_Id = (SELECT MAX(Contract_Main_ID) AS Contract_Main_ID FROM Contract_Main)
				where ProgramControl_Panel_Options_ID = <cfqueryparam value="#ID#" cfsqltype="cf_sql_integer">
				SET NOCOUNT OFF
			</cfquery>
		</cfif>


	<cfelse>

		<cfquery name="updateEZContractId" datasource="#application.datasource#">
			update Program_Control_Panel_Options
			set EZ_Contract_Id = ''
			where ProgramControl_Panel_Options_ID = <cfqueryparam value="#ID#" cfsqltype="cf_sql_integer">
		</cfquery>
	</cfif>
	--->
<!--- ||||||||||||||| CREATE XML LOG OF CHANGES ||||||||||||||| --->
<cfset NewId = Id>
<cfif appSettings.getAuditTrailStorage() NEQ 0>
	<cfset createLog.createXMLlog("Program_Control_Panel_Options",3,NewID)>
</cfif>
<!--- ||||||||||||||| CREATE XML LOG OF CHANGES ||||||||||||||| --->
</cfif>

<cfif Action eq "Copy">

	<cfset templateManager.ReleaseLocks(request.AccessStructure.User_ID)>
	<cfset templateManager.LockTemplate(ID,request.AccessStructure.User_ID)>
	<cfset LockedBy_Current_User = 1 />
	<cfset Lock_img = "Edit">
	<cfset Action = "Edit" />
	<!--- <cflocation url="index.cfm" /> --->

</cfif>

<!---Add default planner settings if planner was selected and an entry does not already exists --->
<cfif form.Retail_Planner neq 0>

	<cfset templateProgramPlanner = templateManager.getTemplateProgramPlanner(ID) />

	<cfif ((NOT isDefined("templateProgramPlanner")) OR templateProgramPlanner.RecordCount EQ 0)>
		<cfquery name="qSaveTemplateProgramPlanner" DATASOURCE="#application.datasource#">
					INSERT INTO Template_Planner_Settings
					(
							First_Parent_ID,
							Created_Date,
							Created_By,
							Budget,
							Marketing_Event,
							NUC_Target,
							Retailer_Unit_Cost,
							Merch_Unit_Price,
							Retailer_Margin
						)
					VALUES
					(
						'#FirstParentID#',
						GetDate(),
						'#request.AccessStructure.user_id#',
						<cfqueryparam value="0" cfsqltype="cf_sql_bit">,
						<cfqueryparam value="0" cfsqltype="cf_sql_bit">,
						<cfqueryparam value="0" cfsqltype="cf_sql_bit">,
						<cfqueryparam value="0" cfsqltype="cf_sql_bit">,
						<cfqueryparam value="0" cfsqltype="cf_sql_bit">,
						<cfqueryparam value="0" cfsqltype="cf_sql_bit">
					)
			</cfquery>
	</cfif>

</cfif>

<cfoutput>
<form action="secondpage.cfm" method="post" name="NextPage">
	<input type="hidden" name="Action" value="#Action#">
	<input type="hidden" name="Generic_type" value="#Generic_type#">
	<input type="hidden" name="Created_Type" value="#Created_Type#">
	<input type="hidden" name="Group_Deal" value="#form.Group_Deal#">
	<input type="hidden" name="ID" value="#ID#">
	<input type="hidden" name="Active" value="#Active#">
</form>
</cfoutput>

<script>
	document.NextPage.submit();
</script>

<!---Action is defined--->
</cfif>
