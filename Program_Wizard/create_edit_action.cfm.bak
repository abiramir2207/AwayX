<cfparam name="Form.Template_In_Program_LH_Recapture_Link_Default" default="0" />
<cfparam name="Form.allowReference2" default="0" />
<cfparam name="Form.Allow_Vendor_Only" default="0">
		<!--- If Include Competitive Data Tracking is not checked then set it's relative form variables to 0 --->
<cfif form.Include_Competitive_Data_Tracking eq 0>
	<cfset FORM.Won_By = 0 />
	<cfset FORM.Won_Rate = 0 />
	<cfset FORM.Won_UOM = 0 />
	<cfset FORM.Won_By_Required = 0 />
	<cfset FORM.Won_Rate_Required = 0 />
	<cfset FORM.Won_UOM_Required = 0 />
	<cfset FORM.Delivery_Type = 0 />
	<cfset FORM.Category = 0 />
	<cfset FORM.Package = 0 />
	<cfset FORM.Shared = 0 />
	<cfset FORM.Incremental = 0 />
	<cfset FORM.Source = 0 />
	<cfset FORM.Source_Type = 0 />
	<cfset FORM.Date_Source_Received = 0 />
	<cfset FORM.Source_Required = 0 />
	<cfset FORM.Source_Type_Required = 0 />
	<cfset FORM.Date_Source_Received_Required = 0 />
	<cfset FORM.Download_Comp_Data_History = 0 />
	<cfset FORM.Specd = 0 />
	<cfset Form.Display_Reminder_Comp_Data_Page = 0/>
	<cfset FORM.Opportunity_Volume = 0 />
</cfif>

<!--- Dev Note: WR 78635 - Check to see if it is a template which pays to "vendor only" --->
<cfif appSettings.get_Setting('Lump_Sums_Programs_Paid_To_Vendor') eq '1'>
	<cfif form.Allow_Vendor_Only eq 1>
		<cfset Form.Specify_Distributors = 0>
		<cfset Form.Specify_Operators = 0>
		<cfset Form.Specify_Brokers = 0>
	</cfif>
</cfif>

<!--- If Include Open Date is not checked then set Include Time of Open Date to 0 --->
<cfif form.Include_Open_Date eq 0>
	<cfset form.Include_Time_Of_Open_Date = 0 />
</cfif>
<!---************** END New Settings for Bid Programs Competitive Data ******************** --->

<cfif Generic_Type IS NOT "Brokerage">
	<cfparam name="Form.ByPass_Margin_Evaluation" 			default="0">
<cfelse>
	<cfparam name="Form.ByPass_Margin_Evaluation" 			default="1">
</cfif>
	<cfparam name="ByPass_Margin_Evaluation_Options" default="1">

<cfif Len(Form.Allow_Product_Group_Level) EQ 0>
	<cfset Form.Restrict_Product_Group_Level = 0>
	<cfset Form.Allow_Lower_Pricing_Level = 1>
</cfif>
<cfif Form.Restrict_Product_Group_Level EQ 0>
	<cfset Form.Allow_Product_Group_Level = "">
	<cfset Form.Allow_Lower_Pricing_Level = 1>
</cfif>

<cfif form.is_pullback_corporate_deal EQ 1>
<cfset form.pullback_from_corporate = 0>
</cfif>

<cfif form.Pullbacks_On EQ 0>
<cfset form.Pullback_Include_RediVolume = 0>
<cfset form.is_pullback_corporate_deal = 1>
<cfset form.pullback_from_corporate = 0>
<cfset form.default_pullback_rate = 0>
<cfset form.Pullback_redi_volume_percent = 0>
</cfif>

<cfparam name="Form.Allow_Approval_group" 			default="">
<cfif Len(Form.Allow_Approval_group) EQ 0>
	<cfset Form.Restrict_On_Approval_Group = 0>
</cfif>
<cfif Form.Restrict_On_Approval_Group EQ 0>
	<cfset Form.Allow_Approval_group = "">
</cfif>
<cfparam name="form.Include_Program" 				default="0">

<cfparam name="form.perfIndMinClaims" 				default="0">
<cfparam name="form.perfIndMinDays"					default="0">
<CFPARAM NAME="FORM.GroupLevelBB" 					DEFAULT="0">

<cfif Len(trim(form.Allow_Retro_Revision_Span)) eq 0>
	<cfset FORM.Allow_Retro_Revision_Span = 0>
</cfif>
<cfparam name="form.Expiring_Notification_Span"		default="0">
<cfparam name="form.Days_For_Reminder"				default="0">
<cfparam name="form.Days_Before_Auto_Renew"			default="0">
<cfparam name="form.Apply_Lead_Time_To_All"			default="0">
<cfparam name="form.Billback_Closing_Method_ID_List"	default="">
<cfparam name="form.BB_Dont_Count_Volume_Select"	default="0">
<cfparam name="form.Include_In_Sales_Tracker_Dashboard"	default="0">
<cfparam name="Form.Manual_Committed_Equal_Actual" default="0" /><!---D50326 --->
<cfparam name="Form.Hide_On_Create_Program" default="0"/>
<cfparam name="form.Percentage_Of_List_Price" 		default="0"><!--- D48146 --->
<cfparam name="form.Price_List_ID" 		default=""><!--- D48146 --->
<cfparam name="form.Set_Billbacks_To_Paid_No_Interface" default="0"/><!--- 55348 --->
<cfparam name="form.Retail_Planner" default="0"/><!--- 55348 --->
<cfparam name="form.Optional_Dates_Program" default="0"/><!--- 60410 --->
<cfparam name="form.Show_Contract_Dates" default="0" /><!--- 64090 --->
<cfparam name="Form.Ignore_Rebate_Volume" default="0" /><!--- 79614 --->

<cfif len(trim(form.Expiring_Notification_Span)) IS 0>
	<cfset form.Expiring_Notification_Span = 0>
</cfif>
<cfif len(trim(form.Days_For_Reminder)) IS 0>
	<cfset form.Days_For_Reminder = 0>
</cfif>
<cfif len(trim(form.Days_Before_Auto_Renew)) IS 0>
	<cfset form.Days_Before_Auto_Renew = 0>
	<cfset form.Apply_Lead_Time_To_All = 0 />
</cfif>

<cfif Form.BB_D_Template_Overrides_Deviation_Tolerances eq 0>
	<cfset Form.Maximum_Dollar_Amount_Checked = 0 />
	<cfset Form.Auto_Deviation_Inc_Manual_BB = 0 />
</cfif>
<cfif Form.Maximum_Dollar_Amount_Checked eq 0>
	<cfset Form.Maximum_Dollar_Amount = "" />
	<cfset Form.Billback_Status_For_Max_Dollar_Amt = 0 />
</cfif>

<!--- Replace any comma with a space for the template name --->
<cfset Form.Created_Type = Replace(Form.Created_Type,chr(44)," ","ALL")>

<!---D38942 :: Program Blackout Period on Frontend --->
<cfquery name="getFisrParentID" datasource="#application.datasource#">
	SELECT	First_Parent_ID, Created_Type
	FROM	Program_Control_Panel_Options
	WHERE ProgramControl_Panel_Options_ID = <cfqueryparam value="#ID#" cfsqltype="CF_SQL_INTEGER">
</cfquery>
<!---D38942 :: Program Blackout Period on Frontend --->

<!---Action is defined--->
<cfif isDefined("form.Action")>

	<cfset Action = form.Action>

	<!---Action is edit or copy--->
	<cfif ListFindNoCase("Edit,Copy",Form.Action)>

		<!---29808 Chris get old settings before changes are made--->
		<cfquery name="tmp_oldInfo" datasource="#application.datasource#">
			SELECT EZButton_On
				FROM Program_Control_Panel_Options
			 WHERE ProgramControl_Panel_Options_ID = <cfqueryparam value="#ID#" cfsqltype="cf_sql_integer">
		</cfquery>

	<!---Only does the copy crap if the program is active--->
	<cfif Active IS 1>

