<cfif isDefined("Max_Global_Volume_Size_CS")>
	<cfif len(trim(Form.Max_Global_Volume_Size_CS)) IS 0>
		<cfset Form.Max_Global_Volume_Size_CS = 0>
	</cfif>
</cfif>
<cfparam name="Form.Max_Global_Volume_Size_LBS" 	default="0">
<cfif isDefined("Max_Global_Volume_Size_LBS")>
	<cfif len(trim(Form.Max_Global_Volume_Size_LBS)) IS 0>
