<cfset genSettingsManager = CreateObject("component", "components.settings.ApplicationSettingsManager").init() />
<cfset appSettings = genSettingsManager.get()>
<cfset templateManager = CreateObject("component","components.programs.template.TemplateManager").init() />
<cfset createLog = createObject("component", "components.settings.AuditTrail.AuditTrail").init()>
<cfset baseSettings = CreateObject("component","components.Base") />

<cfset bTemplateLevelComponentFilter = 1 />
<cfif appSettings.getOperatingGroupOn()>
	<cfset bTemplateLevelComponentFilter = 0 />
</cfif>

<!---Default parameters--->
<cfparam name="Form.Max_Duration" 					default="0">
<cfparam name="Form.Max_Duration_Length" 			default="0">
<cfif len(trim(Form.Max_Duration_Length)) IS 0>
	<cfset Form.Max_Duration_Length = 0>
</cfif>
<cfparam name="Form.Min_Duration" 					default="0">
<cfparam name="Form.Min_Duration_Length" 			default="0">
