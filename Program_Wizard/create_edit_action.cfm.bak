			,<cfqueryparam cfsqltype="cf_sql_bit" value="#Form.Alternate_Payment_Recipient#"><!--- D37492  --->
			,<cfqueryparam cfsqltype="cf_sql_int" value="#Form.Claim_Rates_ConFig_Id#">
