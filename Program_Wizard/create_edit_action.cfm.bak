					Performace_Min_Days			= 	<cfif isDefined("Form.perfIndMinDays") and Form.perfIndMinDays NEQ "">#Form.perfIndMinDays#<cfelse>0</cfif>,
					Max_Duration				=	#Form.Max_Duration#,
					Max_Duration_Length			= 	#Form.Max_Duration_Length#,
					Min_Duration				= 	#Form.Min_Duration#,
