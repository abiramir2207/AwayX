<!---D43539 :: Qualification settings on template become unchecked START--->
	<cfquery name="updateAllPrograms" datasource="#application.datasource#">
		INSERT INTO Qualification_Template_Mapping
				(
					 Template_ID
					,Program_Qualification_Id
					,Answer_Required
					,Display_Sequence
					,is_Included
				)
	SELECT #NewID#
				,Program_Qualification_Id
				,Answer_Required
				,Display_Sequence
				,is_Included
	FROM Qualification_Template_Mapping
	WHERE Template_ID = <cfqueryparam value="#ID#" cfsqltype="cf_sql_integer">
	</cfquery>
<!---D43539 :: Qualification settings on template become unchecked END--->

<!---D38942 :: Program Blackout Period on Frontend --->
<cfif FORM.Blackout_Periods EQ 1>
	<cfquery name="updateAllPrograms" datasource="#application.datasource#">
		UPDATE Contract_Main_Aux_Data
		SET 	Program_Start_Zero = #FORM.Start_Zero#,
			Program_future_zero = #FORM.Future_Zero#
		FROM	Program_Control_Panel_Options PCPO
		INNER JOIN Contract_Main CM
		ON CM.ProgramType_ID = PCPO.ProgramControl_Panel_Options_ID
		INNER JOIN Contract_Main_Aux_Data CMAD
		ON CMAD.Contract_Main_ID = CM.Contract_Main_ID
		WHERE PCPO.First_Parent_ID = '#getFisrParentID.First_Parent_ID#'
	</cfquery>
</cfif>
<!---D38942 :: Program Blackout Period on Frontend --->

		<!--- If the action is copy them we have to handle for budgets and update the First_Parent_ID to the New Id and the Copied_From_Template_ID--->
	<cfif Action eq "Copy">

		<cfset NewName = getFisrParentID.Created_Type />
		<!--- Dev Note: Drachala; D27338 : JS error - syntax error when creating program START --->
			<cfquery name="insert_template_filter" datasource="#application.datasource#">
				SET NOCOUNT ON
					INSERT INTO Template_Filters
					(
					template_id,
					parent_template_id,
					name,
					description,
					status,
					created_user_id
					)
					SELECT
					#NewID#,
					#NewID#,
					'#NewName#',
					description,
					status,
					created_user_id
					FROM Template_Filters
					WHERE parent_template_id =  #getFisrParentID.First_Parent_ID#
					AND deleted = 0
				SELECT Template_Filters_Id = @@IDENTITY
				SET NOCOUNT OFF
			</cfquery>

	<!--- Dev Note: drachala; D28180: Copying a template with PG filters has issues  START
	What I did: creating new variable Template_Filters_Id with value on new Template_Filters_Id--->
		<cfset Template_Filters_Id = insert_template_filter.Template_Filters_Id>

			<cfquery name="insert_group_template" datasource="#application.datasource#">
			INSERT INTO Group_Template
			(
			Template_ID,
			Group_Level_ID,
			PG_Group_Type,
			Allow_in_search,
			Allow_In_Group_Search,
			Active,
			Created_By,
			PG_Flag,
			Updated_From,
			Allow_Filter
			)
			SELECT
			#NewID#,
			Group_Level_ID,
			PG_Group_Type,
			Allow_in_search,
			Allow_In_Group_Search,
			Active,
			Created_By,
			PG_Flag,
			Updated_From,
			Allow_Filter
			FROM Group_Template
			WHERE Template_ID = #getFisrParentID.First_Parent_ID#
									AND Deleted = 0
			</cfquery>
			<cfquery name="insert_customer_group_template" datasource="#application.datasource#">
			INSERT INTO Customer_Group_Template_Selection
			(
			Template_ID,
			Distributor_Group_Level_ID,
			Distributor_Group_ID,
			Active,
			Created_By,
			PG_Flag,
			Updated_From,
			Template_Filters_Id
			)
			SELECT
			#NewID#,
			Distributor_Group_Level_ID,
			Distributor_Group_ID,
			Active,
			Created_By,
			PG_Flag,
			Updated_From,
		<!--- Dev Note: drachala; D28180:  D28180: Copying a template with PG filters has issues --->
			#Template_Filters_Id#
			FROM Customer_Group_Template_Selection
			WHERE Template_ID = #getFisrParentID.First_Parent_ID#
									AND Deleted = 0
			</cfquery>
			<cfquery name="insert_Operator_group_template" datasource="#application.datasource#">
			INSERT INTO Operator_Group_Template_Selection
			(
			Template_ID,
			Operator_Group_Level_ID,
			Operator_Group_ID,
			Active,
			Created_By,
			PG_Flag,
			Updated_From,
			Template_Filters_Id
			)
			SELECT
			#NewID#,
			Operator_Group_Level_ID,
			Operator_Group_ID,
			Active,
			Created_By,
			PG_Flag,
			Updated_From,
		<!--- Dev Note: drachala; D28180:  D28180: Copying a template with PG filters has issues --->
			#Template_Filters_Id#
			FROM Operator_Group_Template_Selection
			WHERE Template_ID = #getFisrParentID.First_Parent_ID#
									AND Deleted = 0
			</cfquery>
			<cfquery name="insert_Product_group_template" datasource="#application.datasource#">
			INSERT INTO Product_Group_Template_Selection
			(
			Template_ID,
			Product_Group_Level_ID,
			Product_Group_ID,
			Active,
			Created_By,
			PG_Flag,
			Updated_From,
			Template_Filters_Id
			)
			SELECT
			#NewID#,
			Product_Group_Level_ID,
			Product_Group_ID,
			Active,
			Created_By,
			PG_Flag,
			Updated_From,
		<!--- Dev Note: drachala; D28180:  D28180: Copying a template with PG filters has issues --->
					#Template_Filters_Id#
			FROM Product_Group_Template_Selection
			WHERE Template_ID = #getFisrParentID.First_Parent_ID#
									AND Deleted = 0
			</cfquery>
		<!--- Dev Note: Drachala; D27338 : JS error - syntax error when creating program START --->

			<cfset 	budgetManager = CreateObject("component","components.budgets.BudgetManager") />
			<cfset	budgetManager.copyTemplateBudget(getFisrParentID.First_Parent_ID , NewID) />

			<cfquery name="updatedFirstParent" datasource="#application.datasource#">
				UPDATE 	Program_Control_Panel_Options
				SET 	First_Parent_ID = <cfqueryparam value="#NewID#" cfsqltype="CF_SQL_INTEGER">,
						Copied_From_Template_ID = <cfqueryparam value="#ID#" cfsqltype="cf_sql_integer">
				WHERE 	ProgramControl_Panel_Options_ID = <cfqueryparam value="#NewID#" cfsqltype="CF_SQL_INTEGER">
			</cfquery>

		</cfif>

			<!--- Copy access proiles to new template ID --->
			<cfquery name="AccessInfo" datasource="#application.datasource#">
				INSERT INTO Profile_Forbidden_Template
					(
					Profile_ID,
					Template_ID,
					Forbid_Access_Type,
					Forbid_Type
					)
				SELECT
					Profile_ID,
					<cfqueryparam cfsqltype="cf_sql_integer" value="#NewID#">,
					Forbid_Access_Type,
					Forbid_Type
				FROM Profile_Forbidden_Template
				WHERE Template_ID = <cfqueryparam cfsqltype="cf_sql_integer" value="#ID#">
			</cfquery>


			<!--- update check duplicate based on the newID--->
			<cfquery name="UpdateCheckDup" datasource="#application.datasource#">
				UPDATE 	Program_Control_Panel_Options
				SET 	Check_Duplicate_Program = <cfqueryparam value="#FORM.allow_dup_programs#" cfsqltype="cf_sql_bit">,
						Duplicate_Program_Action = <cfqueryparam value="#FORM.dupAction#" cfsqltype="cf_sql_integer">
				WHERE 	ProgramControl_Panel_Options_ID = <cfqueryparam value="#NewID#" cfsqltype="cf_sql_integer">
			</cfquery>

			<!---Deactivates previous version only if its an edit not copy--->
			<cfif Action neq "Copy">
				<cfquery name="UpdateOldInfo" datasource="#application.datasource#">
					UPDATE 	Program_Control_Panel_Options
					SET 	IsDominant = 0
					WHERE 	ProgramControl_Panel_Options_ID = <cfqueryparam value="#ID#" cfsqltype="cf_sql_integer">
				</cfquery>
			</cfif>

			<cfquery name="CurrentPerformanceReq" datasource="#application.datasource#">
				SELECT 	DISTINCT Program_Perf_Req_ID, isnull(Program_Perf_Req_Checked, 1) as Program_Perf_Req_Checked
				FROM 	Program_Perf_Mapping
				WHERE 	Template_ID = <cfqueryparam value="#ID#" cfsqltype="cf_sql_integer">
			</cfquery>

			<cfloop query="CurrentPerformanceReq">
				<!---Updates performance requirements--->
				<cfquery name="UpdatePerfReqs" datasource="#application.datasource#">
				INSERT INTO Program_Perf_Mapping
				(Template_ID,
				Program_Perf_Req_ID,
				Program_Perf_Req_Checked)
				VALUES
				(
				<cfqueryparam value="#NewID#" cfsqltype="cf_sql_integer">,
				<cfqueryparam value="#Program_Perf_Req_ID#" cfsqltype="cf_sql_integer">,
				<!--- 17677 RBL NOTE: In 5.0 and 5.1, this is a cfqueryparamed as tinyint instead of legacy bit. In 4.3 not datatyped. [begin] --->
				<cfqueryparam value="#Program_Perf_Req_Checked#" cfsqltype="cf_sql_tinyint">
								<!--- 17677 RBL NOTE: In 5.0 and 5.1, this is a cfqueryparamed as tinyint instead of legacy bit. In 4.3 not datatyped. [end] --->
				)
				</cfquery>
			</cfloop>


			<!---Updates payment types--->

			<cfquery name="CurrentPaymentType" datasource="#application.datasource#">
				SELECT 	distinct Payment_Type_ID
				FROM 	Payment_Template_Mapping
				WHERE 	Template_ID = <cfqueryparam value="#ID#" cfsqltype="cf_sql_integer">
			</cfquery>

			<cfloop query="CurrentPaymentType">
				<!---Updates performance requirements--->
				<cfquery name="UpdatePaymentType" datasource="#application.datasource#">
				INSERT INTO Payment_Template_Mapping
				(Template_ID,
				Payment_Type_ID,
				Deleted,
				Created_Date)
				VALUES
				(
				<cfqueryparam value="#NewID#" cfsqltype="cf_sql_integer">,
				<cfqueryparam value="#Payment_Type_ID#" cfsqltype="cf_sql_integer">,
				0,
				GetDate()
				)
				</cfquery>
			</cfloop>


			<!---Updates currency --->

			<cfquery name="CurrentCurrency" datasource="#application.datasource#">
				SELECT 	distinct Currency_ID
				FROM 	Currency_Mapping
				WHERE 	Template_ID = <cfqueryparam value="#ID#" cfsqltype="cf_sql_integer">
			</cfquery>

			<cfloop query="CurrentCurrency">
				<cfquery name="UpdateCurrency" datasource="#application.datasource#">
				INSERT INTO Currency_Mapping
				(Template_ID,
				Currency_ID,
				Deleted,
				Created_Date)
				VALUES
				(
				<cfqueryparam value="#NewID#" cfsqltype="cf_sql_integer">,
				<cfqueryparam value="#Currency_ID#" cfsqltype="cf_sql_integer">,
				0,
				GetDate()
				)
				</cfquery>
			</cfloop>


			<!---Updates payment paid to types--->

			<cfquery name="CurrentPaymentPaidToType" datasource="#application.datasource#">
				SELECT 	distinct Payment_Paid_To_ID
				FROM 	Payment_Paid_To_Template_Mapping
				WHERE 	Template_ID = <cfqueryparam value="#ID#" cfsqltype="cf_sql_integer">
			</cfquery>

			<cfloop query="CurrentPaymentPaidToType">
				<!---Updates performance requirements--->
				<cfquery name="UpdatePaymentPaidToType" datasource="#application.datasource#">
				INSERT INTO Payment_Paid_To_Template_Mapping
				(Template_ID,
				Payment_Paid_To_ID,
				Deleted,
				Created_Date)
				VALUES
				(
				<cfqueryparam value="#NewID#" cfsqltype="cf_sql_integer">,
				<cfqueryparam value="#Payment_Paid_To_ID#" cfsqltype="cf_sql_integer">,
				0,
				GetDate()
				)
				</cfquery>
			</cfloop>

			<!------ Copy Template Discount Components ----->
			<cfif bTemplateLevelComponentFilter>
				<cfset templateManager.copyTemplateDiscountComponents(ID, NewID) />
			</cfif>

			<!------ copy revision settings from the parent template  ----->
			<cfset templateManager.copyRevisionSettings(fromTemplateId = ID, toTemplateId = NewID) />

			<cfparam name="PageName" default="Duplicate Program">
			<!------ Bring over all the duplicate definition in the parent template to this new tamplate ----->
			<cfset dupTemplateManager = CreateObject("component","components.programs.template.DuplicateTemplateManager").init(ID,trim(PageName)) />
			<!--- check to see if there's definition based on old ID --->
			<!--- if not, check if duplicate program check is on, if so, include importDupDefinition --->
			<cfif Not dupTemplateManager.isDuplicateDefExisted()>
				<cfif Not isDefined("template")>
					<cfset template = templateManager.get(NewID)>
				</cfif>
				<cfset allow_dup_programs = template.getDuplicate()>
				<cfif allow_dup_programs EQ 1>
					<cfinclude template="importDupDefinition.cfm">
				</cfif>
			</cfif>
				<cfset dupTemplateManager.importDefinitionFromTemplate(NewID)>
				<!------ Bring over all the clauses in the parent template to this new tamplate ----->
				<cfset clauseTemplateManager = CreateObject("component", "components.clause_library.ClauseTemplateManager").init() />
				<cfset clauseTemplateManager.importClauseFromTemplate(NewID, ID)>

				<!------ Save product category filter ----->
				<cfset productCategory = CreateObject("component", "components.products.Category.ProductCategory") />
				<cfif isDefined("application.returned_customer_setting.product_category_filter") and application.returned_customer_setting.product_category_filter>
					<cfset productCategory.saveCategoryFilters(NewID, productCategory.getCategoryFilters(ID)) />
				</cfif>

				<!---Save Template Business Segment if it's enabled--->
				<!---init BusinessSegmentManager to check if it's enabled--->
				<cfset variables.businessSegmentManager = CreateObject("component", "components.programs.business_segment.BusinessSegmentManager") />
				<cfif variables.businessSegmentManager.isEnabled() and appSettings.getFilterBusinessSegments()>
					<cfset variables.businessSegmentManager.addBusinessSegmentTemplateSettings(ID, NewID, form.Template_Business_Segment_ID) />
				</cfif>

<!--- save pullback default rates for Corporate Programs --->
		<!--- ************************************************************************************** --->
			<!---START: COMMENTED OUT WR 67118 DATA IS STORED AT Template_Parent_Id- LEVEL NOW  START --->
	<!--- ************************************************************************************** --->
<!---		<cfif form.Pullbacks_On EQ 1 and form.is_pullback_corporate_deal EQ 1>
						<cfquery name="currentdefaultrates" datasource="#application.datasource#">
						SELECT 	*
						FROM 	template_pullback_defaults
						WHERE 	corp_Template_ID = <cfqueryparam value="#ID#" cfsqltype="cf_sql_integer">
						and deleted = 0
					</cfquery>

					<cfloop query="currentdefaultrates">
						<!---Updates performance requirements--->
						<cfquery name="insertdefaultrates" datasource="#application.datasource#">
						INSERT INTO template_pullback_defaults
						(Corp_Template_ID,
						Opr_Loc_Template_Id,
						Pullback_Default_Rate)
						VALUES
						(
						<cfqueryparam value="#NewID#" cfsqltype="cf_sql_integer">,
						<cfqueryparam value="#Opr_Loc_Template_ID#" cfsqltype="cf_sql_integer">,
						<cfqueryparam value="#Pullback_Default_Rate#" cfsqltype="cf_sql_float">
						)
						</cfquery>
					</cfloop>
		<cfelseif ((form.generic_type EQ 'Distributor Trade/Shelter' and form.Pullbacks_On EQ 1 and form.is_pullback_corporate_deal EQ 0 and form.pullback_from_corporate EQ 1) OR ((form.generic_type EQ 'Operator Direct or HQ Programs' OR form.generic_type EQ 'Operator-Deviated Pricing') and form.Pullbacks_On EQ 1))>
				<cfquery name="currentdefaultrates" datasource="#application.datasource#">
						SELECT 	*
						FROM 	template_pullback_defaults
						WHERE 	Opr_Loc_Template_Id = <cfqueryparam value="#ID#" cfsqltype="cf_sql_integer">
						and deleted = 0
				</cfquery>
				<!---
				Dev Note: Milan (48182) - Remove any insert/update to "template_pullback_program_defaults".
				This table is not being used anymore.
				--->

				<cfloop query="currentdefaultrates">
						<!---Updates performance requirements--->
				<cfquery name="insertdefaultrates" datasource="#application.datasource#">
						INSERT INTO template_pullback_defaults
						(Corp_Template_ID,
						Opr_Loc_Template_Id,
						Pullback_Default_Rate)
						VALUES
						(
						<cfqueryparam value="#Corp_Template_ID#" cfsqltype="cf_sql_integer">,
						<cfqueryparam value="#NEWID#" cfsqltype="cf_sql_integer">,
						<cfqueryparam value="#Pullback_Default_Rate#" cfsqltype="cf_sql_float">
						)
				</cfquery>
				</cfloop>

		</cfif>--->
	<!--- ************************************************************************************** --->
			<!--- END: COMMENTED OUT WR 67118 DATA IS STORED AT Template_Parent_Id- LEVEL NOW END  --->
	<!--- ************************************************************************************** --->
<!--- end save pullback default rates for Corporate Programs --->
				<cfset ID = NewID>
				<cftransaction action="COMMIT">
				</cftransaction>

			<!---Gets ID for new version--->

			<!---Sets the ID equal to the new ID--->
		<!---It is active--->
		</cfif>

		<cfif Form.Active EQ "">
			<cfset Form.Active = "NULL">
		</cfif>

		<cfif Action eq "Copy">
			<cfset Form.Active = "0">
